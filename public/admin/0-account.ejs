        .account-status-inactive {
            color: #8a8a8a;
            background: rgba(138, 138, 138, 0.10);
        }
        .account-status-suspended {
            color: #dc3545;
            background: rgba(220, 53, 69, 0.10);
        }
        .account-status-pending {
            color: #d99a00;
            background: rgba(217, 154, 0, 0.10);
        }
    </style>
</head>
