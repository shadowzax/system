    <script>
        (function () {
            var userData = {};
            try { userData = JSON.parse(localStorage.getItem('userProfileData') || '{}'); } catch(e) {}
            var isAdmin = (userData.role || '').toLowerCase() === 'admin' || (userData.role || '').toLowerCase() === 'administrator';

            if (!isAdmin) {
                var container = document.querySelector('main .container');
                if (container) {
                    container.innerHTML = '<div class="info-card text-center py-12"><i class="las la-lock text-6xl text-error mb-4 block"></i><h2 class="text-2xl font-bold mb-2 text-[var(--color-white)]">غير مصرح لك بالوصول</h2><p class="text-muted">هذه الصفحة مخصصة للمسؤولين فقط.</p></div>';
                }
                Swal.fire({
                    icon: 'error',
                    title: 'غير مصرح',
                    text: 'يجب أن تكون مسؤولاً للوصول إلى هذه الصفحة.',
                    confirmButtonText: 'حسناً'
                });
                return;
            }

            var API_BASE = 'https://xsysx.shadowza.space/api/admin';
            var CREATE_URL = API_BASE + '/create/account';
            var LIST_URL = API_BASE + '/create/users';

            var accFullName = document.getElementById('accFullName');
            var accEmail = document.getElementById('accEmail');
            var accPhone = document.getElementById('accPhone');
            var accJobTitle = document.getElementById('accJobTitle');
            var accPassword = document.getElementById('accPassword');
            var accConfirmPass = document.getElementById('accConfirmPass');
            var accRole = document.getElementById('accRole');
            var accStatus = document.getElementById('accStatus');
            var accStatusLbl = document.getElementById('accStatusLbl');
            var saveAccBtn = document.getElementById('saveAccBtn');
            var resetAccBtn = document.getElementById('resetAccBtn');
            var togglePassBtn = document.getElementById('togglePassBtn');
            var toggleConfPassBtn = document.getElementById('toggleConfPassBtn');
            var emailMsg = document.getElementById('emailMsg');
            var phoneMsg = document.getElementById('phoneMsg');
            var passMsg = document.getElementById('passMsg');
            var confPassMsg = document.getElementById('confPassMsg');
            var roleMsg = document.getElementById('roleMsg');
            var permCheckboxes = document.querySelectorAll('.perm-checkbox');

            var accountsTable = document.getElementById('accountsTable');
            var accountsTableBody = document.getElementById('accountsTableBody');
            var accountsCountLabel = document.getElementById('accountsCountLabel');
            var accountsLoadingMsg = document.getElementById('accountsLoadingMsg');
            var noAccountsMsg = document.getElementById('noAccountsMsg');
            var refreshAccountsBtn = document.getElementById('refreshAccountsBtn');

            var cachedAccounts = [];

            function escapeHtml(value) {
                return String(value ?? "")
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            function getAccountTypeLabel(accountType) {
                var types = {
                    admin: "ادمن",
                    cashier: "كاشير",
                    viewer: "مشاهد"
                };
                return types[accountType] || accountType || "غير محدد";
            }

            function getAccountStatusLabel(status) {
                var statuses = {
                    active: "نشط",
                    inactive: "غير نشط",
                    suspended: "موقوف",
                    pending: "معلق"
                };
                return statuses[status] || status || "غير محدد";
            }

            function getAccountStatusClass(status) {
                var classes = {
                    active: "account-status-active",
                    inactive: "account-status-inactive",
                    suspended: "account-status-suspended",
                    pending: "account-status-pending"
                };
                return classes[status] || "account-status-inactive";
            }

            function getProfilePicture(user) {
                if (user.profile_picture) return escapeHtml(user.profile_picture);
                return "https://via.placeholder.com/80x80?text=User";
            }

            function renderAccounts(users) {
                accountsTableBody.innerHTML = "";
                cachedAccounts = Array.isArray(users) ? users : [];

                if (cachedAccounts.length === 0) {
                    accountsTable.style.display = "none";
                    noAccountsMsg.style.display = "block";
                    accountsCountLabel.textContent = "لا توجد حسابات";
                    accountsLoadingMsg.style.display = "none";
                    return;
                }

                noAccountsMsg.style.display = "none";
                accountsTable.style.display = "table";
                accountsCountLabel.textContent = 'إجمالي الحسابات: ' + cachedAccounts.length;
                accountsLoadingMsg.style.display = "none";

                cachedAccounts.forEach(function (user) {
                    var accountType = getAccountTypeLabel(user.account_type);
                    var accountStatus = getAccountStatusLabel(user.account_status);
                    var statusClass = getAccountStatusClass(user.account_status);
                    var row = document.createElement("tr");

                    row.innerHTML =
                        '<td>' +
                        '<div class="flex items-center gap-3">' +
                        '<img src="' + getProfilePicture(user) + '" alt="' + escapeHtml(user.name) + '" class="w-10 h-10 rounded-full object-cover" onerror="this.src=\'https://via.placeholder.com/80x80?text=User\';">' +
                        '<div>' +
                        '<div class="font-semibold text-[var(--color-white)]">' + escapeHtml(user.name || "بدون اسم") + '</div>' +
                        '<div class="text-xs text-[var(--color-muted)]">' + escapeHtml(user.phone_number || "بدون رقم") + '</div>' +
                        '</div>' +
                        '</div>' +
                        '</td>' +
                        '<td><span class="text-sm">' + escapeHtml(user.email || "غير متوفر") + '</span></td>' +
                        '<td><span class="text-sm">' + escapeHtml(accountType) + '</span></td>' +
                        '<td><span class="account-status ' + statusClass + '">' + escapeHtml(accountStatus) + '</span></td>' +
                        '<td><div class="flex items-center gap-2">' +
                        '<button type="button" class="btn-outline btn-sm view-account-btn" data-id="' + escapeHtml(user.id) + '" title="عرض الحساب"><i class="las la-eye"></i></button>' +
                        '</div></td>';

                    accountsTableBody.appendChild(row);
                });

                accountsTableBody.querySelectorAll('.view-account-btn').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        viewAccount(this.getAttribute('data-id'));
                    });
                });
            }

            function loadAccounts() {
                accountsLoadingMsg.style.display = "block";
                noAccountsMsg.style.display = "none";
                accountsTable.style.display = "none";
                accountsCountLabel.textContent = "جاري التحميل...";

                fetch(LIST_URL, {
                    method: "GET",
                    headers: { "Accept": "application/json" }
                })
                .then(function (response) {
                    if (!response.ok) throw new Error('HTTP Error: ' + response.status);
                    return response.json();
                })
                .then(function (data) {
                    if (!data.success) throw new Error(data.message || 'Failed to load accounts');
                    renderAccounts(data.users || []);
                })
                .catch(function (error) {
                    console.error("Failed to load accounts:", error);
                    accountsTable.style.display = "none";
                    noAccountsMsg.style.display = "none";
                    accountsCountLabel.textContent = "تعذر تحميل الحسابات";
                    accountsLoadingMsg.style.display = "none";
                    Swal.fire({
                        icon: 'error',
                        title: 'خطأ',
                        text: 'فشل تحميل الحسابات: ' + error.message,
                        confirmButtonText: 'حسناً'
                    });
                });
            }

            function viewAccount(id) {
                var account = cachedAccounts.find(function (user) {
                    return String(user.id) === String(id);
                });

                if (!account) return;

                var profilePicture = account.profile_picture
                    ? escapeHtml(account.profile_picture)
                    : "https://via.placeholder.com/80x80?text=User";

                var accountStatus = getAccountStatusLabel(account.account_status);
                var accountStatusClass = getAccountStatusClass(account.account_status);

                Swal.fire({
                    title: "تفاصيل الحساب",
                    html:
                        '<div class="account-details-wrapper">' +
                        '<div class="account-profile-header">' +
                        '<div class="account-profile-image-wrapper">' +
                        '<img src="' + profilePicture + '" alt="' + escapeHtml(account.name || "المستخدم") + '" class="account-profile-image" onerror="this.src=\'https://via.placeholder.com/80x80?text=User\';">' +
                        '</div>' +
                        '<div class="account-profile-info">' +
                        '<h3 class="account-profile-name">' + escapeHtml(account.name || "بدون اسم") + '</h3>' +
                        '<p class="account-profile-phone">' + escapeHtml(account.phone_number || "بدون رقم") + '</p>' +
                        '</div>' +
                        '</div>' +
                        '<div class="account-details-grid">' +
                        '<div class="account-detail-item"><div class="account-detail-icon"><i class="las la-user"></i></div><div class="account-detail-content"><span class="account-detail-label">الاسم</span><span class="account-detail-value">' + escapeHtml(account.name || "غير متوفر") + '</span></div></div>' +
                        '<div class="account-detail-item"><div class="account-detail-icon"><i class="las la-envelope"></i></div><div class="account-detail-content"><span class="account-detail-label">البريد الإلكتروني</span><span class="account-detail-value ltr">' + escapeHtml(account.email || "غير متوفر") + '</span></div></div>' +
                        '<div class="account-detail-item"><div class="account-detail-icon"><i class="las la-phone"></i></div><div class="account-detail-content"><span class="account-detail-label">رقم الهاتف</span><span class="account-detail-value ltr">' + escapeHtml(account.phone_number || "غير متوفر") + '</span></div></div>' +
                        '<div class="account-detail-item"><div class="account-detail-icon"><i class="las la-briefcase"></i></div><div class="account-detail-content"><span class="account-detail-label">المسمى الوظيفي</span><span class="account-detail-value">' + escapeHtml(account.job_title || "غير متوفر") + '</span></div></div>' +
                        '<div class="account-detail-item"><div class="account-detail-icon"><i class="las la-user-shield"></i></div><div class="account-detail-content"><span class="account-detail-label">الدور</span><span class="account-detail-value">' + escapeHtml(getAccountTypeLabel(account.account_type)) + '</span></div></div>' +
                        '<div class="account-detail-item"><div class="account-detail-icon"><i class="las la-toggle-on"></i></div><div class="account-detail-content"><span class="account-detail-label">الحالة</span><span class="account-detail-value"><span class="account-status-badge ' + accountStatusClass + '">' + escapeHtml(accountStatus) + '</span></span></div></div>' +
                        '</div>' +
                        '</div>',
                    confirmButtonText: "إغلاق",
                    confirmButtonColor: "#0d99ff",
                    width: "720px",
                    padding: "0",
                    background: "var(--color-light, #f9f7f7)",
                    color: "var(--text-dark, #2d2d2d)",
                    showCloseButton: true,
                    customClass: {
                        popup: 'account-details-swal'
                    }
                });
            }

            function clearValidationMsgs() {
                emailMsg.textContent = '';
                emailMsg.className = 'validation-msg';
                phoneMsg.textContent = '';
                phoneMsg.className = 'validation-msg';
                passMsg.textContent = '';
                passMsg.className = 'validation-msg';
                confPassMsg.textContent = '';
                confPassMsg.className = 'validation-msg';
                roleMsg.textContent = '';
                roleMsg.className = 'validation-msg';
            }

            function validateEmailOnly(email) {
                if (!email) return false;
                return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
            }

            function validateCreateForm() {
                clearValidationMsgs();
                var isValid = true;

                if (!accFullName.value.trim()) {
                    isValid = false;
                    accFullName.style.borderColor = '#ef4444';
                    setTimeout(function () { accFullName.style.borderColor = ''; }, 3000);
                }

                var emailVal = accEmail.value.trim();
                if (!emailVal) {
                    isValid = false;
                    emailMsg.textContent = 'البريد الإلكتروني مطلوب';
                    emailMsg.className = 'validation-msg error';
                } else if (!validateEmailOnly(emailVal)) {
                    isValid = false;
                    emailMsg.textContent = 'صيغة البريد الإلكتروني غير صالحة';
                    emailMsg.className = 'validation-msg error';
                }

                if (!accPhone.value.trim()) {
                    isValid = false;
                    phoneMsg.textContent = 'رقم الهاتف مطلوب';
                    phoneMsg.className = 'validation-msg error';
                }

                var passVal = accPassword.value;
                if (!passVal) {
                    isValid = false;
                    passMsg.textContent = 'كلمة المرور مطلوبة';
                    passMsg.className = 'validation-msg error';
                } else if (passVal.length < 6) {
                    isValid = false;
                    passMsg.textContent = 'كلمة المرور يجب أن تكون 6 أحرف على الأقل';
                    passMsg.className = 'validation-msg error';
                }

                var confVal = accConfirmPass.value;
                if (!confVal) {
                    isValid = false;
                    confPassMsg.textContent = 'تأكيد كلمة المرور مطلوب';
                    confPassMsg.className = 'validation-msg error';
                } else if (passVal !== confVal) {
                    isValid = false;
                    confPassMsg.textContent = 'كلمتا المرور غير متطابقتين';
                    confPassMsg.className = 'validation-msg error';
                }

                if (!accRole.value) {
                    isValid = false;
                    roleMsg.textContent = 'الدور الأساسي مطلوب';
                    roleMsg.className = 'validation-msg error';
                }

                return isValid;
            }

            function collectPermissions() {
                var permissions = {};
                permCheckboxes.forEach(function (cb) {
                    permissions[cb.getAttribute('data-perm')] = cb.checked ? 1 : 0;
                });
                return permissions;
            }

            function buildCreatePayload() {
                var permissions = collectPermissions();
                return {
                    name: accFullName.value.trim(),
                    email: accEmail.value.trim().toLowerCase(),
                    phone_number: accPhone.value.trim(),
                    password: accPassword.value,
                    account_type: accRole.value,
                    job_title: accJobTitle.value.trim(),
                    account_status: accStatus.checked ? 'active' : 'inactive',
                    advances: [],
                    expenses: [],
                    transfers: [],
                    fees: [],
                    dashboard_view: permissions.dashboard_view,
                    outgoing_manage: permissions.outgoing_manage,
                    visa_manage: permissions.visa_manage,
                    transfers_manage: permissions.transfers_manage,
                    advances_manage: permissions.advances_manage,
                    payments_manage: permissions.payments_manage,
                    accounts_manage: permissions.accounts_manage,
                    logs_view: permissions.logs_view,
                    settings_manage: permissions.settings_manage,
                    print_reports: permissions.print_reports
                };
            }

            function resetCreateForm() {
                accFullName.value = '';
                accEmail.value = '';
                accPhone.value = '';
                accJobTitle.value = '';
                accPassword.value = '';
                accConfirmPass.value = '';
                accRole.value = '';
                accStatus.checked = true;
                accStatusLbl.textContent = 'نشط';
                accPassword.setAttribute('type', 'password');
                accConfirmPass.setAttribute('type', 'password');
                togglePassBtn.querySelector('i').classList.remove('la-eye-slash');
                togglePassBtn.querySelector('i').classList.add('la-eye');
                toggleConfPassBtn.querySelector('i').classList.remove('la-eye-slash');
                toggleConfPassBtn.querySelector('i').classList.add('la-eye');
                permCheckboxes.forEach(function (cb) {
                    cb.checked = cb.getAttribute('data-perm') === 'dashboard_view';
                });
                clearValidationMsgs();
                accFullName.style.borderColor = '';
                accEmail.style.borderColor = '';
            }

            togglePassBtn.addEventListener('click', function () {
                var type = accPassword.getAttribute('type') === 'password' ? 'text' : 'password';
                accPassword.setAttribute('type', type);
                var icon = togglePassBtn.querySelector('i');
                icon.classList.toggle('la-eye', type === 'password');
                icon.classList.toggle('la-eye-slash', type === 'text');
            });

            toggleConfPassBtn.addEventListener('click', function () {
                var type = accConfirmPass.getAttribute('type') === 'password' ? 'text' : 'password';
                accConfirmPass.setAttribute('type', type);
                var icon = toggleConfPassBtn.querySelector('i');
                icon.classList.toggle('la-eye', type === 'password');
                icon.classList.toggle('la-eye-slash', type === 'text');
            });

            accStatus.addEventListener('change', function () {
                accStatusLbl.textContent = accStatus.checked ? 'نشط' : 'غير نشط';
            });

            saveAccBtn.addEventListener('click', function () {
                clearValidationMsgs();

                if (!validateCreateForm()) {
                    Swal.fire({
                        icon: 'error',
                        title: 'خطأ في النموذج',
                        text: 'يرجى تصحيح الأخطاء في النموذج',
                        confirmButtonText: 'حسناً'
                    });
                    return;
                }

                saveAccBtn.disabled = true;
                saveAccBtn.innerHTML = '<i class="las la-spinner la-spin"></i> جاري الحفظ...';

                fetch(CREATE_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(buildCreatePayload())
                })
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    saveAccBtn.disabled = false;
                    saveAccBtn.innerHTML = '<i class="las la-save"></i> حفظ الحساب';

                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'تم بنجاح',
                            text: 'تم إنشاء الحساب بنجاح',
                            confirmButtonText: 'حسناً'
                        });
                        resetCreateForm();
                        loadAccounts();
                    } else {
                        var message = data.message || '';
                        if (message.toLowerCase().indexOf('email') !== -1 && message.toLowerCase().indexOf('exist') !== -1) {
                            emailMsg.textContent = 'البريد الإلكتروني مستخدم بالفعل';
                            emailMsg.className = 'validation-msg error';
                        }
                        if (message.toLowerCase().indexOf('phone') !== -1 && message.toLowerCase().indexOf('exist') !== -1) {
                            phoneMsg.textContent = 'رقم الهاتف مستخدم بالفعل';
                            phoneMsg.className = 'validation-msg error';
                        }
                        Swal.fire({
                            icon: 'error',
                            title: 'خطأ',
                            text: data.message || 'حدث خطأ أثناء إنشاء الحساب',
                            confirmButtonText: 'حسناً'
                        });
                    }
                })
                .catch(function (err) {
                    saveAccBtn.disabled = false;
                    saveAccBtn.innerHTML = '<i class="las la-save"></i> حفظ الحساب';
                    Swal.fire({
                        icon: 'error',
                        title: 'فشل الاتصال',
                        text: 'فشل الاتصال بالخادم: ' + err.message,
                        confirmButtonText: 'حسناً'
                    });
                });
            });

            resetAccBtn.addEventListener('click', function () {
                resetCreateForm();
                Swal.fire({
                    icon: 'success',
                    title: 'تم',
                    text: 'تم إعادة تعيين النموذج',
                    confirmButtonText: 'حسناً',
                    timer: 1500,
                    showConfirmButton: false
                });
            });

            refreshAccountsBtn.addEventListener('click', loadAccounts);

            loadAccounts();
        })();
    </script>

    <script>
        (function () {
            var themeToggles = document.querySelectorAll('.theme-toggle');
            var body = document.body;
            var savedTheme = localStorage.getItem('theme') || 'dark';

            function applyTheme(theme) {
                var isDark = theme === 'dark';
                body.classList.toggle('light', !isDark);
                themeToggles.forEach(function (toggle) {
                    toggle.classList.toggle('dark', isDark);
                });
                localStorage.setItem('theme', theme);
            }

            applyTheme(savedTheme);

            themeToggles.forEach(function (toggle) {
                toggle.addEventListener('click', function () {
                    var isDark = !body.classList.contains('light');
                    applyTheme(isDark ? 'light' : 'dark');
                });
            });
        })();
    </script>

    <script>
        (function () {
            var userFullNameEl = document.getElementById('userFullName');
            var roleEl = document.getElementById('role');
            var headerAvatarImg = document.getElementById('headerAvatar');
            var userAvatarImg = document.getElementById('userAvatar');

            try {
                var stored = localStorage.getItem('userProfileData');
                if (stored) {
                    var data = JSON.parse(stored);
                    if (data.fullName && userFullNameEl) userFullNameEl.textContent = data.fullName;
                    if (data.role && roleEl) roleEl.textContent = data.role;
                    if (data.avatar) {
                        if (headerAvatarImg) headerAvatarImg.src = data.avatar;
                        if (userAvatarImg) userAvatarImg.src = data.avatar;
                    }
                }
            } catch (e) {}
        })();
    </script>

