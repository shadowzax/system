            transition: background 0.2s;
        }
        .accounts-table tbody tr:hover {
            background: rgba(13, 153, 255, 0.04);
        }

        .role-badge {
            font-size: 0.7rem;
            padding: 4px 12px;
            border-radius: 20px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            white-space: nowrap;
