            function renderSharedTable() {
                const file = getFileByRestaurantId(currentRestaurantId);
                if (!file) return;
                const monthKey = getFolderMonthKey(currentRestaurantId);
                const daysInMonth = getDaysInMonth(monthKey);
                if (salariesMonthBadge) {
                    salariesMonthBadge.innerHTML = '<i class="las la-calendar-alt"></i> ' + formatMonthDisplay(monthKey) + ' · ' + daysInMonth + ' يوم';
                }
                sharedTableHead.innerHTML = '';
                sharedTableBody.innerHTML = '';
                sharedTableFoot.innerHTML = '';
                if (!file.employees || file.employees.length === 0) {
                    sharedTableBody.innerHTML = '<tr><td colspan="' + (daysInMonth + 9) + '" class="text-center py-8 text-[var(--color-muted)]">لا يوجد موظفين</td></tr>';
                    return;
                }
                let headRow = '<tr><th class="emp-header">الموظف</th>';
                for (let d = 1; d <= daysInMonth; d++) {
                    headRow += '<th class="day-num-header">' + d + '</th>';
                }
                headRow += '<th class="emp-header" style="width:50px; min-width:50px;">خصم أيام</th>';
                headRow += '<th class="emp-header" style="width:60px; min-width:60px;">خصم تأمينات</th>';
                headRow += '<th class="emp-header" style="width:60px; min-width:60px;">خصم نقدي</th>';
                headRow += '<th class="emp-header">أيام الحضور</th>';
                headRow += '<th class="emp-header">راتب الأيام</th>';
                headRow += '<th class="emp-header">إجمالي السلف</th>';
                headRow += '<th class="emp-header">اليومية</th>';
                headRow += '<th class="emp-header">صافي الراتب</th>';
                headRow += '<th class="emp-header">إجمالي الخصومات</th>';
                headRow += '</tr>';
                sharedTableHead.innerHTML = headRow;
                file.employees.forEach(emp => {
                    const monthlySalary = parseNumber(emp.monthlySalary || 0);
                    const dayRate = monthlySalary / 30;
                    const dayData = getEmployeeDayData(currentRestaurantId, emp.id, monthKey, 'salary');
                    if (!dayData.days) dayData.days = {};
                    let originalAttendanceDays = 0;
                    let row = '<tr>';
                    row += '<td class="emp-cell"><div class="emp-name-display">' + (emp.name || 'بدون اسم') + '</div><div class="emp-code-display">كود: ' + (emp.code || '---') + ' · ' + (emp.profession || '---') + '</div></td>';
                    for (let d = 1; d <= daysInMonth; d++) {
                        const multiplierVal = dayData.days[d] !== undefined ? dayData.days[d] : '';
                        const numVal = parseNumber(multiplierVal);
                        const hasVal = multiplierVal !== '' && !isNaN(numVal);
                        const isZero = hasVal && numVal === 0;
                        let cls = '';
                        if (isZero) cls = ' has-value-zero';
                        else if (hasVal && numVal !== 0) cls = ' has-value';
                        if (hasVal && numVal > 0) originalAttendanceDays++;
                        const readonlyAttr = isViewer ? ' readonly' : '';
                        row += '<td><input type="text" class="day-input' + cls + '" id="day-input-' + emp.id + '-' + d + '" data-day="' + d + '" data-eid="' + emp.id + '" value="' + multiplierVal + '" inputmode="decimal" placeholder="0"' + readonlyAttr + '></td>';
                    }
                    const daysDeduction = parseNumber(dayData.daysDeduction || 0);
                    const insuranceDeduction = parseNumber(dayData.insuranceDeduction || 0);
                    const cashDeduction = parseNumber(dayData.cashDeduction || 0);
                    row += '<td><input type="text" class="deduction-input" id="daysDeduction-input-' + emp.id + '" data-eid="' + emp.id + '" data-type="days" value="' + (daysDeduction || '') + '" inputmode="decimal" placeholder="0"' + (isViewer ? ' readonly' : '') + '></td>';
                    row += '<td><input type="text" class="deduction-input" id="insuranceDeduction-input-' + emp.id + '" data-eid="' + emp.id + '" data-type="insurance" value="' + (insuranceDeduction || '') + '" inputmode="decimal" placeholder="0"' + (isViewer ? ' readonly' : '') + '></td>';
                    row += '<td><input type="text" class="deduction-input" id="cashDeduction-input-' + emp.id + '" data-eid="' + emp.id + '" data-type="cash" value="' + (cashDeduction || '') + '" inputmode="decimal" placeholder="0"' + (isViewer ? ' readonly' : '') + '></td>';
                    const adjustedAttendanceDays = Math.max(0, originalAttendanceDays - daysDeduction);
                    const totalLoans = getEmployeeTotalLoans(emp);
                    const daysSalary = dayRate * adjustedAttendanceDays;
                    const netSalary = daysSalary - totalLoans - insuranceDeduction - cashDeduction;
                    const totalDeductions = (daysInMonth - adjustedAttendanceDays) * dayRate + insuranceDeduction + cashDeduction;
                    row += '<td class="emp-cell" style="color:var(--color-primary);font-weight:700;">' + formatNumber(adjustedAttendanceDays) + '</td>';
                    row += '<td class="emp-cell" style="color:#0d99ff;font-weight:700;">' + formatNumber(daysSalary) + '</td>';
                    row += '<td class="emp-cell" style="color:#ef4444;font-weight:700;">' + formatNumber(totalLoans) + '</td>';
                    row += '<td class="emp-cell" style="color:var(--color-muted);font-weight:600;">' + formatNumber(dayRate) + '</td>';
                    row += '<td class="emp-cell" style="color:#10b981;font-weight:700;">' + formatNumber(netSalary) + '</td>';
                    row += '<td class="emp-cell" style="color:#f59e0b;font-weight:700;">' + formatNumber(totalDeductions) + '</td>';
                    row += '</tr>';
                    sharedTableBody.innerHTML += row;
                });
                sharedTableFoot.innerHTML = '<tr><td colspan="' + (daysInMonth + 9) + '" class="summary-label-cell"></td></tr>';
                if (!isViewer) {
                    bindSalaryInputEvents();
                    bindDeductionInputEvents();
                }
                filterSalariesTable();
            }

            function filterSalariesTable() {
                const query = salariesSearchInput ? salariesSearchInput.value.toLowerCase().trim() : '';
                const rows = sharedTableBody.querySelectorAll('tr');
                rows.forEach(row => {
                    const empName = row.querySelector('.emp-name-display')?.textContent || '';
                    const empCode = row.querySelector('.emp-code-display')?.textContent || '';
                    const searchText = (empName + ' ' + empCode).toLowerCase();
                    if (searchText.includes(query)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }

            function updateSalaryRowSummary(empId) {
                const monthKey = getFolderMonthKey(currentRestaurantId);
                const file = getFileByRestaurantId(currentRestaurantId);
                if (!file) return;
                const emp = file.employees.find(e => e.id === empId);
                if (!emp) return;
                const daysInMonth = getDaysInMonth(monthKey);
                const monthlySalary = parseNumber(emp.monthlySalary || 0);
                const dayRate = monthlySalary / 30;
                let originalAttendanceDays = 0;
                for (let d = 1; d <= daysInMonth; d++) {
                    const input = document.getElementById('day-input-' + empId + '-' + d);
                    if (input) {
                        const val = parseNumber(input.value);
                        if (!isNaN(val) && val > 0) originalAttendanceDays++;
                    }
                }
                const daysDeduction = parseNumber(document.getElementById('daysDeduction-input-' + empId)?.value || 0);
                const insuranceDeduction = parseNumber(document.getElementById('insuranceDeduction-input-' + empId)?.value || 0);
                const cashDeduction = parseNumber(document.getElementById('cashDeduction-input-' + empId)?.value || 0);
                const adjustedAttendanceDays = Math.max(0, originalAttendanceDays - daysDeduction);
                const totalLoans = getEmployeeTotalLoans(emp);
                const daysSalary = dayRate * adjustedAttendanceDays;
                const netSalary = daysSalary - totalLoans - insuranceDeduction - cashDeduction;
                const totalDeductions = (daysInMonth - adjustedAttendanceDays) * dayRate + insuranceDeduction + cashDeduction;
                const rows = sharedTableBody.querySelectorAll('tr');
                rows.forEach(row => {
                    const rowEmpId = row.querySelector('.day-input')?.getAttribute('data-eid');
                    if (rowEmpId === empId) {
                        const cells = row.querySelectorAll('td.emp-cell');
                        if (cells.length >= 6) {
                            cells[0].textContent = formatNumber(adjustedAttendanceDays);
                            cells[0].style.color = 'var(--color-primary)';
                            cells[1].textContent = formatNumber(daysSalary);
                            cells[1].style.color = '#0d99ff';
                            cells[2].textContent = formatNumber(totalLoans);
                            cells[2].style.color = '#ef4444';
                            cells[3].textContent = formatNumber(dayRate);
                            cells[3].style.color = 'var(--color-muted)';
                            cells[4].textContent = formatNumber(netSalary);
                            cells[4].style.color = '#10b981';
                            cells[5].textContent = formatNumber(totalDeductions);
                            cells[5].style.color = '#f59e0b';
                        }
                    }
                });
            }

            function bindSalaryInputEvents() {
                sharedTableBody.querySelectorAll('.day-input').forEach(input => {
                    if (isViewer) return;
                    input.addEventListener('input', function() {
                        const val = convertArabicNumerals(this.value).replace(/,/g, '');
                        const num = parseFloat(val);
                        this.classList.remove('has-value', 'has-value-zero');
                        if (val !== '' && !isNaN(num)) {
                            if (num === 0) this.classList.add('has-value-zero');
                            else this.classList.add('has-value');
                        }
                        const empId = this.getAttribute('data-eid');
                        if (empId) updateSalaryRowSummary(empId);
                    });
                    input.addEventListener('blur', async function() {
                        let val = convertArabicNumerals(this.value).replace(/,/g, '');
                        const num = parseFloat(val);
                        if (!isNaN(num) && val !== '') {
                            this.value = formatNumber(num);
                            if (num === 0) { this.classList.add('has-value-zero'); this.classList.remove('has-value'); }
                            else { this.classList.add('has-value'); this.classList.remove('has-value-zero'); }
                        } else {
                            this.value = '';
                            this.classList.remove('has-value', 'has-value-zero');
                        }
                        const empId = this.getAttribute('data-eid');
                        if (empId) updateSalaryRowSummary(empId);
                        await saveSalaryInput(this);
                    });
                    input.addEventListener('keydown', function(e) {
                        const key = e.key;
                        if (key === 'Enter') {
                            e.preventDefault();
                            this.blur();
                            return;
                        }
                        const directionMap = { 'ArrowUp': 'up', 'ArrowDown': 'down', 'ArrowLeft': 'left', 'ArrowRight': 'right' };
                        if (directionMap[key]) {
                            e.preventDefault();
                            const direction = directionMap[key];
                            const target = getAdjacentSalaryInput(this, direction);
                            if (target) target.focus();
                            else this.blur();
                        }
                    });
                });
            }

            function getAdjacentSalaryInput(currentInput, direction) {
                const employeeId = currentInput.getAttribute('data-eid');
                const day = parseInt(currentInput.getAttribute('data-day'));
                const monthKey = getFolderMonthKey(currentRestaurantId);
                const daysInMonth = getDaysInMonth(monthKey);
                if (direction === 'left') {
                    if (day < daysInMonth) return document.getElementById('day-input-' + employeeId + '-' + (day + 1));
                } else if (direction === 'right') {
                    if (day > 1) return document.getElementById('day-input-' + employeeId + '-' + (day - 1));
                } else if (direction === 'up' || direction === 'down') {
                    const file = getFileByRestaurantId(currentRestaurantId);
                    if (!file || !file.employees) return null;
                    const employees = file.employees;
                    const currentEmpIndex = employees.findIndex(e => e.id === employeeId);
                    let targetEmpIndex = direction === 'up' ? currentEmpIndex - 1 : currentEmpIndex + 1;
                    if (targetEmpIndex >= 0 && targetEmpIndex < employees.length) {
                        return document.getElementById('day-input-' + employees[targetEmpIndex].id + '-' + day);
                    }
                }
                return null;
            }

            async function saveSalaryInput(input) {
                if (isViewer) { showToast('لا يمكنك تعديل البيانات في وضع العرض', 'error'); return; }
                const fileId = currentRestaurantId;
                const employeeId = input.getAttribute('data-eid');
                const day = parseInt(input.getAttribute('data-day'));
                const rawVal = convertArabicNumerals(input.value).replace(/,/g, '').trim();
                const amount = rawVal === '' ? 0 : parseFloat(rawVal);
                if (isNaN(amount)) { showToast('قيمة غير صحيحة', 'error'); return; }
                try {
                    await sendSalaryToServer(fileId, employeeId, day, amount);
                    const monthKey = getFolderMonthKey(currentRestaurantId);
                    const file = getFileByRestaurantId(fileId);
                    const emp = file.employees.find(e => e.id === employeeId);
                    if (emp) {
                        if (!emp.monthlyData) emp.monthlyData = {};
                        if (!emp.monthlyData[monthKey]) emp.monthlyData[monthKey] = { days: {}, daysDeduction: 0, insuranceDeduction: 0, cashDeduction: 0 };
                        if (amount === 0) delete emp.monthlyData[monthKey].days[day];
                        else emp.monthlyData[monthKey].days[day] = String(amount);
                    }
                    updateSalaryRowSummary(employeeId);
                    showToast(amount === 0 ? 'تم حذف القيمة' : 'تم حفظ القيمة', 'success');
                } catch (error) {
                    showToast(error.message || 'حدث خطأ', 'error');
                    input.value = input.defaultValue || '';
                }
            }

            function bindDeductionInputEvents() {
                sharedTableBody.querySelectorAll('.deduction-input').forEach(input => {
                    if (isViewer) return;
                    input.addEventListener('input', function() {
                        const empId = this.getAttribute('data-eid');
                        if (empId) updateSalaryRowSummary(empId);
                    });
                    input.addEventListener('blur', async function() {
                        let val = convertArabicNumerals(this.value).replace(/,/g, '').trim();
                        const num = parseFloat(val);
                        if (!isNaN(num) && val !== '') {
                            this.value = formatNumber(num);
                        } else {
                            this.value = '';
                        }
                        const empId = this.getAttribute('data-eid');
                        if (empId) updateSalaryRowSummary(empId);
                        await saveDeductionInput(this);
                    });
                    input.addEventListener('keydown', function(e) {
                        if (e.key === 'Enter') {
                            e.preventDefault();
                            this.blur();
                            return;
                        }
                        const directionMap = { 'ArrowUp': 'up', 'ArrowDown': 'down', 'ArrowLeft': 'left', 'ArrowRight': 'right' };
                        if (directionMap[e.key]) {
                            e.preventDefault();
                            const direction = directionMap[e.key];
                            const target = getAdjacentDeductionInput(this, direction);
                            if (target) target.focus();
                            else this.blur();
                        }
                    });
                });
            }

            function getAdjacentDeductionInput(currentInput, direction) {
                const employeeId = currentInput.getAttribute('data-eid');
                const type = currentInput.getAttribute('data-type');
                const order = ['days', 'insurance', 'cash'];
                const currentIndex = order.indexOf(type);
                const file = getFileByRestaurantId(currentRestaurantId);
                if (!file || !file.employees) return null;
                const employees = file.employees;
                const currentEmpIndex = employees.findIndex(e => e.id === employeeId);
                let targetEmpIndex = currentEmpIndex;
                let targetTypeIndex = currentIndex;
                if (direction === 'left') {
                    targetTypeIndex = Math.min(order.length - 1, currentIndex + 1);
                } else if (direction === 'right') {
                    targetTypeIndex = Math.max(0, currentIndex - 1);
                } else if (direction === 'up') {
                    targetEmpIndex = currentEmpIndex - 1;
                    if (targetEmpIndex < 0) return null;
                } else if (direction === 'down') {
                    targetEmpIndex = currentEmpIndex + 1;
                    if (targetEmpIndex >= employees.length) return null;
                }
                if (targetEmpIndex >= 0 && targetEmpIndex < employees.length && targetTypeIndex >= 0 && targetTypeIndex < order.length) {
                    const targetEmp = employees[targetEmpIndex];
                    const targetType = order[targetTypeIndex];
                    const prefix = targetType === 'days' ? 'daysDeduction' : targetType === 'insurance' ? 'insuranceDeduction' : 'cashDeduction';
                    return document.getElementById(prefix + '-input-' + targetEmp.id);
                }
                return null;
            }

            async function saveDeductionInput(input) {
                if (isViewer) { showToast('لا يمكنك تعديل البيانات في وضع العرض', 'error'); return; }
                const fileId = currentRestaurantId;
                const employeeId = input.getAttribute('data-eid');
                const type = input.getAttribute('data-type');
                const rawVal = convertArabicNumerals(input.value).replace(/,/g, '').trim();
                const value = rawVal === '' ? 0 : parseFloat(rawVal);
                if (isNaN(value)) { showToast('قيمة غير صحيحة', 'error'); return; }
                try {
                    const key = type === 'days' ? 'daysDeduction' : type === 'insurance' ? 'insuranceDeduction' : 'cashDeduction';
                    await sendSalaryToServer(fileId, employeeId, key, value);
                    const monthKey = getFolderMonthKey(currentRestaurantId);
                    const file = getFileByRestaurantId(fileId);
                    const emp = file.employees.find(e => e.id === employeeId);
                    if (emp) {
                        if (!emp.monthlyData) emp.monthlyData = {};
                        if (!emp.monthlyData[monthKey]) emp.monthlyData[monthKey] = { days: {}, daysDeduction: 0, insuranceDeduction: 0, cashDeduction: 0 };
                        if (type === 'days') emp.monthlyData[monthKey].daysDeduction = value;
                        else if (type === 'insurance') emp.monthlyData[monthKey].insuranceDeduction = value;
                        else if (type === 'cash') emp.monthlyData[monthKey].cashDeduction = value;
                    }
                    updateSalaryRowSummary(employeeId);
                    showToast(value === 0 ? 'تم حذف القيمة' : 'تم حفظ القيمة', 'success');
                } catch (error) {
                    showToast(error.message || 'حدث خطأ', 'error');
                }
            }

            function renderAdvancesTable() {
                const file = getFileByRestaurantId(currentRestaurantId);
                if (!file) return;
                const monthKey = getFolderMonthKey(currentRestaurantId);
                const daysInMonth = getDaysInMonth(monthKey);
                if (advancesMonthBadge) {
                    advancesMonthBadge.innerHTML = '<i class="las la-calendar-alt"></i> ' + formatMonthDisplay(monthKey) + ' · ' + daysInMonth + ' يوم';
                }
                advancesTableHead.innerHTML = '';
                advancesTableBody.innerHTML = '';
                advancesTableFoot.innerHTML = '';
                if (!file.employees || file.employees.length === 0) {
                    advancesTableBody.innerHTML = '<tr><td colspan="' + (daysInMonth + 2) + '" class="text-center py-8 text-[var(--color-muted)]">لا يوجد موظفين</td></tr>';
                    return;
                }
                let headRow = '<tr><th class="emp-header">الموظف</th>';
                for (let d = 1; d <= daysInMonth; d++) headRow += '<th class="day-num-header">' + d + '</th>';
                headRow += '<th class="emp-header">إجمالي السلف</th></tr>';
                advancesTableHead.innerHTML = headRow;
                file.employees.forEach(emp => {
                    const advanceData = getEmployeeDayData(currentRestaurantId, emp.id, monthKey, 'advance');
                    if (!advanceData.days) advanceData.days = {};
                    let totalLoans = 0;
                    let row = '<tr>';
                    row += '<td class="emp-cell"><div class="emp-name-display">' + (emp.name || 'بدون اسم') + '</div><div class="emp-code-display">كود: ' + (emp.code || '---') + '</div></td>';
                    for (let d = 1; d <= daysInMonth; d++) {
                        const advanceVal = advanceData.days[d] !== undefined ? advanceData.days[d] : '';
                        const numVal = parseNumber(advanceVal);
                        const hasVal = advanceVal !== '' && !isNaN(numVal);
                        if (hasVal && numVal !== 0) totalLoans += numVal;
                        let cls = '';
                        if (hasVal && numVal !== 0) cls = ' has-value';
                        else if (hasVal && numVal === 0) cls = ' has-value-zero';
                        const readonlyAttr = isViewer ? ' readonly' : '';
                        row += '<td><input type="text" class="day-input' + cls + '" id="advance-input-' + emp.id + '-' + d + '" data-day="' + d + '" data-eid="' + emp.id + '" value="' + advanceVal + '" inputmode="decimal" placeholder="0"' + readonlyAttr + '></td>';
                    }
                    row += '<td class="emp-cell" style="color:#ef4444;font-weight:700;">' + formatNumber(totalLoans) + '</td>';
                    row += '</tr>';
                    advancesTableBody.innerHTML += row;
                });
                let footRow = '<tr><td class="summary-label-cell" style="font-weight:700;">إجمالي السلف لكل يوم</td>';
                for (let d = 1; d <= daysInMonth; d++) footRow += '<td class="summary-value-cell">-</td>';
                footRow += '<td class="summary-label-cell"></td></tr>';
                advancesTableFoot.innerHTML = footRow;
                if (!isViewer) {
                    bindAdvanceInputEvents();
                }
                updateAdvancesTableFootSummary();
                filterAdvancesTable();
            }

            function filterAdvancesTable() {
                const query = advancesSearchInput ? advancesSearchInput.value.toLowerCase().trim() : '';
                const rows = advancesTableBody.querySelectorAll('tr');
                rows.forEach(row => {
                    const empName = row.querySelector('.emp-name-display')?.textContent || '';
                    const empCode = row.querySelector('.emp-code-display')?.textContent || '';
                    const searchText = (empName + ' ' + empCode).toLowerCase();
                    if (searchText.includes(query)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }

            function updateAdvancesTableFootSummary() {
                const monthKey = getFolderMonthKey(currentRestaurantId);
                const file = getFileByRestaurantId(currentRestaurantId);
                if (!file || !file.employees) return;
                const daysInMonth = getDaysInMonth(monthKey);
                const footCells = advancesTableFoot.querySelectorAll('td');
                if (footCells.length < daysInMonth + 2) return;
                for (let d = 1; d <= daysInMonth; d++) {
                    let dayTotal = 0;
                    file.employees.forEach(emp => {
                        const input = document.getElementById('advance-input-' + emp.id + '-' + d);
                        if (input) {
                            const val = parseNumber(input.value);
                            if (!isNaN(val)) dayTotal += val;
                        }
                    });
                    footCells[d].textContent = dayTotal > 0 ? formatNumber(dayTotal) : '-';
                    footCells[d].style.color = dayTotal > 0 ? 'var(--color-primary)' : 'var(--color-muted)';
                }
            }

            function updateAdvanceRowSummary(empId) {
                const monthKey = getFolderMonthKey(currentRestaurantId);
                const file = getFileByRestaurantId(currentRestaurantId);
                if (!file) return;
                const emp = file.employees.find(e => e.id === empId);
                if (!emp) return;
                const daysInMonth = getDaysInMonth(monthKey);
                let totalLoans = 0;
                for (let d = 1; d <= daysInMonth; d++) {
                    const input = document.getElementById('advance-input-' + empId + '-' + d);
                    if (input) {
                        const val = parseNumber(input.value);
                        if (!isNaN(val) && val !== 0) totalLoans += val;
                    }
                }
                const rows = advancesTableBody.querySelectorAll('tr');
                rows.forEach(row => {
                    const rowEmpId = row.querySelector('.day-input')?.getAttribute('data-eid');
                    if (rowEmpId === empId) {
                        const cells = row.querySelectorAll('td.emp-cell');
                        if (cells.length >= 1) {
                            cells[cells.length - 1].textContent = formatNumber(totalLoans);
                            cells[cells.length - 1].style.color = '#ef4444';
                        }
                    }
                });
            }

            function bindAdvanceInputEvents() {
                advancesTableBody.querySelectorAll('.day-input').forEach(input => {
                    if (isViewer) return;
                    input.addEventListener('input', function() {
                        const val = convertArabicNumerals(this.value).replace(/,/g, '');
                        const num = parseFloat(val);
                        this.classList.remove('has-value', 'has-value-zero');
                        if (val !== '' && !isNaN(num)) {
                            if (num === 0) this.classList.add('has-value-zero');
                            else this.classList.add('has-value');
                        }
                        const empId = this.getAttribute('data-eid');
                        if (empId) updateAdvanceRowSummary(empId);
                        updateAdvancesTableFootSummary();
                    });
                    input.addEventListener('blur', async function() {
                        let val = convertArabicNumerals(this.value).replace(/,/g, '');
                        const num = parseFloat(val);
                        if (!isNaN(num) && val !== '') {
                            this.value = formatNumber(num);
                            if (num === 0) { this.classList.add('has-value-zero'); this.classList.remove('has-value'); }
                            else { this.classList.add('has-value'); this.classList.remove('has-value-zero'); }
                        } else {
                            this.value = '';
                            this.classList.remove('has-value', 'has-value-zero');
                        }
                        const empId = this.getAttribute('data-eid');
                        if (empId) updateAdvanceRowSummary(empId);
                        updateAdvancesTableFootSummary();
                        await saveAdvanceInput(this);
                    });
                    input.addEventListener('keydown', function(e) {
                        const key = e.key;
                        if (key === 'Enter') {
                            e.preventDefault();
                            this.blur();
                            return;
                        }
                        const directionMap = { 'ArrowUp': 'up', 'ArrowDown': 'down', 'ArrowLeft': 'left', 'ArrowRight': 'right' };
                        if (directionMap[key]) {
                            e.preventDefault();
                            const direction = directionMap[key];
                            const target = getAdjacentAdvanceInput(this, direction);
                            if (target) target.focus();
                            else this.blur();
                        }
                    });
                });
            }

            function getAdjacentAdvanceInput(currentInput, direction) {
                const employeeId = currentInput.getAttribute('data-eid');
                const day = parseInt(currentInput.getAttribute('data-day'));
                const monthKey = getFolderMonthKey(currentRestaurantId);
                const daysInMonth = getDaysInMonth(monthKey);
                if (direction === 'left') {
                    if (day < daysInMonth) return document.getElementById('advance-input-' + employeeId + '-' + (day + 1));
                } else if (direction === 'right') {
                    if (day > 1) return document.getElementById('advance-input-' + employeeId + '-' + (day - 1));
                } else if (direction === 'up' || direction === 'down') {
                    const file = getFileByRestaurantId(currentRestaurantId);
                    if (!file || !file.employees) return null;
                    const employees = file.employees;
                    const currentEmpIndex = employees.findIndex(e => e.id === employeeId);
                    let targetEmpIndex = direction === 'up' ? currentEmpIndex - 1 : currentEmpIndex + 1;
                    if (targetEmpIndex >= 0 && targetEmpIndex < employees.length) {
                        return document.getElementById('advance-input-' + employees[targetEmpIndex].id + '-' + day);
                    }
                }
                return null;
            }

            async function saveAdvanceInput(input) {
                if (isViewer) { showToast('لا يمكنك تعديل البيانات في وضع العرض', 'error'); return; }
                const fileId = currentRestaurantId;
                const employeeId = input.getAttribute('data-eid');
                const day = parseInt(input.getAttribute('data-day'));
                const rawVal = convertArabicNumerals(input.value).replace(/,/g, '').trim();
                const amount = rawVal === '' ? 0 : parseFloat(rawVal);
                if (isNaN(amount)) { showToast('قيمة غير صحيحة', 'error'); return; }
                const monthKey = getFolderMonthKey(currentRestaurantId);
                const file = getFileByRestaurantId(fileId);
                const emp = file.employees.find(e => e.id === employeeId);
                if (emp) {
                    if (!emp.monthlyAdvances) emp.monthlyAdvances = {};
                    if (!emp.monthlyAdvances[monthKey]) emp.monthlyAdvances[monthKey] = { days: {} };
                    if (amount === 0) delete emp.monthlyAdvances[monthKey].days[day];
                    else emp.monthlyAdvances[monthKey].days[day] = String(amount);
                }
                try {
                    await sendAdvanceToServer(fileId, employeeId, day, amount);
                    updateAdvanceRowSummary(employeeId);
                    updateAdvancesTableFootSummary();
                    showToast(amount === 0 ? 'تم حذف السلفة' : 'تم حفظ السلفة', 'success');
                } catch (error) {
                    showToast(error.message || 'حدث خطأ', 'error');
                }
            }

            function exportSalariesToExcel() {
                const file = getFileByRestaurantId(currentRestaurantId);
                if (!file || !file.employees || file.employees.length === 0) {
                    Swal.fire({ icon: 'error', title: 'خطأ', text: 'لا يوجد موظفين للتصدير' });
                    return;
                }
                const monthKey = getFolderMonthKey(currentRestaurantId);
                const daysInMonth = getDaysInMonth(monthKey);
                const data = [];
                const header = ['الموظف'];
                for (let d = 1; d <= daysInMonth; d++) header.push(d);
                header.push('خصم أيام', 'خصم تأمينات', 'خصم نقدي', 'أيام الحضور', 'راتب الأيام', 'إجمالي السلف', 'اليومية', 'صافي الراتب', 'إجمالي الخصومات');
                data.push(header);
                file.employees.forEach(emp => {
                    const row = [];
                    row.push((emp.name || '---') + ' (' + (emp.code || '---') + ')');
                    const monthlySalary = parseNumber(emp.monthlySalary || 0);
                    const dayRate = monthlySalary / 30;
                    const dayData = getEmployeeDayData(currentRestaurantId, emp.id, monthKey, 'salary');
                    if (!dayData.days) dayData.days = {};
                    let originalAttendanceDays = 0;
                    for (let d = 1; d <= daysInMonth; d++) {
                        const val = dayData.days[d] !== undefined ? parseNumber(dayData.days[d]) : '';
                        row.push(val === '' ? '' : val);
                        if (val !== '' && !isNaN(val) && val > 0) originalAttendanceDays++;
                    }
                    const daysDeduction = parseNumber(dayData.daysDeduction || 0);
                    const insuranceDeduction = parseNumber(dayData.insuranceDeduction || 0);
                    const cashDeduction = parseNumber(dayData.cashDeduction || 0);
                    row.push(formatNumber(daysDeduction), formatNumber(insuranceDeduction), formatNumber(cashDeduction));
                    const adjustedAttendanceDays = Math.max(0, originalAttendanceDays - daysDeduction);
                    const totalLoans = getEmployeeTotalLoans(emp);
                    const daysSalary = dayRate * adjustedAttendanceDays;
                    const netSalary = daysSalary - totalLoans - insuranceDeduction - cashDeduction;
                    const totalDeductions = (daysInMonth - adjustedAttendanceDays) * dayRate + insuranceDeduction + cashDeduction;
                    row.push(formatNumber(adjustedAttendanceDays), formatNumber(daysSalary), formatNumber(totalLoans), formatNumber(dayRate), formatNumber(netSalary), formatNumber(totalDeductions));
                    data.push(row);
                });
                const ws = XLSX.utils.aoa_to_sheet(data);
                const wb = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(wb, ws, 'الرواتب');
                XLSX.writeFile(wb, (file.name || 'salaries') + '_' + monthKey + '.xlsx');
            }

            function printSalaries() {
                const file = getFileByRestaurantId(currentRestaurantId);
                if (!file || !file.employees || file.employees.length === 0) {
                    Swal.fire({ icon: 'error', title: 'خطأ', text: 'لا يوجد موظفين للطباعة' });
                    return;
                }
                const monthKey = getFolderMonthKey(currentRestaurantId);
                const daysInMonth = getDaysInMonth(monthKey);
                let html = '<div class="print-header"><h2>' + (file.name || 'كشف رواتب يومية') + '</h2><div class="sub">' + formatMonthDisplay(monthKey) + ' · ' + daysInMonth + ' يوم</div></div>';
                html += '<table><thead><tr><th>الموظف</th>';
                for (let d = 1; d <= daysInMonth; d++) {
                    html += '<th>' + d + '</th>';
                }
                html += '<th>خصم أيام</th><th>خصم تأمينات</th><th>خصم نقدي</th><th>أيام الحضور</th><th>راتب الأيام</th><th>إجمالي السلف</th><th>اليومية</th><th>صافي الراتب</th><th>إجمالي الخصومات</th></tr></thead><tbody>';
                file.employees.forEach(emp => {
                    const monthlySalary = parseNumber(emp.monthlySalary || 0);
                    const dayRate = monthlySalary / 30;
                    const dayData = getEmployeeDayData(currentRestaurantId, emp.id, monthKey, 'salary');
                    if (!dayData.days) dayData.days = {};
                    let originalAttendanceDays = 0;
                    html += '<tr><td>' + (emp.name || '---') + ' (كود: ' + (emp.code || '---') + ')</td>';
                    for (let d = 1; d <= daysInMonth; d++) {
                        const val = dayData.days[d] !== undefined ? parseNumber(dayData.days[d]) : 0;
                        html += '<td>' + val + '</td>';
                        if (val > 0) originalAttendanceDays++;
                    }
                    const daysDeduction = parseNumber(dayData.daysDeduction || 0);
                    const insuranceDeduction = parseNumber(dayData.insuranceDeduction || 0);
                    const cashDeduction = parseNumber(dayData.cashDeduction || 0);
                    html += '<td>' + formatNumber(daysDeduction) + '</td><td>' + formatNumber(insuranceDeduction) + '</td><td>' + formatNumber(cashDeduction) + '</td>';
                    const adjustedAttendanceDays = Math.max(0, originalAttendanceDays - daysDeduction);
                    const totalLoans = getEmployeeTotalLoans(emp);
                    const daysSalary = dayRate * adjustedAttendanceDays;
                    const netSalary = daysSalary - totalLoans - insuranceDeduction - cashDeduction;
                    const totalDeductions = (daysInMonth - adjustedAttendanceDays) * dayRate + insuranceDeduction + cashDeduction;
                    html += '<td>' + formatNumber(adjustedAttendanceDays) + '</td><td>' + formatNumber(daysSalary) + '</td><td>' + formatNumber(totalLoans) + '</td><td>' + formatNumber(dayRate) + '</td><td>' + formatNumber(netSalary) + '</td><td>' + formatNumber(totalDeductions) + '</td></tr>';
                });
                html += '</tbody></table>';
                html += '<div class="footer"><div class="dev">Developed by Abdelrahman Mohamed</div><div class="dev-version">v5.2</div></div>';
                const printArea = document.getElementById('printArea');
                printArea.innerHTML = html;
                printArea.style.display = 'block';
                setTimeout(() => {
                    window.print();
                    printArea.style.display = 'none';
                }, 300);
            }

            function exportAdvancesToExcel() {
                const file = getFileByRestaurantId(currentRestaurantId);
                if (!file || !file.employees || file.employees.length === 0) {
                    Swal.fire({ icon: 'error', title: 'خطأ', text: 'لا يوجد موظفين للتصدير' });
                    return;
                }
                const monthKey = getFolderMonthKey(currentRestaurantId);
                const daysInMonth = getDaysInMonth(monthKey);
                const data = [];
                const header = ['الموظف'];
                for (let d = 1; d <= daysInMonth; d++) header.push(d);
                header.push('إجمالي السلف');
                data.push(header);
                file.employees.forEach(emp => {
                    const row = [];
                    row.push((emp.name || '---') + ' (' + (emp.code || '---') + ')');
                    const advanceData = getEmployeeDayData(currentRestaurantId, emp.id, monthKey, 'advance');
                    if (!advanceData.days) advanceData.days = {};
                    let totalLoans = 0;
                    for (let d = 1; d <= daysInMonth; d++) {
                        const val = advanceData.days[d] !== undefined ? parseNumber(advanceData.days[d]) : '';
                        row.push(val === '' ? '' : val);
                        if (val !== '' && !isNaN(val) && val !== 0) totalLoans += val;
                    }
                    row.push(formatNumber(totalLoans));
                    data.push(row);
                });
                const ws = XLSX.utils.aoa_to_sheet(data);
                const wb = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(wb, ws, 'السلف');
                XLSX.writeFile(wb, (file.name || 'advances') + '_' + monthKey + '_advances.xlsx');
            }

            function printAdvances() {
                const file = getFileByRestaurantId(currentRestaurantId);
                if (!file || !file.employees || file.employees.length === 0) {
                    Swal.fire({ icon: 'error', title: 'خطأ', text: 'لا يوجد موظفين للطباعة' });
                    return;
                }
                const monthKey = getFolderMonthKey(currentRestaurantId);
                const daysInMonth = getDaysInMonth(monthKey);
                let html = '<div class="print-header"><h2>' + (file.name || 'كشف سلف') + '</h2><div class="sub">' + formatMonthDisplay(monthKey) + ' · ' + daysInMonth + ' يوم</div></div>';
                html += '<table><thead><tr><th>الموظف</th>';
                for (let d = 1; d <= daysInMonth; d++) {
                    html += '<th>' + d + '</th>';
                }
                html += '<th>إجمالي السلف</th></tr></thead><tbody>';
                file.employees.forEach(emp => {
                    const advanceData = getEmployeeDayData(currentRestaurantId, emp.id, monthKey, 'advance');
                    if (!advanceData.days) advanceData.days = {};
                    let totalLoans = 0;
                    html += '<tr><td>' + (emp.name || '---') + ' (كود: ' + (emp.code || '---') + ')</td>';
                    for (let d = 1; d <= daysInMonth; d++) {
                        const val = advanceData.days[d] !== undefined ? parseNumber(advanceData.days[d]) : 0;
                        html += '<td>' + val + '</td>';
                        if (val !== 0) totalLoans += val;
                    }
                    html += '<td>' + formatNumber(totalLoans) + '</td></tr>';
                });
                html += '</tbody></table>';
                html += '<div class="footer"><div class="dev">Developed by Abdelrahman Mohamed</div><div class="dev-version">v5.2</div></div>';
                const printArea = document.getElementById('printArea');
                printArea.innerHTML = html;
                printArea.style.display = 'block';
                setTimeout(() => {
                    window.print();
                    printArea.style.display = 'none';
                }, 300);
            }

            document.getElementById('printSalariesBtn').addEventListener('click', printSalaries);
            document.getElementById('exportExcelBtn').addEventListener('click', exportSalariesToExcel);
            document.getElementById('exportAdvancesExcelBtn').addEventListener('click', exportAdvancesToExcel);
            document.getElementById('printAdvancesBtn').addEventListener('click', printAdvances);

            function loadAppDataFromServer() {
                const serverData = window.__SERVER_DATA__;
                if (serverData && serverData.success && Array.isArray(serverData.files)) {
                    appData.files = (serverData.files || []).filter(file => String(file.restaurant_id) === RESTAURANT_ID);
                    appData.files.forEach(file => {
                        if (file.employees) {
                            file.employees = deduplicateEmployees(file.employees);
                            file.employees.forEach(emp => convertLegacySalaryEmployee(emp, file.createdAt));
                        }
                    });
                } else {
                    appData.files = [];
                }
                if (folderSearchInput) folderSearchInput.value = '';
                renderFoldersList();
                setViewMode('files');
            }

            document.getElementById('adminSidebarLogoutBtn').addEventListener('click', function(e) {
                e.preventDefault();
                Swal.fire({
                    title: "تسجيل الخروج؟",
                    text: "هل أنت متأكد أنك تريد تسجيل الخروج؟",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "تسجيل الخروج",
                    cancelButtonText: "إلغاء",
                    confirmButtonColor: "#ef4444"
                }).then((result) => {
                    if (result.isConfirmed) {
                        document.cookie = "token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
                        window.location.href = "/login";
                    }
                });
            });

            document.addEventListener('DOMContentLoaded', function() {
                const themeToggles = document.querySelectorAll('.theme-toggle');
                const body = document.body;
                const applyTheme = (theme) => {
                    const isDark = theme === 'dark';
                    body.classList.toggle('light', !isDark);
                    themeToggles.forEach(toggle => toggle.classList.toggle('dark', isDark));
                };
                const savedTheme = localStorage.getItem('theme') || 'dark';
                applyTheme(savedTheme);
                themeToggles.forEach(toggle => {
                    toggle.addEventListener('click', () => {
                        const isDark = body.classList.contains('light') === false;
                        const newTheme = isDark ? 'light' : 'dark';
                        applyTheme(newTheme);
                        localStorage.setItem('theme', newTheme);
                    });
                });
                applyViewerRestrictions();
                loadAppDataFromServer();
            });
        })();
    </script>
</body>

