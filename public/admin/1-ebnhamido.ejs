    <script>
        window.__SERVER_DATA__ = <%- JSON.stringify(adminFiles) %>;
        (function() {
            const RESTAURANT_ID = "<%= restaurant.id %>";
            const ACCOUNT_TYPE = "<%= (typeof user !== 'undefined' && user && user.account_type) ? user.account_type : 'admin' %>";
            const isViewer = ACCOUNT_TYPE === 'viewer';
            const arabicToEnglishMap = { '٠': '0', '١': '1', '٢': '2', '٣': '3', '٤': '4', '٥': '5', '٦': '6', '٧': '7', '٨': '8', '٩': '9' };
            const Swal = window.Swal;

            function convertArabicNumerals(str) { return String(str).replace(/[٠-٩]/g, m => arabicToEnglishMap[m] || m); }

            function parseNumber(val) { const converted = convertArabicNumerals(String(val)); const cleaned = converted.replace(/,/g, '').trim(); const num = parseFloat(cleaned); return isNaN(num) ? 0 : num; }

            function formatNumber(num) { if (num === 0 || num === -0) return '0'; const abs = Math.abs(num); const formatted = abs.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 }); return num < 0 ? '-' + formatted : formatted; }

            function generateId() { return 'id_' + Date.now() + '_' + Math.random().toString(36).substr(2, 8); }

            function getCurrentMonthKey() { const now = new Date(); return now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0'); }

            function getFolderMonthKey(fileId) {
                const file = appData.files.find(f => String(f.id) === String(fileId));
                if (file && file.createdAt) {
                    const d = new Date(file.createdAt);
                    if (!isNaN(d.getTime())) {
                        return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
                    }
                }
                return getCurrentMonthKey();
            }

            function getDaysInMonth(monthKey) { const parts = monthKey.split('-'); const year = parseInt(parts[0]); const month = parseInt(parts[1]); return new Date(year, month, 0).getDate(); }

            function formatMonthDisplay(monthKey) { const parts = monthKey.split('-'); const year = parseInt(parts[0]); const month = parseInt(parts[1]); const monthNames = ['يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو', 'يوليو', 'أغسطس', 'سبتمبر', 'أكتوبر', 'نوفمبر', 'ديسمبر']; return monthNames[month - 1] + ' ' + year; }

            const API_BASE = '<%= api %>' + '/api/admin';
            let authToken = '<%= token %>';
            let appData = { files: [] };
            let currentRestaurantId = null;
            let currentViewMode = 'files';
            let pendingCopyFolderId = null;

            async function apiRequest(path, method = 'GET', body = null) {
                const headers = { 'Content-Type': 'application/json' };
                if (authToken) headers['Authorization'] = 'Bearer ' + authToken;
                const options = { method, headers };
                if (body) {
                    body.token = authToken;
                    options.body = JSON.stringify(body);
                }
                const response = await fetch(API_BASE + path, options);
                const data = await response.json();
                if (!response.ok || !data.success) {
                    throw new Error(data.message || 'حدث خطأ');
                }
                return data;
            }

            function showToast(message, type = 'success') {
                const container = document.getElementById('toastContainer');
                const toast = document.createElement('div');
                toast.className = 'toast-message ' + type;
                toast.innerHTML = '<i class="las ' + (type === 'success' ? 'la-check-circle' : 'la-exclamation-circle') + '"></i> ' + message;
                container.appendChild(toast);
                setTimeout(() => {
                    toast.classList.add('hide');
                    setTimeout(() => toast.remove(), 400);
                }, 3000);
            }

            function deduplicateEmployees(employees) {
                const seen = new Set();
                return employees.filter(emp => {
                    if (emp && emp.id && !seen.has(emp.id)) {
                        seen.add(emp.id);
                        return true;
                    }
                    return false;
                });
            }

            function convertLegacySalaryEmployee(employee, fileCreatedAt) {
                if (!employee) return;
                if (!employee.monthlyData) employee.monthlyData = {};
                if (!employee.monthlyAdvances) employee.monthlyAdvances = {};
                let monthKey;
                if (fileCreatedAt) {
                    const d = new Date(fileCreatedAt);
                    if (!isNaN(d.getTime())) {
                        monthKey = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
                    }
                }
                if (!monthKey) monthKey = getCurrentMonthKey();
                if (Array.isArray(employee.salaryRecords) && employee.salaryRecords.length > 0) {
                    employee.salaryRecords.forEach(rec => {
                        if (rec.days && typeof rec.days === 'object') {
                            let mk = monthKey;
                            if (rec.month) mk = rec.month;
                            if (!employee.monthlyData[mk]) employee.monthlyData[mk] = { days: {} };
                            for (const day in rec.days) {
                                const val = rec.days[day];
                                if (val !== undefined && val !== null && val !== '') {
                                    employee.monthlyData[mk].days[day] = String(val);
                                }
                            }
                        }
                    });
                    delete employee.salaryRecords;
                }
                if (Array.isArray(employee.advances) && employee.advances.length > 0) {
                    employee.advances.forEach(adv => {
                        if (adv.days && typeof adv.days === 'object') {
                            let mk = monthKey;
                            if (adv.month) mk = adv.month;
                            if (!employee.monthlyAdvances[mk]) employee.monthlyAdvances[mk] = { days: {} };
                            for (const day in adv.days) {
                                const val = adv.days[day];
                                if (val !== undefined && val !== null && val !== '') {
                                    employee.monthlyAdvances[mk].days[day] = String(val);
                                }
                            }
                        }
                    });
                    delete employee.advances;
                }
            }

