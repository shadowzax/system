    <style>
        #toastContainer {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 99999;
            display: flex;
            flex-direction: column;
            gap: 12px;
            pointer-events: none;
        }
        .toast-message {
            min-width: 220px;
            max-width: 320px;
            padding: 12px 18px;
            border-radius: 12px;
            background: #1f2937;
            color: #f9fafb;
            font-family: 'Alexandria', sans-serif;
            font-size: 14px;
            font-weight: 500;
            box-shadow: 0 8px 24px rgba(0,0,0,0.25);
            display: flex;
            align-items: center;
            gap: 10px;
            opacity: 0;
            transform: translateY(20px);
            animation: toastIn 0.35s ease forwards;
            pointer-events: auto;
        }
        .toast-message.success {
            background: #065f46;
            border-right: 4px solid #10b981;
        }
        .toast-message.error {
            background: #7f1d1d;
            border-right: 4px solid #ef4444;
        }
        .toast-message.hide {
            animation: toastOut 0.4s ease forwards;
        }
        @keyframes toastIn {
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes toastOut {
            from { opacity: 1; transform: translateY(0); }
            to { opacity: 0; transform: translateY(20px); }
        }
        .viewer-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(245, 158, 11, 0.15);
            color: #f59e0b;
            font-size: 12px;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 20px;
            border: 1px solid rgba(245, 158, 11, 0.3);
        }
        .viewer-badge i {
            font-size: 14px;
        }
        .day-input[readonly] {
            cursor: default;
            opacity: 0.85;
        }
        .day-input[readonly]:hover {
            border-color: var(--color-border, #374151);
            box-shadow: none;
        }
        .day-input[readonly]:focus {
            border-color: var(--color-border, #374151);
            box-shadow: none;
            outline: none;
        }
        .deduction-input {
            width: 50px;
            min-width: 50px;
            text-align: center;
            padding: 0.25rem 0.2rem;
            border-radius: 6px;
            border: 1px solid var(--color-border, #374151);
            background: var(--color-bg-input, #111827);
            color: var(--color-white);
            font-size: 0.75rem;
            font-weight: 500;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .deduction-input:focus {
            border-color: var(--color-primary, #0d99ff);
            box-shadow: 0 0 0 3px rgba(13, 153, 255, 0.2);
            outline: none;
        }
        .deduction-input.has-value {
            background: rgba(13, 153, 255, 0.1);
            border-color: var(--color-primary, #0d99ff);
        }
        .deduction-input.has-value-zero {
            background: rgba(239, 68, 68, 0.1);
            border-color: #ef4444;
        }
        .deduction-input[readonly] {
            cursor: default;
            opacity: 0.85;
        }
        .deduction-input[readonly]:hover {
            border-color: var(--color-border, #374151);
            box-shadow: none;
        }
        .deduction-input[readonly]:focus {
            border-color: var(--color-border, #374151);
            box-shadow: none;
            outline: none;
        }
        @media (max-width: 640px) {
            .shared-table .day-input,
            .shared-table .deduction-input {
                font-size: 0.75rem;
                padding: 0.25rem 0.2rem;
                min-width: 30px;
                width: 30px;
                height: 30px;
                text-align: center;
            }
            .deduction-input {
                width: 30px;
                min-width: 30px;
            }
            .shared-table th, .shared-table td {
                padding: 0.4rem 0.2rem;
                font-size: 0.75rem;
            }
            .shared-table .emp-cell {
                font-size: 0.7rem;
                min-width: 100px;
                position: sticky;
                right: 0;
                background: var(--color-bg-primary, #111827);
                z-index: 2;
                box-shadow: -2px 0 5px rgba(0,0,0,0.2);
            }
            .shared-table-wrapper {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
                max-height: calc(100vh - 200px);
                overflow-y: auto;
            }
            .shared-table thead th {
                position: sticky;
                top: 0;
                z-index: 3;
                background: var(--color-bg-secondary, #1f2937);
            }
        }
    </style>
