            function getEmployeeDayData(fileId, employeeId, monthKey, type = 'salary') {
                const file = getFileByRestaurantId(fileId);
                if (!file) return {};
                const emp = file.employees.find(e => e.id === employeeId);
                if (!emp) return {};
                if (type === 'salary') {
                    if (!emp.monthlyData) emp.monthlyData = {};
                    if (!emp.monthlyData[monthKey]) emp.monthlyData[monthKey] = { days: {}, daysDeduction: 0, insuranceDeduction: 0, cashDeduction: 0 };
                    return emp.monthlyData[monthKey];
                } else {
                    if (!emp.monthlyAdvances) emp.monthlyAdvances = {};
                    if (!emp.monthlyAdvances[monthKey]) emp.monthlyAdvances[monthKey] = { days: {} };
                    return emp.monthlyAdvances[monthKey];
                }
            }

            function getEmployeeAttendanceDays(fileId, employeeId, monthKey) {
                const dayData = getEmployeeDayData(fileId, employeeId, monthKey, 'salary');
                let count = 0;
                if (dayData.days) {
                    for (const day in dayData.days) {
                        if (parseNumber(dayData.days[day]) > 0) count++;
                    }
                }
                const daysDeduction = parseNumber(dayData.daysDeduction || 0);
                return Math.max(0, count - daysDeduction);
            }

            function getEmployeeTotalLoans(employee) {
                let total = 0;
                if (employee.monthlyAdvances) {
                    for (const monthKey in employee.monthlyAdvances) {
                        const monthData = employee.monthlyAdvances[monthKey];
                        if (monthData.days) {
                            for (const day in monthData.days) {
                                total += parseNumber(monthData.days[day] || 0);
                            }
                        }
                    }
                }
                return total;
            }

