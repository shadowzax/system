        const paginationContainer = document.getElementById('paginationContainer');
        const reportsPageSize = document.getElementById('reportsPageSize');
        const prevReportsPageBtn = document.getElementById('prevReportsPageBtn');
        const nextReportsPageBtn = document.getElementById('nextReportsPageBtn');
        const reportsPageIndicator = document.getElementById('reportsPageIndicator');
        const dashPaginationContainer = document.getElementById('dashPaginationContainer');
        const dashPageSize = document.getElementById('dashPageSize');
        const dashPrevPageBtn = document.getElementById('dashPrevPageBtn');
        const dashNextPageBtn = document.getElementById('dashNextPageBtn');
        const dashPageIndicator = document.getElementById('dashPageIndicator');
        const dashIncomePaginationContainer = document.getElementById('dashIncomePaginationContainer');
        const dashIncomePageSize = document.getElementById('dashIncomePageSize');
        const dashIncomePrevPageBtn = document.getElementById('dashIncomePrevPageBtn');
        const dashIncomeNextPageBtn = document.getElementById('dashIncomeNextPageBtn');
        const dashIncomePageIndicator = document.getElementById('dashIncomePageIndicator');

        let currentViewReportId = null;
        let selectedDateFilter = null;
        let expandedMonthFolders = {};
        let expandedDayFolders = {};
        let excludeCashReports = false;
        let dashExpenseAreaChartInstance = null;
        let dashIncomeAreaChartInstance = null;
        let dashExpenseBarChartInstance = null;
        let dashIncomeBarChartInstance = null;
        let dashExpensePieChartInstance = null;
        let dashIncomePieChartInstance = null;
        let dashboardDateFrom = null;
        let dashboardDateTo = null;
        let currentPage = 0;
        let totalPages = 0;
        let pageSize = 10;
        let monthKeys = [];
        let currentDashPage = 0;
        let totalDashPages = 0;
        let dashPageSizeValue = 10;
        let dashCategories = [];
        let currentIncomePage = 0;
        let totalIncomePages = 0;
        let dashIncomePageSizeValue = 10;
        let dashIncomeCategories = [];

        const arabicMonths = [
            'يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو',
            'يوليو', 'أغسطس', 'سبتمبر', 'أكتوبر', 'نوفمبر', 'ديسمبر'
        ];
        const arabicDays = ['الأحد', 'الاثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'];

        function normalizeArabicDigits(str) {
            if (!str) return str;
            const arabic = '٠١٢٣٤٥٦٧٨٩';
            const persian = '۰۱۲۳۴۵۶۷۸۹';
            return String(str)
                .replace(/[\u0660-\u0669]/g, d => String(arabic.indexOf(d)))
                .replace(/[\u06F0-\u06F9]/g, d => String(persian.indexOf(d)))
                .replace(/[\u200e\u200f]/g, '')
                .trim();
        }

        function parseAmountValue(value) {
            if (value === null || value === undefined) return 0;
            let str = normalizeArabicDigits(String(value));
            str = str.replace(/[^0-9.\-]/g, '');
            const num = parseFloat(str);
            return isNaN(num) ? 0 : num;
        }

        function normalizeDesc(desc) {
            if (!desc) return '';
            let normalized = String(desc).trim().toLowerCase();
            normalized = normalized.replace(/[\u064B-\u0652]/g, '');
            normalized = normalized.replace(/[أإآ]/g, 'ا');
            normalized = normalized.replace(/ى/g, 'ي');
            normalized = normalized.replace(/ة/g, 'ه');
            normalized = normalized.replace(/\s+/g, ' ');
            return normalized;
        }

        function getReportDateKey(report) {
            if (!report) return null;
            if (report.date) {
                const dateStr = normalizeArabicDigits(report.date);
                let m = dateStr.match(/(\d{4})[\/\-](\d{1,2})[\/\-](\d{1,2})/);
                if (m) return `${m[1]}-${m[2].padStart(2, '0')}-${m[3].padStart(2, '0')}`;
                m = dateStr.match(/(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})/);
                if (m) return `${m[3]}-${m[2].padStart(2, '0')}-${m[1].padStart(2, '0')}`;
            }
            if (report.timestamp) return String(report.timestamp).slice(0, 10);
            return null;
        }

        function isValidDateKey(dateKey) {
            if (!dateKey) return false;
            const parts = dateKey.split('-');
            if (parts.length !== 3) return false;
            const year = parseInt(parts[0], 10);
            const month = parseInt(parts[1], 10);
            const day = parseInt(parts[2], 10);
            if (isNaN(year) || isNaN(month) || isNaN(day)) return false;
            const dateObj = new Date(year, month - 1, day);
            return dateObj.getFullYear() === year && dateObj.getMonth() === month - 1 && dateObj.getDate() === day;
        }

        function getArabicDayName(dateKey) {
            if (!isValidDateKey(dateKey)) return '';
            const parts = dateKey.split('-').map(Number);
            const dateObj = new Date(parts[0], parts[1] - 1, parts[2]);
            const dayIndex = dateObj.getDay();
            return arabicDays[dayIndex] || '';
        }

        function getArabicMonthName(monthNum) {
            if (monthNum >= 1 && monthNum <= 12) return arabicMonths[monthNum - 1];
            return '';
        }

        function processReport(report) {
            if (!excludeCashReports) return report;
            const cashKeywords = ['كاش', 'نقدي'];
            const rows = Array.isArray(report.rows) ? report.rows.filter(row => !(row.desc && cashKeywords.some(k => row.desc.includes(k)))) : [];
            const total = rows.reduce((sum, row) => sum + parseAmountValue(row.amount), 0);
            return Object.assign({}, report, { rows: rows, total: total.toString() });
        }

        function getProcessedReports() {
            const reports = Array.isArray(window.expensesReports) ? window.expensesReports : [];
            let processed = excludeCashReports ? reports.map(processReport) : reports.slice();
            processed = combineDailyReports(processed);
            return processed;
        }

        function combineDailyReports(reports) {
            const groups = new Map();
            reports.forEach(report => {
                const name = (report.name || '').toLowerCase();
                const hasSbahi = name.includes('صباحي');
                const hasMasaei = name.includes('مسائي');
                if (!hasSbahi && !hasMasaei) return;
                const shift = hasSbahi ? 'sbahi' : 'masaei';
                const dateKey = getReportDateKey(report);
                if (!dateKey || !isValidDateKey(dateKey)) return;
                const groupKey = dateKey + '_' + shift;
                if (!groups.has(groupKey)) groups.set(groupKey, []);
                groups.get(groupKey).push(report);
            });
            const combinedReports = [];
            groups.forEach((groupReports, key) => {
                if (groupReports.length < 2) return;
                const [dateKey, shift] = key.split('_');
                const name = shift === 'sbahi' ? `تقارير ${restaurantName} صباحي يومي` : `تقارير ${restaurantName} مسائي يومي`;
                const rowsMap = new Map();
                groupReports.forEach(report => {
                    if (report.rows && report.rows.length) {
                        report.rows.forEach(row => {
                            const desc = row.desc || '';
                            const normDesc = normalizeDesc(desc);
                            const amount = parseAmountValue(row.amount);
                            if (rowsMap.has(normDesc)) {
                                const existing = rowsMap.get(normDesc);
                                existing.amount += amount;
                                existing.amountStr = existing.amount.toString();
                            } else {
                                rowsMap.set(normDesc, { desc: desc, amount: amount, amountStr: amount.toString() });
                            }
                        });
                    }
                });
                const combinedRows = Array.from(rowsMap.values()).map(item => ({ desc: item.desc, amount: item.amountStr }));
                const total = combinedRows.reduce((sum, row) => sum + parseAmountValue(row.amount), 0);
                combinedReports.push({
                    id: 'combined_' + key,
                    name: name,
                    date: dateKey,
                    rows: combinedRows,
                    total: total.toString(),
                    sourceLabel: 'مجمع',
                    combined: true,
                    created_by: { name: 'تجميع تلقائي' }
                });
            });
            return reports.concat(combinedReports);
        }

        function hideReportView() {
            reportViewCard.style.display = 'none';
            recentReportsCard.style.display = 'block';
            currentViewReportId = null;
        }

        function viewReportById(reportId) {
            const reports = getProcessedReports();
            const report = reports.find(r => r.id === reportId);
            if (!report) {
                showSuccess('التقرير غير موجود.');
                return;
            }
            currentViewReportId = reportId;
            viewReportTitle2.textContent = report.name || 'تقرير';
            viewReportDate2.textContent = report.date || '';
            viewReportTbody2.innerHTML = '';
            if (report.rows && report.rows.length) {
                report.rows.forEach(row => {
                    const tr = document.createElement('tr');
                    const tdDesc = document.createElement('td');
                    tdDesc.textContent = row.desc || '';
                    const tdAmount = document.createElement('td');
                    tdAmount.textContent = row.amount || '0';
                    tr.appendChild(tdDesc);
                    tr.appendChild(tdAmount);
                    viewReportTbody2.appendChild(tr);
                });
            }
            viewReportTotal2.textContent = report.total || '0';
            if (report.created_by && report.created_by.name) {
                let creatorHtml = '';
                if (report.created_by.profile_picture) {
                    creatorHtml += `<img src="${report.created_by.profile_picture}" class="creator-avatar" alt="creator">`;
                }
                creatorHtml += `<span>بواسطة: ${report.created_by.name}</span>`;
                viewReportCreator.innerHTML = creatorHtml;
            } else {
                viewReportCreator.innerHTML = '';
            }
            reportViewCard.style.display = 'block';
            recentReportsCard.style.display = 'none';
            dashboardCard.style.display = 'none';
        }

        function buildReportListItem(report) {
            const creatorName = report.created_by ? report.created_by.name : '';
            const creatorPic = report.created_by ? report.created_by.profile_picture : '';
            const dateSourceLine = `${report.date || ''}${report.sourceLabel ? ' • ' + report.sourceLabel : ''}${creatorName ? ' • بواسطة: ' + creatorName : ''}`.trim();
            let avatarHtml = '';
            if (creatorPic) avatarHtml = `<img src="${creatorPic}" class="creator-avatar" alt="creator">`;
            return `<div class="report-list-item">
                <div class="report-info">
                    <span class="text-primary"><i class="las la-file-alt text-xl"></i></span>
                    <div>
                        <p class="font-medium text-[var(--color-white)]">${report.name || 'تقرير'}</p>
                        <p class="text-xs text-[var(--color-muted)]">${dateSourceLine || ''}</p>
                        ${creatorPic ? `<div class="creator-info">${avatarHtml}<span>${creatorName}</span></div>` : ''}
                    </div>
                </div>
                <div class="report-actions">
                    <button class="btn-outline btn-xs view-report-btn" data-id="${report.id}" title="عرض التقرير">
                        <i class="las la-eye"></i> عرض
                    </button>
                </div>
            </div>`;
        }

        function attachReportListEvents() {
            document.querySelectorAll('.folder-header[data-toggle="month"]').forEach(header => {
                header.addEventListener('click', function(e) {
                    if (e.target.closest('.folder-toggle-btn') || e.target.closest('.view-report-btn') || e.target.closest('.folder-dash-btn')) return;
                    const monthKey = this.getAttribute('data-key');
                    toggleMonthFolder(monthKey);
                });
            });
            document.querySelectorAll('.folder-header[data-toggle="day"]').forEach(header => {
                header.addEventListener('click', function(e) {
                    if (e.target.closest('.folder-toggle-btn') || e.target.closest('.view-report-btn') || e.target.closest('.folder-dash-btn')) return;
                    const dayStateKey = this.getAttribute('data-key');
                    toggleDayFolder(dayStateKey);
                });
            });
            document.querySelectorAll('.month-toggle-btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const monthKey = this.getAttribute('data-key');
                    toggleMonthFolder(monthKey);
                });
            });
            document.querySelectorAll('.day-toggle-btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const dayStateKey = this.getAttribute('data-key');
                    toggleDayFolder(dayStateKey);
                });
            });
            document.querySelectorAll('.view-report-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const reportId = this.getAttribute('data-id');
                    viewReportById(reportId);
                });
            });
            document.querySelectorAll('.folder-dash-btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const type = this.getAttribute('data-type');
                    const key = this.getAttribute('data-key');
                    openFolderDashboard(type, key);
                });
            });
        }

        function loadRecentReports() {
            const reports = getProcessedReports();
            const searchQuery = reportSearchInput.value.toLowerCase().trim();
            let filteredReports = reports;
            if (searchQuery) {
                filteredReports = filteredReports.filter(report => {
                    const nameMatch = (report.name || '').toLowerCase().includes(searchQuery);
                    const dateMatch = (report.date || '').toLowerCase().includes(searchQuery);
                    const sourceMatch = (report.sourceLabel || '').toLowerCase().includes(searchQuery);
                    const creatorMatch = (report.created_by && report.created_by.name ? report.created_by.name.toLowerCase().includes(searchQuery) : false);
                    return nameMatch || dateMatch || sourceMatch || creatorMatch;
                });
            }
            if (selectedDateFilter) {
                filteredReports = filteredReports.filter(report => getReportDateKey(report) === selectedDateFilter);
            }
            if (selectedDateFilter) {
                dateResultsContainer.style.display = 'block';
                paginationContainer.style.display = 'none';
                renderDateResultsTable(filteredReports);
                recentReportsList.innerHTML = '';
                return;
            } else {
                dateResultsContainer.style.display = 'none';
                dateResultsTbody.innerHTML = '';
                paginationContainer.style.display = 'flex';
            }
            if (filteredReports.length === 0) {
                if (reportSearchInput.value.trim() || excludeCashReports) {
                    recentReportsList.innerHTML = '<div class="empty-state"><i class="las la-search"></i><p>لا توجد نتائج مطابقة</p></div>';
                } else {
                    recentReportsList.innerHTML = '<div class="empty-state"><i class="las la-folder-open"></i><p>لا توجد تقارير محفوظة بعد</p></div>';
                }
                paginationContainer.style.display = 'none';
                return;
            }
            const groupedByMonth = {};
            filteredReports.forEach(report => {
                const dateKey = getReportDateKey(report);
                if (!dateKey || !isValidDateKey(dateKey)) return;
                let year = null,
                    month = null,
                    day = null;
                const parts = dateKey.split('-');
                year = parts[0];
                month = parts[1];
                day = parts[2];
                const monthKey = `${year}-${month}`;
                if (!groupedByMonth[monthKey]) {
                    groupedByMonth[monthKey] = { days: {}, monthNum: parseInt(month, 10), year: year };
                }
                if (!groupedByMonth[monthKey].days[day]) groupedByMonth[monthKey].days[day] = [];
                groupedByMonth[monthKey].days[day].push(report);
            });
            monthKeys = Object.keys(groupedByMonth).sort((a, b) => b.localeCompare(a));
            totalPages = Math.ceil(monthKeys.length / pageSize);
            if (currentPage > totalPages - 1) currentPage = totalPages - 1;
            if (currentPage < 0) currentPage = 0;
            const startIdx = currentPage * pageSize;
            const endIdx = Math.min(startIdx + pageSize, monthKeys.length);
            const currentMonthKeys = monthKeys.slice(startIdx, endIdx);
            let html = '';
            currentMonthKeys.forEach(monthKey => {
                const monthData = groupedByMonth[monthKey];
                const monthNum = monthData.monthNum;
                const monthName = getArabicMonthName(monthNum);
                const monthTitle = `${monthKey} - ${monthName}`;
                const monthExpanded = expandedMonthFolders[monthKey] || false;
                html += `<div class="folder-item month-folder" data-month="${monthKey}">`;
                html += `<div class="folder-header" data-toggle="month" data-key="${monthKey}">`;
                html += `<div class="folder-title"><i class="las la-folder"></i><span>${monthTitle}</span></div>`;
                html += `<div class="flex gap-2 items-center">`;
                html += `<button class="folder-dash-btn" data-type="month" data-key="${monthKey}" title="لوحة معلومات الشهر"><i class="las la-chart-bar"></i></button>`;
                html += `<button class="btn-outline btn-xs folder-toggle-btn month-toggle-btn" data-toggle="month" data-key="${monthKey}">${monthExpanded ? 'إغلاق' : 'فتح'}</button>`;
                html += `</div>`;
                html += `</div>`;
                html += `<div class="folder-content${monthExpanded ? '' : ' hidden'}" data-month-content="${monthKey}">`;
                const dayKeys = Object.keys(monthData.days).sort((a, b) => a.localeCompare(b));
                dayKeys.forEach(dayKey => {
                    const dayStateKey = monthKey + '_' + dayKey;
                    const dayExpanded = expandedDayFolders[dayStateKey] || false;
                    const reportsForDay = monthData.days[dayKey];
                    reportsForDay.sort((a, b) => (b.timestamp || '').localeCompare(a.timestamp || ''));
                    let dayTitle = dayKey;
                    const dayName = getArabicDayName(`${monthKey}-${dayKey}`);
                    if (dayName) dayTitle += ` - ${dayName}`;
                    html += `<div class="folder-item day-folder" data-day="${dayKey}" data-month="${monthKey}">`;
                    html += `<div class="folder-header" data-toggle="day" data-key="${dayStateKey}">`;
                    html += `<div class="folder-title"><i class="las la-folder-open"></i><span>${dayTitle}</span></div>`;
                    html += `<div class="flex gap-2 items-center">`;
                    html += `<button class="folder-dash-btn" data-type="day" data-key="${dayStateKey}" title="لوحة معلومات اليوم"><i class="las la-chart-bar"></i></button>`;
                    html += `<button class="btn-outline btn-xs folder-toggle-btn day-toggle-btn" data-toggle="day" data-key="${dayStateKey}">${dayExpanded ? 'إغلاق' : 'فتح'}</button>`;
                    html += `</div>`;
                    html += `</div>`;
