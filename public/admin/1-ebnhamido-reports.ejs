            if (otherIncomeSum > 0) { incomePieLabels.push('أخرى'); incomePieData.push(otherIncomeSum); }
            const incomePieColors = [greenUp, goldAccent, blueAccent, redDown, purpleAccent, primaryColor, '#ec4899', '#06b6d4', '#f97316'];
            dashIncomePieChartInstance = new Chart(incomePieCtx, {
                type: 'doughnut',
                data: { labels: incomePieLabels, datasets: [{ data: incomePieData, backgroundColor: incomePieColors.slice(0, incomePieData.length), borderWidth: 3, borderColor: cardBg, hoverOffset: 8 }] },
                options: { responsive: true, maintainAspectRatio: false, cutout: '58%', plugins: { legend: { position: 'bottom', labels: { color: whiteColor, font: { family: 'Alexandria', size: 10, weight: '600' }, padding: 10, usePointStyle: true, pointStyleWidth: 8 } }, tooltip: { backgroundColor: 'rgba(0,0,0,0.85)', titleFont: { family: 'Alexandria', size: 12, weight: '700' }, bodyFont: { family: 'Alexandria', size: 11 }, padding: 12, cornerRadius: 8, titleColor: '#ffffff', bodyColor: '#bababa', callbacks: { label: function(context) { const total = context.dataset.data.reduce((a, b) => a + b, 0); const pct = total > 0 ? ((context.parsed / total) * 100).toFixed(1) : 0; return context.label + ': ' + context.parsed.toFixed(2) + ' ج.م (' + pct + '%)'; } } } } }
            });
        }

        function renderDashCategoryTable() {
            const tbody = document.getElementById('dashCategoryTbody');
            tbody.innerHTML = '';
            if (dashCategories.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-center text-[var(--color-muted)]">لا توجد بيانات</td></tr>';
                dashPaginationContainer.style.display = 'none';
                return;
            }
            dashPaginationContainer.style.display = 'flex';
            const startIdx = currentDashPage * dashPageSizeValue;
            const endIdx = Math.min(startIdx + dashPageSizeValue, dashCategories.length);
            const pageCategories = dashCategories.slice(startIdx, endIdx);
            const totalExpenses = dashCategories.reduce((sum, [, val]) => sum + val, 0);
            pageCategories.forEach(([cat, amount], index) => {
                const globalIndex = startIdx + index;
                const pct = totalExpenses > 0 ? ((amount / totalExpenses) * 100).toFixed(1) : 0;
                const prevAmount = globalIndex < dashCategories.length - 1 ? dashCategories[globalIndex + 1][1] : 0;
                let trendClass = 'boursa-badge blue';
                let trendIcon = '<i class="las la-minus"></i>';
                let trendText = 'ثابت';
                if (globalIndex === 0) { trendClass = 'boursa-badge red'; trendIcon = '<i class="las la-arrow-up"></i>'; trendText = 'الأعلى'; }
                else if (amount < prevAmount) { trendClass = 'boursa-badge green'; trendIcon = '<i class="las la-arrow-down"></i>'; trendText = 'انخفاض'; }
                const tr = document.createElement('tr');
                tr.innerHTML = `<td>${cat}</td><td>${amount.toFixed(2)}</td><td>${pct}%</td><td><span class="${trendClass}">${trendIcon} ${trendText}</span></td>`;
                tbody.appendChild(tr);
            });
            dashPageIndicator.textContent = `${currentDashPage + 1} / ${totalDashPages}`;
            dashPrevPageBtn.disabled = currentDashPage <= 0;
            dashNextPageBtn.disabled = currentDashPage >= totalDashPages - 1;
        }

