            });

            const pieCtx = document.getElementById('dashExpensePieChart').getContext('2d');
            if (dashExpensePieChartInstance) dashExpensePieChartInstance.destroy();
            const topForPie = dashCategories.slice(0, 8);
            const otherSum = dashCategories.slice(8).reduce((sum, [, val]) => sum + val, 0);
            const pieLabels = topForPie.map(([label]) => label);
