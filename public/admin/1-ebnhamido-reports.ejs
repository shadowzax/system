<!DOCTYPE html>
<html lang="ar" dir="rtl" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <meta name="theme-color" content="#0d99ff">
    <title>آخر تقارير الخوارج</title>
    <meta name="description" content="عرض جميع تقارير الخوارج">
    <link rel="icon" type="image/png" href="https://files.catbox.moe/kdxauw.png">
    <link rel="apple-touch-icon" href="https://files.catbox.moe/kdxauw.png">
    <link rel="manifest" href="/manifest.json">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/line-awesome/1.3.0/line-awesome/css/line-awesome.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com">
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11">
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js">
    </script>
    <link rel="stylesheet" href="/css/admin-reports.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#0d99ff',
                        secondary: '#7c3aed',
                        accent: '#06b6d4',
                        error: '#ef4444',
                        success: '#10b981',
                        warning: '#f59e0b',
                    }
                }
            }
        }
    </script>
    <style>
        :root {
            --color-primary: #0d99ff;
            --color-secondary: #7c3aed;
            --color-accent: #06b6d4;
            --color-background: #00080f;
            --color-card: #00060c;
            --color-darker: #000308;
            --color-paragraph: #bababa;
            --color-white: #ffffff;
            --color-muted: #9ca3af;
            --border-subtle: rgba(186, 186, 186, 0.24);
            --card-bg: #00060c;
            --border-color: rgba(186, 186, 186, 0.24);
            --darker-bg: #000308;
            --green-up: #10b981;
            --red-down: #ef4444;
            --blue-accent: #3b82f6;
            --orange-accent: #f97316;
            --purple-accent: #8b5cf6;
            --gold-accent: #f59e0b;
        }

        .light {
            --color-background: #f1f5f9;
            --color-card: #ffffff;
            --color-darker: #e2e8f0;
            --color-paragraph: #334155;
            --color-white: #0f172a;
            --color-muted: #64748b;
            --border-subtle: rgba(0, 0, 0, 0.08);
            --card-bg: #ffffff;
            --border-color: rgba(0, 0, 0, 0.1);
            --darker-bg: #e2e8f0;
            --green-up: #059669;
            --red-down: #dc2626;
            --blue-accent: #2563eb;
            --orange-accent: #ea580c;
            --purple-accent: #7c3aed;
            --gold-accent: #d97706;
        }

        .dashboard-card {
            display: none;
        }

        .boursa-summary-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 0.75rem;
            margin-bottom: 1rem;
        }

        .boursa-ticker-item {
            background: var(--color-card);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 0.9rem 1rem;
            text-align: center;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .boursa-ticker-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            border-radius: 10px 10px 0 0;
        }

        .boursa-ticker-item.ticker-red::before {
            background: var(--red-down);
        }
        .boursa-ticker-item.ticker-green::before {
            background: var(--green-up);
        }
        .boursa-ticker-item.ticker-blue::before {
            background: var(--blue-accent);
        }
        .boursa-ticker-item.ticker-gold::before {
            background: var(--gold-accent);
        }
        .boursa-ticker-item.ticker-purple::before {
            background: var(--purple-accent);
        }

        .boursa-ticker-item:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(13, 153, 255, 0.12);
        }

        .boursa-ticker-label {
            font-size: 0.7rem;
            font-weight: 700;
            color: var(--color-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.4rem;
        }

        .boursa-ticker-value {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--color-white);
            letter-spacing: 0.3px;
            line-height: 1.2;
        }

        .boursa-ticker-sub {
            font-size: 0.7rem;
            font-weight: 500;
            color: var(--color-muted);
            margin-top: 0.3rem;
        }

        .boursa-chart-container {
            background: var(--color-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1.25rem;
            margin-bottom: 1rem;
            position: relative;
            height: 340px;
        }

        .boursa-chart-container.half {
            height: 280px;
        }

        .boursa-chart-title {
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--color-white);
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .boursa-chart-title i {
            color: var(--color-primary);
        }

        .boursa-table-wrapper {
            background: var(--color-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1.25rem;
            overflow-x: auto;
            margin-bottom: 1rem;
        }

        .boursa-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.82rem;
        }

        .boursa-table th,
        .boursa-table td {
            padding: 0.65rem 0.85rem;
            text-align: right;
            border-bottom: 1px solid var(--border-subtle);
        }

        .boursa-table th {
            color: var(--color-muted);
            font-weight: 700;
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            background: rgba(13, 153, 255, 0.04);
        }

        .boursa-table td {
            color: var(--color-white);
            font-weight: 500;
        }

        .boursa-table tbody tr:hover td {
            background: rgba(13, 153, 255, 0.05);
        }

        .boursa-table tr:last-child td {
            border-bottom: none;
        }

        .trend-up {
            color: var(--green-up) !important;
            font-weight: 700;
        }

        .trend-down {
            color: var(--red-down) !important;
            font-weight: 700;
        }

        .date-range-filter {
            display: flex;
            gap: 0.75rem;
            align-items: center;
            flex-wrap: wrap;
            margin-bottom: 1rem;
            background: var(--color-card);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 0.75rem 1rem;
        }

        .date-range-filter label {
            color: var(--color-muted);
            font-size: 0.8rem;
            font-weight: 600;
        }

        .date-range-filter input[type="date"] {
            background: var(--color-darker);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 0.45rem 0.7rem;
            color: var(--color-white);
            font-family: 'Alexandria', sans-serif;
            font-size: 0.85rem;
            outline: none;
        }

        .date-range-filter input[type="date"]:focus {
            border-color: var(--color-primary);
        }

        .boursa-grid-2col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        @media (max-width: 768px) {
            .boursa-grid-2col {
                grid-template-columns: 1fr;
            }
            .boursa-chart-container {
                height: 280px;
            }
        }

        .summary-grid {
            display: none;
        }
        .chart-container {
            display: none;
        }
        .dashboard-table-wrapper {
            display: none;
        }
        .dashboard-table {
            display: none;
        }

        .folder-dash-btn {
            background: rgba(13, 153, 255, 0.1);
            border: 1px solid var(--color-primary);
            color: var(--color-primary);
            padding: 0.25rem 0.6rem;
            border-radius: 6px;
            font-size: 0.75rem;
            cursor: pointer;
            transition: all 0.2s;
        }
        .folder-dash-btn:hover {
            background: rgba(13, 153, 255, 0.2);
        }

        .boursa-badge {
            display: inline-block;
            padding: 0.25rem 0.65rem;
            border-radius: 15px;
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.3px;
        }

        .boursa-badge.green {
            background: rgba(16, 185, 129, 0.12);
            color: var(--green-up);
        }
        .boursa-badge.red {
            background: rgba(239, 68, 68, 0.12);
            color: var(--red-down);
        }
        .boursa-badge.blue {
            background: rgba(59, 130, 246, 0.12);
            color: var(--blue-accent);
        }
        .boursa-badge.gold {
            background: rgba(245, 158, 11, 0.12);
            color: var(--gold-accent);
        }
    </style>
</head>
