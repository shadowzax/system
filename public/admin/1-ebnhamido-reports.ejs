                html += '<tr><td style="padding:3px 5px; border:0.5px solid #000; text-align:center;">' + cat + '</td><td style="padding:3px 5px; border:0.5px solid #000; text-align:center;">' + amount.toFixed(2) + '</td><td style="padding:3px 5px; border:0.5px solid #000; text-align:center;">' + pct + '%</td></tr>';
