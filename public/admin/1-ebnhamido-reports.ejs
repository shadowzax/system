<!DOCTYPE html>
<html lang="ar" dir="rtl" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <meta name="theme-color" content="#0d99ff">
    <title>آخر تقارير الخوارج</title>
    <meta name="description" content="عرض جميع تقارير الخوارج">
    <link rel="icon" type="image/png" href="https://files.catbox.moe/kdxauw.png">
    <link rel="apple-touch-icon" href="https://files.catbox.moe/kdxauw.png">
    <link rel="manifest" href="/manifest.json">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/line-awesome/1.3.0/line-awesome/css/line-awesome.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com">
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11">
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js">
    </script>
    <link rel="stylesheet" href="/css/admin-reports.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#0d99ff',
                        secondary: '#7c3aed',
                        accent: '#06b6d4',
                        error: '#ef4444',
                        success: '#10b981',
                        warning: '#f59e0b',
                    }
                }
            }
        }
    </script>
    <style>
        :root {
            --color-primary: #0d99ff;
            --color-secondary: #7c3aed;
            --color-accent: #06b6d4;
            --color-background: #00080f;
            --color-card: #00060c;
            --color-darker: #000308;
            --color-paragraph: #bababa;
            --color-white: #ffffff;
            --color-muted: #9ca3af;
            --border-subtle: rgba(186, 186, 186, 0.24);
            --card-bg: #00060c;
            --border-color: rgba(186, 186, 186, 0.24);
            --darker-bg: #000308;
            --green-up: #10b981;
            --red-down: #ef4444;
            --blue-accent: #3b82f6;
            --orange-accent: #f97316;
            --purple-accent: #8b5cf6;
            --gold-accent: #f59e0b;
        }

        .light {
            --color-background: #f1f5f9;
            --color-card: #ffffff;
            --color-darker: #e2e8f0;
            --color-paragraph: #334155;
            --color-white: #0f172a;
            --color-muted: #64748b;
            --border-subtle: rgba(0, 0, 0, 0.08);
            --card-bg: #ffffff;
            --border-color: rgba(0, 0, 0, 0.1);
            --darker-bg: #e2e8f0;
            --green-up: #059669;
            --red-down: #dc2626;
            --blue-accent: #2563eb;
            --orange-accent: #ea580c;
            --purple-accent: #7c3aed;
            --gold-accent: #d97706;
        }

        .dashboard-card {
            display: none;
        }

        .boursa-summary-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 0.75rem;
            margin-bottom: 1rem;
        }

        .boursa-ticker-item {
            background: var(--color-card);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 0.9rem 1rem;
            text-align: center;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .boursa-ticker-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            border-radius: 10px 10px 0 0;
        }

        .boursa-ticker-item.ticker-red::before {
            background: var(--red-down);
        }
        .boursa-ticker-item.ticker-green::before {
            background: var(--green-up);
        }
        .boursa-ticker-item.ticker-blue::before {
            background: var(--blue-accent);
        }
        .boursa-ticker-item.ticker-gold::before {
            background: var(--gold-accent);
        }
        .boursa-ticker-item.ticker-purple::before {
            background: var(--purple-accent);
        }

        .boursa-ticker-item:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(13, 153, 255, 0.12);
        }

        .boursa-ticker-label {
            font-size: 0.7rem;
            font-weight: 700;
            color: var(--color-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.4rem;
        }

        .boursa-ticker-value {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--color-white);
            letter-spacing: 0.3px;
            line-height: 1.2;
        }

        .boursa-ticker-sub {
            font-size: 0.7rem;
            font-weight: 500;
            color: var(--color-muted);
            margin-top: 0.3rem;
        }

        .boursa-chart-container {
            background: var(--color-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1.25rem;
            margin-bottom: 1rem;
            position: relative;
            height: 340px;
        }

        .boursa-chart-container.half {
            height: 280px;
        }

        .boursa-chart-title {
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--color-white);
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .boursa-chart-title i {
            color: var(--color-primary);
        }

        .boursa-table-wrapper {
            background: var(--color-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1.25rem;
            overflow-x: auto;
            margin-bottom: 1rem;
        }

        .boursa-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.82rem;
        }

        .boursa-table th,
        .boursa-table td {
            padding: 0.65rem 0.85rem;
            text-align: right;
            border-bottom: 1px solid var(--border-subtle);
        }

        .boursa-table th {
            color: var(--color-muted);
            font-weight: 700;
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            background: rgba(13, 153, 255, 0.04);
        }

        .boursa-table td {
            color: var(--color-white);
            font-weight: 500;
        }

        .boursa-table tbody tr:hover td {
            background: rgba(13, 153, 255, 0.05);
        }

        .boursa-table tr:last-child td {
            border-bottom: none;
        }

        .trend-up {
            color: var(--green-up) !important;
            font-weight: 700;
        }

        .trend-down {
            color: var(--red-down) !important;
            font-weight: 700;
        }

        .date-range-filter {
            display: flex;
            gap: 0.75rem;
            align-items: center;
            flex-wrap: wrap;
            margin-bottom: 1rem;
            background: var(--color-card);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 0.75rem 1rem;
        }

        .date-range-filter label {
            color: var(--color-muted);
            font-size: 0.8rem;
            font-weight: 600;
        }

        .date-range-filter input[type="date"] {
            background: var(--color-darker);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 0.45rem 0.7rem;
            color: var(--color-white);
            font-family: 'Alexandria', sans-serif;
            font-size: 0.85rem;
            outline: none;
        }

        .date-range-filter input[type="date"]:focus {
            border-color: var(--color-primary);
        }

        .boursa-grid-2col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        @media (max-width: 768px) {
            .boursa-grid-2col {
                grid-template-columns: 1fr;
            }
            .boursa-chart-container {
                height: 280px;
            }
            .boursa-chart-container.half {
                height: 240px;
            }
            .boursa-summary-grid {
                grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
                gap: 0.5rem;
            }
            .boursa-ticker-value {
                font-size: 1.2rem;
            }
            .boursa-ticker-label {
                font-size: 0.65rem;
            }
            .date-range-filter {
                padding: 0.5rem;
                gap: 0.5rem;
            }
            .date-range-filter input[type="date"] {
                padding: 0.35rem 0.5rem;
                font-size: 0.75rem;
            }
            .boursa-table th,
            .boursa-table td {
                padding: 0.5rem 0.6rem;
                font-size: 0.75rem;
            }
            .boursa-chart-title {
                font-size: 0.75rem;
            }
            .info-card {
                padding: 0.75rem;
            }
            .flex-col.md\:flex-row {
                flex-direction: column;
            }
            .w-full.md\:w-auto {
                width: 100%;
            }
            .sm\:flex-row {
                flex-direction: column;
                align-items: stretch;
            }
            .sm\:w-64 {
                width: 100%;
            }
            .flex.gap-3 {
                gap: 0.5rem;
            }
            .btn-sm {
                padding: 0.35rem 0.75rem;
                font-size: 0.8rem;
            }
            .input-field {
                font-size: 0.85rem;
                padding: 0.5rem 0.75rem;
            }
            .report-list-item {
                flex-direction: column;
                align-items: flex-start;
                gap: 0.5rem;
            }
            .report-actions {
                width: 100%;
                justify-content: flex-start;
            }
            .folder-header {
                padding: 0.5rem;
            }
            .folder-title {
                font-size: 0.85rem;
            }
            .folder-dash-btn {
                padding: 0.15rem 0.4rem;
                font-size: 0.7rem;
            }
            .pagination-controls {
                flex-direction: column;
                gap: 0.5rem;
            }
            .pagination-controls .flex.items-center {
                justify-content: center;
            }
        }

        .summary-grid {
            display: none;
        }
        .chart-container {
            display: none;
        }
        .dashboard-table-wrapper {
            display: none;
        }
        .dashboard-table {
            display: none;
        }

        .folder-dash-btn {
            background: rgba(13, 153, 255, 0.1);
            border: 1px solid var(--color-primary);
            color: var(--color-primary);
            padding: 0.25rem 0.6rem;
            border-radius: 6px;
            font-size: 0.75rem;
            cursor: pointer;
            transition: all 0.2s;
        }
        .folder-dash-btn:hover {
            background: rgba(13, 153, 255, 0.2);
        }

        .boursa-badge {
            display: inline-block;
            padding: 0.25rem 0.65rem;
            border-radius: 15px;
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.3px;
        }

        .boursa-badge.green {
            background: rgba(16, 185, 129, 0.12);
            color: var(--green-up);
        }
        .boursa-badge.red {
            background: rgba(239, 68, 68, 0.12);
            color: var(--red-down);
        }
        .boursa-badge.blue {
            background: rgba(59, 130, 246, 0.12);
            color: var(--blue-accent);
        }
        .boursa-badge.gold {
            background: rgba(245, 158, 11, 0.12);
            color: var(--gold-accent);
        }

        .pagination-controls {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            margin-top: 1rem;
            padding: 0.5rem 0;
        }

        .pagination-controls select,
        .pagination-controls button {
            font-family: 'Alexandria', sans-serif;
            background: var(--color-card);
            border: 1px solid var(--border-color);
            color: var(--color-white);
            border-radius: 6px;
            padding: 0.25rem 0.6rem;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.2s;
        }

        .pagination-controls select:focus,
        .pagination-controls button:focus {
            outline: none;
            border-color: var(--color-primary);
        }

        .pagination-controls button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .pagination-controls button:not(:disabled):hover {
            background: rgba(13, 153, 255, 0.1);
        }
    </style>
</head>
<body>
    <%- include('../sections/admin-header-ebnhamido.ejs') %>
    <div class="info-card mt-6" id="reportViewCard" style="display:none;">
        <div class="flex flex-col md:flex-row items-center justify-between mb-4 gap-4">
            <div class="w-full md:w-auto md:flex-1"></div>
            <div class="w-full md:w-auto md:flex-1 text-center">
                <i class="las la-file-alt text-4xl text-primary mb-2 block"></i>
                <h3 class="text-xl font-bold text-[var(--color-white)]" id="viewReportTitle2">تقرير</h3>
                <p class="text-sm text-[var(--color-muted)]" id="viewReportDate2"></p>
                <div class="view-creator-info" id="viewReportCreator"></div>
            </div>
            <div class="w-full md:w-auto md:flex-1 flex justify-center md:justify-end">
                <div class="flex gap-3 flex-wrap justify-center">
                    <button class="btn-outline btn-sm" id="printDetailReportBtn"><i class="las la-print"></i> طباعة هذا التقرير</button>
                    <button class="btn-outline btn-sm" id="closeDetailReportBtn"><i class="las la-times"></i> إغلاق</button>
                </div>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="view-table" id="viewReportTable2">
                <thead>
                    <tr>
                        <th style="width:55%;">البيان</th>
                        <th style="width:45%;">المبلغ (ج.م)</th>
                    </tr>
                </thead>
                <tbody id="viewReportTbody2"></tbody>
                <tfoot>
                    <tr class="total-row">
                        <td>الإجمالي</td>
                        <td id="viewReportTotal2">0</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
    <div class="mt-6 info-card" id="recentReportsCard">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
                <h3 class="text-lg font-bold text-[var(--color-white)] flex items-center gap-2"><i class="las la-history text-primary"></i> جميع التقارير</h3>
                <p class="text-sm text-[var(--color-muted)]">عرض جميع التقارير المخزنة</p>
            </div>
            <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
                <button id="refreshReportsBtn" type="button" class="btn-outline btn-sm"><i class="las la-sync-alt"></i> تحديث التقارير</button>
                <button id="deleteCashBtn" type="button" class="btn-outline btn-sm"><i class="las la-trash-alt"></i> حذف الكاش</button>
                <button id="showDashboardBtn" type="button" class="btn-primary btn-sm"><i class="las la-chart-pie"></i> لوحة المعلومات</button>
                <input type="date" id="reportDatePicker" class="input-field" />
                <div class="relative flex-1 sm:w-64">
                    <i class="las la-search absolute left-4 top-1/2 transform -translate-y-1/2 text-[var(--color-muted)] text-lg"></i>
                    <input type="text" id="reportSearchInput" class="input-field pr-10" placeholder="ابحث بالاسم أو التاريخ...">
                </div>
            </div>
        </div>
        <div id="dateResultsContainer" style="display:none;" class="mt-4 overflow-x-auto">
            <table class="date-results-table" id="dateResultsTable">
                <thead>
                    <tr>
                        <th style="width:40%;">اسم التقرير</th>
                        <th style="width:25%;">التاريخ</th>
                        <th style="width:20%;">الإجمالي (ج.م)</th>
                        <th style="width:15%;">عرض</th>
                    </tr>
                </thead>
                <tbody id="dateResultsTbody"></tbody>
            </table>
        </div>
        <div class="mt-4" id="recentReportsList"></div>
        <div class="flex flex-wrap items-center justify-between gap-3 mt-4" id="paginationContainer" style="display:none;">
            <div class="flex items-center gap-2">
                <span class="text-xs text-[var(--color-muted)]">عرض</span>
                <select id="reportsPageSize" class="input-field text-xs py-1 px-2" style="width:auto; padding:4px 8px;">
                    <option value="5">5</option>
                    <option value="10" selected>10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                </select>
                <span class="text-xs text-[var(--color-muted)]">تقارير</span>
            </div>
            <div class="flex items-center gap-2">
                <button class="btn-outline btn-xs" id="prevReportsPageBtn" disabled=""><i class="las la-angle-right"></i></button>
                <span class="text-xs text-[var(--color-muted)]" id="reportsPageIndicator">0 / 0</span>
                <button class="btn-outline btn-xs" id="nextReportsPageBtn" disabled=""><i class="las la-angle-left"></i></button>
            </div>
        </div>
    </div>
    <div class="mt-6 info-card dashboard-card" id="dashboardCard">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-4">
            <div>
                <h3 class="text-lg font-bold text-[var(--color-white)] flex items-center gap-2"><i class="las la-chart-line text-primary"></i> لوحة تحليلات المصروفات والدخل</h3>
                <p class="text-sm text-[var(--color-muted)]" id="dashboardPeriodLabel">جميع الفترات</p>
            </div>
            <div class="flex gap-2">
                <button id="printDashboardBtn" class="btn-outline btn-sm"><i class="las la-print"></i> طباعة اللوحة</button>
                <button id="closeDashboardBtn" class="btn-outline btn-sm"><i class="las la-times"></i> إغلاق اللوحة</button>
            </div>
        </div>
        <div class="date-range-filter">
            <label for="dashDateFrom">من تاريخ:</label>
            <input type="date" id="dashDateFrom" />
            <label for="dashDateTo">إلى تاريخ:</label>
            <input type="date" id="dashDateTo" />
            <button id="applyDateRangeBtn" class="btn-primary btn-sm"><i class="las la-filter"></i> تطبيق</button>
            <button id="resetDateRangeBtn" class="btn-outline btn-sm"><i class="las la-undo-alt"></i> إعادة تعيين</button>
        </div>

        <div class="boursa-summary-grid" id="expenseSummaryGrid">
            <div class="boursa-ticker-item ticker-red">
                <div class="boursa-ticker-label">إجمالي المصروفات</div>
                <div class="boursa-ticker-value" id="dashTotalExpenses">0</div>
                <div class="boursa-ticker-sub">جنيه مصري</div>
            </div>
            <div class="boursa-ticker-item ticker-blue">
                <div class="boursa-ticker-label">عدد التقارير</div>
                <div class="boursa-ticker-value" id="dashReportCount">0</div>
                <div class="boursa-ticker-sub">تقرير</div>
            </div>
            <div class="boursa-ticker-item ticker-green">
                <div class="boursa-ticker-label">متوسط اليومي</div>
                <div class="boursa-ticker-value" id="dashAvgDaily">0</div>
                <div class="boursa-ticker-sub">جنيه / يوم</div>
            </div>
            <div class="boursa-ticker-item ticker-gold">
                <div class="boursa-ticker-label">أعلى يوم مصروف</div>
                <div class="boursa-ticker-value" id="dashMaxDaily">0</div>
                <div class="boursa-ticker-sub" id="dashMaxDailyDate">-</div>
            </div>
            <div class="boursa-ticker-item ticker-purple">
                <div class="boursa-ticker-label">عدد بنود المصروفات</div>
                <div class="boursa-ticker-value" id="dashItemCount">0</div>
                <div class="boursa-ticker-sub">بند</div>
            </div>
        </div>

        <div class="boursa-summary-grid" id="incomeSummaryGrid" style="margin-top:1rem;">
            <div class="boursa-ticker-item ticker-green">
                <div class="boursa-ticker-label">إجمالي الدخل</div>
                <div class="boursa-ticker-value" id="dashTotalIncome">0</div>
                <div class="boursa-ticker-sub">جنيه مصري</div>
            </div>
            <div class="boursa-ticker-item ticker-blue">
                <div class="boursa-ticker-label">متوسط الدخل اليومي</div>
                <div class="boursa-ticker-value" id="dashAvgDailyIncome">0</div>
                <div class="boursa-ticker-sub">جنيه / يوم</div>
            </div>
            <div class="boursa-ticker-item ticker-gold">
                <div class="boursa-ticker-label">أعلى يوم دخل</div>
                <div class="boursa-ticker-value" id="dashMaxDailyIncome">0</div>
                <div class="boursa-ticker-sub" id="dashMaxDailyIncomeDate">-</div>
            </div>
            <div class="boursa-ticker-item ticker-purple">
                <div class="boursa-ticker-label">عدد بنود الدخل</div>
                <div class="boursa-ticker-value" id="dashIncomeItemCount">0</div>
                <div class="boursa-ticker-sub">بند</div>
            </div>
        </div>

        <div class="boursa-grid-2col">
            <div class="boursa-chart-container">
                <div class="boursa-chart-title"><i class="las la-chart-area"></i> منحنى المصروفات اليومية</div>
                <canvas id="dashExpenseAreaChart"></canvas>
            </div>
            <div class="boursa-chart-container">
                <div class="boursa-chart-title"><i class="las la-chart-area"></i> منحنى الدخل اليومي</div>
                <canvas id="dashIncomeAreaChart"></canvas>
            </div>
        </div>
        <div class="boursa-grid-2col">
            <div class="boursa-chart-container">
                <div class="boursa-chart-title"><i class="las la-chart-bar"></i> أعلى 10 بنود مصروفات</div>
                <canvas id="dashExpenseBarChart"></canvas>
            </div>
            <div class="boursa-chart-container">
                <div class="boursa-chart-title"><i class="las la-chart-bar"></i> أعلى 10 بنود دخل</div>
                <canvas id="dashIncomeBarChart"></canvas>
            </div>
        </div>
        <div class="boursa-grid-2col">
            <div class="boursa-chart-container half">
