        function openFolderDashboard(type, key) {
            if (type === 'month') {
                const [year, month] = key.split('-');
                const monthNum = parseInt(month, 10);
                const lastDay = new Date(year, monthNum, 0).getDate();
                dashboardDateFrom = `${year}-${month}-01`;
                dashboardDateTo = `${year}-${month}-${String(lastDay).padStart(2, '0')}`;
                dashDateFrom.value = dashboardDateFrom;
                dashDateTo.value = dashboardDateTo;
                const monthName = getArabicMonthName(monthNum);
                dashboardPeriodLabel.textContent = `شهر ${monthName} ${year}`;
            } else if (type === 'day') {
                const [year, month, day] = key.split('-');
                dashboardDateFrom = `${year}-${month}-${day}`;
                dashboardDateTo = `${year}-${month}-${day}`;
                dashDateFrom.value = dashboardDateFrom;
                dashDateTo.value = dashboardDateTo;
                const monthName = getArabicMonthName(parseInt(month, 10));
                const dayNum = parseInt(day, 10);
                const dayName = getArabicDayName(`${year}-${month}-${day}`);
                const weekdayName = dayName || '';
                dashboardPeriodLabel.textContent = `يوم ${dayNum} ${monthName} ${year} ${weekdayName ? '(' + weekdayName + ')' : ''}`;
            }
            showDashboard();
        }

        function buildDashboard() {
            const reports = window.expensesReports.filter(r => !r.combined && r.source !== 'transfers' && r.source !== 'fees');
            const incomeKeywords = ['كاش', 'فيزا', 'تحويلات', 'فيز'];
            const expenseCategories = {};
            const incomeCategories = {};
            const dailyExpenses = {};
            const dailyIncome = {};

            reports.forEach(report => {
                if (dashboardDateFrom || dashboardDateTo) {
                    const reportDate = getReportDateKey(report);
                    if (!reportDate || !isValidDateKey(reportDate)) return;
                    if (dashboardDateFrom && reportDate < dashboardDateFrom) return;
                    if (dashboardDateTo && reportDate > dashboardDateTo) return;
                }
                const dateKey = getReportDateKey(report);
                if (!dateKey || !isValidDateKey(dateKey)) return;
                if (report.rows && report.rows.length) {
                    report.rows.forEach(row => {
                        const desc = row.desc || '';
                        const amount = parseAmountValue(row.amount);
                        const normDesc = normalizeDesc(desc);
                        let isIncome = false;
                        for (const kw of incomeKeywords) {
                            if (normDesc.includes(kw.toLowerCase())) {
                                isIncome = true;
                                break;
                            }
                        }
                        if (isIncome) {
                            let catKey = normDesc || 'دخل غير مصنف';
                            incomeCategories[catKey] = (incomeCategories[catKey] || 0) + amount;
                            dailyIncome[dateKey] = (dailyIncome[dateKey] || 0) + amount;
                        } else {
                            let catKey = normDesc || 'غير مصنف';
                            if (catKey.includes('راتب') || catKey.includes('رواتب')) {
                                catKey = 'رواتب';
                            }
                            expenseCategories[catKey] = (expenseCategories[catKey] || 0) + amount;
                            dailyExpenses[dateKey] = (dailyExpenses[dateKey] || 0) + amount;
                        }
                    });
                }
            });

            const totalExpenses = Object.values(expenseCategories).reduce((sum, val) => sum + val, 0);
            const totalIncome = Object.values(incomeCategories).reduce((sum, val) => sum + val, 0);
            const itemCount = Object.keys(expenseCategories).length;
            const incomeItemCount = Object.keys(incomeCategories).length;
            const reportCount = reports.filter(r => {
                const rd = getReportDateKey(r);
                if (!rd || !isValidDateKey(rd)) return false;
                if (dashboardDateFrom && rd < dashboardDateFrom) return false;
                if (dashboardDateTo && rd > dashboardDateTo) return false;
                return true;
            }).length;
            const dailyKeys = Object.keys(dailyExpenses);
            const avgDaily = dailyKeys.length > 0 ? totalExpenses / dailyKeys.length : 0;
            let maxDaily = 0;
            let maxDailyDate = '-';
            dailyKeys.forEach(dk => {
                if (dailyExpenses[dk] > maxDaily) {
                    maxDaily = dailyExpenses[dk];
                    maxDailyDate = dk;
                }
            });
            const dailyIncomeKeys = Object.keys(dailyIncome);
            const avgDailyIncome = dailyIncomeKeys.length > 0 ? totalIncome / dailyIncomeKeys.length : 0;
            let maxDailyIncome = 0;
            let maxDailyIncomeDate = '-';
            dailyIncomeKeys.forEach(dk => {
                if (dailyIncome[dk] > maxDailyIncome) {
                    maxDailyIncome = dailyIncome[dk];
                    maxDailyIncomeDate = dk;
                }
            });

            document.getElementById('dashTotalExpenses').textContent = totalExpenses.toFixed(2);
            document.getElementById('dashReportCount').textContent = reportCount;
            document.getElementById('dashAvgDaily').textContent = avgDaily.toFixed(2);
            document.getElementById('dashMaxDaily').textContent = maxDaily.toFixed(2);
            document.getElementById('dashMaxDailyDate').textContent = maxDailyDate !== '-' ? maxDailyDate : '-';
            document.getElementById('dashItemCount').textContent = itemCount;
            document.getElementById('dashTotalIncome').textContent = totalIncome.toFixed(2);
            document.getElementById('dashAvgDailyIncome').textContent = avgDailyIncome.toFixed(2);
            document.getElementById('dashMaxDailyIncome').textContent = maxDailyIncome.toFixed(2);
            document.getElementById('dashMaxDailyIncomeDate').textContent = maxDailyIncomeDate !== '-' ? maxDailyIncomeDate : '-';
            document.getElementById('dashIncomeItemCount').textContent = incomeItemCount;

            dashCategories = Object.entries(expenseCategories).sort((a, b) => b[1] - a[1]);
            dashIncomeCategories = Object.entries(incomeCategories).sort((a, b) => b[1] - a[1]);

            totalDashPages = Math.ceil(dashCategories.length / dashPageSizeValue);
            if (currentDashPage > totalDashPages - 1) currentDashPage = totalDashPages - 1;
            if (currentDashPage < 0) currentDashPage = 0;
            renderDashCategoryTable();

            totalIncomePages = Math.ceil(dashIncomeCategories.length / dashIncomePageSizeValue);
            if (currentIncomePage > totalIncomePages - 1) currentIncomePage = totalIncomePages - 1;
            if (currentIncomePage < 0) currentIncomePage = 0;
            renderDashIncomeTable();

            const sortedDailyKeys = dailyKeys.sort((a, b) => a.localeCompare(b));
            const dailyLabels = sortedDailyKeys.map(dk => {
                const parts = dk.split('-');
                if (parts.length === 3) {
                    const dayNum = parseInt(parts[2], 10);
                    const monthNum = parseInt(parts[1], 10);
                    return `${dayNum}/${monthNum}`;
                }
                return dk;
            });
            const dailyData = sortedDailyKeys.map(dk => dailyExpenses[dk]);
            const sortedIncomeDailyKeys = dailyIncomeKeys.sort((a, b) => a.localeCompare(b));
            const dailyIncomeLabels = sortedIncomeDailyKeys.map(dk => {
                const parts = dk.split('-');
                if (parts.length === 3) {
                    const dayNum = parseInt(parts[2], 10);
