            const incomeAreaCtx = document.getElementById('dashIncomeAreaChart').getContext('2d');
            if (dashIncomeAreaChartInstance) dashIncomeAreaChartInstance.destroy();
            const incomeAreaGradient = incomeAreaCtx.createLinearGradient(0, 0, 0, 320);
            incomeAreaGradient.addColorStop(0, greenUp + '55');
            incomeAreaGradient.addColorStop(1, greenUp + '05');
            dashIncomeAreaChartInstance = new Chart(incomeAreaCtx, {
                type: 'line',
                data: {
                    labels: dailyIncomeLabels,
                    datasets: [{
                        label: 'الدخل اليومي',
                        data: dailyIncomeData,
                        borderColor: greenUp,
                        backgroundColor: incomeAreaGradient,
                        fill: true,
                        tension: 0.4,
                        borderWidth: 2.5,
                        pointRadius: 4,
                        pointHoverRadius: 7,
                        pointBackgroundColor: whiteColor,
                        pointBorderColor: greenUp,
                        pointBorderWidth: 2,
                        pointHoverBackgroundColor: greenUp,
                        pointHoverBorderColor: whiteColor
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    scales: {
                        x: { ticks: { color: textColor, font: { family: 'Alexandria', size: 11 }, maxRotation: 45 }, grid: { color: 'rgba(186,186,186,0.08)', drawBorder: false } },
                        y: { beginAtZero: true, ticks: { color: textColor, font: { family: 'Alexandria', size: 11 }, callback: function(value) { return value.toFixed(0); } }, grid: { color: 'rgba(186,186,186,0.08)', drawBorder: false } }
                    },
                    plugins: {
                        legend: { display: true, labels: { color: whiteColor, font: { family: 'Alexandria', size: 12, weight: '600' }, usePointStyle: true, pointStyleWidth: 12, padding: 15 } },
                        tooltip: { backgroundColor: 'rgba(0,0,0,0.85)', titleFont: { family: 'Alexandria', size: 13, weight: '700' }, bodyFont: { family: 'Alexandria', size: 12 }, padding: 12, cornerRadius: 8, titleColor: '#ffffff', bodyColor: '#bababa', callbacks: { label: function(context) { return 'الدخل: ' + context.parsed.y.toFixed(2) + ' ج.م'; } } }
                    }
                }
            });

            const barCtx = document.getElementById('dashExpenseBarChart').getContext('2d');
            if (dashExpenseBarChartInstance) dashExpenseBarChartInstance.destroy();
            const topForBar = dashCategories.slice(0, 10);
            const barLabels = topForBar.map(([label]) => label);
            const barData = topForBar.map(([, val]) => val);
