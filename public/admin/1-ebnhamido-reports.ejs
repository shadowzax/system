            if (otherSum > 0) { pieLabels.push('أخرى'); pieData.push(otherSum); }
            const pieColors = [redDown, goldAccent, blueAccent, greenUp, purpleAccent, primaryColor, '#ec4899', '#06b6d4', '#f97316'];
            dashExpensePieChartInstance = new Chart(pieCtx, {
                type: 'doughnut',
