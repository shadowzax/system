            html += '<table style="width:100%; border-collapse:collapse; font-size:11px; table-layout:fixed; border:1px solid #000; margin-bottom:3mm;">';
            html += '<thead><tr><th style="padding:3px 5px; border:0.5px solid #000; background:#e8e8e8; text-align:center; font-weight:700;">البيان</th><th style="padding:3px 5px; border:0.5px solid #000; background:#e8e8e8; text-align:center; font-weight:700;">المبلغ (ج.م)</th><th style="padding:3px 5px; border:0.5px solid #000; background:#e8e8e8; text-align:center; font-weight:700;">النسبة</th></tr></thead><tbody>';
