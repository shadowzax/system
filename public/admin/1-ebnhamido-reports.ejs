    <script>
        window.expensesReports = <%- typeof reports !== 'undefined' && reports !== null ? JSON.stringify(reports) : '[]' %>;
        (function() {
            var raw = window.expensesReports;
            if (!Array.isArray(raw)) {
                var arr = [];
                var sources = [
                    { key: 'advances', label: 'سلف' },
                    { key: 'expenses', label: 'خوارج' }
                ];
                if (raw && typeof raw === 'object') {
                    sources.forEach(function(src) {
                        var list = raw[src.key] || [];
                        if (Array.isArray(list)) {
                            list.forEach(function(report) {
                                arr.push(Object.assign({}, report, { source: src.key, sourceLabel: src.label }));
                            });
                        }
                    });
                }
                window.expensesReports = arr;
            }
        })();
    </script>
    <script>
        const restaurantName = "<%= restaurant.name %>";
        const reportViewCard = document.getElementById('reportViewCard');
        const viewReportTitle2 = document.getElementById('viewReportTitle2');
        const viewReportDate2 = document.getElementById('viewReportDate2');
        const viewReportTbody2 = document.getElementById('viewReportTbody2');
        const viewReportTotal2 = document.getElementById('viewReportTotal2');
        const viewReportCreator = document.getElementById('viewReportCreator');
        const recentReportsCard = document.getElementById('recentReportsCard');
        const recentReportsList = document.getElementById('recentReportsList');
        const reportSearchInput = document.getElementById('reportSearchInput');
        const dateResultsContainer = document.getElementById('dateResultsContainer');
        const dateResultsTbody = document.getElementById('dateResultsTbody');
        const reportDatePicker = document.getElementById('reportDatePicker');
        const deleteCashBtn = document.getElementById('deleteCashBtn');
        const refreshReportsBtn = document.getElementById('refreshReportsBtn');
        const showDashboardBtn = document.getElementById('showDashboardBtn');
        const closeDashboardBtn = document.getElementById('closeDashboardBtn');
        const dashboardCard = document.getElementById('dashboardCard');
        const dashDateFrom = document.getElementById('dashDateFrom');
        const dashDateTo = document.getElementById('dashDateTo');
        const applyDateRangeBtn = document.getElementById('applyDateRangeBtn');
        const resetDateRangeBtn = document.getElementById('resetDateRangeBtn');
        const dashboardPeriodLabel = document.getElementById('dashboardPeriodLabel');

        let currentViewReportId = null;
        let selectedDateFilter = null;
        let expandedMonthFolders = {};
        let expandedDayFolders = {};
        let excludeCashReports = false;
        let dashExpenseAreaChartInstance = null;
        let dashExpenseBarChartInstance = null;
        let dashExpensePieChartInstance = null;
        let dashboardDateFrom = null;
        let dashboardDateTo = null;

        const arabicMonths = [
            'يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو',
            'يوليو', 'أغسطس', 'سبتمبر', 'أكتوبر', 'نوفمبر', 'ديسمبر'
        ];
        const arabicDays = ['الأحد', 'الاثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'];

        function normalizeArabicDigits(str) {
            if (!str) return str;
            const arabic = '٠١٢٣٤٥٦٧٨٩';
            const persian = '۰۱۲۳۴۵۶۷۸۹';
            return String(str)
                .replace(/[\u0660-\u0669]/g, d => String(arabic.indexOf(d)))
                .replace(/[\u06F0-\u06F9]/g, d => String(persian.indexOf(d)))
                .replace(/[\u200e\u200f]/g, '')
                .trim();
        }

        function parseAmountValue(value) {
            if (value === null || value === undefined) return 0;
            let str = normalizeArabicDigits(String(value));
            str = str.replace(/[^0-9.\-]/g, '');
            const num = parseFloat(str);
            return isNaN(num) ? 0 : num;
        }

        function normalizeDesc(desc) {
            if (!desc) return '';
            let normalized = String(desc).trim().toLowerCase();
            normalized = normalized.replace(/[\u064B-\u0652]/g, '');
            normalized = normalized.replace(/[أإآ]/g, 'ا');
            normalized = normalized.replace(/ى/g, 'ي');
            normalized = normalized.replace(/ة/g, 'ه');
            normalized = normalized.replace(/\s+/g, ' ');
            return normalized;
        }

        function getReportDateKey(report) {
            if (!report) return null;
            if (report.date) {
                const dateStr = normalizeArabicDigits(report.date);
                let m = dateStr.match(/(\d{4})[\/\-](\d{1,2})[\/\-](\d{1,2})/);
                if (m) return `${m[1]}-${m[2].padStart(2, '0')}-${m[3].padStart(2, '0')}`;
                m = dateStr.match(/(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})/);
                if (m) return `${m[3]}-${m[2].padStart(2, '0')}-${m[1].padStart(2, '0')}`;
            }
            if (report.timestamp) return String(report.timestamp).slice(0, 10);
            return null;
        }

        function processReport(report) {
            if (!excludeCashReports) return report;
            const cashKeywords = ['كاش', 'نقدي'];
            const rows = Array.isArray(report.rows) ? report.rows.filter(row => !(row.desc && cashKeywords.some(k => row.desc.includes(k)))) : [];
            const total = rows.reduce((sum, row) => sum + parseAmountValue(row.amount), 0);
            return Object.assign({}, report, { rows: rows, total: total.toString() });
        }

        function getProcessedReports() {
            const reports = Array.isArray(window.expensesReports) ? window.expensesReports : [];
            let processed = excludeCashReports ? reports.map(processReport) : reports.slice();
            processed = combineDailyReports(processed);
            return processed;
        }

        function combineDailyReports(reports) {
            const groups = new Map();
            reports.forEach(report => {
                const name = (report.name || '').toLowerCase();
                const hasSbahi = name.includes('صباحي');
                const hasMasaei = name.includes('مسائي');
                if (!hasSbahi && !hasMasaei) return;
                const shift = hasSbahi ? 'sbahi' : 'masaei';
                const dateKey = getReportDateKey(report);
                if (!dateKey) return;
                const groupKey = dateKey + '_' + shift;
                if (!groups.has(groupKey)) groups.set(groupKey, []);
                groups.get(groupKey).push(report);
            });
            const combinedReports = [];
            groups.forEach((groupReports, key) => {
                if (groupReports.length < 2) return;
                const [dateKey, shift] = key.split('_');
                const name = shift === 'sbahi' ? `تقارير ${restaurantName} صباحي يومي` : `تقارير ${restaurantName} مسائي يومي`;
                const rowsMap = new Map();
                groupReports.forEach(report => {
                    if (report.rows && report.rows.length) {
                        report.rows.forEach(row => {
                            const desc = row.desc || '';
                            const normDesc = normalizeDesc(desc);
                            const amount = parseAmountValue(row.amount);
                            if (rowsMap.has(normDesc)) {
                                const existing = rowsMap.get(normDesc);
                                existing.amount += amount;
                                existing.amountStr = existing.amount.toString();
                            } else {
                                rowsMap.set(normDesc, { desc: desc, amount: amount, amountStr: amount.toString() });
                            }
                        });
                    }
                });
                const combinedRows = Array.from(rowsMap.values()).map(item => ({ desc: item.desc, amount: item.amountStr }));
                const total = combinedRows.reduce((sum, row) => sum + parseAmountValue(row.amount), 0);
                combinedReports.push({
                    id: 'combined_' + key,
                    name: name,
                    date: dateKey,
                    rows: combinedRows,
                    total: total.toString(),
                    sourceLabel: 'مجمع',
                    combined: true,
                    created_by: { name: 'تجميع تلقائي' }
                });
            });
            return reports.concat(combinedReports);
        }

