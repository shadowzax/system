        function loadRecentReports() {
            const reports = getProcessedReports();
            const searchQuery = reportSearchInput.value.toLowerCase().trim();
            let filteredReports = reports;
            if (searchQuery) {
                filteredReports = filteredReports.filter(report => {
                    const nameMatch = (report.name || '').toLowerCase().includes(searchQuery);
                    const dateMatch = (report.date || '').toLowerCase().includes(searchQuery);
                    const sourceMatch = (report.sourceLabel || '').toLowerCase().includes(searchQuery);
                    const creatorMatch = (report.created_by && report.created_by.name ? report.created_by.name.toLowerCase().includes(searchQuery) : false);
                    return nameMatch || dateMatch || sourceMatch || creatorMatch;
                });
            }
            if (selectedDateFilter) {
                filteredReports = filteredReports.filter(report => getReportDateKey(report) === selectedDateFilter);
            }
            if (selectedDateFilter) {
                dateResultsContainer.style.display = 'block';
                renderDateResultsTable(filteredReports);
                recentReportsList.innerHTML = '';
                return;
            } else {
                dateResultsContainer.style.display = 'none';
                dateResultsTbody.innerHTML = '';
            }
            if (filteredReports.length === 0) {
                if (reportSearchInput.value.trim() || excludeCashReports) {
                    recentReportsList.innerHTML = '<div class="empty-state"><i class="las la-search"></i><p>لا توجد نتائج مطابقة</p></div>';
                } else {
                    recentReportsList.innerHTML = '<div class="empty-state"><i class="las la-folder-open"></i><p>لا توجد تقارير محفوظة بعد</p></div>';
                }
                return;
            }
            const groupedByMonth = {};
            filteredReports.forEach(report => {
                const dateKey = getReportDateKey(report);
                let year = null,
                    month = null,
                    day = null;
                if (dateKey) {
                    const parts = dateKey.split('-');
                    if (parts.length === 3) {
                        year = parts[0];
                        month = parts[1];
                        day = parts[2];
                    }
                }
                const monthKey = (year && month) ? `${year}-${month}` : '__undated__';
                if (!groupedByMonth[monthKey]) {
                    groupedByMonth[monthKey] = { days: {}, monthNum: month ? parseInt(month, 10) : null, year: year };
                }
                const dayKey = day || (dateKey ? '__noDay__' : '__undated__');
                if (!groupedByMonth[monthKey].days[dayKey]) groupedByMonth[monthKey].days[dayKey] = [];
                groupedByMonth[monthKey].days[dayKey].push(report);
            });
            let html = '';
            const monthKeys = Object.keys(groupedByMonth).sort((a, b) => {
                if (a === '__undated__') return 1;
                if (b === '__undated__') return -1;
                return b.localeCompare(a);
            });
            monthKeys.forEach(monthKey => {
                const monthData = groupedByMonth[monthKey];
                let monthTitle = monthKey;
                if (monthKey !== '__undated__' && monthData.monthNum) {
                    const monthName = arabicMonths[monthData.monthNum - 1] || '';
                    monthTitle = `${monthKey} - ${monthName}`;
                } else if (monthKey === '__undated__') {
                    monthTitle = 'غير مؤرخ';
                }
                const monthExpanded = expandedMonthFolders[monthKey] || false;
                html += `<div class="folder-item month-folder" data-month="${monthKey}">`;
                html += `<div class="folder-header" data-toggle="month" data-key="${monthKey}">`;
                html += `<div class="folder-title"><i class="las la-folder"></i><span>${monthTitle}</span></div>`;
                html += `<div class="flex gap-2 items-center">`;
                html += `<button class="folder-dash-btn" data-type="month" data-key="${monthKey}" title="لوحة معلومات الشهر"><i class="las la-chart-bar"></i></button>`;
                html += `<button class="btn-outline btn-xs folder-toggle-btn month-toggle-btn" data-toggle="month" data-key="${monthKey}">${monthExpanded ? 'إغلاق' : 'فتح'}</button>`;
                html += `</div>`;
                html += `</div>`;
                html += `<div class="folder-content${monthExpanded ? '' : ' hidden'}" data-month-content="${monthKey}">`;
                const dayKeys = Object.keys(monthData.days).sort((a, b) => {
                    if (a === '__undated__' || a === '__noDay__') return 1;
                    if (b === '__undated__' || b === '__noDay__') return -1;
                    return a.localeCompare(b);
                });
                dayKeys.forEach(dayKey => {
                    const dayStateKey = monthKey + '_' + dayKey;
                    const dayExpanded = expandedDayFolders[dayStateKey] || false;
                    const reportsForDay = monthData.days[dayKey];
                    reportsForDay.sort((a, b) => (b.timestamp || '').localeCompare(a.timestamp || ''));
                    if (dayKey === '__noDay__' || dayKey === '__undated__') {
                        reportsForDay.forEach(report => { html += buildReportListItem(report); });
                    } else {
                        let dayTitle = dayKey;
                        if (monthKey !== '__undated__') {
                            const year = monthData.year;
                            const monthNum = monthData.monthNum;
                            const dayNum = parseInt(dayKey, 10);
                            if (year && monthNum && !isNaN(dayNum)) {
                                const dateObj = new Date(year, monthNum - 1, dayNum);
                                const weekdayName = arabicDays[dateObj.getDay()];
                                dayTitle = `${dayKey} - ${weekdayName}`;
                            }
                        }
                        html += `<div class="folder-item day-folder" data-day="${dayKey}" data-month="${monthKey}">`;
                        html += `<div class="folder-header" data-toggle="day" data-key="${dayStateKey}">`;
                        html += `<div class="folder-title"><i class="las la-folder-open"></i><span>${dayTitle}</span></div>`;
                        html += `<div class="flex gap-2 items-center">`;
                        html += `<button class="folder-dash-btn" data-type="day" data-key="${dayStateKey}" title="لوحة معلومات اليوم"><i class="las la-chart-bar"></i></button>`;
                        html += `<button class="btn-outline btn-xs folder-toggle-btn day-toggle-btn" data-toggle="day" data-key="${dayStateKey}">${dayExpanded ? 'إغلاق' : 'فتح'}</button>`;
                        html += `</div>`;
                        html += `</div>`;
                        html += `<div class="folder-content${dayExpanded ? '' : ' hidden'}" data-day-content="${dayStateKey}">`;
                        reportsForDay.forEach(report => { html += buildReportListItem(report); });
                        html += `</div></div>`;
                    }
                });
                html += `</div></div>`;
            });
            recentReportsList.innerHTML = html;
            attachReportListEvents();
        }

