            html += '<tr><td style="padding:3px 5px; border:0.5px solid #000; text-align:center;">أعلى يوم دخل</td><td style="padding:3px 5px; border:0.5px solid #000; text-align:center;">' + document.getElementById('dashMaxDailyIncome').textContent + ' ج.م</td></tr>';
