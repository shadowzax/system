        function openFolderDashboard(type, key) {
            if (type === 'month') {
                const [year, month] = key.split('-');
                const monthNum = parseInt(month, 10);
                const lastDay = new Date(year, monthNum, 0).getDate();
                dashboardDateFrom = `${year}-${month}-01`;
                dashboardDateTo = `${year}-${month}-${String(lastDay).padStart(2, '0')}`;
                dashDateFrom.value = dashboardDateFrom;
                dashDateTo.value = dashboardDateTo;
                const monthName = arabicMonths[monthNum - 1] || '';
                dashboardPeriodLabel.textContent = `شهر ${monthName} ${year}`;
            } else if (type === 'day') {
                const [year, month, day] = key.split('-');
                dashboardDateFrom = `${year}-${month}-${day}`;
                dashboardDateTo = `${year}-${month}-${day}`;
                dashDateFrom.value = dashboardDateFrom;
                dashDateTo.value = dashboardDateTo;
                const monthName = arabicMonths[parseInt(month, 10) - 1] || '';
                const dayNum = parseInt(day, 10);
                const dateObj = new Date(year, parseInt(month, 10) - 1, dayNum);
                const weekdayName = arabicDays[dateObj.getDay()];
                dashboardPeriodLabel.textContent = `يوم ${dayNum} ${monthName} ${year} (${weekdayName})`;
            }
            showDashboard();
        }

        function buildDashboard() {
            const reports = window.expensesReports.filter(r => !r.combined);
            const incomeKeywords = ['كاش', 'نقدي', 'تحويلات', 'فيزا', 'فيز'];
            const expenseCategories = {};
            const dailyExpenses = {};

            reports.forEach(report => {
                if (dashboardDateFrom || dashboardDateTo) {
                    const reportDate = getReportDateKey(report);
                    if (reportDate) {
                        if (dashboardDateFrom && reportDate < dashboardDateFrom) return;
                        if (dashboardDateTo && reportDate > dashboardDateTo) return;
                    } else {
                        return;
                    }
                }
                const dateKey = getReportDateKey(report);
                if (report.rows && report.rows.length) {
                    report.rows.forEach(row => {
                        const desc = row.desc || '';
                        const amount = parseAmountValue(row.amount);
                        const normDesc = normalizeDesc(desc);
                        let isIncome = false;
                        for (const kw of incomeKeywords) {
                            if (normDesc.includes(kw.toLowerCase())) {
                                isIncome = true;
                                break;
                            }
                        }
                        if (!isIncome) {
                            const catKey = normDesc || 'غير مصنف';
                            expenseCategories[catKey] = (expenseCategories[catKey] || 0) + amount;
                            if (dateKey) {
                                dailyExpenses[dateKey] = (dailyExpenses[dateKey] || 0) + amount;
                            }
                        }
                    });
                }
            });

            const totalExpenses = Object.values(expenseCategories).reduce((sum, val) => sum + val, 0);
            const itemCount = Object.keys(expenseCategories).length;
            const reportCount = reports.filter(r => {
                if (dashboardDateFrom || dashboardDateTo) {
                    const rd = getReportDateKey(r);
                    if (rd) {
                        if (dashboardDateFrom && rd < dashboardDateFrom) return false;
                        if (dashboardDateTo && rd > dashboardDateTo) return false;
                    } else {
                        return false;
                    }
                }
                return true;
            }).length;
            const dailyKeys = Object.keys(dailyExpenses);
            const avgDaily = dailyKeys.length > 0 ? totalExpenses / dailyKeys.length : 0;
            let maxDaily = 0;
            let maxDailyDate = '-';
            dailyKeys.forEach(dk => {
                if (dailyExpenses[dk] > maxDaily) {
                    maxDaily = dailyExpenses[dk];
                    maxDailyDate = dk;
                }
            });

            document.getElementById('dashTotalExpenses').textContent = totalExpenses.toFixed(2);
            document.getElementById('dashReportCount').textContent = reportCount;
            document.getElementById('dashAvgDaily').textContent = avgDaily.toFixed(2);
            document.getElementById('dashMaxDaily').textContent = maxDaily.toFixed(2);
            document.getElementById('dashMaxDailyDate').textContent = maxDailyDate !== '-' ? maxDailyDate : '-';
            document.getElementById('dashItemCount').textContent = itemCount;

            const sortedCategories = Object.entries(expenseCategories).sort((a, b) => b[1] - a[1]);
            const sortedDailyKeys = dailyKeys.sort((a, b) => a.localeCompare(b));
            const dailyLabels = sortedDailyKeys.map(dk => {
                const parts = dk.split('-');
                if (parts.length === 3) {
                    const dayNum = parseInt(parts[2], 10);
                    const monthNum = parseInt(parts[1], 10);
                    return `${dayNum}/${monthNum}`;
                }
                return dk;
            });
            const dailyData = sortedDailyKeys.map(dk => dailyExpenses[dk]);

            const ctx = document.documentElement;
            const cardBg = getComputedStyle(ctx).getPropertyValue('--color-card').trim() || '#00060c';
            const textColor = getComputedStyle(ctx).getPropertyValue('--color-muted').trim() || '#9ca3af';
            const whiteColor = getComputedStyle(ctx).getPropertyValue('--color-white').trim() || '#ffffff';
            const primaryColor = getComputedStyle(ctx).getPropertyValue('--color-primary').trim() || '#0d99ff';
            const greenUp = getComputedStyle(ctx).getPropertyValue('--green-up').trim() || '#10b981';
            const redDown = getComputedStyle(ctx).getPropertyValue('--red-down').trim() || '#ef4444';
            const blueAccent = getComputedStyle(ctx).getPropertyValue('--blue-accent').trim() || '#3b82f6';
            const goldAccent = getComputedStyle(ctx).getPropertyValue('--gold-accent').trim() || '#f59e0b';
            const purpleAccent = getComputedStyle(ctx).getPropertyValue('--purple-accent').trim() || '#8b5cf6';

            const areaCtx = document.getElementById('dashExpenseAreaChart').getContext('2d');
            if (dashExpenseAreaChartInstance) dashExpenseAreaChartInstance.destroy();
            const areaGradient = areaCtx.createLinearGradient(0, 0, 0, 320);
            areaGradient.addColorStop(0, primaryColor + '55');
            areaGradient.addColorStop(1, primaryColor + '05');
            dashExpenseAreaChartInstance = new Chart(areaCtx, {
                type: 'line',
                data: {
                    labels: dailyLabels,
                    datasets: [{
                        label: 'المصروفات اليومية',
                        data: dailyData,
                        borderColor: primaryColor,
                        backgroundColor: areaGradient,
                        fill: true,
                        tension: 0.4,
                        borderWidth: 2.5,
                        pointRadius: 4,
                        pointHoverRadius: 7,
                        pointBackgroundColor: whiteColor,
                        pointBorderColor: primaryColor,
                        pointBorderWidth: 2,
                        pointHoverBackgroundColor: primaryColor,
                        pointHoverBorderColor: whiteColor
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    scales: {
                        x: {
                            ticks: { color: textColor, font: { family: 'Alexandria', size: 11 }, maxRotation: 45 },
                            grid: { color: 'rgba(186,186,186,0.08)', drawBorder: false }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: { color: textColor, font: { family: 'Alexandria', size: 11 }, callback: function(value) { return value.toFixed(0); } },
                            grid: { color: 'rgba(186,186,186,0.08)', drawBorder: false }
                        }
                    },
                    plugins: {
                        legend: { display: true, labels: { color: whiteColor, font: { family: 'Alexandria', size: 12, weight: '600' }, usePointStyle: true, pointStyleWidth: 12, padding: 15 } },
                        tooltip: {
                            backgroundColor: 'rgba(0,0,0,0.85)',
                            titleFont: { family: 'Alexandria', size: 13, weight: '700' },
                            bodyFont: { family: 'Alexandria', size: 12 },
                            padding: 12,
                            cornerRadius: 8,
                            titleColor: '#ffffff',
                            bodyColor: '#bababa',
                            callbacks: {
                                label: function(context) { return 'المصروف: ' + context.parsed.y.toFixed(2) + ' ج.م'; }
                            }
                        }
                    }
                }
            });

            const barCtx = document.getElementById('dashExpenseBarChart').getContext('2d');
            if (dashExpenseBarChartInstance) dashExpenseBarChartInstance.destroy();
            const topForBar = sortedCategories.slice(0, 10);
            const barLabels = topForBar.map(([label]) => label);
            const barData = topForBar.map(([, val]) => val);
            const barColors = topForBar.map((_, i) => {
                const palette = [redDown, goldAccent, blueAccent, greenUp, purpleAccent, primaryColor, '#ec4899', '#06b6d4', '#f97316', '#64748b'];
                return palette[i % palette.length];
            });
            dashExpenseBarChartInstance = new Chart(barCtx, {
                type: 'bar',
                data: {
                    labels: barLabels,
                    datasets: [{
                        label: 'المبلغ (ج.م)',
                        data: barData,
                        backgroundColor: barColors,
                        borderRadius: 6,
                        borderSkipped: false,
                        barThickness: 22,
                        hoverBackgroundColor: barColors.map(c => c + 'cc')
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: {
                            beginAtZero: true,
                            ticks: { color: textColor, font: { family: 'Alexandria', size: 11 }, callback: function(value) { return value.toFixed(0); } },
                            grid: { color: 'rgba(186,186,186,0.08)', drawBorder: false }
                        },
                        y: {
                            ticks: { color: whiteColor, font: { family: 'Alexandria', size: 11, weight: '600' } },
                            grid: { display: false }
                        }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(0,0,0,0.85)',
                            titleFont: { family: 'Alexandria', size: 12, weight: '700' },
                            bodyFont: { family: 'Alexandria', size: 11 },
                            padding: 12,
                            cornerRadius: 8,
                            titleColor: '#ffffff',
                            bodyColor: '#bababa'
                        }
                    }
                }
            });

            const pieCtx = document.getElementById('dashExpensePieChart').getContext('2d');
            if (dashExpensePieChartInstance) dashExpensePieChartInstance.destroy();
            const topForPie = sortedCategories.slice(0, 8);
            const otherSum = sortedCategories.slice(8).reduce((sum, [, val]) => sum + val, 0);
            const pieLabels = topForPie.map(([label]) => label);
            const pieData = topForPie.map(([, val]) => val);
            if (otherSum > 0) {
                pieLabels.push('أخرى');
                pieData.push(otherSum);
            }
            const pieColors = [redDown, goldAccent, blueAccent, greenUp, purpleAccent, primaryColor, '#ec4899', '#06b6d4', '#f97316'];
            dashExpensePieChartInstance = new Chart(pieCtx, {
                type: 'doughnut',
                data: {
                    labels: pieLabels,
                    datasets: [{
                        data: pieData,
                        backgroundColor: pieColors.slice(0, pieData.length),
                        borderWidth: 3,
                        borderColor: cardBg,
                        hoverOffset: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '58%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: whiteColor,
                                font: { family: 'Alexandria', size: 10, weight: '600' },
                                padding: 10,
                                usePointStyle: true,
                                pointStyleWidth: 8
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(0,0,0,0.85)',
                            titleFont: { family: 'Alexandria', size: 12, weight: '700' },
                            bodyFont: { family: 'Alexandria', size: 11 },
                            padding: 12,
                            cornerRadius: 8,
                            titleColor: '#ffffff',
                            bodyColor: '#bababa',
                            callbacks: {
                                label: function(context) {
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const pct = total > 0 ? ((context.parsed / total) * 100).toFixed(1) : 0;
                                    return context.label + ': ' + context.parsed.toFixed(2) + ' ج.م (' + pct + '%)';
                                }
                            }
                        }
                    }
                }
            });

            const tbody = document.getElementById('dashCategoryTbody');
            tbody.innerHTML = '';
            sortedCategories.forEach(([cat, amount], index) => {
                const pct = totalExpenses > 0 ? ((amount / totalExpenses) * 100).toFixed(1) : 0;
                const prevAmount = index < sortedCategories.length - 1 ? sortedCategories[index + 1][1] : 0;
                let trendClass = 'boursa-badge blue';
                let trendIcon = '<i class="las la-minus"></i>';
                if (index === 0) {
                    trendClass = 'boursa-badge red';
                    trendIcon = '<i class="las la-arrow-up"></i>';
                } else if (amount < prevAmount) {
                    trendClass = 'boursa-badge green';
                    trendIcon = '<i class="las la-arrow-down"></i>';
                }
                const tr = document.createElement('tr');
                tr.innerHTML = `<td>${cat}</td><td>${amount.toFixed(2)}</td><td>${pct}%</td><td><span class="${trendClass}">${trendIcon} ${index === 0 ? 'الأعلى' : (amount < prevAmount ? 'انخفاض' : 'ثابت')}</span></td>`;
                tbody.appendChild(tr);
            });
            if (tbody.children.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-center text-[var(--color-muted)]">لا توجد بيانات</td></tr>';
            }
        }

        const sidebar = document.getElementById('dashboardSidebar');
        const headerAvatar = document.getElementById('headerAvatar');

        function openSidebar() {
            sidebar.classList.add('mobile-open');
            sidebar.classList.remove('mobile-closed');
        }

        function closeSidebar() {
            sidebar.classList.remove('mobile-open');
            sidebar.classList.add('mobile-closed');
        }
        if (window.innerWidth < 1025) sidebar.classList.add('mobile-closed');
        window.addEventListener('resize', function() {
            if (window.innerWidth >= 1025) {
                sidebar.classList.remove('mobile-open', 'mobile-closed');
            } else {
                if (!sidebar.classList.contains('mobile-open')) sidebar.classList.add('mobile-closed');
            }
        });
        headerAvatar.addEventListener('click', function(e) {
            e.stopPropagation();
            if (window.innerWidth < 1025) {
                if (sidebar.classList.contains('mobile-open')) closeSidebar();
                else openSidebar();
            }
        });
        document.addEventListener('click', function(e) {
            if (window.innerWidth < 1025 && sidebar.classList.contains('mobile-open')) {
                if (!sidebar.contains(e.target) && e.target !== headerAvatar && !headerAvatar.contains(e.target)) {
                    closeSidebar();
                }
            }
        });
        const sidebarItems = document.querySelectorAll('.sidebar-item');
        sidebarItems.forEach(item => {
            item.addEventListener('click', function() {
                if (this.id === 'adminSidebarLogoutBtn') return;
                sidebarItems.forEach(i => i.classList.remove('active'));
                this.classList.add('active');
                if (window.innerWidth < 1025) closeSidebar();
            });
        });
        const logoutBtn = document.getElementById('adminSidebarLogoutBtn');
        logoutBtn.addEventListener('click', (e) => {
            e.preventDefault();
            Swal.fire({
                title: 'تسجيل الخروج؟',
                text: 'هل أنت متأكد أنك تريد تسجيل الخروج؟',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'تسجيل الخروج',
                cancelButtonText: 'إلغاء',
                confirmButtonColor: '#ef4444'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
                    window.location.href = '/login';
                }
            });
        });
        const successModal = document.getElementById('successModal');
        const closeSuccessModal = document.getElementById('closeSuccessModal');
        const okSuccessBtn = document.getElementById('okSuccessBtn');
        const successMessageEl = document.getElementById('successMessage');

        function showSuccess(msg) {
            successMessageEl.textContent = msg;
            successModal.classList.add('active');
        }

        function hideSuccess() {
            successModal.classList.remove('active');
        }
        closeSuccessModal.addEventListener('click', hideSuccess);
        okSuccessBtn.addEventListener('click', hideSuccess);
        window.addEventListener('click', (e) => {
            if (e.target === successModal) hideSuccess();
        });
        const themeToggleBtn = document.getElementById('themetoggle');
        const body = document.body;

        function applyTheme(theme) {
            const isDark = theme === 'dark';
            body.classList.toggle('light', !isDark);
            themeToggleBtn.classList.toggle('dark', isDark);
            localStorage.setItem('theme', theme);
        }
        const savedTheme = localStorage.getItem('theme') || 'dark';
        applyTheme(savedTheme);
        themeToggleBtn.addEventListener('click', () => {
            const isDark = body.classList.contains('light') === false;
            applyTheme(isDark ? 'light' : 'dark');
        });
        document.addEventListener('DOMContentLoaded', function() {
            loadRecentReports();
        });
    </script>
</body>
</html>
