                                <div>
                                    <label class="block text-sm text-[var(--color-muted)] mb-1">كلمة المرور الحالية</label>
                                    <input type="password" class="input-field" id="currentPassword" placeholder="كلمة المرور الحالية">
                                </div>
                                <div></div>
                                <div>
                                    <label class="block text-sm text-[var(--color-muted)] mb-1">كلمة المرور الجديدة</label>
                                    <input type="password" class="input-field" id="newPassword" placeholder="كلمة المرور الجديدة">
