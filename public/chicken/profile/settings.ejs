                            </div>
                            <div class="flex items-center justify-between p-4 rounded-xl bg-[var(--darker-bg)] border border-[var(--border-color)]">
                                <div>
                                    <p class="font-medium text-[var(--color-white)]">اللون الأساسي</p>
                                    <p class="text-xs text-[var(--color-muted)]">اختيار اللون الرئيسي للوحة التحكم</p>
                                </div>
                                <div class="flex gap-2">
                                    <button class="w-8 h-8 rounded-full bg-[#0d99ff] border-2 border-white color-option" data-color="#0d99ff"></button>
                                    <button class="w-8 h-8 rounded-full bg-[#7c3aed] border-2 border-transparent color-option" data-color="#7c3aed"></button>
                                    <button class="w-8 h-8 rounded-full bg-[#10b981] border-2 border-transparent color-option" data-color="#10b981"></button>
                                    <button class="w-8 h-8 rounded-full bg-[#f59e0b] border-2 border-transparent color-option" data-color="#f59e0b"></button>
                                    <button class="w-8 h-8 rounded-full bg-[#ef4444] border-2 border-transparent color-option" data-color="#ef4444"></button>
                                </div>
                            </div>
                            <div class="flex items-center justify-between p-4 rounded-xl bg-[var(--darker-bg)] border border-[var(--border-color)]">
                                <div>
                                    <p class="font-medium text-[var(--color-white)]">حجم الخط</p>
                                    <p class="text-xs text-[var(--color-muted)]">ضبط حجم الخط في لوحة التحكم</p>
                                </div>
                                <select class="input-field w-auto" id="fontSizeSelect">
                                    <option value="small">صغير</option>
                                    <option value="medium" selected>متوسط</option>
                                    <option value="large">كبير</option>
                                </select>
