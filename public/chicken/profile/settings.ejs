<!DOCTYPE html>
<html lang="ar" dir="rtl" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <meta name="theme-color" content="#0d99ff">
    <title>الإعدادات</title>
    <meta name="description" content="إعدادات لوحة التحكم">
    <link rel="icon" type="image/png" href="/favicon.ico">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/line-awesome/1.3.0/line-awesome/css/line-awesome.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/settings.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#0d99ff',
                        secondary: '#7c3aed',
                        accent: '#06b6d4',
                        error: '#ef4444',
                        success: '#10b981',
                        warning: '#f59e0b',
                    }
                }
            }
        }
    </script>
</head>
<body>
    <script>
        window.__APP_DATA__ = {
            token: "<%- token %>",
            api: "<%- api %>",
            isAuthenticated: <%- isAuthenticated ? 'true' : 'false' %>,
            user: <%- JSON.stringify(user || null) %>
        };
    </script>
    <%- include('../../sections/header-chicken.ejs') %>
            <div class="container mx-auto px-4 py-6 max-w-7xl">
                <div class="mb-6">
                    <h1 class="text-2xl font-bold text-[var(--color-white)] flex items-center gap-3">
                        <i class="las la-cog text-primary text-3xl"></i> الإعدادات
                    </h1>
                    <p class="text-[var(--color-muted)] mt-1 mr-10">إدارة إعدادات النظام والمطعم</p>
                </div>
                <div class="flex flex-wrap gap-2 mb-6 overflow-x-auto pb-2" id="settingsTabs">
                    <button class="settings-tab active" data-tab="profile"><i class="las la-user"></i> الملف الشخصي</button>
                    <button class="settings-tab" data-tab="restaurant"><i class="las la-store-alt"></i> معلومات المطعم</button>
                    <button class="settings-tab" data-tab="notifications"><i class="las la-bell"></i> الإشعارات</button>
                    <button class="settings-tab" data-tab="security"><i class="las la-shield-alt"></i> الأمان</button>
                    <button class="settings-tab" data-tab="appearance"><i class="las la-palette"></i> المظهر</button>
                    <button class="settings-tab" data-tab="backup"><i class="las la-cloud-upload-alt"></i> النسخ الاحتياطي</button>
                </div>
                <div id="settingsContent">
                    <div class="info-card" id="tab-profile">
                        <h3 class="text-lg font-bold text-[var(--color-white)] mb-6 flex items-center gap-2"><i class="las la-user text-primary"></i> الملف الشخصي</h3>
                        <div class="flex flex-col sm:flex-row items-start gap-6 mb-6">
                            <div class="flex flex-col items-center gap-3">
                                <img id="profileAvatar" src="<%- user && user.profile_picture ? user.profile_picture : 'https://i.ibb.co/HRbkkLw/3177440-1.jpg' %>" class="avatar-upload" alt="صورة الملف">
                                <button class="btn-outline btn-sm" id="changeAvatarBtn"><i class="las la-camera"></i> تغيير الصورة</button>
                            </div>
                            <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 gap-4 w-full">
                                <div>
                                    <label class="block text-sm text-[var(--color-muted)] mb-1">الاسم الكامل</label>
                                    <input type="text" class="input-field" id="fullNameInput" value="<%= user && user.name ? user.name : '' %>" placeholder="الاسم الكامل">
                                </div>
                                <div>
                                    <label class="block text-sm text-[var(--color-muted)] mb-1">البريد الإلكتروني</label>
                                    <input type="email" class="input-field" id="emailInput" value="<%= user && user.email ? user.email : '' %>" placeholder="البريد الإلكتروني">
                                </div>
                                <div>
                                    <label class="block text-sm text-[var(--color-muted)] mb-1">رقم الهاتف</label>
                                    <input type="tel" class="input-field" id="phoneInput" value="<%= user && user.phone_number ? user.phone_number : '' %>" placeholder="رقم الهاتف">
                                </div>
                                <div>
                                    <label class="block text-sm text-[var(--color-muted)] mb-1">الدور الوظيفي</label>
                                    <select class="input-field" id="roleSelect">
                                        <option value="admin" <%= user && user.account_type === 'admin' ? 'selected' : '' %>>مدير النظام</option>
                                        <option value="manager" <%= user && user.account_type === 'manager' ? 'selected' : '' %>>مدير مطعم</option>
                                        <option value="cashier" <%= user && user.account_type === 'cashier' ? 'selected' : '' %>>كاشير</option>
                                        <option value="viewer" <%= user && user.account_type === 'viewer' ? 'selected' : '' %>>مشاهد فقط</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <button class="btn-primary" id="saveProfileBtn"><i class="las la-save"></i> حفظ التغييرات</button>
                    </div>
                    <div class="info-card hidden" id="tab-restaurant">
                        <h3 class="text-lg font-bold text-[var(--color-white)] mb-6 flex items-center gap-2"><i class="las la-store-alt text-primary"></i> معلومات المطعم</h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                            <div>
                                <label class="block text-sm text-[var(--color-muted)] mb-1">اسم المطعم</label>
                                <input type="text" class="input-field" id="restaurantName" placeholder="اسم المطعم">
                            </div>
                            <div>
                                <label class="block text-sm text-[var(--color-muted)] mb-1">رقم السجل التجاري</label>
                                <input type="text" class="input-field" id="commercialReg" placeholder="رقم السجل التجاري">
                            </div>
                            <div>
                                <label class="block text-sm text-[var(--color-muted)] mb-1">رقم الهاتف</label>
                                <input type="tel" class="input-field" id="restaurantPhone" placeholder="رقم هاتف المطعم">
                            </div>
                            <div>
                                <label class="block text-sm text-[var(--color-muted)] mb-1">البريد الإلكتروني</label>
                                <input type="email" class="input-field" id="restaurantEmail" placeholder="البريد الإلكتروني">
                            </div>
                            <div class="sm:col-span-2">
                                <label class="block text-sm text-[var(--color-muted)] mb-1">العنوان</label>
                                <textarea class="input-field" id="restaurantAddress" placeholder="العنوان الكامل"></textarea>
                            </div>
                            <div>
                                <label class="block text-sm text-[var(--color-muted)] mb-1">ساعات العمل</label>
                                <input type="text" class="input-field" id="workingHours" placeholder="ساعات العمل">
                            </div>
                            <div>
                                <label class="block text-sm text-[var(--color-muted)] mb-1">العملة الافتراضية</label>
                                <select class="input-field" id="currencySelect">
                                    <option value="EGP">ج.م - جنيه مصري</option>
                                    <option value="SAR">ر.س - ريال سعودي</option>
                                    <option value="USD">$ - دولار أمريكي</option>
                                    <option value="EUR">€ - يورو</option>
                                </select>
                            </div>
                        </div>
                        <button class="btn-primary" id="saveRestaurantBtn"><i class="las la-save"></i> حفظ معلومات المطعم</button>
                    </div>
                    <div class="info-card hidden" id="tab-notifications">
                        <h3 class="text-lg font-bold text-[var(--color-white)] mb-6 flex items-center gap-2"><i class="las la-bell text-primary"></i> إعدادات الإشعارات</h3>
                        <div class="space-y-4">
                            <div class="flex items-center justify-between p-4 rounded-xl bg-[var(--darker-bg)] border border-[var(--border-color)]">
                                <div>
                                    <p class="font-medium text-[var(--color-white)]">إشعارات الطلبات الجديدة</p>
                                    <p class="text-xs text-[var(--color-muted)]">تلقي إشعار عند وصول طلب جديد</p>
                                </div>
                                <label class="toggle-switch">
                                    <input type="checkbox" id="notifyOrders" checked>
                                    <span class="toggle-slider"></span>
                                </label>
                            </div>
                            <div class="flex items-center justify-between p-4 rounded-xl bg-[var(--darker-bg)] border border-[var(--border-color)]">
                                <div>
                                    <p class="font-medium text-[var(--color-white)]">إشعارات المخزون المنخفض</p>
                                    <p class="text-xs text-[var(--color-muted)]">تنبيه عند انخفاض المخزون للحد الأدنى</p>
                                </div>
                                <label class="toggle-switch">
                                    <input type="checkbox" id="notifyInventory" checked>
                                    <span class="toggle-slider"></span>
                                </label>
                            </div>
                            <div class="flex items-center justify-between p-4 rounded-xl bg-[var(--darker-bg)] border border-[var(--border-color)]">
                                <div>
                                    <p class="font-medium text-[var(--color-white)]">إشعارات التقييمات</p>
                                    <p class="text-xs text-[var(--color-muted)]">تلقي إشعار عند إضافة تقييم جديد</p>
                                </div>
                                <label class="toggle-switch">
                                    <input type="checkbox" id="notifyReviews" checked>
                                    <span class="toggle-slider"></span>
                                </label>
                            </div>
                            <div class="flex items-center justify-between p-4 rounded-xl bg-[var(--darker-bg)] border border-[var(--border-color)]">
                                <div>
                                    <p class="font-medium text-[var(--color-white)]">التقارير الأسبوعية</p>
                                    <p class="text-xs text-[var(--color-muted)]">استلام تقرير أسبوعي بالأداء</p>
                                </div>
                                <label class="toggle-switch">
                                    <input type="checkbox" id="notifyWeekly">
                                    <span class="toggle-slider"></span>
                                </label>
                            </div>
                            <div class="flex items-center justify-between p-4 rounded-xl bg-[var(--darker-bg)] border border-[var(--border-color)]">
                                <div>
                                    <p class="font-medium text-[var(--color-white)]">إشعارات البريد الإلكتروني</p>
                                    <p class="text-xs text-[var(--color-muted)]">إرسال الإشعارات عبر البريد الإلكتروني</p>
                                </div>
                                <label class="toggle-switch">
                                    <input type="checkbox" id="notifyEmail" checked>
                                    <span class="toggle-slider"></span>
                                </label>
                            </div>
                        </div>
                        <button class="btn-primary mt-6" id="saveNotificationsBtn"><i class="las la-save"></i> حفظ إعدادات الإشعارات</button>
                    </div>
                    <div class="info-card hidden" id="tab-security">
