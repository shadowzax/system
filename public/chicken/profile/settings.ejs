                                <div>
                                    <label class="block text-sm text-[var(--color-muted)] mb-1">تأكيد كلمة المرور</label>
                                    <input type="password" class="input-field" id="confirmPassword" placeholder="تأكيد كلمة المرور الجديدة">
                                </div>
                            </div>
                            <button class="btn-primary" id="changePasswordBtn"><i class="las la-lock"></i> تغيير كلمة المرور</button>
