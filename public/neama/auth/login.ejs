<!DOCTYPE html>
<html lang="ar" dir="rtl" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <meta name="theme-color" content="#0d99ff">
    <title>تسجيل الدخول</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/line-awesome/1.3.0/line-awesome/css/line-awesome.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com">
    </script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#0d99ff',
                        secondary: '#7c3aed',
                        accent: '#06b6d4',
                        error: '#ef4444',
                        success: '#10b981',
                        warning: '#f59e0b',
                    }
                }
            }
        }
    </script>
    <style>
        :root {
            --color-primary: #0d99ff;
            --color-secondary: #7c3aed;
            --color-accent: #06b6d4;
            --color-background: #00080f;
            --color-card: #00060c;
            --color-darker: #000308;
            --color-paragraph: #bababa;
            --color-white: #ffffff;
            --color-muted: #9ca3af;
            --border-subtle: rgba(186, 186, 186, 0.24);
            --card-bg: #00060c;
            --border-color: rgba(186, 186, 186, 0.24);
            --darker-bg: #000308;
            --header-height: 70px;
            --shadow-glow: 0 0 30px rgba(13, 153, 255, 0.08);
        }

        .light {
            --color-background: #f1f5f9;
            --color-card: #ffffff;
            --color-darker: #e2e8f0;
            --color-paragraph: #334155;
            --color-white: #0f172a;
            --color-muted: #64748b;
            --border-subtle: rgba(0, 0, 0, 0.08);
            --card-bg: #ffffff;
            --border-color: rgba(0, 0, 0, 0.1);
            --darker-bg: #e2e8f0;
            --shadow-glow: 0 0 30px rgba(13, 153, 255, 0.04);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Alexandria', system-ui, sans-serif;
            background-color: var(--color-background);
            color: var(--color-white);
            transition: background-color 0.3s, color 0.3s;
            overflow-x: hidden;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        ::-webkit-scrollbar-track {
            background: var(--color-background);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: #0563a7;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #0d99ff;
        }

        #mainHeader {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: var(--header-height);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            border-bottom: 1px solid var(--border-subtle);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            background: var(--color-background);
            z-index: 110;
            transition: background-color 0.3s;
        }

        main {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding-top: var(--header-height);
            padding-bottom: 40px;
        }

        .info-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 24px;
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            box-shadow: var(--shadow-glow);
        }

        .input-field {
            width: 100%;
            background: var(--darker-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 12px 16px;
            color: var(--color-white);
            font-family: inherit;
            transition: border-color 0.2s;
            font-size: 0.9rem;
        }
        .input-field:focus {
            outline: none;
            border-color: var(--color-primary);
            box-shadow: 0 0 0 3px rgba(13, 153, 255, 0.1);
        }
        .input-field::placeholder {
            color: var(--color-muted);
            opacity: 0.7;
        }
        .input-field.error {
            border-color: #ef4444;
            box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.1);
        }

        .btn-primary {
            background: var(--color-primary);
            color: #fff;
            border: none;
            padding: 12px 24px;
            border-radius: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: inherit;
            font-size: 0.9rem;
        }
        .btn-primary:hover {
            background: #0b85e0;
            transform: translateY(-1px);
            box-shadow: 0 8px 25px rgba(13, 153, 255, 0.25);
        }
        .btn-primary:active {
            transform: scale(0.97);
        }
        .btn-primary:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        .theme-toggle {
            position: relative;
            width: 70px;
            height: 35px;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            overflow: hidden;
            background: linear-gradient(45deg, #ffd700, #ffed4a);
            box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.3);
            transition: all .4s ease;
        }
        .theme-toggle .toggle-circle {
            position: absolute;
            top: 4px;
            right: 4px;
            width: 27px;
            height: 27px;
            border-radius: 50%;
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 8px rgba(0, 0, 0, .2), inset 0 1px 0 rgba(255, 255, 255, .8);
            transition: all .45s cubic-bezier(.68, -0.55, .265, 1.55);
        }
        .theme-toggle .icon {
            position: absolute;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all .4s ease;
        }
        .theme-toggle .sun-icon {
            color: #ff6b35;
            opacity: 1;
            transform: rotate(0deg) scale(1);
        }
        .theme-toggle .moon-icon {
            color: #a78bfa;
            opacity: 0;
            transform: rotate(180deg) scale(.5);
        }
        .theme-toggle.dark {
            background: linear-gradient(45deg, #475569, #1e293b);
            box-shadow: 0 4px 12px rgba(30, 41, 59, .4), inset 0 1px 0 rgba(255, 255, 255, .08);
        }
        .theme-toggle.dark .toggle-circle {
            right: calc(100% - 31px);
            background: #1e293b;
            box-shadow: 0 4px 12px rgba(0, 0, 0, .4), inset 0 1px 0 rgba(255, 255, 255, .08);
        }
        .theme-toggle.dark .sun-icon {
            opacity: 0;
            transform: rotate(-180deg) scale(.5);
        }
        .theme-toggle.dark .moon-icon {
            opacity: 1;
            transform: rotate(0deg) scale(1);
        }

        .login-card {
            width: 100%;
            max-width: 440px;
            margin: 0 16px;
        }

        .validation-msg {
            font-size: 0.72rem;
            margin-top: 4px;
            display: none;
            align-items: center;
            gap: 4px;
        }
        .validation-msg.error {
            color: #ef4444;
            display: flex;
        }
    </style>
</head>
<body>
    <header id="mainHeader">
        <div class="flex items-center gap-6 mr-4">
            <a class="flex w-fit select-none items-center" href="/">
                <img src="/logos/2.png" alt="logo"
                    class="h-[52px] sm:h-[60px] md:h-[68px] object-contain">
            </a>
        </div>
        <div class="flex items-center gap-3 sm:gap-4">
            <button class="theme-toggle" id="themetoggle">
                <div class="toggle-circle">
                    <i class="fas fa-sun icon sun-icon"></i>
                    <i class="fas fa-moon icon moon-icon"></i>
                </div>
            </button>
        </div>
    </header>
    <main>
        <div class="login-card">
            <div class="info-card">
                <div class="text-center mb-6">
                    <div class="text-4xl mb-3 text-primary">
                        <i class="las la-sign-in-alt"></i>
                    </div>
                    <h1 class="text-2xl font-bold text-[var(--color-white)] mb-2">تسجيل الدخول</h1>
                    <p class="text-sm text-[var(--color-muted)]">أدخل بياناتك للوصول إلى لوحة التحكم</p>
                </div>
                <form id="loginForm" autocomplete="off" novalidate>
                    <div class="mb-4">
                        <label class="text-sm text-[var(--color-muted)] block mb-1 font-medium" for="loginIdentifier">
                            البريد الإلكتروني أو رقم الهاتف
                        </label>

                        <input type="text" class="input-field" id="loginIdentifier"
                            placeholder="example@domain.com أو 01012345678" dir="ltr" autocomplete="username">

                        <span class="validation-msg" id="loginIdentifierMsg"></span>
                    </div>

                    <div class="mb-4">
                        <label class="text-sm text-[var(--color-muted)] block mb-1 font-medium" for="loginPassword">
                            كلمة المرور
                        </label>

                        <div class="relative">
                            <input type="password" class="input-field" id="loginPassword" placeholder="أدخل كلمة المرور"
                                style="padding-left:44px;" autocomplete="current-password">

                            <button type="button" id="toggleLoginPassBtn"
                                class="absolute left-2 top-1/2 -translate-y-1/2 bg-transparent border-none text-[var(--color-muted)] cursor-pointer p-2 rounded-lg hover:text-[var(--color-primary)] transition-colors"
                                title="إظهار كلمة المرور">
                                <i class="las la-eye"></i>
                            </button>
                        </div>

                        <span class="validation-msg" id="loginPassMsg"></span>
                    </div>

                    <button type="submit" class="btn-primary w-full justify-center mt-2" id="loginSubmitBtn">
                        <i class="las la-sign-in-alt"></i>
                        تسجيل الدخول
                    </button>
                </form>


                <script>
                    (function () {
                        'use strict';

                        var LOGIN_URL = "<%= api %>" + '/api/auth/login';

                        var loginForm = document.getElementById('loginForm');
                        var loginIdentifier = document.getElementById('loginIdentifier');
                        var loginPassword = document.getElementById('loginPassword');
                        var loginSubmitBtn = document.getElementById('loginSubmitBtn');

                        var loginIdentifierMsg = document.getElementById('loginIdentifierMsg');
                        var loginPassMsg = document.getElementById('loginPassMsg');

                        function clearValidation() {
                            loginIdentifierMsg.textContent = '';
                            loginIdentifierMsg.className = 'validation-msg';

                            loginPassMsg.textContent = '';
                            loginPassMsg.className = 'validation-msg';

                            loginIdentifier.classList.remove('error');
                            loginPassword.classList.remove('error');
                        }

                        function isValidEmail(value) {
                            return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
                        }

                        function isValidPhone(value) {
                            return /^\+?[0-9]{9,15}$/.test(value);
                        }

                        function validateForm() {
                            clearValidation();

                            var valid = true;
                            var identifierValue = loginIdentifier.value.trim();
                            var passwordValue = loginPassword.value;

                            if (!identifierValue) {
                                loginIdentifierMsg.textContent = 'البريد الإلكتروني أو رقم الهاتف مطلوب';
                                loginIdentifierMsg.className = 'validation-msg error';
                                loginIdentifier.classList.add('error');
                                valid = false;
                            } else if (!isValidEmail(identifierValue) && !isValidPhone(identifierValue)) {
                                loginIdentifierMsg.textContent = 'أدخل بريدًا إلكترونيًا أو رقم هاتف صالحًا';
                                loginIdentifierMsg.className = 'validation-msg error';
                                loginIdentifier.classList.add('error');
                                valid = false;
                            }

                            if (!passwordValue) {
                                loginPassMsg.textContent = 'كلمة المرور مطلوبة';
                                loginPassMsg.className = 'validation-msg error';
                                loginPassword.classList.add('error');
                                valid = false;
                            }

                            return valid;
                        }

                        function setLoadingState(isLoading) {
                            loginSubmitBtn.disabled = isLoading;

                            if (isLoading) {
                                loginSubmitBtn.innerHTML =
                                    '<i class="las la-spinner la-spin"></i> جاري تسجيل الدخول...';
                            } else {
                                loginSubmitBtn.innerHTML =
                                    '<i class="las la-sign-in-alt"></i> تسجيل الدخول';
                            }
                        }

                        function showError(title, message) {
                            Swal.fire({
                                icon: 'error',
                                title: title,
                                text: message,
                                confirmButtonText: 'موافق',
                                showConfirmButton: true,
                                allowOutsideClick: false
                            });
                        }

                        loginForm.addEventListener('submit', function (event) {
                            event.preventDefault();

                            if (!validateForm()) {
                                return;
                            }

                            setLoadingState(true);

                            var identifierValue = loginIdentifier.value.trim();
                            if (identifierValue.indexOf('@') !== -1) {
                                identifierValue = identifierValue.toLowerCase();
                            }

                            fetch(LOGIN_URL, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({
                                    identifier: identifierValue,
                                    password: loginPassword.value
                                })
                            })
                                .then(function (response) {
                                    return response.json()
                                        .then(function (data) {
                                            return {
                                                ok: response.ok,
                                                status: response.status,
                                                data: data
                                            };
                                        })
                                        .catch(function () {
                                            return {
                                                ok: response.ok,
                                                status: response.status,
                                                data: null
                                            };
                                        });
                                })
                                .then(function (result) {
                                    setLoadingState(false);

                                    if (
                                        result.ok &&
                                        result.data &&
                                        result.data.success &&
                                        result.data.user
                                    ) {
                                        var user = result.data.user;

                                        if (result.data.token) {
                                            document.cookie =
                                                'token=' +
                                                encodeURIComponent(result.data.token) +
                                                '; path=/; max-age=604800; SameSite=Lax';
                                        }

                                        localStorage.setItem(
                                            'userProfileData',
                                            JSON.stringify({
                                                id: user.id || '',
                                                fullName: user.name || user.fullName || '',
                                                email: user.email || '',
                                                phoneNumber: user.phone_number || '',
                                                role: user.account_type || user.role || '',
                                                accountStatus: user.account_status || '',
                                                avatar: user.profile_picture || ''
                                            })
                                        );

                                        localStorage.setItem('isLoggedIn', 'true');

                                        Swal.fire({
                                            icon: 'success',
                                            title: 'تم تسجيل الدخول بنجاح',
                                            text: 'تم تسجيل الدخول إلى حسابك بنجاح.',
                                            confirmButtonText: 'موافق',
                                            showConfirmButton: true,
                                            allowOutsideClick: false
                                        }).then(function (swalResult) {
                                            if (swalResult.isConfirmed) {
                                                window.location.href = '/outgoing';
                                            }
                                        });

                                        return;
                                    }

                                    var message =
                                        result.data && result.data.message
                                            ? result.data.message
                                            : 'فشل تسجيل الدخول، تحقق من بياناتك.';

                                    showError('فشل تسجيل الدخول', message);
                                })
                                .catch(function (error) {
                                    setLoadingState(false);

                                    showError(
                                        'فشل الاتصال',
                                        'تعذر الاتصال بالخادم: ' + error.message
                                    );
                                });
                        });
                    })();
                </script>
                <script>
                    (function () {
                        var loginPassword = document.getElementById('loginPassword');
                        var toggleLoginPassBtn = document.getElementById('toggleLoginPassBtn');

                        toggleLoginPassBtn.addEventListener('click', function () {
                            var isPassword = loginPassword.type === 'password';

                            loginPassword.type = isPassword ? 'text' : 'password';

                            var icon = toggleLoginPassBtn.querySelector('i');

                            icon.classList.toggle('la-eye', !isPassword);
                            icon.classList.toggle('la-eye-slash', isPassword);

                            toggleLoginPassBtn.title = isPassword
                                ? 'إخفاء كلمة المرور'
                                : 'إظهار كلمة المرور';
                        });
                    })();
                </script>


                <div class="text-center mt-6 pt-4 border-t border-[var(--border-color)]">
                    <span class="text-[9px] uppercase tracking-[0.15em] text-[var(--color-muted)] opacity-70">Developed
                        by</span>
                    <div>
                        <a href="https://www.facebook.com/Abdelrahman.Elshamhuot" target="_blank" rel="noopener noreferrer"
                            class="text-[11px] font-medium text-[var(--color-muted)] hover:underline">Abdelrahman
                            Mohamed</a>
                    </div>
                    <div class="mt-1 text-[9px] text-[var(--color-muted)] opacity-50">v3.2</div>
                </div>
            </div>
        </div>
    </main>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        (function () {
            var themeToggles = document.querySelectorAll('.theme-toggle');
            var body = document.body;
            var savedTheme = localStorage.getItem('theme') || 'dark';

            function applyTheme(theme) {
                var isDark = theme === 'dark';

                body.classList.toggle('light', !isDark);

                themeToggles.forEach(function (toggle) {
                    toggle.classList.toggle('dark', isDark);
                });

                localStorage.setItem('theme', theme);
            }

            applyTheme(savedTheme);

            themeToggles.forEach(function (toggle) {
                toggle.addEventListener('click', function () {
                    var isDark = !body.classList.contains('light');
                    applyTheme(isDark ? 'light' : 'dark');
                });
            });
        })();
    </script>


</body>
</html>
