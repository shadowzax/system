<!DOCTYPE html>
<html lang="ar" dir="rtl" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <meta name="theme-color" content="#0d99ff">
    <title>الرواتب اليومية</title>
    <meta name="description" content="نظام إدارة الرواتب باليومية">
    <link rel="icon" type="image/png" href="/favicon.ico">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/line-awesome/1.3.0/line-awesome/css/line-awesome.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/salary.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#0d99ff',
                        secondary: '#7c3aed',
                        accent: '#06b6d4',
                        error: '#ef4444',
                        success: '#10b981',
                        warning: '#f59e0b',
                    }
                }
            }
        }
    </script>
</head>
<body>
    <script>
        window.__APP_DATA__ = {
            token: "<%- token %>",
            api: "<%- api %>",
            isAuthenticated: <%- isAuthenticated ? 'true' : 'false' %>,
            user: <%- JSON.stringify(user || null) %>
        };
    </script>
    <%- include('../../../sections/header-neama.ejs') %>
            <div class="container mx-auto px-4 py-6 max-w-7xl">
                <div class="title-cell">
                    <div class="title-icon"><i class="las la-money-bill-wave"></i></div>
                    <h1>الرواتب اليومية</h1>
                    <p>إدارة الرواتب اليومية للموظفين</p>
                </div>
                <div id="filesView">
                    <div class="info-card">
                        <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
                            <h3 class="text-lg font-bold text-[var(--color-white)] flex items-center gap-2"><i class="las la-folder-open text-primary"></i> الملفات</h3>
                        </div>
                        <div class="mb-4">
                            <div class="relative">
                                <i class="las la-search absolute left-4 top-1/2 transform -translate-y-1/2 text-[var(--color-muted)] text-lg"></i>
                                <input type="text" id="fileSearchInput" class="input-field pr-10" placeholder="ابحث عن ملف...">
                            </div>
                        </div>
                        <div class="space-y-3" id="filesList"></div>
                    </div>
                </div>
                <div id="employeesView" style="display:none;">
                    <div class="info-card">
                        <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
                            <div class="flex items-center gap-3">
                                <button class="btn-outline btn-sm" id="backToFilesBtn"><i class="las la-arrow-right"></i> رجوع</button>
                                <h3 class="text-lg font-bold text-[var(--color-white)] flex items-center gap-2" id="currentFileName"></h3>
                            </div>
                            <div class="flex flex-wrap gap-2">
                                <button class="btn-outline btn-sm" id="printFileBtn"><i class="las la-print"></i> طباعة الملف</button>
                            </div>
                        </div>
                        <div class="flex flex-wrap items-center gap-3 mb-4 p-3 bg-[var(--darker-bg)] rounded-xl">
                            <span class="text-sm text-[var(--color-muted)]">الشهر:</span>
                            <input type="month" id="employeeMonthFilter" class="input-field text-sm py-2 px-3" style="width:auto;min-width:160px;">
                        </div>
                        <div class="mb-4">
                            <div class="relative">
                                <i class="las la-search absolute left-4 top-1/2 transform -translate-y-1/2 text-[var(--color-muted)] text-lg"></i>
                                <input type="text" id="employeeSearchInput" class="input-field pr-10" placeholder="ابحث عن موظف...">
                            </div>
                        </div>
                        <div class="shared-table-wrapper" id="sharedTableWrapper">
                            <table class="shared-table" id="sharedTable">
                                <thead id="sharedTableHead"></thead>
                                <tbody id="sharedTableBody"></tbody>
                                <tfoot id="sharedTableFoot"></tfoot>
                            </table>
                        </div>
                        <div class="text-center text-xs text-[var(--color-muted)] mt-3" id="tableHint">يمكنك تعديل المضاعفات مباشرة في الجدول أعلاه، وسيتم الحفظ تلقائياً عند الانتقال من الخلية أو بالضغط على Enter.</div>
                    </div>
                </div>
            </div>
        </main>
    </div>
    <div id="printArea" style="display:none;"></div>
    <div class="bottom-mobile-nav" id="bottomMobileNav">
        <div class="nav-notch" id="navNotch"></div>
        <a href="#" class="bottom-nav-item" data-tab="home"><i class="las la-home"></i><span>الرئيسية</span></a>
        <a href="#" class="bottom-nav-item" data-tab="files"><i class="las la-folder"></i><span>الملفات</span></a>
        <a href="#" class="bottom-nav-item active" data-tab="daily-salary"><i class="las la-money-bill-wave"></i><span>الرواتب</span></a>
        <a href="#" class="bottom-nav-item" data-tab="reports"><i class="las la-file-alt"></i><span>التقارير</span></a>
        <a href="#" class="bottom-nav-item" data-tab="settings"><i class="las la-cog"></i><span>الإعدادات</span></a>
    </div>
    <div class="modal-overlay" id="successModal">
        <div class="modal-content text-center">
            <button class="modal-close" id="closeSuccessModal"><i class="las la-times"></i></button>
            <i class="las la-check-circle text-5xl text-primary mb-4"></i>
            <h3 class="text-xl font-bold mb-2 text-[var(--color-white)]">تم بنجاح</h3>
            <p id="successMessage" class="text-[var(--color-muted)]"></p>
            <button id="okSuccessBtn" class="btn-primary mt-6 w-full justify-center">حسناً</button>
        </div>
    </div>
    <div class="modal-overlay" id="confirmModal">
        <div class="modal-content text-center">
            <button class="modal-close" id="closeConfirmModal"><i class="las la-times"></i></button>
            <i class="las la-question-circle text-5xl text-warning mb-4"></i>
            <h3 class="text-xl font-bold mb-2 text-[var(--color-white)]">تأكيد</h3>
            <p id="confirmMessage" class="text-[var(--color-muted)]"></p>
            <div class="flex gap-3 mt-5 justify-center">
                <button class="btn-primary btn-sm" id="confirmYesBtn" style="background:#ef4444;">نعم</button>
                <button class="btn-outline btn-sm" id="confirmNoBtn">لا</button>
            </div>
        </div>
    </div>
    <div id="toast" class="toast"></div>

    <script>
        window.__SERVER_DATA__ = <%- JSON.stringify(adminFiles) %>;
    </script>
    <script>
        (function() {
            const arabicToEnglishMap = { '٠': '0', '١': '1', '٢': '2', '٣': '3', '٤': '4', '٥': '5', '٦': '6', '٧': '7', '٨': '8', '٩': '9' };

            function convertArabicNumerals(str) { return String(str).replace(/[٠-٩]/g, m => arabicToEnglishMap[m] || m); }

            function parseNumber(val) { const converted = convertArabicNumerals(String(val)); const cleaned = converted.replace(/,/g, '').trim(); const num = parseFloat(cleaned); return isNaN(num) ? 0 : num; }

            function formatNumber(num) { if (num === 0 || num === -0) return '0'; const abs = Math.abs(num); const formatted = abs.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 }); return num < 0 ? '-' + formatted : formatted; }

            function generateId() { return 'id_' + Date.now() + '_' + Math.random().toString(36).substr(2, 8); }

            function getCurrentMonthKey() { const now = new Date(); return now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0'); }

            function getDaysInMonth(monthKey) { const parts = monthKey.split('-'); const year = parseInt(parts[0]); const month = parseInt(parts[1]); return new Date(year, month, 0).getDate(); }

            function formatMonthDisplay(monthKey) { const parts = monthKey.split('-'); const year = parseInt(parts[0]); const month = parseInt(parts[1]); const monthNames = ['يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو', 'يوليو', 'أغسطس', 'سبتمبر', 'أكتوبر', 'نوفمبر', 'ديسمبر']; return monthNames[month - 1] + ' ' + year; }

            function monthKeyToInput(monthKey) { return monthKey; }

            function inputToMonthKey(inputVal) { return inputVal; }

            const STORAGE_KEY = 'dailySalaryAppData_v3';
            const API_BASE = '<%= api %>' + '/api/admin';
            const RESTAURANT_ID = "2";

            const isAdmin = window.__APP_DATA__.user && window.__APP_DATA__.user.account_type === 'admin';

            function getToken() {
                if (window.__APP_DATA__ && window.__APP_DATA__.token) {
                    return window.__APP_DATA__.token;
                }
                return localStorage.getItem('token') || localStorage.getItem('authToken') || '';
            }

            function loadAppData() { try { const stored = localStorage.getItem(STORAGE_KEY); if (stored) return JSON.parse(stored); } catch (e) {} return { files: [] }; }

            function saveAppData(data) { try { localStorage.setItem(STORAGE_KEY, JSON.stringify(data)); } catch (e) {} }

            let appData = loadAppData();
            let currentFileId = null;
            let confirmCallback = null;

            const sidebar = document.getElementById('dashboardSidebar');
            const headerAvatar = document.getElementById('headerAvatar');

            function openSidebar() { sidebar.classList.add('mobile-open'); sidebar.classList.remove('mobile-closed'); }

            function closeSidebar() { sidebar.classList.remove('mobile-open'); sidebar.classList.add('mobile-closed'); }
            if (window.innerWidth < 1025) sidebar.classList.add('mobile-closed');
            window.addEventListener('resize', function() { if (window.innerWidth >= 1025) { sidebar.classList.remove('mobile-open', 'mobile-closed'); } else { if (!sidebar.classList.contains('mobile-open')) sidebar.classList.add('mobile-closed'); } });
            if (headerAvatar) { headerAvatar.addEventListener('click', function(e) { e.stopPropagation(); if (window.innerWidth < 1025) { if (sidebar.classList.contains('mobile-open')) closeSidebar(); else openSidebar(); } }); }
            document.addEventListener('click', function(e) { if (window.innerWidth < 1025 && sidebar.classList.contains('mobile-open')) { if (!sidebar.contains(e.target) && e.target !== headerAvatar && !headerAvatar.contains(e.target)) { closeSidebar(); } } });
            const sidebarItems = document.querySelectorAll('.sidebar-item');
            sidebarItems.forEach(item => { item.addEventListener('click', function() { if (this.id === 'logoutBtn') return; sidebarItems.forEach(i => i.classList.remove('active')); this.classList.add('active'); if (window.innerWidth < 1025) closeSidebar(); }); });
            const logoutBtn = document.getElementById('logoutBtn');
            if (logoutBtn) { logoutBtn.addEventListener('click', (e) => { e.preventDefault(); if (confirm('هل أنت متأكد من تسجيل الخروج؟')) window.location.href = '/'; }); }
            const bottomNavItems = document.querySelectorAll('.bottom-nav-item');
            const navNotch = document.getElementById('navNotch');

            function moveNotch(activeItem) { if (!navNotch || !activeItem) return; const rect = activeItem.getBoundingClientRect(); const navRect = document.getElementById('bottomMobileNav').getBoundingClientRect(); const centerX = rect.left + rect.width / 2 - navRect.left; navNotch.style.left = centerX + 'px'; }
            bottomNavItems.forEach(item => { item.addEventListener('click', function(e) { e.preventDefault(); bottomNavItems.forEach(i => i.classList.remove('active')); this.classList.add('active'); moveNotch(this); }); });
            const initialActive = document.querySelector('.bottom-nav-item.active');
            if (initialActive) moveNotch(initialActive);
            window.addEventListener('resize', () => { const activeItem = document.querySelector('.bottom-nav-item.active'); if (activeItem) moveNotch(activeItem); });

            const successModal = document.getElementById('successModal');
            const successMessageEl = document.getElementById('successMessage');

            function showSuccess(msg) { successMessageEl.textContent = msg; successModal.classList.add('active'); }

            function hideSuccess() { successModal.classList.remove('active'); }
            document.getElementById('closeSuccessModal').addEventListener('click', hideSuccess);
            document.getElementById('okSuccessBtn').addEventListener('click', hideSuccess);
            window.addEventListener('click', (e) => { if (e.target === successModal) hideSuccess(); });

            const confirmModal = document.getElementById('confirmModal');
            const confirmMessageEl = document.getElementById('confirmMessage');

            function showConfirm(msg, callback) { confirmMessageEl.textContent = msg; confirmCallback = callback; confirmModal.classList.add('active'); }

            function hideConfirm() { confirmModal.classList.remove('active'); confirmCallback = null; }
            document.getElementById('closeConfirmModal').addEventListener('click', hideConfirm);
            document.getElementById('confirmNoBtn').addEventListener('click', hideConfirm);
            document.getElementById('confirmYesBtn').addEventListener('click', function() { if (confirmCallback) { confirmCallback(); confirmCallback = null; } hideConfirm(); });
            window.addEventListener('click', (e) => { if (e.target === confirmModal) hideConfirm(); });

            const toastEl = document.getElementById('toast');
            let toastTimeout;

            function showToast(message, type = 'success') {
                if (!toastEl) return;
                toastEl.textContent = message;
                toastEl.className = 'toast ' + type + ' show';
                clearTimeout(toastTimeout);
                toastTimeout = setTimeout(() => {
                    toastEl.classList.remove('show');
                }, 2000);
            }

            function convertLegacySalaryEmployee(employee, fileCreatedAt) {
                if (!employee) return;
                if (!Array.isArray(employee.salaryRecords) || employee.salaryRecords.length === 0) return;
                if (!employee.monthlyData) employee.monthlyData = {};
                employee.salaryRecords.forEach(rec => {
                    if (rec.days && typeof rec.days === 'object') {
                        let monthKey;
                        if (rec.month) {
                            monthKey = rec.month;
                        } else if (fileCreatedAt) {
                            const d = new Date(fileCreatedAt);
                            if (!isNaN(d.getTime())) {
                                monthKey = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
                            }
                        } else {
                            monthKey = getCurrentMonthKey();
                        }
                        if (!employee.monthlyData[monthKey]) {
                            employee.monthlyData[monthKey] = { days: {} };
                        }
                        for (const day in rec.days) {
                            const val = rec.days[day];
                            if (val !== undefined && val !== null && val !== '') {
                                employee.monthlyData[monthKey].days[day] = String(val);
                            }
                        }
                    }
                });
                delete employee.salaryRecords;
            }

            async function sendSalaryToServer(fileId, employeeId, day, amount) {
                try {
                    const token = getToken();
                    const headers = { 'Content-Type': 'application/json' };
                    if (token) headers['Authorization'] = 'Bearer ' + token;
                    const response = await fetch(`${API_BASE}/files/salary`, {
                        method: 'POST',
                        headers,
                        body: JSON.stringify({
                            token: token,
                            fileId: fileId,
                            employeeId: employeeId,
                            day: day,
                            amount: amount,
                            restaurant_id: RESTAURANT_ID
                        })
                    });
                    const data = await response.json();
                    if (!response.ok || !data.success) {
                        throw new Error(data.message || 'فشل الحفظ');
                    }
                    return data;
                } catch (error) {
                    throw error;
                }
            }

            function getEmployeeDayData(fileId, employeeId, monthKey) { const file = appData.files.find(f => f.id === fileId); if (!file) return {}; const emp = file.employees.find(e => e.id === employeeId); if (!emp) return {}; if (!emp.monthlyData) emp.monthlyData = {}; if (!emp.monthlyData[monthKey]) emp.monthlyData[monthKey] = { days: {} }; return emp.monthlyData[monthKey]; }

            function getEmployeeTotalDays(fileId, employeeId, monthKey) { const dayData = getEmployeeDayData(fileId, employeeId, monthKey); let totalDays = 0; if (dayData.days) { for (const day in dayData.days) { totalDays += parseNumber(dayData.days[day] || 0); } } return totalDays; }

            function getEmployeeAttendanceDays(fileId, employeeId, monthKey) { const dayData = getEmployeeDayData(fileId, employeeId, monthKey); let count = 0; if (dayData.days) { for (const day in dayData.days) { if (parseNumber(dayData.days[day] || 0) !== 0) count++; } } return count; }

            function getEmployeeAbsenceDays(fileId, employeeId, monthKey) { const daysInMonth = getDaysInMonth(monthKey); const attendance = getEmployeeAttendanceDays(fileId, employeeId, monthKey); return daysInMonth - attendance; }

            function getEmployeeTotalLoans(employee) {
                let total = 0;
                if (employee.advances && Array.isArray(employee.advances)) {
                    employee.advances.forEach(adv => {
                        if (adv.days && typeof adv.days === 'object') {
                            for (const day in adv.days) {
                                total += parseNumber(adv.days[day] || 0);
                            }
                        }
                    });
                }
                return total;
            }

            const filesView = document.getElementById('filesView');
            const employeesView = document.getElementById('employeesView');
            const filesList = document.getElementById('filesList');
            const currentFileName = document.getElementById('currentFileName');
            const employeeMonthFilter = document.getElementById('employeeMonthFilter');
            const sharedTableHead = document.getElementById('sharedTableHead');
            const sharedTableBody = document.getElementById('sharedTableBody');
            const sharedTableFoot = document.getElementById('sharedTableFoot');
            const fileSearchInput = document.getElementById('fileSearchInput');
            const employeeSearchInput = document.getElementById('employeeSearchInput');

            function renderFilesList() {
                const query = fileSearchInput ? fileSearchInput.value.toLowerCase().trim() : '';
                filesList.innerHTML = '';
                const filteredFiles = appData.files.filter(file => file.restaurant_id === RESTAURANT_ID && file.name && file.name.toLowerCase().includes(query));
                if (filteredFiles.length === 0) {
                    filesList.innerHTML = '<div class="text-center py-8 text-[var(--color-muted)]"><i class="las la-folder-open text-5xl block mb-3 opacity-30"></i><p>لا توجد ملفات</p><p class="text-xs mt-1">لا يمكن إنشاء ملفات جديدة</p></div>';
                    return;
                }
                filteredFiles.forEach(file => {
                    const employeeCount = file.employees ? file.employees.length : 0;
                    const div = document.createElement('div');
                    div.className = 'file-card';
                    div.innerHTML = `<div class="file-icon"><i class="las la-folder"></i></div><div class="flex-1 min-w-0"><p class="font-bold text-[var(--color-white)] text-base">${file.name || 'ملف بدون اسم'}</p><p class="text-xs text-[var(--color-muted)]">${employeeCount} موظف · أنشئ ${new Date(file.createdAt).toLocaleDateString('ar-EG')}</p></div><div class="flex gap-2 flex-shrink-0"><button class="btn-outline btn-xs open-file-btn" data-id="${file.id}" title="فتح الملف"><i class="las la-folder-open"></i> فتح</button></div>`;
                    filesList.appendChild(div);
                });
                document.querySelectorAll('.open-file-btn').forEach(btn => { btn.addEventListener('click', function() { openFile(this.getAttribute('data-id')); }); });
            }
            if (fileSearchInput) {
                fileSearchInput.addEventListener('input', renderFilesList);
            }

            function openFile(fileId) {
                currentFileId = fileId;
                const file = appData.files.find(f => f.id === fileId);
                if (!file) return;
                if (!file.employees) file.employees = [];
                currentFileName.textContent = '📁 ' + (file.name || 'ملف');
                filesView.style.display = 'none';
                employeesView.style.display = 'block';
                employeeMonthFilter.value = monthKeyToInput(getCurrentMonthKey());
                if (employeeSearchInput) employeeSearchInput.value = '';
                renderSharedTable();
            }

            function closeFile() {
                currentFileId = null;
                filesView.style.display = 'block';
                employeesView.style.display = 'none';
                renderFilesList();
            }

            function collectAllDaysFromTable() {
                const monthKey = inputToMonthKey(employeeMonthFilter.value) || getCurrentMonthKey();
                const file = appData.files.find(f => f.id === currentFileId);
                if (!file || !file.employees) return;
                const daysInMonth = getDaysInMonth(monthKey);
                file.employees.forEach(emp => {
                    if (!emp.monthlyData) emp.monthlyData = {};
                    if (!emp.monthlyData[monthKey]) emp.monthlyData[monthKey] = { days: {} };
                    emp.monthlyData[monthKey].days = {};
                    for (let d = 1; d <= daysInMonth; d++) {
                        const input = document.getElementById('day-input-' + emp.id + '-' + d);
                        if (input) {
                            const val = convertArabicNumerals(input.value).replace(/,/g, '').trim();
                            if (val !== '' && !isNaN(parseFloat(val)) && parseFloat(val) !== 0) {
                                emp.monthlyData[monthKey].days[d] = val;
                            }
                        }
                    }
                });
            }

            async function saveSalaryForInput(input) {
                const fileId = currentFileId;
                const employeeId = input.getAttribute('data-eid');
                const day = parseInt(input.getAttribute('data-day'));
                const rawVal = convertArabicNumerals(input.value).replace(/,/g, '').trim();
                const amount = rawVal === '' ? 0 : parseFloat(rawVal);
                if (isNaN(amount)) {
                    showToast('قيمة غير صحيحة', 'error');
                    return;
                }

                try {
                    await sendSalaryToServer(fileId, employeeId, day, amount);

                    const monthKey = inputToMonthKey(employeeMonthFilter.value) || getCurrentMonthKey();
                    const file = appData.files.find(f => f.id === fileId);
                    const emp = file.employees.find(e => e.id === employeeId);
                    if (emp) {
                        if (!emp.monthlyData) emp.monthlyData = {};
                        if (!emp.monthlyData[monthKey]) emp.monthlyData[monthKey] = { days: {} };
                        if (amount === 0) {
                            delete emp.monthlyData[monthKey].days[day];
                        } else {
                            emp.monthlyData[monthKey].days[day] = String(amount);
                        }
                    }
                    saveAppData(appData);
                    updateRowSummary(employeeId);
                    updateTableFootSummary();
                    showToast(amount === 0 ? 'تم حذف القيمة' : 'تم حفظ القيمة');
                } catch (error) {
                    showToast('خطأ: ' + error.message, 'error');
                    input.value = input.defaultValue || '';
                }
            }

            function renderSharedTable() {
                const monthKey = inputToMonthKey(employeeMonthFilter.value) || getCurrentMonthKey();
                const file = appData.files.find(f => f.id === currentFileId);
                const daysInMonth = getDaysInMonth(monthKey);
                sharedTableHead.innerHTML = '';
                sharedTableBody.innerHTML = '';
                sharedTableFoot.innerHTML = '';
                if (!file || !file.employees || file.employees.length === 0) {
                    sharedTableBody.innerHTML = '<tr><td colspan="' + (daysInMonth + 5) + '" class="text-center py-8 text-[var(--color-muted)]"><i class="las la-users text-4xl block mb-2 opacity-30"></i>لا يوجد موظفين في هذا الملف</td></tr>';
                    return;
                }
                let headRow = '<tr><th class="emp-header">الموظف</th>';
                for (let d = 1; d <= daysInMonth; d++) {
                    headRow += '<th class="day-num-header">' + d + '</th>';
                }
                headRow += '<th class="emp-header">إجمالي الأيام</th><th class="emp-header">راتب الأيام</th><th class="emp-header">إجمالي السلف</th><th class="emp-header">اليومية</th><th class="emp-header">صافي الراتب</th></tr>';
                sharedTableHead.innerHTML = headRow;
                file.employees.forEach(emp => {
                    const monthlySalary = parseNumber(emp.monthlySalary || 0);
                    const dayRate = monthlySalary / 30;
                    const dayData = getEmployeeDayData(currentFileId, emp.id, monthKey);
                    if (!dayData.days) dayData.days = {};
                    let totalDays = 0;
                    let row = '<tr>';
                    row += '<td class="emp-cell"><div class="emp-name-display">' + (emp.name || 'بدون اسم') + '</div><div class="emp-code-display">كود: ' + (emp.code || '---') + ' · ' + (emp.profession || '---') + '</div></td>';
                    for (let d = 1; d <= daysInMonth; d++) {
                        const multiplierVal = dayData.days[d] !== undefined ? dayData.days[d] : '';
                        const numVal = parseNumber(multiplierVal);
                        const hasVal = multiplierVal !== '' && !isNaN(numVal);
                        const isZero = hasVal && numVal === 0;
                        let cls = '';
                        if (isZero) cls = ' has-value-zero';
                        else if (hasVal && numVal !== 0) cls = ' has-value';
                        if (hasVal && numVal !== 0) totalDays += numVal;
                        const disabledAttr = isAdmin ? '' : ' disabled';
                        row += '<td><input type="text" class="day-input' + cls + '" id="day-input-' + emp.id + '-' + d + '" data-day="' + d + '" data-eid="' + emp.id + '" value="' + multiplierVal + '" inputmode="decimal" placeholder="0"' + disabledAttr + '></td>';
                    }
                    const totalSalary = dayRate * totalDays;
                    const totalLoans = getEmployeeTotalLoans(emp);
                    const netSalary = totalSalary - totalLoans;
                    row += '<td class="emp-cell" style="color:var(--color-primary);font-weight:700;">' + formatNumber(totalDays) + '</td>';
                    row += '<td class="emp-cell" style="color:#10b981;font-weight:700;">' + formatNumber(totalSalary) + '</td>';
                    row += '<td class="emp-cell" style="color:#ef4444;font-weight:700;">' + formatNumber(totalLoans) + '</td>';
                    row += '<td class="emp-cell" style="color:var(--color-muted);font-weight:600;">' + formatNumber(dayRate) + '</td>';
                    row += '<td class="emp-cell" style="color:#10b981;font-weight:800;">' + formatNumber(netSalary) + '</td>';
                    row += '</tr>';
                    sharedTableBody.innerHTML += row;
                });
                let footRow = '<tr><td class="summary-label-cell" style="font-weight:700;">إجمالي اليومي</td>';
                for (let d = 1; d <= daysInMonth; d++) {
                    footRow += '<td class="summary-value-cell">-</td>';
                }
                footRow += '<td class="summary-label-cell"></td><td class="summary-label-cell"></td><td class="summary-label-cell"></td><td class="summary-label-cell"></td><td class="summary-label-cell"></td></tr>';
                sharedTableFoot.innerHTML = footRow;
                bindTableInputEvents();
                updateTableFootSummary();
                applyEmployeeFilter();
            }

            function applyEmployeeFilter() {
                const query = employeeSearchInput ? employeeSearchInput.value.toLowerCase().trim() : '';
                const rows = sharedTableBody.querySelectorAll('tr');
                rows.forEach(row => {
                    const empName = row.querySelector('.emp-name-display')?.textContent || '';
                    const empCode = row.querySelector('.emp-code-display')?.textContent || '';
                    const searchText = (empName + ' ' + empCode).toLowerCase();
                    if (searchText.includes(query)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }
            if (employeeSearchInput) {
                employeeSearchInput.addEventListener('input', applyEmployeeFilter);
            }

            function updateTableFootSummary() {
                const monthKey = inputToMonthKey(employeeMonthFilter.value) || getCurrentMonthKey();
                const file = appData.files.find(f => f.id === currentFileId);
                if (!file || !file.employees) return;
                const daysInMonth = getDaysInMonth(monthKey);
                const footCells = sharedTableFoot.querySelectorAll('td');
                if (footCells.length < daysInMonth + 5) return;
                for (let d = 1; d <= daysInMonth; d++) {
                    let dayTotal = 0;
                    file.employees.forEach(emp => {
                        const input = document.getElementById('day-input-' + emp.id + '-' + d);
                        if (input) {
                            const val = parseNumber(input.value);
                            if (!isNaN(val)) dayTotal += val;
                        }
                    });
                    footCells[d].textContent = dayTotal > 0 ? formatNumber(dayTotal) : '-';
                    footCells[d].style.color = dayTotal > 0 ? 'var(--color-primary)' : 'var(--color-muted)';
                }
                const summaryLabelCell = footCells[0];
                if (summaryLabelCell) summaryLabelCell.textContent = 'إجمالي الأيام لكل يوم';
            }

            function updateRowSummary(empId) {
                const monthKey = inputToMonthKey(employeeMonthFilter.value) || getCurrentMonthKey();
                const file = appData.files.find(f => f.id === currentFileId);
                if (!file) return;
                const emp = file.employees.find(e => e.id === empId);
                if (!emp) return;
                const daysInMonth = getDaysInMonth(monthKey);
                const monthlySalary = parseNumber(emp.monthlySalary || 0);
                const dayRate = monthlySalary / 30;
                let totalDays = 0;
                for (let d = 1; d <= daysInMonth; d++) {
                    const input = document.getElementById('day-input-' + empId + '-' + d);
                    if (input) {
                        const val = parseNumber(input.value);
                        if (!isNaN(val) && val !== 0) totalDays += val;
                    }
                }
                const totalSalary = dayRate * totalDays;
                const totalLoans = getEmployeeTotalLoans(emp);
                const netSalary = totalSalary - totalLoans;
                const rows = sharedTableBody.querySelectorAll('tr');
                rows.forEach(row => {
                    const firstCell = row.querySelector('td.emp-cell');
                    if (firstCell) {
                        const rowEmpId = row.querySelector('.day-input')?.getAttribute('data-eid');
                        if (rowEmpId === empId) {
                            const cells = row.querySelectorAll('td.emp-cell');
                            if (cells.length >= 5) {
                                cells[1].textContent = formatNumber(totalDays);
                                cells[1].style.color = 'var(--color-primary)';
                                cells[2].textContent = formatNumber(totalSalary);
                                cells[2].style.color = '#10b981';
                                cells[3].textContent = formatNumber(totalLoans);
                                cells[3].style.color = '#ef4444';
                                cells[4].textContent = formatNumber(dayRate);
                                cells[4].style.color = 'var(--color-muted)';
                                cells[5].textContent = formatNumber(netSalary);
                                cells[5].style.color = '#10b981';
                            }
                        }
                    }
                });
            }

            function bindTableInputEvents() {
                if (!isAdmin) return;
                sharedTableBody.querySelectorAll('.day-input').forEach(input => {
                    input.addEventListener('input', function() {
                        const val = convertArabicNumerals(this.value).replace(/,/g, '');
                        const num = parseFloat(val);
                        this.classList.remove('has-value', 'has-value-zero');
                        if (val !== '' && !isNaN(num)) {
                            if (num === 0) {
                                this.classList.add('has-value-zero');
                            } else {
                                this.classList.add('has-value');
                            }
                        }
                        const empId = this.getAttribute('data-eid');
                        if (empId) updateRowSummary(empId);
                        updateTableFootSummary();
                    });
                    input.addEventListener('blur', function() {
                        let val = convertArabicNumerals(this.value).replace(/,/g, '');
                        const num = parseFloat(val);
                        if (!isNaN(num) && val !== '') {
                            this.value = formatNumber(num);
                            if (num === 0) {
                                this.classList.add('has-value-zero');
                                this.classList.remove('has-value');
                            } else {
                                this.classList.add('has-value');
                                this.classList.remove('has-value-zero');
                            }
                        } else {
                            this.value = '';
                            this.classList.remove('has-value', 'has-value-zero');
                        }
                        const empId = this.getAttribute('data-eid');
                        if (empId) updateRowSummary(empId);
                        updateTableFootSummary();
                        saveSalaryForInput(this);
                    });
                    input.addEventListener('keydown', function(e) {
                        const key = e.key;
                        if (key === 'Enter') {
                            e.preventDefault();
                            this.blur();
                            return;
                        }
                        const directionMap = {
                            'ArrowUp': 'up',
                            'ArrowDown': 'down',
                            'ArrowLeft': 'left',
                            'ArrowRight': 'right'
                        };
                        if (directionMap[key]) {
                            e.preventDefault();
                            const direction = directionMap[key];
                            const target = getAdjacentInput(this, direction);
                            if (target) {
                                target.focus();
                            } else {
                                this.blur();
                            }
                        }
                    });
                });
            }

            function getAdjacentInput(currentInput, direction) {
                const employeeId = currentInput.getAttribute('data-eid');
                const day = parseInt(currentInput.getAttribute('data-day'));
                const monthKey = inputToMonthKey(employeeMonthFilter.value) || getCurrentMonthKey();
                const daysInMonth = getDaysInMonth(monthKey);
                if (direction === 'left') {
                    if (day < daysInMonth) return document.getElementById('day-input-' + employeeId + '-' + (day + 1));
                } else if (direction === 'right') {
                    if (day > 1) return document.getElementById('day-input-' + employeeId + '-' + (day - 1));
                } else if (direction === 'up' || direction === 'down') {
                    const file = appData.files.find(f => f.id === currentFileId);
                    if (!file || !file.employees) return null;
                    const employees = file.employees;
                    const currentEmpIndex = employees.findIndex(e => e.id === employeeId);
                    let targetEmpIndex = direction === 'up' ? currentEmpIndex - 1 : currentEmpIndex + 1;
                    if (targetEmpIndex >= 0 && targetEmpIndex < employees.length) {
                        return document.getElementById('day-input-' + employees[targetEmpIndex].id + '-' + day);
                    }
                }
                return null;
            }

            function printAllFileEmployees() {
                collectAllDaysFromTable();
                saveAppData(appData);
                const file = appData.files.find(f => f.id === currentFileId);
                if (!file || !file.employees || file.employees.length === 0) {
                    showSuccess('لا يوجد موظفين في هذا الملف للطباعة.');
                    return;
                }
                const monthKey = inputToMonthKey(employeeMonthFilter.value) || getCurrentMonthKey();
                const daysInMonth = getDaysInMonth(monthKey);
                let html = '<div class="print-header"><h2>' + (file.name || 'كشف رواتب يومية') + '</h2><div class="sub">' + formatMonthDisplay(monthKey) + '</div></div>';
                html += '<table><thead><tr><th>الموظف</th><th>الراتب الشهري</th><th>اليومية</th><th>إجمالي الأيام</th><th>راتب الأيام</th><th>إجمالي السلف</th><th>صافي الراتب</th></tr></thead><tbody>';
                let counter = 1;
                file.employees.forEach(emp => {
                    const monthlySalary = parseNumber(emp.monthlySalary || 0);
                    const dayRate = monthlySalary / 30;
                    const totalDays = getEmployeeTotalDays(currentFileId, emp.id, monthKey);
                    const totalSalary = dayRate * totalDays;
                    const totalLoans = getEmployeeTotalLoans(emp);
                    const netSalary = totalSalary - totalLoans;
                    html += '<tr><td>' + counter++ + ' - ' + (emp.name || '---') + ' (كود: ' + (emp.code || '---') + ')</td><td>' + formatNumber(monthlySalary) + '</td><td>' + formatNumber(dayRate) + '</td><td>' + formatNumber(totalDays) + '</td><td>' + formatNumber(totalSalary) + '</td><td>' + formatNumber(totalLoans) + '</td><td style="font-weight:bold;color:#059669;">' + formatNumber(netSalary) + '</td></tr>';
                });
                html += '</tbody></table>';
                html += '<div class="footer"><div class="dev">Developed by Abdelrahman Mohamed</div><div class="dev-version">v5.2</div></div>';
                const printArea = document.getElementById('printArea');
                printArea.innerHTML = html;
                printArea.style.display = 'block';
                setTimeout(() => {
                    window.print();
                    printArea.style.display = 'none';
                }, 300);
            }

            document.getElementById('backToFilesBtn').addEventListener('click', () => {
                collectAllDaysFromTable();
                saveAppData(appData);
                closeFile();
            });
            document.getElementById('employeeMonthFilter').addEventListener('change', function() {
                collectAllDaysFromTable();
                saveAppData(appData);
                renderSharedTable();
            });
            document.getElementById('printFileBtn').addEventListener('click', printAllFileEmployees);

            function loadInitialData() {
                const serverData = window.__SERVER_DATA__;
                if (serverData && serverData.files && Array.isArray(serverData.files)) {
                    appData.files = serverData.files.filter(file => file.restaurant_id === RESTAURANT_ID);
                } else if (serverData && Array.isArray(serverData)) {
                    appData.files = serverData.filter(file => file.restaurant_id === RESTAURANT_ID);
                }
                appData.files.forEach(file => {
                    if (file.employees && Array.isArray(file.employees)) {
                        file.employees.forEach(emp => {
                            convertLegacySalaryEmployee(emp, file.createdAt);
                        });
                    }
                });
                saveAppData(appData);
                renderFilesList();
            }

            document.addEventListener('DOMContentLoaded', function() {
                const themeToggles = document.querySelectorAll('.theme-toggle');
                const body = document.body;
                const applyTheme = (theme) => {
                    const isDark = theme === 'dark';
                    body.classList.toggle('light', !isDark);
                    themeToggles.forEach(toggle => toggle.classList.toggle('dark', isDark));
                    localStorage.setItem('theme', theme);
                };
                const savedTheme = localStorage.getItem('theme') || 'dark';
                applyTheme(savedTheme);
                themeToggles.forEach(toggle => {
                    toggle.addEventListener('click', () => {
                        const isDark = body.classList.contains('light') === false;
                        applyTheme(isDark ? 'light' : 'dark');
                    });
                });
                employeeMonthFilter.value = monthKeyToInput(getCurrentMonthKey());
                loadInitialData();
            });
        })();
    </script>
</body>
</html>
