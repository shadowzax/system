        let expandedMonthFolders = {};
        let expandedDayFolders = {};

        const arabicMonths = [
            'يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو',
            'يوليو', 'أغسطس', 'سبتمبر', 'أكتوبر', 'نوفمبر', 'ديسمبر'
        ];
        const arabicDays = ['الأحد', 'الاثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'];

        function normalizeArabicDigits(str) {
            if (!str) return str;
            const arabic = '٠١٢٣٤٥٦٧٨٩';
            const persian = '۰۱۲۳۴۵۶۷۸۹';
            return String(str)
                .replace(/[\u0660-\u0669]/g, d => String(arabic.indexOf(d)))
                .replace(/[\u06F0-\u06F9]/g, d => String(persian.indexOf(d)))
                .replace(/[\u200e\u200f]/g, '')
                .trim();
        }

        function getReportDateKey(report) {
            if (!report) return null;

            if (report.date) {
                const dateStr = normalizeArabicDigits(report.date);
                let m = dateStr.match(/(\d{4})[\/\-](\d{1,2})[\/\-](\d{1,2})/);
                if (m) {
                    return `${m[1]}-${m[2].padStart(2, '0')}-${m[3].padStart(2, '0')}`;
                }
                m = dateStr.match(/(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})/);
                if (m) {
                    return `${m[3]}-${m[2].padStart(2, '0')}-${m[1].padStart(2, '0')}`;
                }
            }

            if (report.timestamp) {
                return String(report.timestamp).slice(0, 10);
            }
            return null;
        }

        function hideReportView() {
            reportViewCard.style.display = 'none';
            recentReportsCard.style.display = 'block';
            currentViewReportId = null;
        }

        function viewReportById(reportId) {
            const reports = Array.isArray(window.expensesReports) ? window.expensesReports : [];
            const report = reports.find(r => r.id === reportId);
            if (!report) {
                showSuccess('التقرير غير موجود.');
                return;
            }
            currentViewReportId = reportId;
            viewReportTitle2.textContent = report.name || 'تقرير';
            viewReportDate2.textContent = report.date || '';
            viewReportTbody2.innerHTML = '';
            if (report.rows && report.rows.length) {
                report.rows.forEach(row => {
                    const tr = document.createElement('tr');
                    const tdDesc = document.createElement('td');
                    tdDesc.textContent = row.desc || '';
                    const tdAmount = document.createElement('td');
                    tdAmount.textContent = row.amount || '0';
                    tr.appendChild(tdDesc);
                    tr.appendChild(tdAmount);
                    viewReportTbody2.appendChild(tr);
                });
            }
            viewReportTotal2.textContent = report.total || '0';

            if (report.created_by && report.created_by.name) {
                let creatorHtml = '';
                if (report.created_by.profile_picture) {
                    creatorHtml += `<img src="${report.created_by.profile_picture}" class="creator-avatar" alt="creator">`;
                }
                creatorHtml += `<span>بواسطة: ${report.created_by.name}</span>`;
                viewReportCreator.innerHTML = creatorHtml;
            } else {
                viewReportCreator.innerHTML = '';
            }

            reportViewCard.style.display = 'block';
            recentReportsCard.style.display = 'none';
        }

        function buildReportListItem(report) {
            const creatorName = report.created_by ? report.created_by.name : '';
            const creatorPic = report.created_by ? report.created_by.profile_picture : '';
            const dateSourceLine = `${report.date || ''}${report.sourceLabel ? ' • ' + report.sourceLabel : ''}${creatorName ? ' • بواسطة: ' + creatorName : ''}`.trim();
            let avatarHtml = '';
            if (creatorPic) {
                avatarHtml = `<img src="${creatorPic}" class="creator-avatar" alt="creator">`;
            }
            return `<div class="report-list-item">
                <div class="report-info">
                    <span class="text-primary"><i class="las la-file-alt text-xl"></i></span>
                    <div>
                        <p class="font-medium text-[var(--color-white)]">${report.name || 'تقرير'}</p>
                        <p class="text-xs text-[var(--color-muted)]">${dateSourceLine || ''}</p>
                        ${creatorPic ? `<div class="creator-info">${avatarHtml}<span>${creatorName}</span></div>` : ''}
                    </div>
                </div>
                <div class="report-actions">
                    <button class="btn-outline btn-xs view-report-btn" data-id="${report.id}" title="عرض التقرير">
                        <i class="las la-eye"></i> عرض
                    </button>
                </div>
            </div>`;
        }

        function attachReportListEvents() {
            document.querySelectorAll('.folder-header[data-toggle="month"]').forEach(header => {
                header.addEventListener('click', function (e) {
                    if (e.target.closest('.folder-toggle-btn') || e.target.closest('.view-report-btn')) return;
                    const monthKey = this.getAttribute('data-key');
                    toggleMonthFolder(monthKey);
                });
            });

            document.querySelectorAll('.folder-header[data-toggle="day"]').forEach(header => {
                header.addEventListener('click', function (e) {
                    if (e.target.closest('.folder-toggle-btn') || e.target.closest('.view-report-btn')) return;
                    const dayStateKey = this.getAttribute('data-key');
                    toggleDayFolder(dayStateKey);
                });
            });

            document.querySelectorAll('.month-toggle-btn').forEach(btn => {
                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    const monthKey = this.getAttribute('data-key');
                    toggleMonthFolder(monthKey);
                });
            });

            document.querySelectorAll('.day-toggle-btn').forEach(btn => {
                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    const dayStateKey = this.getAttribute('data-key');
                    toggleDayFolder(dayStateKey);
                });
            });

            document.querySelectorAll('.view-report-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const reportId = this.getAttribute('data-id');
                    viewReportById(reportId);
                });
            });
        }

        function loadRecentReports() {
            const reports = Array.isArray(window.expensesReports) ? window.expensesReports : [];
            const searchQuery = reportSearchInput.value.toLowerCase().trim();
            let filteredReports = reports;

            if (searchQuery) {
                filteredReports = filteredReports.filter(report => {
                    const nameMatch = (report.name || '').toLowerCase().includes(searchQuery);
                    const dateMatch = (report.date || '').toLowerCase().includes(searchQuery);
                    const sourceMatch = (report.sourceLabel || '').toLowerCase().includes(searchQuery);
                    const creatorMatch = (report.created_by && report.created_by.name ? report.created_by.name.toLowerCase().includes(searchQuery) : false);
                    return nameMatch || dateMatch || sourceMatch || creatorMatch;
                });
            }

            if (selectedDateFilter) {
                filteredReports = filteredReports.filter(report => getReportDateKey(report) === selectedDateFilter);
            }

            if (selectedDateFilter) {
                dateResultsContainer.style.display = 'block';
                renderDateResultsTable(filteredReports);
                recentReportsList.innerHTML = '';
                return;
            } else {
                dateResultsContainer.style.display = 'none';
                dateResultsTbody.innerHTML = '';
            }

            if (filteredReports.length === 0) {
                if (reportSearchInput.value.trim()) {
                    recentReportsList.innerHTML = '<div class="empty-state"><i class="las la-search"></i><p>لا توجد نتائج مطابقة لبحثك</p></div>';
                } else {
                    recentReportsList.innerHTML = '<div class="empty-state"><i class="las la-folder-open"></i><p>لا توجد تقارير محفوظة بعد</p></div>';
                }
                return;
            }

            const groupedByMonth = {};
            filteredReports.forEach(report => {
                const dateKey = getReportDateKey(report);
                let year = null,
                    month = null,
                    day = null;
                if (dateKey) {
                    const parts = dateKey.split('-');
                    if (parts.length === 3) {
                        year = parts[0];
                        month = parts[1];
                        day = parts[2];
                    }
                }
                const monthKey = (year && month) ? `${year}-${month}` : '__undated__';
                if (!groupedByMonth[monthKey]) {
                    groupedByMonth[monthKey] = {
                        days: {},
                        monthNum: month ? parseInt(month, 10) : null,
                        year: year
                    };
                }
                const dayKey = day || (dateKey ? '__noDay__' : '__undated__');
                if (!groupedByMonth[monthKey].days[dayKey]) groupedByMonth[monthKey].days[dayKey] = [];
                groupedByMonth[monthKey].days[dayKey].push(report);
            });

            let html = '';
            const monthKeys = Object.keys(groupedByMonth).sort((a, b) => {
                if (a === '__undated__') return 1;
                if (b === '__undated__') return -1;
                return b.localeCompare(a);
            });

            monthKeys.forEach(monthKey => {
                const monthData = groupedByMonth[monthKey];
                let monthTitle = monthKey;
                if (monthKey !== '__undated__' && monthData.monthNum) {
                    const monthName = arabicMonths[monthData.monthNum - 1] || '';
                    monthTitle = `${monthKey} - ${monthName}`;
                } else if (monthKey === '__undated__') {
                    monthTitle = 'غير مؤرخ';
                }
                const monthExpanded = expandedMonthFolders[monthKey] || false;
                html += `<div class="folder-item month-folder" data-month="${monthKey}">`;
                html += `<div class="folder-header" data-toggle="month" data-key="${monthKey}">`;
                html += `<div class="folder-title"><i class="las la-folder"></i><span>${monthTitle}</span></div>`;
                html += `<button class="btn-outline btn-xs folder-toggle-btn month-toggle-btn" data-toggle="month" data-key="${monthKey}">${monthExpanded ? 'إغلاق' : 'فتح'}</button>`;
                html += `</div>`;
                html += `<div class="folder-content${monthExpanded ? '' : ' hidden'}" data-month-content="${monthKey}">`;

                const dayKeys = Object.keys(monthData.days).sort((a, b) => {
                    if (a === '__undated__' || a === '__noDay__') return 1;
                    if (b === '__undated__' || b === '__noDay__') return -1;
                    return a.localeCompare(b);
                });

                dayKeys.forEach(dayKey => {
                    const dayStateKey = monthKey + '_' + dayKey;
                    const dayExpanded = expandedDayFolders[dayStateKey] || false;
                    const reportsForDay = monthData.days[dayKey];
                    reportsForDay.sort((a, b) => (b.timestamp || '').localeCompare(a.timestamp || ''));

                    if (dayKey === '__noDay__' || dayKey === '__undated__') {
                        reportsForDay.forEach(report => {
                            html += buildReportListItem(report);
                        });
                    } else {
                        let dayTitle = dayKey;
                        if (monthKey !== '__undated__') {
                            const year = monthData.year;
                            const monthNum = monthData.monthNum;
                            const dayNum = parseInt(dayKey, 10);
                            if (year && monthNum && !isNaN(dayNum)) {
                                const dateObj = new Date(year, monthNum - 1, dayNum);
                                const weekdayName = arabicDays[dateObj.getDay()];
                                dayTitle = `${dayKey} - ${weekdayName}`;
                            }
                        }
                        html += `<div class="folder-item day-folder" data-day="${dayKey}" data-month="${monthKey}">`;
                        html += `<div class="folder-header" data-toggle="day" data-key="${dayStateKey}">`;
                        html += `<div class="folder-title"><i class="las la-folder-open"></i><span>${dayTitle}</span></div>`;
                        html += `<button class="btn-outline btn-xs folder-toggle-btn day-toggle-btn" data-toggle="day" data-key="${dayStateKey}">${dayExpanded ? 'إغلاق' : 'فتح'}</button>`;
                        html += `</div>`;
                        html += `<div class="folder-content${dayExpanded ? '' : ' hidden'}" data-day-content="${dayStateKey}">`;
                        reportsForDay.forEach(report => {
                            html += buildReportListItem(report);
                        });
                        html += `</div></div>`;
                    }
                });
                html += `</div></div>`;
            });
            recentReportsList.innerHTML = html;

            attachReportListEvents();
        }

        function toggleMonthFolder(monthKey) {
            const content = document.querySelector(`[data-month-content="${monthKey}"]`);
            if (!content) return;
            const isHidden = content.classList.toggle('hidden');
            expandedMonthFolders[monthKey] = !isHidden;
            const btn = document.querySelector(`.month-toggle-btn[data-key="${monthKey}"]`);
            if (btn) {
                btn.textContent = isHidden ? 'فتح' : 'إغلاق';
            }
        }

        function toggleDayFolder(dayStateKey) {
            const content = document.querySelector(`[data-day-content="${dayStateKey}"]`);
            if (!content) return;
            const isHidden = content.classList.toggle('hidden');
            expandedDayFolders[dayStateKey] = !isHidden;
            const btn = document.querySelector(`.day-toggle-btn[data-key="${dayStateKey}"]`);
            if (btn) {
                btn.textContent = isHidden ? 'فتح' : 'إغلاق';
            }
        }

        function renderDateResultsTable(reports) {
            dateResultsContainer.style.display = 'block';
            dateResultsTbody.innerHTML = '';
            if (reports.length === 0) {
                dateResultsTbody.innerHTML = '<tr><td colspan="4" class="text-center py-6 text-[var(--color-muted)]">لا توجد تقارير لهذا اليوم</td></tr>';
                return;
            }
            reports.forEach(report => {
                const tr = document.createElement('tr');
                const tdName = document.createElement('td');
                const creatorName = report.created_by ? report.created_by.name : '';
                tdName.textContent = `${report.name || 'تقرير'}${report.sourceLabel ? ' (' + report.sourceLabel + ')' : ''}${creatorName ? ' - ' + creatorName : ''}`;
                const tdDate = document.createElement('td');
                tdDate.textContent = report.date || '';
                const tdTotal = document.createElement('td');
                tdTotal.textContent = report.total || '0';
                const tdAction = document.createElement('td');
                const viewBtn = document.createElement('button');
                viewBtn.className = 'btn-outline btn-xs view-report-btn';
                viewBtn.setAttribute('data-id', report.id);
                viewBtn.innerHTML = '<i class="las la-eye"></i> عرض';
                viewBtn.addEventListener('click', function () {
                    viewReportById(report.id);
                });
                tdAction.appendChild(viewBtn);
                tr.appendChild(tdName);
                tr.appendChild(tdDate);
                tr.appendChild(tdTotal);
                tr.appendChild(tdAction);
                dateResultsTbody.appendChild(tr);
            });
        }

        reportDatePicker.addEventListener('change', function () {
            selectedDateFilter = this.value;
            if (!selectedDateFilter) {
                selectedDateFilter = null;
            }
            loadRecentReports();
        });

        if (reportSearchInput) {
            reportSearchInput.addEventListener('input', function () {
                loadRecentReports();
            });
        }

        function buildPrintHTML(name, dateStr, rowsData, totalText) {
            const LOGO_URL = 'https://files.catbox.moe/05wiyk.png';
            let html = '';
            html += '<div style="text-align:center; margin-bottom:2mm;">';
            html += '<img src="' + LOGO_URL + '" style="width:20mm; height:auto; margin:0 auto; display:block;" alt="Logo" />';
            html += '<div class="restaurant-name" style="font-size:20px; font-weight:800; margin-top:1mm; text-align:center;">' + (name || '') + '</div>';
            html += '<div class="print-date" style="font-size:11px; font-weight:600; margin-top:0.5mm; text-align:center;">' + (dateStr || '') + '</div>';
            html += '</div>';
            html += '<div class="header-separator" style="width:100%; height:2px; background:#000; margin-bottom:3mm;"></div>';
            html += '<table style="width:100%; border-collapse:collapse; font-size:12px; table-layout:fixed; border:1px solid #000;">';
            html += '<thead><tr><th style="width:62%; padding:4px 5px; border:0.5px solid #000; background:#e8e8e8; text-align:center; font-weight:700; font-size:11px;">البيان</th><th style="width:38%; padding:4px 5px; border:0.5px solid #000; background:#e8e8e8; text-align:center; font-weight:700; font-size:11px;">المبلغ (ج.م)</th></tr></thead><tbody>';
            if (rowsData && rowsData.length) {
                rowsData.forEach(row => {
                    html += '<tr><td style="padding:4px 5px; border:0.5px solid #000; text-align:center;">' + (row.desc || '') + '</td><td style="padding:4px 5px; border:0.5px solid #000; text-align:center;">' + (row.amount || '0') + '</td></tr>';
                });
            }
            html += '<tr class="total-row"><td style="padding:4px 5px; border:0.5px solid #000; text-align:center; font-weight:800; font-size:14px; background:#f4f4f4;">الإجمالي</td><td style="padding:4px 5px; border:0.5px solid #000; text-align:center; font-weight:800; font-size:14px; background:#f4f4f4;">' + (totalText || '0') + '</td></tr>';
            html += '</tbody></table>';
            html += '<div class="footer" style="margin-top:6mm; padding-top:2mm; border-top:1px dashed #333; text-align:center; font-size:11px; color:#000; font-weight:700; line-height:1.5;">';
            html += '<div class="dev" style="font-size:10px; font-weight:600; color:#111; margin-top:1mm;"><p>Developed By Abdelrahman & Mando</p><p>&lt;&nbsp;All Copyrights Reserved&nbsp;&copy;&nbsp;2026&nbsp;&gt;</p></div>';
            html += '<div class="dev-version" style="font-size:10px; font-weight:600; color:#111; margin-top:0.5mm;">v3.2</div>';
            html += '</div>';
            return html;
        }

        document.getElementById('closeDetailReportBtn').addEventListener('click', hideReportView);
        document.getElementById('printDetailReportBtn').addEventListener('click', function () {
            if (!currentViewReportId) return;
            const reports = Array.isArray(window.expensesReports) ? window.expensesReports : [];
            const report = reports.find(r => r.id === currentViewReportId);
            if (!report) return;
            const printArea = document.getElementById('printArea');
            const rowsData = (report.rows && report.rows.length) ? report.rows.map(r => ({ desc: r.desc || '', amount: r.amount || '0' })) : [];
            printArea.innerHTML = buildPrintHTML(report.name || '', report.date || '', rowsData, report.total || '0');
            printArea.style.display = 'block';
            setTimeout(() => {
                window.print();
                printArea.style.display = 'none';
            }, 300);
        });

        const sidebar = document.getElementById('dashboardSidebar');
        const headerAvatar = document.getElementById('headerAvatar');

        function openSidebar() {
            sidebar.classList.add('mobile-open');
            sidebar.classList.remove('mobile-closed');
        }

        function closeSidebar() {
            sidebar.classList.remove('mobile-open');
            sidebar.classList.add('mobile-closed');
        }

        if (window.innerWidth < 1025) sidebar.classList.add('mobile-closed');

        window.addEventListener('resize', function () {
            if (window.innerWidth >= 1025) {
                sidebar.classList.remove('mobile-open', 'mobile-closed');
            } else {
                if (!sidebar.classList.contains('mobile-open')) {
                    sidebar.classList.add('mobile-closed');
                }
            }
        });

        headerAvatar.addEventListener('click', function (e) {
            e.stopPropagation();
            if (window.innerWidth < 1025) {
                if (sidebar.classList.contains('mobile-open')) closeSidebar();
                else openSidebar();
            }
        });

        document.addEventListener('click', function (e) {
            if (window.innerWidth < 1025 && sidebar.classList.contains('mobile-open')) {
                if (!sidebar.contains(e.target) && e.target !== headerAvatar && !headerAvatar.contains(e.target)) {
                    closeSidebar();
                }
            }
        });

        const sidebarItems = document.querySelectorAll('.sidebar-item');
        sidebarItems.forEach(item => {
            item.addEventListener('click', function () {
                if (this.id === 'logoutBtn') return;
                sidebarItems.forEach(i => i.classList.remove('active'));
                this.classList.add('active');
                if (window.innerWidth < 1025) {
                    closeSidebar();
                }
            });
        });

        const logoutBtn = document.getElementById('logoutBtn');
        logoutBtn.addEventListener('click', (e) => {
            e.preventDefault();
            if (confirm('هل أنت متأكد من تسجيل الخروج من لوحة التحكم؟')) {
                window.location.href = '/';
            }
        });

        const successModal = document.getElementById('successModal');
        const closeSuccessModal = document.getElementById('closeSuccessModal');
        const okSuccessBtn = document.getElementById('okSuccessBtn');
        const successMessageEl = document.getElementById('successMessage');

        function showSuccess(msg) {
            successMessageEl.textContent = msg;
            successModal.classList.add('active');
        }

        function hideSuccess() {
            successModal.classList.remove('active');
        }

        closeSuccessModal.addEventListener('click', hideSuccess);
        okSuccessBtn.addEventListener('click', hideSuccess);

        window.addEventListener('click', (e) => {
            if (e.target === successModal) hideSuccess();
        });

        const themeToggleBtn = document.getElementById('themetoggle');
        const body = document.body;

        function applyTheme(theme) {
            const isDark = theme === 'dark';
            body.classList.toggle('light', !isDark);
            themeToggleBtn.classList.toggle('dark', isDark);
            localStorage.setItem('theme', theme);
        }

        const savedTheme = localStorage.getItem('theme') || 'dark';
        applyTheme(savedTheme);

        themeToggleBtn.addEventListener('click', () => {
            const isDark = body.classList.contains('light') === false;
            applyTheme(isDark ? 'light' : 'dark');
        });

        document.addEventListener('DOMContentLoaded', function () {
            loadRecentReports();
        });
    </script>
</body>

</html>
