    <div id="printArea" style="display:none;"></div>
    <div class="modal-overlay" id="successModal">
        <div class="modal-content text-center">
            <button class="modal-close" id="closeSuccessModal"><i class="las la-times"></i></button>
            <i class="las la-check-circle text-5xl text-primary mb-4"></i>
            <h3 class="text-xl font-bold mb-2 text-[var(--color-white)]">تم بنجاح</h3>
            <p id="successMessage" class="text-[var(--color-muted)]"></p>
            <button id="okSuccessBtn" class="btn-primary mt-6 w-full justify-center">حسناً</button>
        </div>
    </div>
    <script>
        (function () {
            const arabicToEnglishMap = { '٠': '0', '١': '1', '٢': '2', '٣': '3', '٤': '4', '٥': '5', '٦': '6', '٧': '7',
                '٨': '8', '٩': '9' };

            function convertArabicNumerals(str) { return String(str).replace(/[٠-٩]/g, function (match) { return arabicToEnglishMap[
                        match] || match; }); }

            function parseNumber(val) { const converted = convertArabicNumerals(String(val)); const cleaned = converted
                    .replace(/,/g, '').trim(); const num = parseFloat(cleaned); return isNaN(num) ? 0 : num; }

            function formatNumber(num) { if (num === 0 || num === -0) return '0'; const abs = Math.abs(num); const
                    formatted = abs.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 }); return num <
                    0 ? '-' + formatted : formatted; }

            function formatDateForInput(date) { const yyyy = date.getFullYear(); const mm = String(date.getMonth() + 1)
                    .padStart(2, '0'); const dd = String(date.getDate()).padStart(2, '0'); return yyyy + '-' + mm + '-' +
                dd; }

            const sidebar = document.getElementById('dashboardSidebar');
            const headerAvatar = document.getElementById('headerAvatar');

            function openSidebar() { sidebar.classList.add('mobile-open');
                sidebar.classList.remove('mobile-closed'); }

            function closeSidebar() { sidebar.classList.remove('mobile-open');
                sidebar.classList.add('mobile-closed'); }
            if (window.innerWidth < 1025) sidebar.classList.add('mobile-closed');
            window.addEventListener('resize', function () { if (window.innerWidth >= 1025) { sidebar.classList.remove(
                        'mobile-open', 'mobile-closed'); } else { if (!sidebar.classList.contains(
                        'mobile-open')) sidebar.classList.add('mobile-closed'); } });
            if (headerAvatar) { headerAvatar.addEventListener('click', function (e) { e.stopPropagation(); if (window
                        .innerWidth < 1025) { if (sidebar.classList.contains('mobile-open')) closeSidebar(); else
                            openSidebar(); } }); }
            document.addEventListener('click', function (e) { if (window.innerWidth < 1025 && sidebar.classList.contains(
                        'mobile-open')) { if (!sidebar.contains(e.target) && e.target !== headerAvatar && !headerAvatar
                        .contains(e.target)) { closeSidebar(); } } });
            const sidebarItems = document.querySelectorAll('.sidebar-item');
            sidebarItems.forEach(item => { item.addEventListener('click', function () { if (this.id ===
                        'logoutBtn') return;
                    sidebarItems.forEach(i => i.classList.remove('active'));
                    this.classList.add('active'); if (window.innerWidth < 1025) { closeSidebar(); } }); });
            const logoutBtn = document.getElementById('logoutBtn'); if (logoutBtn) { logoutBtn.addEventListener('click',
                    (e) => { e.preventDefault(); if (confirm(
                            'هل أنت متأكد من تسجيل الخروج من لوحة التحكم؟')) window.location.href = '/'; }); }
            const successModal = document.getElementById('successModal');
            const closeSuccessModal = document.getElementById('closeSuccessModal');
            const okSuccessBtn = document.getElementById('okSuccessBtn');
            const successMessageEl = document.getElementById('successMessage');

            function showSuccess(msg) { successMessageEl.textContent = msg;
                successModal.classList.add('active'); }

            function hideSuccess() { successModal.classList.remove('active'); }
            closeSuccessModal.addEventListener('click', hideSuccess);
            okSuccessBtn.addEventListener('click', hideSuccess);
            window.addEventListener('click', (e) => { if (e.target === successModal) hideSuccess(); });
            const reportDetailCard = document.getElementById('reportDetailCard');
            const detailReportTitle = document.getElementById('detailReportTitle');
            const detailReportDate = document.getElementById('detailReportDate');
            const detailReportCategory = document.getElementById('detailReportCategory');
            const detailReportTbody = document.getElementById('detailReportTbody');
            const detailReportTotal = document.getElementById('detailReportTotal');
            const reportsTableCard = document.getElementById('reportsTableCard');
            let currentDetailReport = null;

            function hideReportDetail() { reportDetailCard.style.display = 'none';
                reportsTableCard.style.display = 'block';
                currentDetailReport = null; }
            document.getElementById('closeDetailReportBtn').addEventListener('click', hideReportDetail);
            const STORAGE_KEY_OUTGOING = 'restaurantStoredReports';
            const STORAGE_KEY_ADVANCES = 'advancesStoredReports';
            const STORAGE_KEY_VISA = 'visaStoredReports';
            const STORAGE_KEY_TRANSFERS = 'transfersStoredReports';

            function loadAllReports() { let allReports = []; try { const stored = localStorage.getItem(
                        STORAGE_KEY_OUTGOING); if (stored) { JSON.parse(stored).forEach(r => { r.category =
                            'خوارج';
                        allReports.push(r); }); } } catch (e) {} try { const stored = localStorage.getItem(
                        STORAGE_KEY_VISA); if (stored) { JSON.parse(stored).forEach(r => { r.category = 'فيز';
                        allReports.push(r); }); } } catch (e) {} try { const stored = localStorage.getItem(
                        STORAGE_KEY_TRANSFERS); if (stored) { JSON.parse(stored).forEach(r => { r.category =
                            'تحويلات';
                        allReports.push(r); }); } } catch (e) {} try { const stored = localStorage.getItem(
                        STORAGE_KEY_ADVANCES); if (stored) { JSON.parse(stored).forEach(r => { r.category =
                            'سلف';
                        allReports.push(r); }); } } catch (e) {}
                allReports.sort((a, b) => { const ta = a.timestamp ? new Date(a.timestamp).getTime() : 0; const tb = b
                        .timestamp ? new Date(b.timestamp).getTime() : 0; return tb - ta; }); return allReports; }

            function getFilteredReports() { const allReports = loadAllReports(); const dateFromVal = document.getElementById(
                    'filterDateFrom').value; const dateToVal = document.getElementById('filterDateTo').value; const
                    categoryVal = document.getElementById('filterCategory').value; const searchTextVal = document
                    .getElementById('filterSearchText').value.trim().toLowerCase(); return allReports.filter(report => { if (
                        dateFromVal) { const reportDateOnly = report.timestamp ? report.timestamp.split('T')[
                            0] : ''; if (reportDateOnly < dateFromVal) return false; } if (dateToVal) { const
                            reportDateOnly = report.timestamp ? report.timestamp.split('T')[0] : ''; if (
                            reportDateOnly > dateToVal) return false; } if (categoryVal !== 'all' && report
                        .category !== categoryVal) return false; if (searchTextVal) { const nameMatch = (report
                            .name || '').toLowerCase().includes(searchTextVal); const dateMatch = (report.date ||
                            '').toLowerCase().includes(searchTextVal); const categoryMatch = (report.category ||
                            '').toLowerCase().includes(searchTextVal); if (!nameMatch && !dateMatch && !
                            categoryMatch) return false; } return true; }); }

            function getCategoryBadgeClass(category) { if (category === 'خوارج') return 'badge-primary'; if (category ===
                    'فيز') return 'badge-secondary'; if (category === 'تحويلات') return 'badge-accent'; if (category ===
                    'سلف') return 'badge-warning'; return 'badge-primary'; }

            function updateStats(filteredReports) { let outgoingTotal = 0; let visaTotal = 0; let transfersTotal = 0; let
                    advancesTotal = 0;
                filteredReports.forEach(r => { const totalNum = parseNumber(r.total || '0'); if (r.category ===
                        'خوارج') outgoingTotal += totalNum; else if (r.category === 'فيز') visaTotal +=
                    totalNum; else if (r.category === 'تحويلات') transfersTotal += totalNum; else if (r
                        .category === 'سلف') advancesTotal += totalNum; }); const grandTotal = outgoingTotal +
                    visaTotal + transfersTotal + advancesTotal;
                document.getElementById('statOutgoingTotal').textContent = formatNumber(outgoingTotal);
                document.getElementById('statVisaTotal').textContent = formatNumber(visaTotal);
                document.getElementById('statTransfersTotal').textContent = formatNumber(transfersTotal);
                document.getElementById('statAdvancesTotal').textContent = formatNumber(advancesTotal);
                document.getElementById('statGrandTotal').textContent = formatNumber(grandTotal);
                document.getElementById('statReportCount').textContent = filteredReports.length; }

            function renderReportsTable() { const filteredReports = getFilteredReports(); const tbody = document.getElementById(
                    'reportsTbody');
                tbody.innerHTML = ''; if (filteredReports.length === 0) { tbody.innerHTML =
                    '<tr class="empty-row"><td colspan="5"><i class="las la-inbox text-4xl block mb-2" style="color:var(--color-muted);"></i>لا توجد تقارير متطابقة مع البحث</td></tr>'; } else { filteredReports.forEach(
                    report => { const tr = document.createElement('tr'); const tdDate = document
                        .createElement('td');
                        tdDate.textContent = report.date || ''; const tdCategory = document.createElement(
                            'td'); const catBadge = document.createElement('span');
                        catBadge.className = getCategoryBadgeClass(report.category);
                        catBadge.textContent = report.category || '';
                        tdCategory.appendChild(catBadge); const tdName = document.createElement('td');
                        tdName.textContent = report.name || 'تقرير'; const tdTotal = document.createElement(
                            'td');
                        tdTotal.style.fontWeight = '600';
                        tdTotal.textContent = report.total || '0'; const tdActions = document.createElement(
                            'td'); const viewBtn = document.createElement('button');
                        viewBtn.className = 'report-action-btn';
                        viewBtn.title = 'عرض التقرير';
                        viewBtn.innerHTML = '<i class="las la-eye"></i>';
                        viewBtn.addEventListener('click', function () { viewReportDetail(
                            report); }); const printBtn = document.createElement('button');
                        printBtn.className = 'report-action-btn print-btn';
                        printBtn.title = 'طباعة التقرير';
                        printBtn.innerHTML = '<i class="las la-print"></i>';
                        printBtn.addEventListener('click', function () { printReport(
                        report); }); const deleteBtn = document.createElement('button');
                        deleteBtn.className = 'report-action-btn delete-btn';
                        deleteBtn.title = 'حذف التقرير';
                        deleteBtn.innerHTML = '<i class="las la-trash-alt"></i>';
                        deleteBtn.addEventListener('click', function () { deleteReport(
                            report); });
                        tdActions.appendChild(viewBtn);
                        tdActions.appendChild(printBtn);
                        tdActions.appendChild(deleteBtn);
                        tr.appendChild(tdDate);
                        tr.appendChild(tdCategory);
                        tr.appendChild(tdName);
                        tr.appendChild(tdTotal);
                        tr.appendChild(tdActions);
                        tbody.appendChild(tr); }); }
                updateStats(filteredReports); }

            function viewReportDetail(report) { currentDetailReport = report;
                detailReportTitle.textContent = report.name || 'تقرير';
                detailReportDate.textContent = report.date || '';
                detailReportCategory.textContent = report.category || '';
                detailReportCategory.className = getCategoryBadgeClass(report.category);
                detailReportTbody.innerHTML = ''; if (report.rows && report.rows.length) { report.rows.forEach(row => { const
                        tr = document.createElement('tr'); const tdDesc = document.createElement('td');
                        tdDesc.textContent = row.desc || ''; const tdAmount = document.createElement('td');
                        tdAmount.textContent = row.amount || '0';
                        tr.appendChild(tdDesc);
                        tr.appendChild(tdAmount);
                        detailReportTbody.appendChild(tr); }); }
                detailReportTotal.textContent = report.total || '0';
                reportDetailCard.style.display = 'block';
                reportsTableCard.style.display = 'none'; }

            function buildPrintHTML(report) { const LOGO_URL = 'https://files.catbox.moe/05wiyk.png'; let html = '';
                html +=
                '<table class="header-table" style="width:100%; border-collapse:collapse; margin-bottom:3mm; border:none;">';
                html += '<tr>';
                html +=
                '<td class="title-cell-print" style="width:62%; text-align:right; vertical-align:bottom; padding:0; border:none; background:transparent;">';
                html += '<div class="restaurant-name">' + (report.name || '') + '</div>';
                html += '<div class="print-date">' + (report.date || '') + ' - ' + (report.category || '') + '</div>';
                html += '</td>';
                html +=
                '<td class="logo-cell" style="width:38%; text-align:left; vertical-align:bottom; padding:0; border:none; background:transparent;">';
                html += '<img src="' + LOGO_URL +
                    '" style="max-width:27mm; height:auto; display:block;" alt="Logo" />';
                html += '</td>';
                html += '</tr></table>';
                html += '<div class="header-separator"></div>';
                html += '<table>';
                html +=
                '<thead><tr><th style="width:62%;">البيان</th><th style="width:38%;">المبلغ (ج.م)</th></tr></thead><tbody>';
                if (report.rows && report.rows.length) { report.rows.forEach(row => { html += '<tr><td>' + (row
                            .desc || '') + '</td><td>' + (row.amount || '0') + '</td></tr>'; }); }
                html += '<tr class="total-row"><td style="width:62%;"><strong>الإجمالي</strong></td><td style="width:38%;"><strong>' +
                    (report.total || '0') + '</strong></td></tr>';
                html += '</tbody></table>';
                html +=
                '<div class="footer"><div class="dev"><p>Developed By Abdelrahman &amp; Mando</p><p>&lt;&nbsp;All Copyrights Reserved&nbsp;&copy;&nbsp;2026&nbsp;&gt;</p></div><div class="dev-version">v3.2</div></div>';
                return html; }

            function printReport(report) { const printArea = document.getElementById('printArea');
                printArea.innerHTML = buildPrintHTML(report);
                printArea.style.display = 'block';
                setTimeout(() => { window.print();
                    printArea.style.display = 'none'; }, 300); }
            document.getElementById('printDetailReportBtn').addEventListener('click', function () { if (
                    currentDetailReport) { printReport(currentDetailReport); } });

            function deleteReport(report) { if (!confirm('هل أنت متأكد من حذف هذا التقرير؟')) return; let storageKey; if (
                    report.category === 'خوارج') storageKey = STORAGE_KEY_OUTGOING; else if (report.category ===
                    'فيز') storageKey = STORAGE_KEY_VISA; else if (report.category === 'تحويلات') storageKey =
                    STORAGE_KEY_TRANSFERS; else storageKey = STORAGE_KEY_ADVANCES; try { const stored = localStorage
                    .getItem(storageKey); if (!stored) return; let reports = JSON.parse(stored);
                    reports = reports.filter(r => r.id !== report.id);
                    localStorage.setItem(storageKey, JSON.stringify(reports)); if (currentDetailReport && currentDetailReport
                        .id === report.id) { hideReportDetail(); }
                    renderReportsTable();
                    showSuccess('تم حذف التقرير بنجاح.'); } catch (e) { showSuccess('حدث خطأ أثناء الحذف.'); } }
            document.getElementById('clearAllReportsBtn').addEventListener('click', function () { if (!confirm(
                        'هل أنت متأكد من مسح جميع التقارير من جميع الأقسام؟ هذا الإجراء لا يمكن التراجع عنه.'))
                    return;
                localStorage.removeItem(STORAGE_KEY_OUTGOING);
                localStorage.removeItem(STORAGE_KEY_VISA);
                localStorage.removeItem(STORAGE_KEY_TRANSFERS);
                localStorage.removeItem(STORAGE_KEY_ADVANCES);
                hideReportDetail();
                renderReportsTable();
                showSuccess('تم مسح جميع التقارير بنجاح.'); });
            document.getElementById('filterDateFrom').addEventListener('change', renderReportsTable);
            document.getElementById('filterDateTo').addEventListener('change', renderReportsTable);
            document.getElementById('filterCategory').addEventListener('change', renderReportsTable);
            document.getElementById('filterSearchText').addEventListener('input', renderReportsTable);
            document.getElementById('clearFiltersBtn').addEventListener('click', function () { document.getElementById(
                        'filterDateFrom').value = '';
                document.getElementById('filterDateTo').value = '';
                document.getElementById('filterCategory').value = 'all';
                document.getElementById('filterSearchText').value = '';
                renderReportsTable(); });
            const userAvatarImg = document.getElementById('userAvatar'); if (userAvatarImg) { userAvatarImg.addEventListener(
                    'click', () => { const input = document.createElement('input');
                    input.type = 'file';
                    input.accept = 'image/*';
                    input.onchange = (e) => { const file = e.target.files[0]; if (file) { const reader = new
                                FileReader();
                            reader.onload = (ev) => { userAvatarImg.src = ev.target.result; const headerAv =
                                    document.getElementById('headerAvatar'); if (headerAv) headerAv.src = ev
                                    .target.result;
                                showSuccess('تم تحديث الصورة الشخصية.'); };
                            reader.readAsDataURL(file); } };
                    input.click(); }); }
            document.addEventListener('DOMContentLoaded', function () { const themeToggles = document.querySelectorAll(
                        '.theme-toggle'); const body = document.body; const applyTheme = (theme) => { const
                        isDark = theme === 'dark';
                    body.classList.toggle('light', !isDark);
                    themeToggles.forEach(toggle => toggle.classList.toggle('dark', isDark));
                    localStorage.setItem('theme', theme); }; const savedTheme = localStorage.getItem('theme') ||
                    'dark';
                applyTheme(savedTheme);
                themeToggles.forEach(toggle => { toggle.addEventListener('click', () => { const isDark = body
                            .classList.contains('light') === false;
                        applyTheme(isDark ? 'light' : 'dark'); }); });
                renderReportsTable(); });
        })();
    </script>
</body>

</html>
