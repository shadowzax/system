    <div class="modal-overlay" id="successModal">
        <div class="modal-content text-center">
            <button class="modal-close" id="closeSuccessModal"><i class="las la-times"></i></button>
            <i class="las la-check-circle text-5xl text-primary mb-4"></i>
            <h3 class="text-xl font-bold mb-2 text-[var(--color-white)]">تم بنجاح</h3>
            <p id="successMessage" class="text-[var(--color-muted)]"></p>
            <button id="okSuccessBtn" class="btn-primary mt-6 w-full justify-center">حسناً</button>
        </div>
    </div>
    <script>
        (function() {
            const sidebar = document.getElementById('dashboardSidebar');
            const headerAvatar = document.getElementById('headerAvatar');
            function openSidebar() { sidebar.classList.add('mobile-open');
                sidebar.classList.remove('mobile-closed'); }

            function closeSidebar() { sidebar.classList.remove('mobile-open');
                sidebar.classList.add('mobile-closed'); }
            if (window.innerWidth < 1025) sidebar.classList.add('mobile-closed');
            window.addEventListener('resize', function() {
                if (window.innerWidth >= 1025) {
                    sidebar.classList.remove('mobile-open', 'mobile-closed');
                } else {
                    if (!sidebar.classList.contains('mobile-open')) sidebar.classList.add('mobile-closed');
                }
            });
            if (headerAvatar) {
                headerAvatar.addEventListener('click', function(e) {
                    e.stopPropagation();
                    if (window.innerWidth < 1025) {
                        if (sidebar.classList.contains('mobile-open')) closeSidebar();
                        else openSidebar();
                    }
                });
            }
            document.addEventListener('click', function(e) {
                if (window.innerWidth < 1025 && sidebar.classList.contains('mobile-open')) {
                    if (!sidebar.contains(e.target) && e.target !== headerAvatar && !headerAvatar.contains(e
                            .target)) {
                        closeSidebar();
                    }
                }
            });
const sidebarItems = document.querySelectorAll('.sidebar-item');

sidebarItems.forEach(item => {
    item.addEventListener('click', function () {
        if (this.id === 'logoutBtn') return;

        sidebarItems.forEach(i => i.classList.remove('active'));
        this.classList.add('active');

        if (window.innerWidth < 1025) {
            closeSidebar();
        }
    });
});
            const logoutBtn = document.getElementById('logoutBtn');
            if (logoutBtn) {
                logoutBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    if (confirm('هل أنت متأكد من تسجيل الخروج من لوحة التحكم؟')) window.location.href = '/';
                });
            }
            const bottomNavItems = document.querySelectorAll('.bottom-nav-item');
            const navNotch = document.getElementById('navNotch');

            function moveNotch(activeItem) {
                if (!navNotch || !activeItem) return;
                const rect = activeItem.getBoundingClientRect();
                const navRect = document.getElementById('bottomMobileNav').getBoundingClientRect();
                const centerX = rect.left + rect.width / 2 - navRect.left;
                navNotch.style.left = centerX + 'px';
            }

            function setBottomNavActive() {
                let activeItem = null;
                bottomNavItems.forEach(item => {
                    item.classList.remove('active');
                    const tab = item.getAttribute('data-tab');
                    if (tab === 'reports') { item.classList.add('active');
                        activeItem = item; }
                });
                if (activeItem) moveNotch(activeItem);
                else if (bottomNavItems.length > 0) { bottomNavItems[0].classList.add('active');
                    moveNotch(bottomNavItems[0]); }
            }
            setBottomNavActive();
            window.addEventListener('resize', () => {
                const activeItem = document.querySelector('.bottom-nav-item.active');
                if (activeItem) moveNotch(activeItem);
            });
            bottomNavItems.forEach(item => {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    bottomNavItems.forEach(i => i.classList.remove('active'));
                    this.classList.add('active');
                    moveNotch(this);
                });
            });
            const successModal = document.getElementById('successModal');
            const closeSuccessModal = document.getElementById('closeSuccessModal');
            const okSuccessBtn = document.getElementById('okSuccessBtn');
            const successMessageEl = document.getElementById('successMessage');

            function showSuccess(msg) { successMessageEl.textContent = msg;
                successModal.classList.add('active'); }

            function hideSuccess() { successModal.classList.remove('active'); }
            closeSuccessModal.addEventListener('click', hideSuccess);
            okSuccessBtn.addEventListener('click', hideSuccess);
            window.addEventListener('click', (e) => { if (e.target === successModal) hideSuccess(); });
            document.getElementById('clearReportsBtn').addEventListener('click', function() {
                const list = document.getElementById('recentReportsList');
                list.innerHTML =
                    '<div class="text-center py-6 text-[var(--color-muted)] text-sm">لا توجد تقارير سابقة</div>';
                showSuccess('تم مسح سجل التقارير بنجاح.');
            });
            const tbody = document.getElementById('restaurantTbody');
            const totalAmountEl = document.getElementById('totalAmount');
            const restaurantNameInput = document.getElementById('restaurantNameInput');
            const LOGO_URL = 'https://files.catbox.moe/27w55o.png';

            function parseNumber(val) { const cleaned = val.replace(/,/g, ''); const num = parseFloat(cleaned); return isNaN(
                    num) ? 0 : num; }

            function formatNumber(num) { return num.toLocaleString('en-US'); }

            function updateTotal() {
                let total = 0;
                const rows = tbody.querySelectorAll('tr');
                rows.forEach(row => { const input = row.querySelector('.amount-input'); if (input) total +=
                        parseNumber(input.value); });
                totalAmountEl.textContent = formatNumber(total);
            }

            function focusInput(input) {
                if (input) {
                    input.focus();
                    if (input.type === 'text' && input.value) {
                        input.setSelectionRange(input.value.length, input.value.length);
                    }
                }
            }

            function getRowIndex(tr) {
                return Array.from(tbody.children).indexOf(tr);
            }

            function getInputsInRow(tr) {
                const descInput = tr.querySelector('.desc-input');
                const amountInput = tr.querySelector('.amount-input');
                return { descInput, amountInput };
            }

            function getCellIndex(input) {
                if (input.classList.contains('desc-input')) return 0;
                if (input.classList.contains('amount-input')) return 1;
                return -1;
            }

            function navigateCell(currentInput, rowDelta, cellDelta) {
                const currentTr = currentInput.closest('tr');
                if (!currentTr) return;
                const rows = Array.from(tbody.querySelectorAll('tr'));
                const currentRowIndex = rows.indexOf(currentTr);
                const currentCellIndex = getCellIndex(currentInput);
                const targetRowIndex = currentRowIndex + rowDelta;
                if (targetRowIndex < 0 || targetRowIndex >= rows.length) return;
                const targetRow = rows[targetRowIndex];
                const { descInput, amountInput } = getInputsInRow(targetRow);
                const targetCellIndex = cellDelta !== undefined ? cellDelta : currentCellIndex;
                if (targetCellIndex === 0 && descInput) focusInput(descInput);
                else if (targetCellIndex === 1 && amountInput) focusInput(amountInput);
            }

            function setupKeyboardNavigation(input) {
                input.addEventListener('keydown', function(e) {
                    const key = e.key;
                    const tr = this.closest('tr');
                    const rows = Array.from(tbody.querySelectorAll('tr'));
                    const rowIndex = rows.indexOf(tr);
                    const cellIndex = getCellIndex(this);
                    if (key === 'Enter') {
                        e.preventDefault();
                        const isLastRow = rowIndex === rows.length - 1;
                        const isAmountCell = cellIndex === 1;
                        if (isLastRow && isAmountCell) {
                            const newTr = addRow('', '');
                            const { descInput } = getInputsInRow(newTr);
                            if (descInput) focusInput(descInput);
                            saveToSystem();
                        } else if (isLastRow && cellIndex === 0) {
                            const { amountInput } = getInputsInRow(tr);
                            if (amountInput) focusInput(amountInput);
                        } else {
                            navigateCell(this, 1, cellIndex);
                        }
                    } else if (key === 'ArrowDown') {
                        e.preventDefault();
                        navigateCell(this, 1, cellIndex);
                    } else if (key === 'ArrowUp') {
                        e.preventDefault();
                        navigateCell(this, -1, cellIndex);
                    } else if (key === 'ArrowRight') {
                        e.preventDefault();
                        if (cellIndex === 1) {
                            navigateCell(this, 0, 0);
                        }
                    } else if (key === 'ArrowLeft') {
                        e.preventDefault();
                        if (cellIndex === 0) {
                            navigateCell(this, 0, 1);
                        }
                    } else if (key === 'Tab') {
                        e.preventDefault();
                        if (e.shiftKey) {
                            if (cellIndex === 1) {
                                navigateCell(this, 0, 0);
                            } else if (cellIndex === 0 && rowIndex > 0) {
                                navigateCell(this, -1, 1);
                            }
                        } else {
                            if (cellIndex === 0) {
                                navigateCell(this, 0, 1);
                            } else if (cellIndex === 1) {
                                if (rowIndex < rows.length - 1) {
                                    navigateCell(this, 1, 0);
                                } else {
                                    const newTr = addRow('', '');
                                    const { descInput } = getInputsInRow(newTr);
                                    if (descInput) focusInput(descInput);
                                    saveToSystem();
                                }
                            }
                        }
                    }
                });
            }

            function addRow(description, amount) {
                const tr = document.createElement('tr');
                const descTd = document.createElement('td');
                const descInput = document.createElement('input');
                descInput.type = 'text';
                descInput.className = 'input-field desc-input';
                descInput.placeholder = 'أدخل البيان';
                descInput.value = description || '';
                setupKeyboardNavigation(descInput);
                descTd.appendChild(descInput);
                const amountTd = document.createElement('td');
                const amountInput = document.createElement('input');
                amountInput.type = 'text';
                amountInput.className = 'input-field amount-input';
                amountInput.placeholder = 'المبلغ';
                amountInput.value = amount ? formatNumber(parseNumber(amount)) : '';
                amountInput.setAttribute('inputmode', 'numeric');
                setupKeyboardNavigation(amountInput);
                amountTd.appendChild(amountInput);
                const actionTd = document.createElement('td');
                const deleteBtn = document.createElement('button');
                deleteBtn.className = 'delete-row-btn';
                deleteBtn.tabIndex = -1;
                deleteBtn.innerHTML = '<i class="las la-trash-alt"></i>';
                deleteBtn.addEventListener('click', function() {
                    if (tbody.children.length > 1) { tr.remove();
                        updateTotal();
                        saveToSystem(); } else { showSuccess('لا يمكن حذف الصف الأخير.'); }
                });
                actionTd.appendChild(deleteBtn);
                tr.appendChild(descTd);
                tr.appendChild(amountTd);
                tr.appendChild(actionTd);
                descInput.addEventListener('input', function() {});
                amountInput.addEventListener('input', function() {
                    let val = this.value.replace(/,/g, '');
                    const num = parseFloat(val);
                    if (!isNaN(num) && val !== '') this.value = formatNumber(num);
                    else if (val === '') this.value = '';
                    updateTotal();
                });
                amountInput.addEventListener('blur', function() {
                    let val = this.value.replace(/,/g, '');
                    const num = parseFloat(val);
                    if (!isNaN(num) && val !== '') this.value = formatNumber(num);
                    else this.value = '';
                    updateTotal();
                });
                tbody.appendChild(tr);
                updateTotal();
                return tr;
            }

            function clearAllRows() { tbody.innerHTML = '';
                addRow('', '');
                updateTotal(); }

            function getTableData() {
                const rows = tbody.querySelectorAll('tr');
                const data = [];
                rows.forEach(row => {
                    const descInput = row.querySelector('.desc-input');
                    const amountInput = row.querySelector('.amount-input');
                    if (descInput && amountInput) data.push({ desc: descInput.value || '', amount: amountInput
                            .value || '0' });
                });
                return data;
            }

            function loadTableData(data) {
                tbody.innerHTML = '';
                if (data.length === 0) addRow('', '');
                else data.forEach(item => addRow(item.desc, item.amount));
                updateTotal();
            }

            function saveToSystem() {
                const data = getTableData();
                const name = restaurantNameInput.value || '';
                const payload = { name: name, rows: data, timestamp: new Date().toISOString() };
                try { localStorage.setItem('restaurantReportData', JSON.stringify(payload)); } catch (e) {}
            }

            function loadFromSystem() {
                try {
                    const stored = localStorage.getItem('restaurantReportData');
                    if (stored) { const payload = JSON.parse(stored);
                        restaurantNameInput.value = payload.name || '';
                        loadTableData(payload.rows || []); return true; }
                } catch (e) {}
                return false;
            }

            function saveAndUpload() {
                saveToSystem();
                const name = restaurantNameInput.value || '';
                const data = getTableData();
                let csv = 'البيان,المبلغ (ج.م)\n';
                data.forEach(item => csv += item.desc + ',' + item.amount + '\n');
                csv += 'الإجمالي,' + totalAmountEl.textContent + '\n';
                const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = name + '_تقرير_' + new Date().toISOString().slice(0, 10) + '.csv';
                link.click();
                showSuccess('تم حفظ البيانات ورفعها كملف CSV.');
            }
            document.getElementById('addRowBtn').addEventListener('click', function() { addRow('', ''); });
            document.getElementById('addRowsBatchBtn').addEventListener('click', function() {
                const countInput = document.getElementById('rowsCountInput');
                let count = parseInt(countInput.value) || 1;
                if (count < 1) count = 1;
                if (count > 50) count = 50;
                countInput.value = count;
                for (let i = 0; i < count; i++) addRow('', '');
                showSuccess('تم إضافة ' + count + ' صفوف جديدة.');
            });
            document.getElementById('clearRowsBtn').addEventListener('click', function() {
                if (tbody.children.length === 0) return;
                if (confirm('هل أنت متأكد من مسح جميع الصفوف؟')) { clearAllRows();
                    saveToSystem(); }
            });
            document.getElementById('saveSystemBtn').addEventListener('click', function() { saveToSystem();
                showSuccess('تم حفظ البيانات في النظام بنجاح.'); });
            document.getElementById('saveUploadBtn').addEventListener('click', function() { saveAndUpload(); });
            document.getElementById('printInvoiceBtn').addEventListener('click', function() {
                const printArea = document.getElementById('printArea');
                const name = restaurantNameInput.value || '';
                const now = new Date().toLocaleString('ar-EG');
                let html = '';
                html += '<table class="header-table" style="width:100%; border-collapse:collapse; margin-bottom:2mm; border:none;">';
                html += '<tr>';
                html += '<td style="width:60%; text-align:right; vertical-align:bottom; padding:0; border:none;">';
                html += '<div class="restaurant-name">' + name + '</div>';
                html += '<div class="print-date">' + now + '</div>';
                html += '</td>';
                html += '<td class="logo-cell" style="width:40%;">';
                html += '<img src="' + LOGO_URL +
                    '" style="max-width:14mm; height:auto; display:block;" alt="Logo" />';
                html += '</td>';
                html += '</tr></table>';
                html += '<table>';
                html += '<thead><tr><th style="width:62%;">البيان</th><th style="width:38%;">المبلغ (ج.م)</th></tr></thead><tbody>';
                const rows = tbody.querySelectorAll('tr');
                rows.forEach(row => {
                    const descInput = row.querySelector('.desc-input');
                    const amountInput = row.querySelector('.amount-input');
                    if (descInput && amountInput) {
                        html += '<tr><td>' + (descInput.value || '') + '</td><td>' + (amountInput.value ||
                            '0') + '</td></tr>';
                    }
                });
                html += '<tr class="total-row"><td style="width:62%;"><strong>الإجمالي</strong></td><td style="width:38%;"><strong>' +
                    totalAmountEl.textContent + '</strong></td></tr>';
                html += '</tbody></table>';
                html +=
                    '<div class="footer"><div class="dev">Developed by Abdelrahman Mohamed</div><div class="dev-version">v3.2</div></div>';
                printArea.innerHTML = html;
                printArea.style.display = 'block';
                setTimeout(() => { window.print();
                    printArea.style.display = 'none'; }, 300);
            });
            document.getElementById('exportRestaurantBtn').addEventListener('click', function() {
                const name = restaurantNameInput.value || '';
                let csv = 'البيان,المبلغ (ج.م)\n';
                const rows = tbody.querySelectorAll('tr');
                rows.forEach(row => {
                    const descInput = row.querySelector('.desc-input');
                    const amountInput = row.querySelector('.amount-input');
                    if (descInput && amountInput) csv += (descInput.value || '') + ',' + (amountInput.value ||
                        '0') + '\n';
                });
                csv += 'الإجمالي,' + totalAmountEl.textContent + '\n';
                const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = name + '_تقرير.csv';
                link.click();
                showSuccess('تم تصدير التقرير بصيغة CSV بنجاح.');
            });
            const userAvatarImg = document.getElementById('userAvatar');
            if (userAvatarImg) {
                userAvatarImg.addEventListener('click', () => {
                    const input = document.createElement('input');
                    input.type = 'file';
                    input.accept = 'image/*';
                    input.onchange = (e) => {
                        const file = e.target.files[0];
                        if (file) {
                            const reader = new FileReader();
                            reader.onload = (ev) => {
                                userAvatarImg.src = ev.target.result;
                                const headerAv = document.getElementById('headerAvatar');
                                if (headerAv) headerAv.src = ev.target.result;
                                showSuccess('تم تحديث الصورة الشخصية.');
                            };
                            reader.readAsDataURL(file);
                        }
                    };
                    input.click();
                });
            }
            document.addEventListener('DOMContentLoaded', function() {
                const themeToggles = document.querySelectorAll('.theme-toggle');
                const body = document.body;
                const applyTheme = (theme) => {
                    const isDark = theme === 'dark';
                    body.classList.toggle('light', !isDark);
                    themeToggles.forEach(toggle => toggle.classList.toggle('dark', isDark));
                    localStorage.setItem('theme', theme);
                };
                const savedTheme = localStorage.getItem('theme') || 'dark';
                applyTheme(savedTheme);
                themeToggles.forEach(toggle => {
                    toggle.addEventListener('click', () => {
                        const isDark = body.classList.contains('light') === false;
                        applyTheme(isDark ? 'light' : 'dark');
                    });
                });
                if (!loadFromSystem()) {
                    tbody.innerHTML = '';
                    addRow('', '');
                    updateTotal();
                }
            });
        })();
    </script>
</body>
</html>