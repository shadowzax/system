
<!DOCTYPE html>
<html lang="ar" dir="rtl" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <meta name="theme-color" content="#0d99ff">
    <title>تقرير فيزا</title>
    <meta name="description" content="تقرير تسجيل معاملات الفيزا">
    <link rel="icon" type="image/png" href="/favicon.ico">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/line-awesome/1.3.0/line-awesome/css/line-awesome.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com">
    </script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#0d99ff',
                        secondary: '#7c3aed',
                        accent: '#06b6d4',
                        error: '#ef4444',
                        success: '#10b981',
                        warning: '#f59e0b',
                    }
                }
            }
        }
    </script>
    <style>
        :root {
            --color-primary: #0d99ff;
            --color-secondary: #7c3aed;
            --color-accent: #06b6d4;
            --color-background: #00080f;
            --color-card: #00060c;
            --color-darker: #000308;
            --color-paragraph: #bababa;
            --color-white: #ffffff;
            --color-muted: #9ca3af;
            --border-subtle: rgba(186, 186, 186, 0.24);
            --card-bg: #00060c;
            --border-color: rgba(186, 186, 186, 0.24);
            --darker-bg: #000308;
            --header-height: 70px;
            --sidebar-width: 280px;
            --bottom-nav-height: 68px;
            --shadow-glow: 0 0 30px rgba(13, 153, 255, 0.08);
        }
        .light {
            --color-background: #f1f5f9;
            --color-card: #ffffff;
            --color-darker: #e2e8f0;
            --color-paragraph: #334155;
            --color-white: #0f172a;
            --color-muted: #64748b;
            --border-subtle: rgba(0, 0, 0, 0.08);
            --card-bg: #ffffff;
            --border-color: rgba(0, 0, 0, 0.1);
            --darker-bg: #e2e8f0;
            --shadow-glow: 0 0 30px rgba(13, 153, 255, 0.04);
        }
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Alexandria', system-ui, sans-serif;
            background-color: var(--color-background);
            color: var(--color-white);
            transition: background-color 0.3s, color 0.3s;
            overflow-x: hidden;
            padding-bottom: 0;
        }
        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        ::-webkit-scrollbar-track {
            background: var(--color-background);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: #0563a7;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #0d99ff;
        }
        .dashboard-sidebar {
            width: var(--sidebar-width);
            background: var(--card-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-left: 1px solid var(--border-color);
            position: fixed;
            right: 0;
            top: var(--header-height);
            bottom: 0;
            overflow-y: auto;
            transition: transform 0.3s ease, z-index 0.3s;
            z-index: 30;
            padding: 24px 16px;
            transform: translateX(0);
        }
        .dashboard-sidebar.mobile-closed {
            transform: translateX(100%);
        }
        @media (max-width: 1024px) {
            .dashboard-sidebar.mobile-open {
                z-index: 105;
            }
        }
        .sidebar-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-radius: 14px;
            margin-bottom: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
            color: var(--color-muted);
            font-weight: 500;
            text-decoration: none;
            font-size: 0.95rem;
        }
        .sidebar-item i {
            font-size: 22px;
            width: 28px;
            flex-shrink: 0;
        }
        .sidebar-item:hover {
            background: rgba(13, 153, 255, 0.08);
            color: var(--color-primary);
        }
        .sidebar-item.active {
            background: linear-gradient(135deg, rgba(13, 153, 255, 0.15), rgba(124, 58, 237, 0.1));
            color: var(--color-primary);
            border-right: 3px solid var(--color-primary);
            font-weight: 600;
        }
        .sidebar-section-title {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--color-muted);
            padding: 16px 16px 8px;
            font-weight: 600;
        }
        @media (max-width: 1024px) {
            .dashboard-sidebar {
                transform: translateX(100%);
                width: 260px;
                z-index: 45;
            }
            .dashboard-sidebar.mobile-open {
                transform: translateX(0);
                z-index: 105;
            }
            .dashboard-sidebar.mobile-closed {
                transform: translateX(100%);
                z-index: 45;
            }
            body {
                padding-bottom: 0;
            }
        }
        @media (min-width: 1025px) {
            .dashboard-sidebar {
                transform: translateX(0) !important;
                z-index: 30;
            }
            .dashboard-sidebar.mobile-open,
            .dashboard-sidebar.mobile-closed {
                transform: translateX(0) !important;
            }
            body {
                padding-bottom: 0;
            }
        }
        .info-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 24px;
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            box-shadow: var(--shadow-glow);
        }
        #mainHeader {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: var(--header-height);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            border-bottom: 1px solid var(--border-subtle);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            background: var(--color-background);
            z-index: 110;
            transition: background-color 0.3s;
        }
        .header-avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--color-primary);
            cursor: pointer;
            transition: all 0.2s;
            flex-shrink: 0;
        }
        .header-avatar:hover {
            transform: scale(1.05);
            border-color: #f59e0b;
        }
        main {
            padding-top: var(--header-height);
        }
        .input-field {
            width: 100%;
            background: var(--darker-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 12px 16px;
            color: var(--color-white);
            font-family: inherit;
            transition: border-color 0.2s;
            font-size: 0.9rem;
        }
        .input-field:focus {
            outline: none;
            border-color: var(--color-primary);
            box-shadow: 0 0 0 3px rgba(13, 153, 255, 0.1);
        }
        @media (max-width: 640px) {
            .input-field {
                padding: 14px 18px;
                font-size: 1rem;
            }
            .info-card {
                padding: 18px;
            }
            .btn-sm {
                padding: 10px 16px;
                font-size: 0.85rem;
            }
            .add-rows-section input {
                width: 80px;
            }
        }
        .btn-primary {
            background: var(--color-primary);
            color: #fff;
            border: none;
            padding: 12px 24px;
            border-radius: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: inherit;
            font-size: 0.9rem;
        }
        .btn-primary:hover {
            background: #0b85e0;
            transform: translateY(-1px);
            box-shadow: 0 8px 25px rgba(13, 153, 255, 0.25);
        }
        .btn-primary:active {
            transform: scale(0.97);
        }
        .btn-outline {
            background: transparent;
            color: var(--color-white);
            border: 1px solid var(--border-color);
            padding: 10px 20px;
            border-radius: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: inherit;
            font-size: 0.85rem;
        }
        .btn-outline:hover {
            border-color: var(--color-primary);
            color: var(--color-primary);
            background: rgba(13, 153, 255, 0.05);
        }
        .btn-sm {
            padding: 6px 14px;
            font-size: 0.78rem;
            border-radius: 8px;
        }
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            z-index: 200;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s, visibility 0.3s;
        }
        .modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }
        .modal-content {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 24px;
            padding: 36px 32px;
            width: 100%;
            max-width: 500px;
            max-height: 85vh;
            overflow-y: auto;
            position: relative;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);
        }
        @media (max-width: 640px) {
            .modal-content {
                padding: 24px 20px;
                border-radius: 18px;
                max-width: 95vw;
            }
        }
        .modal-close {
            position: absolute;
            top: 14px;
            left: 14px;
            background: rgba(255, 255, 255, 0.06);
            border: none;
            color: var(--color-muted);
            font-size: 1.2rem;
            cursor: pointer;
            border-radius: 50%;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: 0.2s;
            z-index: 5;
        }
        .modal-close:hover {
            background: rgba(255, 255, 255, 0.15);
            color: #fff;
        }
        .title-cell {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 30px 32px;
            text-align: center;
            box-shadow: var(--shadow-glow);
            margin-bottom: 28px;
        }
        .title-cell h1 {
            font-size: 2rem;
            font-weight: 700;
            color: var(--color-white);
        }
        .title-cell p {
            color: var(--color-muted);
            font-size: 1rem;
            margin-top: 6px;
        }
        .title-cell .title-icon {
            font-size: 2.4rem;
            color: var(--color-primary);
            margin-bottom: 8px;
        }
        @media (max-width: 640px) {
            .title-cell {
                padding: 20px 16px;
            }
            .title-cell h1 {
                font-size: 1.5rem;
            }
            .title-cell p {
                font-size: 0.85rem;
            }
        }
        .visa-table {
            width: 100%;
            border-collapse: collapse;
            font-family: 'Alexandria', sans-serif;
        }
        .visa-table th,
        .visa-table td {
            padding: 10px 12px;
            border-bottom: 1px solid var(--border-color);
            text-align: right;
        }
        .visa-table th {
            background: var(--darker-bg);
            color: var(--color-muted);
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .visa-table td .input-field {
            background: transparent;
            border: none;
            padding: 4px 0;
            font-size: 0.95rem;
            color: var(--color-white);
            width: 100%;
        }
        .visa-table td .input-field:focus {
            border-bottom: 1px solid var(--color-primary);
            box-shadow: none;
        }
        .visa-table .total-row td {
            border-top: 2px solid var(--color-primary);
            font-weight: 700;
            font-size: 1.1rem;
            color: var(--color-primary);
        }
        .visa-table .serial-cell {
            text-align: center;
            font-weight: 700;
            color: var(--color-primary);
            font-size: 0.95rem;
            min-width: 40px;
            width: 8%;
        }
        .datetime-input {
            background: transparent;
            border: none;
            border-bottom: 1px dashed var(--border-color);
            color: var(--color-white);
            font-family: inherit;
            font-size: 0.8rem;
            text-align: center;
            direction: ltr;
            width: 100%;
            min-width: 140px;
            padding: 2px 4px;
            transition: border-color 0.2s;
        }
        .datetime-input:focus {
            outline: none;
            border-bottom: 1px solid var(--color-primary);
        }
        .datetime-input::placeholder {
            color: var(--color-muted);
            opacity: 0.5;
        }
        @media (max-width: 640px) {
            .datetime-input {
                font-size: 0.7rem;
                min-width: 100px;
            }
            .visa-table .serial-cell {
                font-size: 0.8rem;
                min-width: 30px;
            }
        }
        .visa-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 20px;
            box-shadow: var(--shadow-glow);
            margin-top: 28px;
        }
        .visa-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
            border-bottom: 2px dashed var(--border-color);
            padding-bottom: 12px;
            flex-wrap: wrap;
        }
        .visa-header i {
            font-size: 2rem;
            color: var(--color-primary);
        }
        .visa-header h3 {
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--color-white);
        }
        .visa-header .visa-name-input {
            flex: 1;
            min-width: 150px;
            background: var(--darker-bg);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 6px 14px;
            color: var(--color-white);
            font-family: inherit;
            font-size: 1rem;
            font-weight: 600;
        }
        .visa-header .visa-name-input:focus {
            outline: none;
            border-color: var(--color-primary);
        }
        .delete-row-btn {
            background: transparent;
            border: none;
            color: var(--color-muted);
            cursor: pointer;
            font-size: 1.1rem;
            transition: 0.2s;
            padding: 4px 8px;
            border-radius: 8px;
        }
        .delete-row-btn:hover {
            color: #ef4444;
            background: rgba(239, 68, 68, 0.1);
        }
        .time-toggle-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 14px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.25s ease;
            border: 1px solid var(--border-color);
            background: var(--darker-bg);
            color: var(--color-muted);
            font-family: inherit;
            white-space: nowrap;
        }
        .time-toggle-btn.active {
            background: rgba(13, 153, 255, 0.15);
            border-color: var(--color-primary);
            color: var(--color-primary);
        }
        .time-toggle-btn i {
            font-size: 1rem;
            transition: all 0.25s ease;
        }
        .time-toggle-btn.active i {
            color: var(--color-primary);
        }
        .theme-toggle {
            position: relative;
            width: 70px;
            height: 35px;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            overflow: hidden;
            background: linear-gradient(45deg, #ffd700, #ffed4a);
            box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.3);
            transition: all .4s ease;
        }
        .theme-toggle .toggle-circle {
            position: absolute;
            top: 4px;
            right: 4px;
            width: 27px;
            height: 27px;
            border-radius: 50%;
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 8px rgba(0, 0, 0, .2), inset 0 1px 0 rgba(255, 255, 255, .8);
            transition: all .45s cubic-bezier(.68, -0.55, .265, 1.55);
        }
        .theme-toggle .icon {
            position: absolute;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all .4s ease;
        }
        .theme-toggle .sun-icon {
            color: #ff6b35;
            opacity: 1;
            transform: rotate(0deg) scale(1);
        }
        .theme-toggle .moon-icon {
            color: #a78bfa;
            opacity: 0;
            transform: rotate(180deg) scale(.5);
        }
        .theme-toggle.dark {
            background: linear-gradient(45deg, #475569, #1e293b);
            box-shadow: 0 4px 12px rgba(30, 41, 59, .4), inset 0 1px 0 rgba(255, 255, 255, .08);
        }
        .theme-toggle.dark .toggle-circle {
            right: calc(100% - 31px);
            background: #1e293b;
            box-shadow: 0 4px 12px rgba(0, 0, 0, .4), inset 0 1px 0 rgba(255, 255, 255, .08);
        }
        .theme-toggle.dark .sun-icon {
            opacity: 0;
            transform: rotate(-180deg) scale(.5);
        }
        .theme-toggle.dark .moon-icon {
            opacity: 1;
            transform: rotate(0deg) scale(1);
        }
        .add-rows-section {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        .add-rows-section input {
            width: 100px;
            background: var(--darker-bg);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 6px 12px;
            color: var(--color-white);
            font-family: inherit;
            font-size: 0.9rem;
            text-align: center;
        }
        .add-rows-section input:focus {
            outline: none;
            border-color: var(--color-primary);
        }
        .report-list-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 18px;
            border-radius: 14px;
            background: var(--darker-bg);
            border: 1px solid var(--border-color);
            flex-wrap: wrap;
            gap: 12px;
            transition: all 0.2s;
        }
        .report-list-item:hover {
            border-color: rgba(13, 153, 255, 0.3);
            background: rgba(13, 153, 255, 0.03);
        }
        .report-list-item .report-info {
            display: flex;
            align-items: center;
            gap: 12px;
            flex: 1;
            min-width: 180px;
        }
        .report-list-item .report-actions {
            display: flex;
            gap: 8px;
            flex-shrink: 0;
        }
        @page {
            size: 82.5mm 297mm;
            margin: 0;
        }
        @media print {
            html,
            body {
                width: 82.5mm;
                height: 297mm;
                margin: 0;
                padding: 0;
                background: white;
                font-family: 'Alexandria', sans-serif;
                direction: rtl;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
            body * {
                visibility: hidden;
            }
            #printArea,
            #printArea * {
                visibility: visible;
            }
            #printArea {
                display: block !important;
                position: fixed;
                left: 0;
                top: 0;
                width: 82.5mm;
                min-height: 297mm;
                padding: 4mm 5mm 4mm 5mm;
                margin: 0 auto;
                background: white;
                color: #000;
                direction: rtl;
                overflow: hidden;
                box-sizing: border-box;
                font-family: 'Alexandria', sans-serif;
            }
            #printArea .print-header-section {
                margin-bottom: 3mm;
                padding-bottom: 2mm;
                border-bottom: 2px solid #000;
            }
            #printArea .restaurant-name {
                font-size: 22px;
                font-weight: 800;
                margin-bottom: 1mm;
                color: #000;
                text-align: right;
                line-height: 1.2;
            }
            #printArea .print-date {
                font-size: 13px;
                font-weight: 600;
                color: #000;
                margin-bottom: 1mm;
                text-align: right;
            }
            #printArea .logo-cell {
                text-align: left;
                vertical-align: bottom;
                padding: 0;
                border: none;
            }
            #printArea .logo-cell img {
                max-width: 15mm;
                height: auto;
                display: block;
            }
            #printArea table {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
                border: 1.5px solid #000;
            }
            #printArea table th,
            #printArea table td {
                padding: 5px 4px;
                border: 1px solid #000;
                text-align: right;
                font-size: 12px;
                word-break: break-word;
                line-height: 1.3;
            }
            #printArea table th {
                font-size: 11px;
                background: #e0e0e0;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.3px;
            }
            #printArea .print-serial {
                width: 10%;
                text-align: center;
                font-weight: 700;
            }
            #printArea .print-amount {
                width: 38%;
                text-align: right;
                font-weight: 600;
            }
            #printArea .print-datetime {
                width: 52%;
                text-align: center;
                direction: ltr;
                font-size: 11px;
            }
            #printArea .header-table td {
                border: none;
                padding: 0;
            }
            #printArea .total-row td {
                border-top: 2.5px solid #000;
                border-bottom: 2.5px solid #000;
                font-weight: 800;
                font-size: 16px;
                background: #e8e8e8;
                padding: 6px 4px;
            }
            #printArea .total-row td:first-child {
                text-align: center;
            }
            #printArea .footer {
                margin-top: 5mm;
                padding-top: 3mm;
                border-top: 1.5px dashed #000;
                text-align: center;
                font-size: 12px;
                color: #000;
                font-weight: 700;
                line-height: 1.7;
            }
            #printArea .footer .dev {
                font-size: 10px;
                font-weight: 600;
                color: #000;
                margin-top: 2mm;
            }
            #printArea .footer .dev-version {
                font-size: 9px;
                font-weight: 600;
                color: #000;
                margin-top: 0.5mm;
            }
        }
    </style>
</head>
<body>
    <div class="relative min-h-screen">
        <aside class="dashboard-sidebar mobile-closed" id="dashboardSidebar">
            <div class="mb-6 px-2 mt-4">
                <div class="flex items-center gap-3 pb-4 border-b border-[var(--border-color)]">
                    <img id="userAvatar" src="https://files.catbox.moe/4lsmka.jpg" class="w-12 h-12 rounded-full border-2 shadow object-cover" alt="avatar" style="border-color:#f59e0b;">
                    <div>
                        <p class="font-bold text-[var(--color-white)]" id="userFullName">عبدالرحمن محمد</p>
                        <p class="text-xs text-[var(--color-muted)]" id="role">Administrator</p>
                    </div>
                </div>
            </div>
            <nav class="flex-1">
                <div class="sidebar-section-title">الرئيسية</div>
                <a href="/" class="sidebar-item" data-page="dashboard"><i class="las la-tachometer-alt"></i><span>لوحة التحكم</span></a>
                <div class="sidebar-section-title">الكاش</div>
                <a href="/outgoing" class="sidebar-item" data-page="outgoing-invoices"><i class="las la-file-invoice-dollar"></i><span>خوارج</span></a>
                <a href="/visa" class="sidebar-item active" data-page="visa"><i class="las la-credit-card"></i><span>فيز</span></a>
                <a href="/cash" class="sidebar-item" data-page="transfers"><i class="las la-exchange-alt"></i><span>تحويلات</span></a>
                <div class="sidebar-section-title">الإدارة</div>
                <a href="/payments" class="sidebar-item" data-page="payments"><i class="las la-credit-card"></i><span>المدفوعات</span></a>
                <div class="sidebar-section-title">النظام</div>
                <a href="/settings" class="sidebar-item" data-page="settings"><i class="las la-cog"></i><span>الإعدادات</span></a>
                <a href="/activity" class="sidebar-item" data-page="logs"><i class="las la-history"></i><span>سجل النشاط</span></a>
                <div class="mt-8 pt-4 border-t border-[var(--border-color)]">
                    <a href="#" id="logoutBtn" class="sidebar-item" style="color: #ef4444;"><i class="las la-sign-out-alt"></i><span>تسجيل الخروج</span></a>
                </div>
            </nav>
            <div class="mt-5 pt-4 border-t border-black/10 dark:border-white/10 text-center leading-tight">
                <span class="text-[9px] uppercase tracking-[0.15em] text-[var(--color-muted)] opacity-70">Developed by</span>
                <div>
                    <a href="https://www.facebook.com/Abdelrahman.Elshamhuot" target="_blank" rel="noopener noreferrer" class="text-[11px] font-medium text-[var(--color-muted)] hover:underline">Abdelrahman Mohamed</a>
                </div>
                <div class="mt-1 text-[9px] text-[var(--color-muted)] opacity-50">v3.2</div>
            </div>
        </aside>
        <main class="lg:mr-[280px] transition-all">
            <header id="mainHeader">
                <div class="flex items-center gap-6 mr-4">
                    <a class="flex w-fit select-none items-center" href="/">
                        <img src="https://files.catbox.moe/kdxauw.png" alt="logo" class="h-[52px] sm:h-[60px] md:h-[68px] object-contain">
                    </a>
                </div>
                <div class="flex items-center gap-3 sm:gap-4">
                    <button class="theme-toggle" id="themetoggle">
                        <div class="toggle-circle">
                            <i class="fas fa-sun icon sun-icon"></i>
                            <i class="fas fa-moon icon moon-icon"></i>
                        </div>
                    </button>
                    <img id="headerAvatar" src="https://files.catbox.moe/4lsmka.jpg" class="header-avatar" alt="avatar">
                </div>
            </header>
            <div class="container mx-auto px-4 py-6 max-w-7xl">
                <div class="title-cell">
                    <div class="title-icon"><i class="las la-credit-card"></i></div>
                    <h1>الفيز</h1>
                    <p>تسجيل معاملات الفيز</p>
                </div>
                <div class="visa-card">
                    <div class="visa-header">
                        <i class="las la-credit-card"></i>
                        <h3>الفيز</h3>
                        <input type="text" class="visa-name-input" id="visaNameInput" placeholder="عنوان التقرير">
                        <button type="button" id="timeToggleBtn" class="time-toggle-btn active" title="تبديل بين الوقت التلقائي واليدوي">
                            <i class="las la-clock"></i>
                            <span id="timeToggleText">تلقائي</span>
                        </button>
                        <span class="mr-auto text-xs text-[var(--color-muted)]" id="lastUpdateSpan">آخر تحديث: اليوم</span>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="visa-table" id="visaTable">
                            <thead>
                                <tr>
                                    <th style="width:8%;text-align:center;">#</th>
                                    <th style="width:35%;">المبلغ (ج.م)</th>
                                    <th style="width:37%;text-align:center;">التاريخ والوقت</th>
                                    <th style="width:20%;"></th>
                                </tr>
                            </thead>
                            <tbody id="visaTbody"></tbody>
                            <tfoot>
                                <tr class="total-row" id="totalRow">
                                    <td style="text-align:center;">-</td>
                                    <td id="totalAmount">0</td>
                                    <td style="text-align:center;">الإجمالي</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <div class="flex flex-wrap gap-3 mt-4 justify-between items-center">
                        <div class="flex flex-wrap gap-3 items-center">
                            <button class="btn-outline btn-sm" id="addRowBtn"><i class="las la-plus"></i> إضافة صف</button>
                            <div class="add-rows-section">
                                <span class="text-xs text-[var(--color-muted)]">عدد الصفوف:</span>
                                <input type="number" id="rowsCountInput" value="3" min="1" max="50">
                                <button class="btn-outline btn-sm" id="addRowsBatchBtn"><i class="las la-plus-circle"></i> إضافة</button>
                            </div>
                            <button class="btn-outline btn-sm" id="clearRowsBtn"><i class="las la-trash-alt"></i> مسح الكل</button>
                        </div>
                        <div class="flex flex-wrap gap-3">
                            <button class="btn-primary btn-sm" id="storeBtn"><i class="las la-save"></i> تخزين</button>
                            <button class="btn-outline btn-sm" id="printInvoiceBtn"><i class="las la-print"></i> طباعة (80mm)</button>
                            <button class="btn-outline btn-sm" id="exportVisaBtn"><i class="las la-file-excel"></i> CSV</button>
                        </div>
                    </div>
                </div>
                <div class="mt-6 info-card" id="recentReportsCard">
                    <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
                        <div>
                            <h3 class="text-lg font-bold text-[var(--color-white)] flex items-center gap-2"><i class="las la-history text-primary"></i> آخر التقارير المنشأة</h3>
                            <p class="text-sm text-[var(--color-muted)]">عرض آخر التقارير التي تم تخزينها</p>
                        </div>
                        <button class="btn-outline btn-sm" id="clearReportsBtn"><i class="las la-trash-alt"></i> مسح السجل</button>
                    </div>
                    <div id="recentReportsListView" class="space-y-3"></div>
                    <div id="reportViewInline" style="display:none;">
                        <div class="border-t border-[var(--border-color)] pt-4 mt-4">
                            <div class="flex items-center justify-between mb-4">
                                <div>
                                    <h3 class="text-xl font-bold text-[var(--color-white)]" id="viewReportTitle">تقرير سابق</h3>
                                    <p class="text-sm text-[var(--color-muted)]" id="viewReportDate"></p>
                                </div>
                                <button class="btn-outline btn-sm" id="closeInlineViewBtn"><i class="las la-times"></i> إغلاق</button>
                            </div>
                            <div class="overflow-x-auto">
                                <table class="visa-table" id="viewReportTable">
                                    <thead>
                                        <tr><th style="width:8%;text-align:center;">#</th><th style="width:46%;">المبلغ (ج.م)</th><th style="width:46%;text-align:center;">التاريخ والوقت</th></tr>
                                    </thead>
                                    <tbody id="viewReportTbody"></tbody>
                                    <tfoot>
                                        <tr class="total-row">
                                            <td style="text-align:center;">-</td>
                                            <td id="viewReportTotal">0</td>
                                            <td style="text-align:center;">الإجمالي</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
    <div id="printArea" style="display:none;"></div>
    <div class="modal-overlay" id="successModal">
        <div class="modal-content text-center">
            <button class="modal-close" id="closeSuccessModal"><i class="las la-times"></i></button>
            <i class="las la-check-circle text-5xl text-primary mb-4"></i>
            <h3 class="text-xl font-bold mb-2 text-[var(--color-white)]">تم بنجاح</h3>
            <p id="successMessage" class="text-[var(--color-muted)]"></p>
            <button id="okSuccessBtn" class="btn-primary mt-6 w-full justify-center">حسناً</button>
        </div>
    </div>
    <script>
        (function() {
            const arabicToEnglishMap = { '٠': '0', '١': '1', '٢': '2', '٣': '3', '٤': '4', '٥': '5', '٦': '6', '٧': '7', '٨': '8', '٩': '9' };
            function convertArabicNumerals(str) { return String(str).replace(/[٠-٩]/g, function(match) { return arabicToEnglishMap[match] || match; }); }
            function parseNumber(val) { const converted = convertArabicNumerals(String(val)); const cleaned = converted.replace(/,/g, '').trim(); const num = parseFloat(cleaned); return isNaN(num) ? 0 : num; }
            function formatNumber(num) { if (num === 0 || num === -0) return '0'; const abs = Math.abs(num); const formatted = abs.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 }); return num < 0 ? '-' + formatted : formatted; }
            function formatDateTime12(isoString) { const d = new Date(isoString); if (isNaN(d.getTime())) return ''; let hours = d.getHours(); const minutes = String(d.getMinutes()).padStart(2, '0'); const ampm = hours >= 12 ? 'PM' : 'AM'; hours = hours % 12; hours = hours ? hours : 12; const hStr = String(hours).padStart(2, '0'); const day = String(d.getDate()).padStart(2, '0'); const month = String(d.getMonth() + 1).padStart(2, '0'); return day + '-' + month + ' ' + hStr + ':' + minutes + ' ' + ampm; }
            function getNowISO() { return new Date().toISOString(); }
            function getNowFormatted12() { return formatDateTime12(getNowISO()); }
            function getFormattedDateArabic() { return new Date().toLocaleDateString('ar-EG', { year: 'numeric', month: 'numeric', day: 'numeric' }); }
            function updateLastUpdateSpan() { const span = document.getElementById('lastUpdateSpan'); if (span) span.textContent = 'آخر تحديث: ' + getFormattedDateArabic(); }

            const sidebar = document.getElementById('dashboardSidebar');
            const headerAvatar = document.getElementById('headerAvatar');
            function openSidebar() { sidebar.classList.add('mobile-open'); sidebar.classList.remove('mobile-closed'); }
            function closeSidebar() { sidebar.classList.remove('mobile-open'); sidebar.classList.add('mobile-closed'); }
            if (window.innerWidth < 1025) sidebar.classList.add('mobile-closed');
            window.addEventListener('resize', function() { if (window.innerWidth >= 1025) { sidebar.classList.remove('mobile-open', 'mobile-closed'); } else { if (!sidebar.classList.contains('mobile-open')) sidebar.classList.add('mobile-closed'); } });
            if (headerAvatar) { headerAvatar.addEventListener('click', function(e) { e.stopPropagation(); if (window.innerWidth < 1025) { if (sidebar.classList.contains('mobile-open')) closeSidebar(); else openSidebar(); } }); }
            document.addEventListener('click', function(e) { if (window.innerWidth < 1025 && sidebar.classList.contains('mobile-open')) { if (!sidebar.contains(e.target) && e.target !== headerAvatar && !headerAvatar.contains(e.target)) { closeSidebar(); } } });
            const sidebarItems = document.querySelectorAll('.sidebar-item');
            sidebarItems.forEach(item => { item.addEventListener('click', function() { if (this.id === 'logoutBtn') return; sidebarItems.forEach(i => i.classList.remove('active')); this.classList.add('active'); if (window.innerWidth < 1025) { closeSidebar(); } }); });
            const logoutBtn = document.getElementById('logoutBtn'); if (logoutBtn) { logoutBtn.addEventListener('click', (e) => { e.preventDefault(); if (confirm('هل أنت متأكد من تسجيل الخروج من لوحة التحكم؟')) window.location.href = '/'; }); }

            const successModal = document.getElementById('successModal');
            const closeSuccessModal = document.getElementById('closeSuccessModal');
            const okSuccessBtn = document.getElementById('okSuccessBtn');
            const successMessageEl = document.getElementById('successMessage');
            function showSuccess(msg) { successMessageEl.textContent = msg; successModal.classList.add('active'); }
            function hideSuccess() { successModal.classList.remove('active'); }
            closeSuccessModal.addEventListener('click', hideSuccess);
            okSuccessBtn.addEventListener('click', hideSuccess);
            window.addEventListener('click', (e) => { if (e.target === successModal) hideSuccess(); });

            let autoTimeMode = true;
            const timeToggleBtn = document.getElementById('timeToggleBtn');
            const timeToggleText = document.getElementById('timeToggleText');
            timeToggleBtn.addEventListener('click', function() {
                autoTimeMode = !autoTimeMode;
                if (autoTimeMode) {
                    this.classList.add('active');
                    timeToggleText.textContent = 'تلقائي';
                    this.querySelector('i').className = 'las la-clock';
                } else {
                    this.classList.remove('active');
                    timeToggleText.textContent = 'يدوي';
                    this.querySelector('i').className = 'las la-clock';
                }
                saveToSession();
            });

            const recentReportsListView = document.getElementById('recentReportsListView');
            const reportViewInline = document.getElementById('reportViewInline');
            const viewReportTitle = document.getElementById('viewReportTitle');
            const viewReportDate = document.getElementById('viewReportDate');
            const viewReportTbody = document.getElementById('viewReportTbody');
            const viewReportTotal = document.getElementById('viewReportTotal');
            const closeInlineViewBtn = document.getElementById('closeInlineViewBtn');

            function openReportInline(report) {
                viewReportTitle.textContent = report.name || 'تقرير فيز';
                viewReportDate.textContent = report.date || '';
                viewReportTbody.innerHTML = '';
                if (report.rows && report.rows.length) {
                    report.rows.forEach((row, idx) => {
                        const tr = document.createElement('tr');
                        const tdNum = document.createElement('td'); tdNum.style.textAlign = 'center'; tdNum.textContent = idx + 1;
                        const tdAmount = document.createElement('td'); tdAmount.textContent = row.amount || '0';
                        const tdDate = document.createElement('td'); tdDate.style.textAlign = 'center'; tdDate.textContent = row.displayDate || '';
                        tr.appendChild(tdNum); tr.appendChild(tdAmount); tr.appendChild(tdDate);
                        viewReportTbody.appendChild(tr);
                    });
                }
                viewReportTotal.textContent = report.total || '0';
                reportViewInline.style.display = 'block';
                recentReportsListView.style.display = 'none';
            }
            function closeInlineView() {
                reportViewInline.style.display = 'none';
                recentReportsListView.style.display = '';
            }
            closeInlineViewBtn.addEventListener('click', closeInlineView);

            function loadRecentReports() {
                try {
                    const stored = localStorage.getItem('visaStoredReports');
                    if (stored) {
                        const reports = JSON.parse(stored);
                        if (reports.length === 0) {
                            recentReportsListView.innerHTML = '<div class="text-center py-6 text-[var(--color-muted)] text-sm">لا توجد تقارير سابقة</div>';
                            return;
                        }
                        let html = '';
                        reports.forEach((report) => {
                            html += '<div class="report-list-item"><div class="report-info"><span class="text-primary"><i class="las la-file-alt text-xl"></i></span><div><p class="font-medium text-[var(--color-white)]">' + (report.name || 'تقرير فيز') + '</p><p class="text-xs text-[var(--color-muted)]">' + (report.date || '') + ' | الإجمالي: ' + (report.total || '0') + ' ج.م</p></div></div><div class="report-actions"><button class="btn-outline btn-xs view-report-btn" data-id="' + report.id + '" title="عرض التقرير"><i class="las la-eye"></i> عرض</button><button class="btn-outline btn-xs delete-report-btn" data-id="' + report.id + '" title="حذف التقرير" style="color:#ef4444;border-color:rgba(239,68,68,0.3);"><i class="las la-trash-alt"></i> حذف</button></div></div>';
                        });
                        recentReportsListView.innerHTML = html;
                        reportViewInline.style.display = 'none';
                        recentReportsListView.style.display = '';
                        document.querySelectorAll('.view-report-btn').forEach(btn => {
                            btn.addEventListener('click', function() {
                                const reportId = this.getAttribute('data-id');
                                const stored = localStorage.getItem('visaStoredReports');
                                if (stored) {
                                    const reports = JSON.parse(stored);
                                    const report = reports.find(r => r.id === reportId);
                                    if (report) openReportInline(report);
                                    else showSuccess('التقرير غير موجود.');
                                }
                            });
                        });
                        document.querySelectorAll('.delete-report-btn').forEach(btn => {
                            btn.addEventListener('click', function() {
                                const reportId = this.getAttribute('data-id');
                                deleteReportById(reportId);
                            });
                        });
                    } else {
                        recentReportsListView.innerHTML = '<div class="text-center py-6 text-[var(--color-muted)] text-sm">لا توجد تقارير سابقة</div>';
                    }
                } catch (e) {
                    recentReportsListView.innerHTML = '<div class="text-center py-6 text-[var(--color-muted)] text-sm">لا توجد تقارير سابقة</div>';
                }
            }
            function deleteReportById(reportId) {
                if (!confirm('هل أنت متأكد من حذف هذا التقرير؟')) return;
                try {
                    const stored = localStorage.getItem('visaStoredReports');
                    if (!stored) return;
                    let reports = JSON.parse(stored);
                    reports = reports.filter(r => r.id !== reportId);
                    localStorage.setItem('visaStoredReports', JSON.stringify(reports));
                    loadRecentReports();
                    showSuccess('تم حذف التقرير بنجاح.');
                } catch (e) {}
            }
            function storeReportToHistory(name, rows, total) {
                const report = {
                    id: 'visa_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6),
                    name: name,
                    date: getFormattedDateArabic(),
                    timestamp: new Date().toISOString(),
                    rows: rows,
                    total: total
                };
                try {
                    let reports = [];
                    const stored = localStorage.getItem('visaStoredReports');
                    if (stored) reports = JSON.parse(stored);
                    reports.unshift(report);
                    if (reports.length > 20) reports = reports.slice(0, 20);
                    localStorage.setItem('visaStoredReports', JSON.stringify(reports));
                    loadRecentReports();
                } catch (e) {}
            }
            document.getElementById('clearReportsBtn').addEventListener('click', function() {
                if (!confirm('هل أنت متأكد من مسح جميع التقارير المخزنة؟')) return;
                localStorage.removeItem('visaStoredReports');
                recentReportsListView.innerHTML = '<div class="text-center py-6 text-[var(--color-muted)] text-sm">لا توجد تقارير سابقة</div>';
                showSuccess('تم مسح سجل التقارير بنجاح.');
            });
            loadRecentReports();

            const tbody = document.getElementById('visaTbody');
            const totalAmountEl = document.getElementById('totalAmount');
            const visaNameInput = document.getElementById('visaNameInput');
            const LOGO_URL = 'https://files.catbox.moe/27w55o.png';
            let printPending = false;

            function updateTotal() { let total = 0; const rows = tbody.querySelectorAll('tr'); rows.forEach(row => { const input = row.querySelector('.amount-input'); if (input) { const val = parseNumber(input.value); total += val; } }); totalAmountEl.textContent = formatNumber(total); }
            function updateAllSerialNumbers() { const rows = tbody.querySelectorAll('tr'); rows.forEach((row, index) => { const serialCell = row.querySelector('.serial-cell'); if (serialCell) { serialCell.textContent = index + 1; } }); }
            function focusInput(input) { if (input) { input.focus(); if (input.type === 'text' && input.value) input.setSelectionRange(input.value.length, input.value.length); } }
            function setRowDateTime(tr) { const amountInput = tr.querySelector('.amount-input'); const datetimeInput = tr.querySelector('.datetime-input'); if (!amountInput || !datetimeInput) return; const val = amountInput.value.replace(/,/g, '').trim(); if (val !== '' && parseFloat(val) >= 0) { const nowISO = getNowISO(); const nowFormatted = getNowFormatted12(); datetimeInput.value = nowFormatted; datetimeInput.setAttribute('data-iso', nowISO); } else if (val === '') { datetimeInput.value = ''; datetimeInput.setAttribute('data-iso', ''); } }

            function createRowElement(amountStr, isoString) {
                const tr = document.createElement('tr');
                const serialTd = document.createElement('td');
                serialTd.className = 'serial-cell';
                serialTd.textContent = '0';
                const amountTd = document.createElement('td');
                const amountInput = document.createElement('input');
                amountInput.type = 'text';
                amountInput.className = 'input-field amount-input';
                amountInput.placeholder = 'أدخل المبلغ';
                amountInput.setAttribute('inputmode', 'decimal');
                const formattedAmount = amountStr ? formatNumber(parseNumber(amountStr)) : '';
                amountInput.value = formattedAmount;
                const datetimeTd = document.createElement('td');
                datetimeTd.style.textAlign = 'center';
                const datetimeInput = document.createElement('input');
                datetimeInput.type = 'text';
                datetimeInput.className = 'datetime-input';
                datetimeInput.placeholder = 'DD-MM HH:MM AM/PM';
                datetimeInput.dir = 'ltr';
                if (isoString && isoString.trim() !== '') {
                    datetimeInput.value = formatDateTime12(isoString);
                    datetimeInput.setAttribute('data-iso', isoString);
                } else {
                    datetimeInput.value = '';
                    datetimeInput.setAttribute('data-iso', '');
                }
                const actionTd = document.createElement('td');
                const deleteBtn = document.createElement('button');
                deleteBtn.className = 'delete-row-btn';
                deleteBtn.tabIndex = -1;
                deleteBtn.innerHTML = '<i class="las la-trash-alt"></i>';
                deleteBtn.addEventListener('click', function() {
                    if (tbody.children.length <= 1) { showSuccess('لا يمكن حذف الصف الأخير.'); return; }
                    tr.remove();
                    updateTotal();
                    updateAllSerialNumbers();
                    saveToSession();
                });
                amountTd.appendChild(amountInput);
                datetimeTd.appendChild(datetimeInput);
                actionTd.appendChild(deleteBtn);
                tr.appendChild(serialTd);
                tr.appendChild(amountTd);
                tr.appendChild(datetimeTd);
                tr.appendChild(actionTd);
                amountInput.addEventListener('input', function() {
                    let val = this.value.replace(/,/g, '');
                    const num = parseFloat(val);
                    if (!isNaN(num) && val !== '') this.value = formatNumber(num);
                    else if (val === '') this.value = '';
                    updateTotal();
                    saveToSession();
                    updateLastUpdateSpan();
                });
                amountInput.addEventListener('blur', function() {
                    if (autoTimeMode) {
                        setRowDateTime(tr);
                    }
                    updateTotal();
                    saveToSession();
                    updateLastUpdateSpan();
                });
                amountInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') { e.preventDefault(); if (autoTimeMode) { setRowDateTime(tr); } else { focusInput(datetimeInput); return; } const rows = Array.from(tbody.querySelectorAll('tr')); const rowIndex = rows.indexOf(tr); const isLastRow = rowIndex === rows.length - 1; if (isLastRow) { const newTr = addRowAtEnd('', ''); const newAmount = newTr.querySelector('.amount-input'); if (newAmount) focusInput(newAmount); } else { const nextAmount = rows[rowIndex + 1].querySelector('.amount-input'); if (nextAmount) focusInput(nextAmount); } saveToSession(); updateLastUpdateSpan(); }
                    else if (e.key === 'ArrowDown') { e.preventDefault(); if (autoTimeMode) { setRowDateTime(tr); } const nextRow = tr.nextElementSibling; if (nextRow) { const nextAmount = nextRow.querySelector('.amount-input'); if (nextAmount) focusInput(nextAmount); } }
                    else if (e.key === 'ArrowUp') { e.preventDefault(); if (autoTimeMode) { setRowDateTime(tr); } const prevRow = tr.previousElementSibling; if (prevRow) { const prevAmount = prevRow.querySelector('.amount-input'); if (prevAmount) focusInput(prevAmount); } }
                });
                datetimeInput.addEventListener('blur', function() {
                    const amountInput = tr.querySelector('.amount-input');
                    if (amountInput && amountInput.value.trim() !== '') {
                        const iso = this.getAttribute('data-iso') || '';
                        if (!iso) {
                            const nowISO = getNowISO();
                            this.value = getNowFormatted12();
                            this.setAttribute('data-iso', nowISO);
                        }
                    }
                    saveToSession();
                    updateLastUpdateSpan();
                });
                datetimeInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') { e.preventDefault(); const rows = Array.from(tbody.querySelectorAll('tr')); const rowIndex = rows.indexOf(tr); const isLastRow = rowIndex === rows.length - 1; if (isLastRow) { const newTr = addRowAtEnd('', ''); const newAmount = newTr.querySelector('.amount-input'); if (newAmount) focusInput(newAmount); } else { const nextAmount = rows[rowIndex + 1].querySelector('.amount-input'); if (nextAmount) focusInput(nextAmount); } saveToSession(); updateLastUpdateSpan(); }
                    else if (e.key === 'ArrowDown') { e.preventDefault(); const nextRow = tr.nextElementSibling; if (nextRow) { const nextDt = nextRow.querySelector('.datetime-input'); if (nextDt) focusInput(nextDt); } }
                    else if (e.key === 'ArrowUp') { e.preventDefault(); const prevRow = tr.previousElementSibling; if (prevRow) { const prevDt = prevRow.querySelector('.datetime-input'); if (prevDt) focusInput(prevDt); } }
                });
                datetimeInput.addEventListener('input', function() { saveToSession(); updateLastUpdateSpan(); });
                updateAllSerialNumbers();
                return tr;
            }

            function addRowAtEnd(amountStr, isoString) { const tr = createRowElement(amountStr, isoString); tbody.appendChild(tr); updateTotal(); updateAllSerialNumbers(); return tr; }
            function clearAllRows() { tbody.innerHTML = ''; addRowAtEnd('', ''); updateTotal(); updateAllSerialNumbers(); }
            function getTableData() { const rows = tbody.querySelectorAll('tr'); const data = []; rows.forEach(row => { const amountInput = row.querySelector('.amount-input'); const datetimeInput = row.querySelector('.datetime-input'); if (amountInput && datetimeInput) { data.push({ amount: amountInput.value || '0', iso: datetimeInput.getAttribute('data-iso') || '', displayDate: datetimeInput.value || '' }); } }); return data; }
            function loadTableData(data) { tbody.innerHTML = ''; if (data.length === 0) addRowAtEnd('', ''); else data.forEach(item => addRowAtEnd(item.amount, item.iso)); updateTotal(); updateAllSerialNumbers(); }
            function saveToSession() { const data = getTableData(); const name = visaNameInput.value || ''; const payload = { name: name, rows: data, autoTime: autoTimeMode, timestamp: new Date().toISOString() }; try { localStorage.setItem('visaReportData', JSON.stringify(payload)); } catch (e) {} }
            function loadFromSession() { try { const stored = localStorage.getItem('visaReportData'); if (stored) { const payload = JSON.parse(stored); visaNameInput.value = payload.name || ''; if (payload.autoTime !== undefined) { autoTimeMode = payload.autoTime; timeToggleBtn.classList.toggle('active', autoTimeMode); timeToggleText.textContent = autoTimeMode ? 'تلقائي' : 'يدوي'; timeToggleBtn.querySelector('i').className = 'las la-clock'; } loadTableData(payload.rows || []); return true; } } catch (e) {} return false; }

            visaNameInput.addEventListener('input', function() { saveToSession(); updateLastUpdateSpan(); });
            document.getElementById('storeBtn').addEventListener('click', function() {
                saveToSession();
                const name = visaNameInput.value || '';
                const rows = getTableData();
                const total = totalAmountEl.textContent;
                storeReportToHistory(name, rows, total);
                showSuccess('تم تخزين التقرير بنجاح.');
                updateLastUpdateSpan();
            });
            document.getElementById('addRowBtn').addEventListener('click', function() { addRowAtEnd('', ''); saveToSession(); updateLastUpdateSpan(); });
            document.getElementById('addRowsBatchBtn').addEventListener('click', function() { const countInput = document.getElementById('rowsCountInput'); let count = parseInt(countInput.value) || 1; if (count < 1) count = 1; if (count > 50) count = 50; countInput.value = count; for (let i = 0; i < count; i++) addRowAtEnd('', ''); saveToSession(); updateLastUpdateSpan(); showSuccess('تم إضافة ' + count + ' صفوف جديدة.'); });
            document.getElementById('clearRowsBtn').addEventListener('click', function() { if (tbody.children.length === 0) return; if (confirm('هل أنت متأكد من مسح جميع الصفوف؟')) { clearAllRows(); saveToSession(); updateLastUpdateSpan(); } });
            document.getElementById('printInvoiceBtn').addEventListener('click', function() {
                if (printPending) return;
                printPending = true;
                saveToSession();
                const printArea = document.getElementById('printArea');
                const name = visaNameInput.value || '';
                const dateStr = getFormattedDateArabic();
                let html = '';
                html += '<table class="header-table" style="width:100%; border-collapse:collapse; margin-bottom:2mm; border:none;">';
                html += '<tr>';
                html += '<td style="width:60%; text-align:right; vertical-align:bottom; padding:0; border:none;">';
                html += '<div class="print-header-section">';
                html += '<div class="restaurant-name">' + name + '</div>';
                html += '<div class="print-date">' + dateStr + '</div>';
                html += '</div>';
                html += '</td>';
                html += '<td class="logo-cell" style="width:40%;">';
                html += '<img src="' + LOGO_URL + '" style="max-width:15mm; height:auto; display:block;" alt="Logo" />';
                html += '</td>';
                html += '</tr></table>';
                html += '<table>';
                html += '<thead><tr><th class="print-serial">#</th><th class="print-amount">المبلغ (ج.م)</th><th class="print-datetime">التاريخ والوقت</th></tr></thead><tbody>';
                const rows = tbody.querySelectorAll('tr');
                rows.forEach((row, index) => {
                    const amountInput = row.querySelector('.amount-input');
                    const datetimeInput = row.querySelector('.datetime-input');
                    if (amountInput && datetimeInput) {
                        html += '<tr><td class="print-serial">' + (index + 1) + '</td><td class="print-amount">' + (amountInput.value || '0') + '</td><td class="print-datetime">' + (datetimeInput.value || '') + '</td></tr>';
                    }
                });
                html += '<tr class="total-row"><td class="print-serial">-</td><td class="print-amount"><strong>' + totalAmountEl.textContent + '</strong></td><td class="print-datetime"><strong>الإجمالي</strong></td></tr>';
                html += '</tbody></table>';
                html += '<div class="footer"><div></div><div class="dev">Developed by Abdelrahman Mohamed</div><div class="dev-version">v3.2</div></div>';
                printArea.innerHTML = html;
                printArea.style.display = 'block';
                window.addEventListener('afterprint', function onAfterPrint() {
                    printArea.style.display = 'none';
                    printPending = false;
                    window.removeEventListener('afterprint', onAfterPrint);
                }, { once: true });
                window.print();
            });
            document.getElementById('exportVisaBtn').addEventListener('click', function() {
                saveToSession();
                const name = visaNameInput.value || '';
                let csv = '#,المبلغ (ج.م),التاريخ والوقت\n';
                const rows = tbody.querySelectorAll('tr');
                let rowIndex = 1;
                rows.forEach(row => {
                    const amountInput = row.querySelector('.amount-input');
                    const datetimeInput = row.querySelector('.datetime-input');
                    if (amountInput && datetimeInput) {
                        csv += rowIndex + ',' + (amountInput.value || '0') + ',' + (datetimeInput.value || '') + '\n';
                        rowIndex++;
                    }
                });
                csv += '-,الإجمالي,' + totalAmountEl.textContent + '\n';
                const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = (name || 'تقرير_فيزا') + '.csv';
                link.click();
                showSuccess('تم تصدير التقرير بصيغة CSV بنجاح.');
            });

            const userAvatarImg = document.getElementById('userAvatar'); if (userAvatarImg) { userAvatarImg.addEventListener('click', () => { const input = document.createElement('input'); input.type = 'file'; input.accept = 'image/*'; input.onchange = (e) => { const file = e.target.files[0]; if (file) { const reader = new FileReader(); reader.onload = (ev) => { userAvatarImg.src = ev.target.result; const headerAv = document.getElementById('headerAvatar'); if (headerAv) headerAv.src = ev.target.result; showSuccess('تم تحديث الصورة الشخصية.'); }; reader.readAsDataURL(file); } }; input.click(); }); }

            document.addEventListener('DOMContentLoaded', function() {
                const themeToggles = document.querySelectorAll('.theme-toggle');
                const body = document.body;
                const applyTheme = (theme) => { const isDark = theme === 'dark'; body.classList.toggle('light', !isDark); themeToggles.forEach(toggle => toggle.classList.toggle('dark', isDark)); localStorage.setItem('theme', theme); };
                const savedTheme = localStorage.getItem('theme') || 'dark';
                applyTheme(savedTheme);
                themeToggles.forEach(toggle => { toggle.addEventListener('click', () => { const isDark = body.classList.contains('light') === false; applyTheme(isDark ? 'light' : 'dark'); }); });
                if (!loadFromSession()) {
                    tbody.innerHTML = '';
                    addRowAtEnd('', '');
                    addRowAtEnd('', '');
                    addRowAtEnd('', '');
                    updateTotal();
                    updateAllSerialNumbers();
                }
                loadRecentReports();
                updateLastUpdateSpan();
            });
        })();
    </script>
</body>
</html>
