    <script>
        (function() {
            const appData = window.__APP_DATA__ || {};
            const userData = appData.user || {};
            const serverAdvances = Array.isArray(appData.advances) ? appData.advances : null;
            const token = appData.token || "";
            const apiBase = appData.api || "";
            const restaurantId = "1";
            const arabicToEnglishMap = { '٠': '0', '١': '1', '٢': '2', '٣': '3', '٤': '4', '٥': '5', '٦': '6', '٧': '7', '٨': '8', '٩': '9' };
            const PRINT_LOGO = 'https://files.catbox.moe/05wiyk.png';
            let printLogoURL = PRINT_LOGO;

            let allReports = [];
            let currentReportsPage = 1;
            let reportsPageSize = 5;
            let currentEditReportId = null;
            let sortOrder = 'newest';
            let previousState = null;

            document.getElementById('userFullName').textContent = userData.name || 'مستخدم';
            document.getElementById('role').textContent = userData.job_title || userData.account_type || 'مستخدم';
            if (userData.profile_picture) {
                document.getElementById('userAvatar').src = userData.profile_picture;
                document.getElementById('headerAvatar').src = userData.profile_picture;
            }

            function convertArabicNumerals(str) { return String(str).replace(/[٠-٩]/g, function(match) { return arabicToEnglishMap[match] || match; }); }
            function parseNumber(val) { const converted = convertArabicNumerals(String(val)); const cleaned = converted.replace(/,/g, '').trim(); const num = parseFloat(cleaned); return isNaN(num) ? 0 : num; }
            function formatNumber(num) { if (num === 0 || num === -0) return '0'; const abs = Math.abs(num); const formatted = abs.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 }); return num < 0 ? '-' + formatted : formatted; }
            function formatDateForInput(date) { const yyyy = date.getFullYear(); const mm = String(date.getMonth() + 1).padStart(2, '0'); const dd = String(date.getDate()).padStart(2, '0'); return yyyy + '-' + mm + '-' + dd; }

            const tbody = document.getElementById('restaurantTbody');
            const totalAmountEl = document.getElementById('totalAmount');
            const restaurantNameInput = document.getElementById('restaurantNameInput');
            const dateToggleBtn = document.getElementById('dateToggleBtn');
            const dateToggleText = document.getElementById('dateToggleText');
            const reportDateInput = document.getElementById('reportDateInput');
            const storeBtn = document.getElementById('storeBtn');
            const cancelEditBtn = document.getElementById('cancelEditBtn');

            function updateTotal() {
                let total = 0;
                const rows = tbody.querySelectorAll('tr');
                rows.forEach(row => {
                    const input = row.querySelector('.amount-input');
                    if (input) total += parseNumber(input.value);
                });
                totalAmountEl.textContent = formatNumber(total);
            }

            function focusInput(input) {
                if (input) {
                    input.focus();
                    if (input.type === 'text' && input.value) input.setSelectionRange(input.value.length, input.value.length);
                }
            }

            function getInputsInRow(tr) {
                const descInput = tr.querySelector('.desc-input');
                const amountInput = tr.querySelector('.amount-input');
                return { descInput, amountInput };
            }

            function getCellIndex(input) {
                if (input.classList.contains('desc-input')) return 0;
                if (input.classList.contains('amount-input')) return 1;
                return -1;
            }

            function navigateCell(currentInput, rowDelta, cellDelta) {
                const currentTr = currentInput.closest('tr');
                if (!currentTr) return;
                const rows = Array.from(tbody.querySelectorAll('tr'));
                const currentRowIndex = rows.indexOf(currentTr);
                const currentCellIndex = getCellIndex(currentInput);
                const targetRowIndex = currentRowIndex + rowDelta;
                if (targetRowIndex < 0 || targetRowIndex >= rows.length) return;
                const targetRow = rows[targetRowIndex];
                const { descInput, amountInput } = getInputsInRow(targetRow);
                const targetCellIndex = cellDelta !== undefined ? cellDelta : currentCellIndex;
                if (targetCellIndex === 0 && descInput) focusInput(descInput);
                else if (targetCellIndex === 1 && amountInput) focusInput(amountInput);
            }

            function setupKeyboardNavigation(input) {
                input.addEventListener('keydown', function(e) {
                    const key = e.key;
                    const tr = this.closest('tr');
                    const rows = Array.from(tbody.querySelectorAll('tr'));
                    const rowIndex = rows.indexOf(tr);
                    const cellIndex = getCellIndex(this);

                    if (key === 'Enter') {
                        e.preventDefault();
                        const isLastRow = rowIndex === rows.length - 1;
                        const isAmountCell = cellIndex === 1;
                        if (isLastRow && isAmountCell) {
                            const newTr = addRowAtEnd('', '');
                            const { descInput } = getInputsInRow(newTr);
                            if (descInput) focusInput(descInput);
                            saveToSession();
                        } else if (isLastRow && cellIndex === 0) {
                            const { amountInput } = getInputsInRow(tr);
                            if (amountInput) focusInput(amountInput);
                        } else {
                            navigateCell(this, 1, cellIndex);
                        }
                    } else if (key === 'ArrowDown') {
                        e.preventDefault();
                        navigateCell(this, 1, cellIndex);
                    } else if (key === 'ArrowUp') {
                        e.preventDefault();
                        navigateCell(this, -1, cellIndex);
                    } else if (key === 'ArrowRight') {
                        e.preventDefault();
                        if (cellIndex === 1) navigateCell(this, 0, 0);
                    } else if (key === 'ArrowLeft') {
                        e.preventDefault();
                        if (cellIndex === 0) navigateCell(this, 0, 1);
                    } else if (key === 'Tab') {
                        e.preventDefault();
                        if (e.shiftKey) {
                            if (cellIndex === 1) navigateCell(this, 0, 0);
                            else if (cellIndex === 0 && rowIndex > 0) navigateCell(this, -1, 1);
                        } else {
                            if (cellIndex === 0) navigateCell(this, 0, 1);
                            else if (cellIndex === 1) {
                                if (rowIndex < rows.length - 1) navigateCell(this, 1, 0);
                                else {
                                    const newTr = addRowAtEnd('', '');
                                    const { descInput } = getInputsInRow(newTr);
                                    if (descInput) focusInput(descInput);
                                    saveToSession();
                                }
                            }
                        }
                    }
                });
            }

            function updateSignButton(row) {
                const amountInput = row.querySelector('.amount-input');
                const signBtn = row.querySelector('.sign-btn');
                if (!amountInput || !signBtn) return;
                const val = parseNumber(amountInput.value);
                if (val < 0) {
                    signBtn.classList.add('negative');
                    signBtn.classList.remove('positive');
                    signBtn.innerHTML = '<i class="las la-minus-circle"></i>';
                    signBtn.title = 'القيمة سالبة - اضغط لجعلها موجبة';
                } else {
                    signBtn.classList.add('positive');
                    signBtn.classList.remove('negative');
                    signBtn.innerHTML = '<i class="las la-plus-circle"></i>';
                    signBtn.title = 'القيمة موجبة - اضغط لجعلها سالبة';
                }
            }

            function createRowElement(description, amount) {
                const tr = document.createElement('tr');

                const descTd = document.createElement('td');
                const descInput = document.createElement('input');
                descInput.type = 'text';
                descInput.className = 'input-field desc-input';
                descInput.placeholder = 'أدخل البيان';
                descInput.value = description || '';
                setupKeyboardNavigation(descInput);
                descTd.appendChild(descInput);

                const amountTd = document.createElement('td');
                const amountInput = document.createElement('input');
                amountInput.type = 'text';
                amountInput.className = 'input-field amount-input';
                amountInput.placeholder = 'المبلغ';
                amountInput.value = amount ? formatNumber(parseNumber(amount)) : '';
                amountInput.setAttribute('inputmode', 'decimal');
                setupKeyboardNavigation(amountInput);
                amountTd.appendChild(amountInput);

                const actionTd = document.createElement('td');
                actionTd.style.whiteSpace = 'nowrap';
                actionTd.style.textAlign = 'right';

                const upBtn = document.createElement('button');
                upBtn.className = 'row-action-btn arrow-btn';
                upBtn.tabIndex = -1;
                upBtn.title = 'إضافة صف للأعلى';
                upBtn.innerHTML = '<i class="las la-arrow-up"></i>';
                upBtn.addEventListener('click', function() {
                    const newTr = createRowElement('', '');
                    tbody.insertBefore(newTr, tr);
                    updateTotal();
                    saveToSession();
                    const { descInput: newDesc } = getInputsInRow(newTr);
                    if (newDesc) focusInput(newDesc);
                });

                const downBtn = document.createElement('button');
                downBtn.className = 'row-action-btn arrow-btn';
                downBtn.tabIndex = -1;
                downBtn.title = 'إضافة صف للأسفل';
                downBtn.innerHTML = '<i class="las la-arrow-down"></i>';
                downBtn.addEventListener('click', function() {
                    const newTr = createRowElement('', '');
                    if (tr.nextSibling) tbody.insertBefore(newTr, tr.nextSibling);
                    else tbody.appendChild(newTr);
                    updateTotal();
                    saveToSession();
                    const { descInput: newDesc } = getInputsInRow(newTr);
                    if (newDesc) focusInput(newDesc);
                });

                const signBtn = document.createElement('button');
                signBtn.className = 'row-action-btn sign-btn positive';
                signBtn.tabIndex = -1;
                signBtn.title = 'تغيير إشارة المبلغ (جمع / طرح)';
                signBtn.innerHTML = '<i class="las la-plus-circle"></i>';
                signBtn.addEventListener('click', function() {
                    const currentVal = parseNumber(amountInput.value);
                    if (currentVal === 0) {
                        amountInput.value = '';
                        updateSignButton(tr);
                        updateTotal();
                        saveToSession();
                        return;
                    }
                    const newVal = -currentVal;
                    amountInput.value = formatNumber(newVal);
                    updateSignButton(tr);
                    updateTotal();
                    saveToSession();
                });

                const deleteBtn = document.createElement('button');
                deleteBtn.className = 'row-action-btn delete-btn';
                deleteBtn.tabIndex = -1;
                deleteBtn.title = 'حذف الصف';
                deleteBtn.innerHTML = '<i class="las la-trash-alt"></i>';
                deleteBtn.addEventListener('click', function() {
                    if (tbody.children.length > 1) {
                        tr.remove();
                        updateTotal();
                        saveToSession();
                    } else {
                        Swal.fire('تنبيه', 'لا يمكن حذف الصف الأخير.', 'info');
                    }
                });

                actionTd.appendChild(upBtn);
                actionTd.appendChild(downBtn);
                actionTd.appendChild(signBtn);
                actionTd.appendChild(deleteBtn);

                tr.appendChild(descTd);
                tr.appendChild(amountTd);
                tr.appendChild(actionTd);

                amountInput.addEventListener('input', function() {
                    updateTotal();
                    updateSignButton(tr);
                });
                amountInput.addEventListener('blur', function() {
                    let val = convertArabicNumerals(this.value).replace(/,/g, '');
                    const num = parseFloat(val);
                    if (!isNaN(num) && val !== '') this.value = formatNumber(num);
                    else this.value = '';
                    updateTotal();
                    updateSignButton(tr);
                    saveToSession();
                });
                descInput.addEventListener('input', function() { saveToSession(); });

                updateSignButton(tr);
                return tr;
            }

            function addRowAtEnd(description, amount) {
                const tr = createRowElement(description, amount);
                tbody.appendChild(tr);
                updateTotal();
                return tr;
            }

            function clearAllRows() {
                tbody.innerHTML = '';
                addRowAtEnd('', '');
                updateTotal();
            }

            function getTableData() {
                const rows = tbody.querySelectorAll('tr');
                const data = [];
                rows.forEach(row => {
                    const descInput = row.querySelector('.desc-input');
                    const amountInput = row.querySelector('.amount-input');
                    if (descInput && amountInput) data.push({ desc: descInput.value || '', amount: amountInput.value || '0' });
                });
                return data;
            }

            function loadTableData(data) {
                tbody.innerHTML = '';
                if (data.length === 0) addRowAtEnd('', '');
                else data.forEach(item => addRowAtEnd(item.desc, item.amount));
                updateTotal();
            }

            function saveToSession() {
                const data = getTableData();
                const name = restaurantNameInput.value || '';
                const isAuto = dateToggleBtn.classList.contains('active');
                const customDate = reportDateInput.value;
                const payload = { name: name, rows: data, isAuto: isAuto, customDate: customDate, timestamp: new Date().toISOString() };
                try { localStorage.setItem('advanceReportData', JSON.stringify(payload)); } catch (e) {}
            }

            function updateDateToggleUI(isAuto) {
                const icon = dateToggleBtn.querySelector('i');
                const span = dateToggleBtn.querySelector('span');
                if (isAuto) {
                    dateToggleBtn.classList.add('active');
                    dateToggleBtn.classList.remove('inactive');
                    if (icon) icon.className = 'las la-calendar-check';
                    if (span) span.textContent = 'تلقائي';
                    reportDateInput.disabled = true;
                } else {
                    dateToggleBtn.classList.remove('active');
                    dateToggleBtn.classList.add('inactive');
                    if (icon) icon.className = 'las la-calendar-alt';
                    if (span) span.textContent = 'يدوي';
                    reportDateInput.disabled = false;
                }
            }

            function loadFromSession() {
                try {
                    const stored = localStorage.getItem('advanceReportData');
                    if (stored) {
                        const payload = JSON.parse(stored);
                        restaurantNameInput.value = payload.name || '';
                        const isAuto = payload.isAuto !== undefined ? payload.isAuto : true;
                        updateDateToggleUI(isAuto);
                        if (payload.customDate) reportDateInput.value = payload.customDate;
                        else reportDateInput.value = formatDateForInput(new Date());
                        loadTableData(payload.rows || []);
                        return true;
                    }
                } catch (e) {}
                return false;
            }

            function getReportDateString() {
                const now = new Date();
                const isAuto = dateToggleBtn.classList.contains('active');
                const customDate = reportDateInput.value;
                let dateObj;
                if (now.getHours() < 8) {
                    dateObj = new Date(now);
                    dateObj.setDate(dateObj.getDate() - 1);
                } else {
                    if (isAuto || !customDate) dateObj = new Date(now);
                    else dateObj = new Date(customDate + 'T00:00:00');
                }
                const day = String(dateObj.getDate()).padStart(2, '0');
                const month = String(dateObj.getMonth() + 1).padStart(2, '0');
                const year = dateObj.getFullYear();
                return day + '/' + month + '/' + year;
            }

            function buildPrintHTML(name, dateStr, rowsData, totalText) {
                const LOGO_URL = printLogoURL;
                let html = '';
                html += '<table class="header-table" style="width:100%; border-collapse:collapse; margin-bottom:3mm; border:none;">';
                html += '<tr>';
                html += '<td class="title-cell-print" style="width:62%; text-align:right; vertical-align:bottom; padding:0; border:none; background:transparent;">';
                html += '<div class="restaurant-name">' + (name || '') + '</div>';
                html += '<div class="print-date">' + (dateStr || '') + '</div>';
                html += '</td>';
                html += '<td class="logo-cell" style="width:38%; text-align:left; vertical-align:bottom; padding:0; border:none; background:transparent;">';
                html += '<img src="' + LOGO_URL + '" style="max-width:27mm; height:auto; display:block;" alt="Logo" />';
                html += '</td>';
                html += '</tr></table>';
                html += '<div class="header-separator"></div>';
                html += '<table>';
                html += '<thead><tr><th style="width:62%;">البيان</th><th style="width:38%;">المبلغ (ج.م)</th></tr></thead><tbody>';
                if (rowsData && rowsData.length) {
                    rowsData.forEach(row => {
                        html += '<tr><td>' + (row.desc || '') + '</td><td>' + (row.amount || '0') + '</td></tr>';
                    });
                }
                html += '<tr class="total-row"><td style="width:62%;"><strong>الإجمالي</strong></td><td style="width:38%;"><strong>' + (totalText || '0') + '</strong></td></tr>';
                html += '</tbody></table>';
                html += '<div class="footer"><div class="dev"><p>Developed By Abdelrahman & Mando</p><p>&lt;&nbsp;All Copyrights Reserved&nbsp;&copy;&nbsp;2026&nbsp;&gt;</p></div><div class="dev-version">v3.2</div></div>';
                return html;
            }

            const reportViewCard = document.getElementById('reportViewCard');
            const viewReportTitle2 = document.getElementById('viewReportTitle2');
            const viewReportDate2 = document.getElementById('viewReportDate2');
            const viewReportTbody2 = document.getElementById('viewReportTbody2');
            const viewReportTotal2 = document.getElementById('viewReportTotal2');
            const recentReportsCard = document.getElementById('recentReportsCard');
            const recentReportsList = document.getElementById('recentReportsList');
            let currentViewReportId = null;

            function hideReportView() {
                reportViewCard.style.display = 'none';
                recentReportsCard.style.display = 'block';
                currentViewReportId = null;
            }

            function viewReportById(reportId) {
                let report = null;
                if (serverAdvances) report = serverAdvances.find(r => String(r.id) === String(reportId));
                if (!report) {
                    const stored = localStorage.getItem('advanceStoredReports');
                    if (stored) {
                        const reports = JSON.parse(stored);
                        report = reports.find(r => String(r.id) === String(reportId));
                    }
                }
                if (!report) { Swal.fire('خطأ', 'التقرير غير موجود.', 'error'); return; }
                currentViewReportId = reportId;
                viewReportTitle2.textContent = report.name || 'تقرير';
                viewReportDate2.textContent = report.date || '';
                viewReportTbody2.innerHTML = '';
                if (report.rows && report.rows.length) {
                    report.rows.forEach(row => {
                        const tr = document.createElement('tr');
                        const tdDesc = document.createElement('td');
                        tdDesc.textContent = row.desc || '';
                        const tdAmount = document.createElement('td');
                        tdAmount.textContent = row.amount || '0';
                        tr.appendChild(tdDesc);
                        tr.appendChild(tdAmount);
                        viewReportTbody2.appendChild(tr);
                    });
                }
                viewReportTotal2.textContent = report.total || '0';
                reportViewCard.style.display = 'block';
                recentReportsCard.style.display = 'none';
            }

            function loadRecentReports() {
                let reports = serverAdvances || [];
                if (!Array.isArray(reports) || reports.length === 0) {
                    try {
                        const stored = localStorage.getItem('advanceStoredReports');
                        if (stored) reports = JSON.parse(stored);
                    } catch (e) { reports = []; }
                }
                allReports = Array.isArray(reports) ? reports : [];
                if (allReports.length === 0) {
                    recentReportsList.innerHTML = '<div class="text-center py-6 text-[var(--color-muted)] text-sm">لا توجد تقارير سابقة</div>';
                    document.getElementById('prevReportsPageBtn').disabled = true;
                    document.getElementById('nextReportsPageBtn').disabled = true;
                    document.getElementById('reportsPageIndicator').textContent = '0 / 0';
                    return;
                }
                currentReportsPage = 1;
                renderRecentReportsPage();
                document.getElementById('reportsPageSize').value = reportsPageSize;
            }

            function getSortTime(report) {
                if (report.timestamp) return new Date(report.timestamp).getTime();
                const id = String(report.id || '');
                const match = id.match(/^rep_(\d+)_/);
                if (match) return parseInt(match[1]);
                return 0;
            }

            function sortReports() {
                if (sortOrder === 'oldest') {
                    allReports.sort((a, b) => getSortTime(a) - getSortTime(b));
                } else {
                    allReports.sort((a, b) => getSortTime(b) - getSortTime(a));
                }
            }

            function renderRecentReportsPage() {
                sortReports();
                const totalPages = Math.ceil(allReports.length / reportsPageSize);
                if (currentReportsPage < 1) currentReportsPage = 1;
                if (currentReportsPage > totalPages) currentReportsPage = totalPages;
                const start = (currentReportsPage - 1) * reportsPageSize;
                const end = start + reportsPageSize;
                const pageReports = allReports.slice(start, end);
                let html = '';
                pageReports.forEach((report) => {
                    html += '<div class="report-list-item"><div class="report-info"><span class="text-primary"><i class="las la-file-alt text-xl"></i></span><div><p class="font-medium text-[var(--color-white)]">' + (report.name || 'تقرير') + '</p><p class="text-xs text-[var(--color-muted)]">' + (report.date || '') + '</p></div></div><div class="report-actions"><button class="btn-outline btn-xs view-report-btn" data-id="' + report.id + '" title="عرض التقرير"><i class="las la-eye"></i> عرض</button><button class="btn-outline btn-xs edit-report-btn" data-id="' + report.id + '" title="تعديل التقرير"><i class="las la-edit"></i> تعديل</button><button class="btn-outline btn-xs delete-report-btn" data-id="' + report.id + '" title="حذف التقرير" style="color:#ef4444;border-color:rgba(239,68,68,0.3);"><i class="las la-trash-alt"></i> حذف</button></div></div>';
                });
                recentReportsList.innerHTML = html;
                document.querySelectorAll('.view-report-btn').forEach(btn => {
                    btn.addEventListener('click', function() { viewReportById(this.getAttribute('data-id')); });
                });
                document.querySelectorAll('.edit-report-btn').forEach(btn => {
                    btn.addEventListener('click', function() { editReportById(this.getAttribute('data-id')); });
                });
                document.querySelectorAll('.delete-report-btn').forEach(btn => {
                    btn.addEventListener('click', function() { deleteReportById(this.getAttribute('data-id')); });
                });
                document.getElementById('reportsPageIndicator').textContent = currentReportsPage + ' / ' + totalPages;
                document.getElementById('prevReportsPageBtn').disabled = currentReportsPage <= 1;
                document.getElementById('nextReportsPageBtn').disabled = currentReportsPage >= totalPages;
            }

            document.getElementById('sortOrderSelect').addEventListener('change', function() {
                sortOrder = this.value;
                currentReportsPage = 1;
                renderRecentReportsPage();
            });

            document.getElementById('reportsPageSize').addEventListener('change', function() {
                reportsPageSize = parseInt(this.value);
                currentReportsPage = 1;
                renderRecentReportsPage();
            });
            document.getElementById('prevReportsPageBtn').addEventListener('click', function() {
                if (currentReportsPage > 1) { currentReportsPage--; renderRecentReportsPage(); }
            });
            document.getElementById('nextReportsPageBtn').addEventListener('click', function() {
                const totalPages = Math.ceil(allReports.length / reportsPageSize);
                if (currentReportsPage < totalPages) { currentReportsPage++; renderRecentReportsPage(); }
            });

            function deleteReportById(reportId) {
                Swal.fire({
                    title: 'حذف التقرير',
                    text: 'أدخل كلمة المرور للحذف',
                    input: 'password',
                    inputPlaceholder: 'كلمة المرور',
                    showCancelButton: true,
                    confirmButtonText: 'حذف',
                    cancelButtonText: 'إلغاء',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed && result.value) {
                        const password = result.value;
                        fetch(apiBase + '/api/expenses/advances-delete', {
                            method: 'DELETE',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ token, restaurant_id: restaurantId, reportId, password })
                        })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                if (serverAdvances) {
                                    const index = serverAdvances.findIndex(r => String(r.id) === String(reportId));
                                    if (index !== -1) serverAdvances.splice(index, 1);
                                }
                                allReports = allReports.filter(r => String(r.id) !== String(reportId));
                                if (allReports.length === 0) loadRecentReports();
                                else {
                                    const totalPages = Math.ceil(allReports.length / reportsPageSize);
                                    if (currentReportsPage > totalPages) currentReportsPage = totalPages;
                                    renderRecentReportsPage();
                                }
                                Swal.fire('تم الحذف', data.message, 'success');
                            } else {
                                Swal.fire('خطأ', data.message, 'error');
                            }
                        })
                        .catch(err => Swal.fire('خطأ', 'فشل الاتصال بالخادم', 'error'));
                    }
                });
            }

            function storeCurrentReport() {
                const name = restaurantNameInput.value || '';
                const rows = getTableData();
                const total = totalAmountEl.textContent;
                const dateStr = getReportDateString();
                fetch(apiBase + '/api/expenses/advances-store', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ token, restaurant_id: restaurantId, code: '', name, date: dateStr, rows, total })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        if (serverAdvances) {
                            const idx = serverAdvances.findIndex(r => String(r.restaurant_id) === restaurantId && String(r.date) === dateStr);
                            if (idx !== -1) serverAdvances.splice(idx, 1);
                            serverAdvances.unshift(data.report);
                            if (serverAdvances.length > 20) serverAdvances.length = 20;
                        }
                        allReports = allReports.filter(r => !(String(r.restaurant_id) === restaurantId && String(r.date) === dateStr));
                        allReports.unshift(data.report);
                        if (allReports.length > 20) allReports.length = 20;
                        currentReportsPage = 1;
                        renderRecentReportsPage();
                        Swal.fire('تم التخزين', data.message, 'success');
                    } else {
                        Swal.fire('خطأ', data.message, 'error');
                    }
                })
                .catch(err => Swal.fire('خطأ', 'فشل الاتصال بالخادم', 'error'));
            }

            function restorePreviousState() {
                if (previousState) {
                    restaurantNameInput.value = previousState.name || '';
                    updateDateToggleUI(previousState.isAuto !== undefined ? previousState.isAuto : true);
                    if (previousState.customDate) reportDateInput.value = previousState.customDate;
                    else reportDateInput.value = formatDateForInput(new Date());
                    loadTableData(previousState.rows || []);
                    previousState = null;
                }
            }

            function updateCurrentReport() {
                if (!currentEditReportId) return;
                const name = restaurantNameInput.value || '';
                const rows = getTableData();
                const total = totalAmountEl.textContent;
                const dateStr = getReportDateString();
                fetch(apiBase + '/api/expenses/advances-update', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ token, restaurant_id: restaurantId, reportId: currentEditReportId, code: '', name, date: dateStr, rows, total })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        if (serverAdvances) {
                            const idx = serverAdvances.findIndex(r => String(r.id) === String(currentEditReportId));
                            if (idx !== -1) serverAdvances[idx] = data.report;
                        }
                        const idxAll = allReports.findIndex(r => String(r.id) === String(currentEditReportId));
                        if (idxAll !== -1) allReports[idxAll] = data.report;
                        renderRecentReportsPage();
                        Swal.fire('تم التعديل', data.message, 'success');
                        restorePreviousState();
                        cancelEditMode();
                    } else {
                        Swal.fire('خطأ', data.message, 'error');
                    }
                })
                .catch(err => Swal.fire('خطأ', 'فشل الاتصال بالخادم', 'error'));
            }

            function cancelEditMode() {
                currentEditReportId = null;
                storeBtn.innerHTML = '<i class="las la-save"></i> تخزين';
                cancelEditBtn.classList.add('hidden');
            }

            function editReportById(reportId) {
                let report = null;
                if (serverAdvances) report = serverAdvances.find(r => String(r.id) === String(reportId));
                if (!report) {
                    const stored = localStorage.getItem('advanceStoredReports');
                    if (stored) {
                        const reports = JSON.parse(stored);
                        report = reports.find(r => String(r.id) === String(reportId));
                    }
                }
                if (!report) { Swal.fire('خطأ', 'التقرير غير موجود.', 'error'); return; }

                if (currentEditReportId) {
                    cancelEditMode();
                }

                previousState = {
                    name: restaurantNameInput.value || '',
                    isAuto: dateToggleBtn.classList.contains('active'),
                    customDate: reportDateInput.value,
                    rows: getTableData()
                };

                currentEditReportId = reportId;
                restaurantNameInput.value = report.name || '';
                if (report.date) {
                    const parts = report.date.split('/');
                    if (parts.length === 3) {
                        reportDateInput.value = parts[2] + '-' + parts[1].padStart(2, '0') + '-' + parts[0].padStart(2, '0');
                    }
                }
                updateDateToggleUI(false);
                tbody.innerHTML = '';
                if (report.rows && report.rows.length) {
                    report.rows.forEach(row => addRowAtEnd(row.desc || '', row.amount || ''));
                } else {
                    addRowAtEnd('', '');
                }
                updateTotal();
                storeBtn.innerHTML = '<i class="las la-edit"></i> تحديث التقرير';
                cancelEditBtn.classList.remove('hidden');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            cancelEditBtn.addEventListener('click', function() {
                if (previousState) {
                    restorePreviousState();
                }
                cancelEditMode();
                Swal.fire('تم', 'تم إلغاء التعديل.', 'info');
            });

            storeBtn.addEventListener('click', function() {
                saveToSession();
                if (currentEditReportId) updateCurrentReport();
                else storeCurrentReport();
            });

            document.getElementById('addRowBtn').addEventListener('click', function() {
                const newTr = addRowAtEnd('', '');
                const { descInput } = getInputsInRow(newTr);
                if (descInput) focusInput(descInput);
                saveToSession();
            });
            document.getElementById('addRowsBatchBtn').addEventListener('click', function() {
                const countInput = document.getElementById('rowsCountInput');
                let count = parseInt(countInput.value) || 1;
                if (count < 1) count = 1;
                if (count > 50) count = 50;
                countInput.value = count;
                for (let i = 0; i < count; i++) addRowAtEnd('', '');
                saveToSession();
                Swal.fire('تم', 'تم إضافة ' + count + ' صفوف جديدة.', 'success');
            });
            document.getElementById('clearRowsBtn').addEventListener('click', function() {
                if (tbody.children.length === 0) return;
                Swal.fire({
                    title: 'مسح الكل',
                    text: 'هل أنت متأكد من مسح جميع الصفوف؟',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'نعم، امسح',
                    cancelButtonText: 'إلغاء',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        clearAllRows();
                        saveToSession();
                        Swal.fire('تم', 'تم مسح جميع الصفوف.', 'success');
                    }
                });
            });
            document.getElementById('printInvoiceBtn').addEventListener('click', function() {
                saveToSession();
                const printArea = document.getElementById('printArea');
                const name = restaurantNameInput.value || '';
                const dateStr = getReportDateString();
                const rowsData = getTableData();
                printArea.innerHTML = buildPrintHTML(name, dateStr, rowsData, totalAmountEl.textContent);
                printArea.style.display = 'block';
                setTimeout(() => { window.print(); printArea.style.display = 'none'; }, 300);
            });
            document.getElementById('exportRestaurantBtn').addEventListener('click', function() {
                saveToSession();
                const name = restaurantNameInput.value || '';
                let csv = 'البيان,المبلغ (ج.م)\n';
                const rows = getTableData();
                rows.forEach(row => {
                    csv += (row.desc || '') + ',' + (row.amount || '0') + '\n';
                });
                csv += 'الإجمالي,' + totalAmountEl.textContent + '\n';
                const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = name + '_تقرير_سلف.csv';
                link.click();
                Swal.fire('تم', 'تم تصدير التقرير بصيغة CSV بنجاح.', 'success');
            });

            document.getElementById('closeDetailReportBtn').addEventListener('click', hideReportView);
            document.getElementById('printDetailReportBtn').addEventListener('click', function() {
                if (!currentViewReportId) return;
                let report = null;
                if (serverAdvances) report = serverAdvances.find(r => String(r.id) === String(currentViewReportId));
                if (!report) {
                    const stored = localStorage.getItem('advanceStoredReports');
                    if (stored) {
                        const reports = JSON.parse(stored);
                        report = reports.find(r => String(r.id) === String(currentViewReportId));
                    }
                }
                if (!report) return;
                const printArea = document.getElementById('printArea');
                const rowsData = (report.rows && report.rows.length) ? report.rows.map(r => ({ desc: r.desc || '', amount: r.amount || '0' })) : [];
                printArea.innerHTML = buildPrintHTML(report.name || '', report.date || '', rowsData, report.total || '0');
                printArea.style.display = 'block';
                setTimeout(() => { window.print(); printArea.style.display = 'none'; }, 300);
            });

            const sidebar = document.getElementById('dashboardSidebar');
            const headerAvatar = document.getElementById('headerAvatar');
            function openSidebar() { sidebar.classList.add('mobile-open'); sidebar.classList.remove('mobile-closed'); }
            function closeSidebar() { sidebar.classList.remove('mobile-open'); sidebar.classList.add('mobile-closed'); }
            if (window.innerWidth < 1025) sidebar.classList.add('mobile-closed');
            window.addEventListener('resize', function() {
                if (window.innerWidth >= 1025) sidebar.classList.remove('mobile-open', 'mobile-closed');
                else if (!sidebar.classList.contains('mobile-open')) sidebar.classList.add('mobile-closed');
            });
            headerAvatar.addEventListener('click', function(e) {
                e.stopPropagation();
                if (window.innerWidth < 1025) {
                    if (sidebar.classList.contains('mobile-open')) closeSidebar();
                    else openSidebar();
                }
            });
            document.addEventListener('click', function(e) {
                if (window.innerWidth < 1025 && sidebar.classList.contains('mobile-open')) {
                    if (!sidebar.contains(e.target) && e.target !== headerAvatar && !headerAvatar.contains(e.target)) closeSidebar();
                }
            });
            const sidebarItems = document.querySelectorAll('.sidebar-item');
            sidebarItems.forEach(item => item.addEventListener('click', function() {
                if (this.id === 'logoutBtn') return;
                sidebarItems.forEach(i => i.classList.remove('active'));
                this.classList.add('active');
                if (window.innerWidth < 1025) closeSidebar();
            }));
            const logoutBtn = document.getElementById('logoutBtn');
            if (logoutBtn) logoutBtn.addEventListener('click', (e) => {
                e.preventDefault();
                Swal.fire({ title: 'تسجيل الخروج', text: 'هل أنت متأكد؟', icon: 'warning', showCancelButton: true, confirmButtonText: 'نعم', cancelButtonText: 'إلغاء' }).then((result) => { if (result.isConfirmed) window.location.href = '/'; });
            });

            const bottomNavItems = document.querySelectorAll('.bottom-nav-item');
            const navNotch = document.getElementById('navNotch');
            function moveNotch(activeItem) {
                if (!navNotch || !activeItem) return;
                const rect = activeItem.getBoundingClientRect();
                const navRect = document.getElementById('bottomMobileNav').getBoundingClientRect();
                const centerX = rect.left + rect.width / 2 - navRect.left;
                navNotch.style.left = centerX + 'px';
            }
            function setBottomNavActive() {
                let activeItem = null;
                bottomNavItems.forEach(item => {
                    item.classList.remove('active');
                    const tab = item.getAttribute('data-tab');
                    if (tab === 'reports') {
                        item.classList.add('active');
                        activeItem = item;
                    }
                });
                if (activeItem) moveNotch(activeItem);
                else if (bottomNavItems.length > 0) { bottomNavItems[0].classList.add('active'); moveNotch(bottomNavItems[0]); }
            }
            setBottomNavActive();
            window.addEventListener('resize', () => { const activeItem = document.querySelector('.bottom-nav-item.active'); if (activeItem) moveNotch(activeItem); });
            bottomNavItems.forEach(item => item.addEventListener('click', function(e) {
                e.preventDefault();
                bottomNavItems.forEach(i => i.classList.remove('active'));
                this.classList.add('active');
                moveNotch(this);
            }));

            const successModal = document.getElementById('successModal');
            const closeSuccessModal = document.getElementById('closeSuccessModal');
            const okSuccessBtn = document.getElementById('okSuccessBtn');
            const successMessageEl = document.getElementById('successMessage');
            function showSuccess(msg) { successMessageEl.textContent = msg; successModal.classList.add('active'); }
            function hideSuccess() { successModal.classList.remove('active'); }
            closeSuccessModal.addEventListener('click', hideSuccess);
            okSuccessBtn.addEventListener('click', hideSuccess);
            window.addEventListener('click', (e) => { if (e.target === successModal) hideSuccess(); });

            dateToggleBtn.addEventListener('click', function() {
                const isAuto = dateToggleBtn.classList.contains('active');
                updateDateToggleUI(!isAuto);
                saveToSession();
            });
            reportDateInput.addEventListener('input', function() { saveToSession(); });
            restaurantNameInput.addEventListener('input', function() { saveToSession(); });

            const themeToggleBtn = document.getElementById('themetoggle');
            const body = document.body;
            function applyTheme(theme) {
                const isDark = theme === 'dark';
                body.classList.toggle('light', !isDark);
                themeToggleBtn.classList.toggle('dark', isDark);
                localStorage.setItem('theme', theme);
            }
            const savedTheme = localStorage.getItem('theme') || 'dark';
            applyTheme(savedTheme);
            themeToggleBtn.addEventListener('click', () => {
                const isDark = body.classList.contains('light') === false;
                applyTheme(isDark ? 'light' : 'dark');
            });

            document.addEventListener('DOMContentLoaded', function() {
                if (!loadFromSession()) {
                    tbody.innerHTML = '';
                    addRowAtEnd('', '');
                    updateTotal();
                    reportDateInput.value = formatDateForInput(new Date());
                }
                loadRecentReports();
            });
        })();
    </script>
</body>
</html>
