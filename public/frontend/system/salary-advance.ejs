<!DOCTYPE html>
<html lang="ar" dir="rtl" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <meta name="theme-color" content="#0d99ff">
    <title>تقرير السلف</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/line-awesome/1.3.0/line-awesome/css/line-awesome.min.css">
    <meta name="description" content="تقرير السلف">
    <link rel="stylesheet" href="/css/salary-advance.css">
    <link rel="icon" type="image/png" href="/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#0d99ff',
                        secondary: '#7c3aed',
                        accent: '#06b6d4',
                        error: '#ef4444',
                        success: '#10b981',
                        warning: '#f59e0b',
                    }
                }
            }
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .edit-report-section {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            padding: 16px 18px;
            margin-top: 16px;
            backdrop-filter: blur(6px);
        }
        .edit-report-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
            padding-bottom: 12px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        }
        .edit-report-header-icon {
            width: 38px;
            height: 38px;
            min-width: 38px;
            border-radius: 50%;
            background: rgba(13, 153, 255, 0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #0d99ff;
            font-size: 20px;
            transition: all 0.25s ease;
        }
        .edit-report-header h4 {
            font-size: 15px;
            font-weight: 700;
            color: #fff;
            margin: 0;
            line-height: 1.2;
        }
        .edit-report-header p {
            font-size: 11px;
            color: #888;
            margin: 2px 0 0 0;
        }
        .edit-form-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px;
            margin-bottom: 14px;
        }
        @media (min-width: 640px) {
            .edit-form-grid {
                grid-template-columns: 1fr 190px;
                gap: 16px;
            }
        }
        .edit-form-group label {
            display: block;
            font-size: 11px;
            font-weight: 500;
            color: #999;
            margin-bottom: 5px;
        }
        .edit-form-group .input-field,
        .edit-form-group .input-date-compact {
            padding: 6px 10px;
            font-size: 13px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(0, 0, 0, 0.2);
            color: #fff;
            transition: border-color 0.2s, box-shadow 0.2s;
            width: 100%;
        }
        .edit-form-group .input-date-compact {
            max-width: 170px;
            appearance: none;
            -webkit-appearance: none;
        }
        .edit-form-group .input-date-compact::-webkit-calendar-picker-indicator {
            opacity: 0.5;
            cursor: pointer;
        }
        .edit-form-group .input-field:focus,
        .edit-form-group .input-date-compact:focus {
            border-color: #0d99ff;
            box-shadow: 0 0 0 3px rgba(13, 153, 255, 0.12);
            outline: none;
        }
        .edit-table-wrapper {
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.06);
            background: rgba(0, 0, 0, 0.15);
            overflow: hidden;
        }
        .edit-report-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            justify-content: flex-end;
            margin-top: 14px;
        }
        body.light .edit-report-section {
            background: rgba(0, 0, 0, 0.02);
            border-color: rgba(0, 0, 0, 0.08);
        }
        body.light .edit-report-header {
            border-bottom-color: rgba(0, 0, 0, 0.06);
        }
        body.light .edit-report-header h4 { color: #1a1a1a; }
        body.light .edit-report-header p { color: #666; }
        body.light .edit-form-group label { color: #555; }
        body.light .edit-form-group .input-field,
        body.light .edit-form-group .input-date-compact {
            background: rgba(0, 0, 0, 0.03);
            border-color: rgba(0, 0, 0, 0.1);
            color: #1a1a1a;
        }
        body.light .edit-table-wrapper {
            border-color: rgba(0, 0, 0, 0.06);
            background: rgba(0, 0, 0, 0.02);
        }
    </style>
    <script>
        window.__APP_DATA__ = {
            token: "<%- token %>",
            api: "<%- api %>",
            isAuthenticated: <%- isAuthenticated ? 'true' : 'false' %>,
            user: <%- JSON.stringify(user || null) %>,
            advances: <%- JSON.stringify(user && user.advances ? JSON.parse(user.advances) : []) %>,
            restaurant_id: 1
        };
    </script>
</head>
<body>
    <%- include('../../sections/header-ebnhamido.ejs') %>

            <div class="container mx-auto px-4 py-6 max-w-7xl">
                <div class="title-cell">
                    <div class="title-icon"><i class="las la-hand-holding-usd"></i></div>
