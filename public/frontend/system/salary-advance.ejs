                        <div class="w-full md:w-auto md:flex-1 text-center">
                            <i class="las la-file-alt text-4xl text-primary mb-2 block"></i>
                            <h3 class="text-xl font-bold text-[var(--color-white)]" id="viewReportTitle2">تقرير</h3>
                            <p class="text-sm text-[var(--color-muted)]" id="viewReportDate2"></p>
