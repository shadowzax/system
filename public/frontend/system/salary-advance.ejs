    <script>
        (function() {
            const appData = window.__APP_DATA__ || {};
            const userData = appData.user || {};
            const restaurantId = "1";
            const serverAdvances = Array.isArray(appData.advances)
                ? appData.advances.filter(f => String(f.restaurant_id) === restaurantId)
                : null;
            const token = appData.token || "";
            const apiBase = appData.api || "";
            const userRole = userData.account_type || 'viewer';
            const isAdmin = (userRole === 'admin');
            const isCashier = (userRole === 'cashier');
            const isViewer = (userRole === 'viewer');
            const arabicToEnglishMap = { '٠': '0', '١': '1', '٢': '2', '٣': '3', '٤': '4', '٥': '5', '٦': '6', '٧': '7', '٨': '8', '٩': '9' };
            const PRINT_LOGO = '/logos/1.png';
            let printLogoURL = PRINT_LOGO;

            let allReports = [];
            let currentReportsPage = 1;
            let reportsPageSize = 5;
            let sortOrder = 'newest';
            let editingReportId = null;

            document.getElementById('userFullName').textContent = userData.name || 'مستخدم';
            document.getElementById('role').textContent = userData.job_title || userData.account_type || 'مستخدم';
            if (userData.profile_picture) {
                document.getElementById('userAvatar').src = userData.profile_picture;
                document.getElementById('headerAvatar').src = userData.profile_picture;
            }

            const editableActions = document.getElementById('editableActions');
            const storeBtn = document.getElementById('storeBtn');
            const cancelEditBtn = document.getElementById('cancelEditBtn');
            if (isViewer) {
                editableActions.style.display = 'none';
                storeBtn.style.display = 'none';
                cancelEditBtn.style.display = 'none';
            } else {
                editableActions.style.display = 'flex';
                storeBtn.style.display = 'inline-flex';
            }

            function convertArabicNumerals(str) { return String(str).replace(/[٠-٩]/g, function(match) { return arabicToEnglishMap[match] || match; }); }
            function parseNumber(val) { const converted = convertArabicNumerals(String(val)); const cleaned = converted.replace(/,/g, '').trim(); const num = parseFloat(cleaned); return isNaN(num) ? 0 : num; }
            function formatNumber(num) { if (num === 0 || num === -0) return '0'; const abs = Math.abs(num); const formatted = abs.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 }); return num < 0 ? '-' + formatted : formatted; }
            function formatDateForInput(date) { const yyyy = date.getFullYear(); const mm = String(date.getMonth() + 1).padStart(2, '0'); const dd = String(date.getDate()).padStart(2, '0'); return yyyy + '-' + mm + '-' + dd; }

            const tbody = document.getElementById('restaurantTbody');
            const totalAmountEl = document.getElementById('totalAmount');
            const restaurantNameInput = document.getElementById('restaurantNameInput');
            const dateToggleBtn = document.getElementById('dateToggleBtn');
            const dateToggleText = document.getElementById('dateToggleText');
            const reportDateInput = document.getElementById('reportDateInput');

            const editReportContainer = document.getElementById('editReportContainer');
            const editReportName = document.getElementById('editReportName');
            const editReportDate = document.getElementById('editReportDate');
            const editReportTbody = document.getElementById('editReportTbody');
            const editReportTotal = document.getElementById('editReportTotal');

            function updateTotal() {
                let total = 0;
                const rows = tbody.querySelectorAll('tr');
                rows.forEach(row => {
                    const input = row.querySelector('.amount-input');
                    if (input) total += parseNumber(input.value);
                });
                totalAmountEl.textContent = formatNumber(total);
            }

            function updateEditTotal() {
                let total = 0;
                const rows = editReportTbody.querySelectorAll('tr');
                rows.forEach(row => {
                    const input = row.querySelector('.amount-input');
                    if (input) total += parseNumber(input.value);
                });
                editReportTotal.textContent = formatNumber(total);
            }

            function focusInput(input) {
                if (input) {
                    input.focus();
                    if (input.type === 'text' && input.value) input.setSelectionRange(input.value.length, input.value.length);
                }
            }

            function getInputsInRow(tr) {
                const descInput = tr.querySelector('.desc-input');
                const amountInput = tr.querySelector('.amount-input');
                return { descInput, amountInput };
            }

            function getCellIndex(input) {
                if (input.classList.contains('desc-input')) return 0;
                if (input.classList.contains('amount-input')) return 1;
                return -1;
            }

            function navigateCell(currentInput, rowDelta, cellDelta) {
                const currentTr = currentInput.closest('tr');
                if (!currentTr) return;
                const rows = Array.from(tbody.querySelectorAll('tr'));
                const currentRowIndex = rows.indexOf(currentTr);
                const currentCellIndex = getCellIndex(currentInput);
                const targetRowIndex = currentRowIndex + rowDelta;
                if (targetRowIndex < 0 || targetRowIndex >= rows.length) return;
                const targetRow = rows[targetRowIndex];
                const { descInput, amountInput } = getInputsInRow(targetRow);
                const targetCellIndex = cellDelta !== undefined ? cellDelta : currentCellIndex;
                if (targetCellIndex === 0 && descInput) focusInput(descInput);
                else if (targetCellIndex === 1 && amountInput) focusInput(amountInput);
            }

            function setupKeyboardNavigation(input) {
                input.addEventListener('keydown', function(e) {
                    const key = e.key;
                    const tr = this.closest('tr');
                    const rows = Array.from(tbody.querySelectorAll('tr'));
                    const rowIndex = rows.indexOf(tr);
                    const cellIndex = getCellIndex(this);

                    if (key === 'Enter') {
                        e.preventDefault();
                        const isLastRow = rowIndex === rows.length - 1;
                        const isAmountCell = cellIndex === 1;
                        if (isLastRow && isAmountCell) {
                            if (isViewer) return;
                            const newTr = addRowAtEnd('', '');
                            const { descInput } = getInputsInRow(newTr);
                            if (descInput) focusInput(descInput);
                            saveToSession();
                        } else if (isLastRow && cellIndex === 0) {
                            const { amountInput } = getInputsInRow(tr);
                            if (amountInput) focusInput(amountInput);
                        } else {
                            navigateCell(this, 1, cellIndex);
                        }
                    } else if (key === 'ArrowDown') {
                        e.preventDefault();
                        navigateCell(this, 1, cellIndex);
                    } else if (key === 'ArrowUp') {
                        e.preventDefault();
                        navigateCell(this, -1, cellIndex);
                    } else if (key === 'ArrowRight') {
                        e.preventDefault();
                        if (cellIndex === 1) navigateCell(this, 0, 0);
                    } else if (key === 'ArrowLeft') {
                        e.preventDefault();
                        if (cellIndex === 0) navigateCell(this, 0, 1);
                    } else if (key === 'Tab') {
                        e.preventDefault();
                        if (e.shiftKey) {
                            if (cellIndex === 1) navigateCell(this, 0, 0);
                            else if (cellIndex === 0 && rowIndex > 0) navigateCell(this, -1, 1);
                        } else {
                            if (cellIndex === 0) navigateCell(this, 0, 1);
                            else if (cellIndex === 1) {
                                if (rowIndex < rows.length - 1) navigateCell(this, 1, 0);
                                else {
                                    if (isViewer) return;
                                    const newTr = addRowAtEnd('', '');
                                    const { descInput } = getInputsInRow(newTr);
                                    if (descInput) focusInput(descInput);
                                    saveToSession();
                                }
                            }
                        }
                    }
                });
            }

            function updateSignButton(row) {
                const amountInput = row.querySelector('.amount-input');
                const signBtn = row.querySelector('.sign-btn');
                if (!amountInput || !signBtn) return;
                const val = parseNumber(amountInput.value);
                if (val < 0) {
                    signBtn.classList.add('negative');
                    signBtn.classList.remove('positive');
                    signBtn.innerHTML = '<i class="las la-minus-circle"></i>';
                    signBtn.title = 'القيمة سالبة - اضغط لجعلها موجبة';
                } else {
                    signBtn.classList.add('positive');
                    signBtn.classList.remove('negative');
                    signBtn.innerHTML = '<i class="las la-plus-circle"></i>';
                    signBtn.title = 'القيمة موجبة - اضغط لجعلها سالبة';
                }
            }

            function createRowElement(description, amount, isEditMode = false) {
                const tr = document.createElement('tr');

                const descTd = document.createElement('td');
                const descInput = document.createElement('input');
                descInput.type = 'text';
                descInput.className = 'input-field desc-input';
                descInput.placeholder = 'أدخل البيان';
                descInput.value = description || '';
                descTd.appendChild(descInput);

                const amountTd = document.createElement('td');
                const amountInput = document.createElement('input');
                amountInput.type = 'text';
                amountInput.className = 'input-field amount-input';
                amountInput.placeholder = 'المبلغ';
                amountInput.value = amount ? formatNumber(parseNumber(amount)) : '';
                amountInput.setAttribute('inputmode', 'decimal');
                amountTd.appendChild(amountInput);

                const actionTd = document.createElement('td');
