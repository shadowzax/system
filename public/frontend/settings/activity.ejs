    <div class="modal-overlay" id="successModal">
        <div class="modal-content text-center">
            <button class="modal-close" id="closeSuccessModal"><i class="las la-times"></i></button>
            <i class="las la-check-circle text-5xl text-primary mb-4"></i>
            <h3 class="text-xl font-bold mb-2 text-[var(--color-white)]">تم بنجاح</h3>
            <p id="successMessage" class="text-[var(--color-muted)]"></p>
            <button id="okSuccessBtn" class="btn-primary mt-6 w-full justify-center">حسناً</button>
        </div>
    </div>
    <script>
            (function () {
                const sidebar = document.getElementById('dashboardSidebar');
                const headerAvatar = document.getElementById('headerAvatar');

                function openSidebar() {
                    sidebar.classList.add('mobile-open');
                    sidebar.classList.remove('mobile-closed');
                }

                function closeSidebar() {
                    sidebar.classList.remove('mobile-open');
                    sidebar.classList.add('mobile-closed');
                }
                if (window.innerWidth < 1025) sidebar.classList.add('mobile-closed');
                window.addEventListener('resize', function () {
                    if (window.innerWidth >= 1025) {
                        sidebar.classList.remove('mobile-open', 'mobile-closed');
                    } else {
                        if (!sidebar.classList.contains('mobile-open')) sidebar.classList.add('mobile-closed');
                    }
                });
                if (headerAvatar) {
                    headerAvatar.addEventListener('click', function (e) {
                        e.stopPropagation();
                        if (window.innerWidth < 1025) {
                            if (sidebar.classList.contains('mobile-open')) closeSidebar();
                            else openSidebar();
                        }
                    });
                }
                document.addEventListener('click', function (e) {
                    if (window.innerWidth < 1025 && sidebar.classList.contains('mobile-open')) {
                        if (!sidebar.contains(e.target) && e.target !== headerAvatar && !headerAvatar.contains(e
                            .target)) {
                            closeSidebar();
                        }
                    }
                });
const sidebarItems = document.querySelectorAll('.sidebar-item');

sidebarItems.forEach(item => {
    item.addEventListener('click', function () {
        if (this.id === 'logoutBtn') return;

        sidebarItems.forEach(i => i.classList.remove('active'));
        this.classList.add('active');

        if (window.innerWidth < 1025) {
            closeSidebar();
        }
    });
});
                const logoutBtn = document.getElementById('logoutBtn');
                if (logoutBtn) {
                    logoutBtn.addEventListener('click', (e) => {
                        e.preventDefault();
                        if (confirm('هل أنت متأكد من تسجيل الخروج من لوحة التحكم؟')) window.location.href = '/';
                    });
                }
                const bottomNavItems = document.querySelectorAll('.bottom-nav-item');
                const navNotch = document.getElementById('navNotch');

                function moveNotch(activeItem) {
                    if (!navNotch || !activeItem) return;
                    const rect = activeItem.getBoundingClientRect();
                    const navRect = document.getElementById('bottomMobileNav').getBoundingClientRect();
                    const centerX = rect.left + rect.width / 2 - navRect.left;
                    navNotch.style.left = centerX + 'px';
                }

                function setBottomNavActive() {
                    let activeItem = null;
                    bottomNavItems.forEach(item => {
                        item.classList.remove('active');
                        const tab = item.getAttribute('data-tab');
                        if (tab === 'dashboard') {
                            item.classList.add('active');
                            activeItem = item;
                        }
                    });
                    if (activeItem) moveNotch(activeItem);
                    else if (bottomNavItems.length > 0) {
                        bottomNavItems[0].classList.add('active');
                        moveNotch(bottomNavItems[0]);
                    }
                }
                setBottomNavActive();
                window.addEventListener('resize', () => {
                    const activeItem = document.querySelector('.bottom-nav-item.active');
                    if (activeItem) moveNotch(activeItem);
                });
                bottomNavItems.forEach(item => {
                    item.addEventListener('click', function (e) {
                        e.preventDefault();
                        bottomNavItems.forEach(i => i.classList.remove('active'));
                        this.classList.add('active');
                        moveNotch(this);
                        const tab = this.getAttribute('data-tab');
                        if (tab === 'reports') {
                            window.location.href = '?page=reports';
                        }
                    });
                });
                const successModal = document.getElementById('successModal');
                const closeSuccessModal = document.getElementById('closeSuccessModal');
                const okSuccessBtn = document.getElementById('okSuccessBtn');
                const successMessageEl = document.getElementById('successMessage');

                function showSuccess(msg) {
                    successMessageEl.textContent = msg;
                    successModal.classList.add('active');
                }

                function hideSuccess() { successModal.classList.remove('active'); }
                closeSuccessModal.addEventListener('click', hideSuccess);
                okSuccessBtn.addEventListener('click', hideSuccess);
                window.addEventListener('click', (e) => { if (e.target === successModal) hideSuccess(); });
                const userAvatarImg = document.getElementById('userAvatar');
                if (userAvatarImg) {
                    userAvatarImg.addEventListener('click', () => {
                        const input = document.createElement('input');
                        input.type = 'file';
                        input.accept = 'image/*';
                        input.onchange = (e) => {
                            const file = e.target.files[0];
                            if (file) {
                                const reader = new FileReader();
                                reader.onload = (ev) => {
                                    userAvatarImg.src = ev.target.result;
                                    const headerAv = document.getElementById('headerAvatar');
                                    if (headerAv) headerAv.src = ev.target.result;
                                    showSuccess('تم تحديث الصورة الشخصية.');
                                };
                                reader.readAsDataURL(file);
                            }
                        };
                        input.click();
                    });
                }
                document.getElementById('refreshDashboardBtn').addEventListener('click', function () {
                    const btn = this;
                    const originalHTML = btn.innerHTML;
                    btn.innerHTML = '<i class="las la-spinner la-spin"></i> جاري التحديث...';
                    btn.disabled = true;
                    setTimeout(() => {
                        btn.innerHTML = originalHTML;
                        btn.disabled = false;
                        showSuccess('تم تحديث لوحة التحكم بنجاح.');
                        updateRandomStats();
                    }, 1500);
                });
                document.getElementById('viewAllOrdersBtn').addEventListener('click', function () {
                    showSuccess('جاري تحميل جميع الطلبات...');
                });

                function updateRandomStats() {
                    const revenue = Math.floor(Math.random() * 80000) + 100000;
                    const orders = Math.floor(Math.random() * 600) + 1000;
                    const avg = (Math.random() * 80 + 80).toFixed(1);
                    const customers = Math.floor(Math.random() * 40) + 30;
                    document.getElementById('totalRevenue').textContent = revenue.toLocaleString('en-US');
                    document.getElementById('totalOrders').textContent = orders.toLocaleString('en-US');
                    document.getElementById('avgOrder').textContent = avg;
                    document.getElementById('newCustomers').textContent = customers;
                }
                document.addEventListener('DOMContentLoaded', function () {
                    const themeToggles = document.querySelectorAll('.theme-toggle');
                    const body = document.body;
                    const applyTheme = (theme) => {
                        const isDark = theme === 'dark';
                        body.classList.toggle('light', !isDark);
                        themeToggles.forEach(toggle => toggle.classList.toggle('dark', isDark));
                        localStorage.setItem('theme', theme);
                        updateChartsTheme(isDark);
                    };
                    const savedTheme = localStorage.getItem('theme') || 'dark';
                    applyTheme(savedTheme);
                    themeToggles.forEach(toggle => {
                        toggle.addEventListener('click', () => {
                            const isDark = body.classList.contains('light') === false;
                            applyTheme(isDark ? 'light' : 'dark');
                        });
                    });
                    initCharts();
                });

                function getChartColors(isDark) {
                    if (isDark) {
                        return {
                            gridColor: 'rgba(186,186,186,0.08)',
                            textColor: '#9ca3af',
                            primary: '#0d99ff',
                            secondary: '#7c3aed',
                            accent: '#06b6d4',
                            success: '#10b981',
                            warning: '#f59e0b'
                        };
                    } else {
                        return {
                            gridColor: 'rgba(0,0,0,0.06)',
                            textColor: '#64748b',
                            primary: '#0d99ff',
                            secondary: '#7c3aed',
                            accent: '#06b6d4',
                            success: '#10b981',
                            warning: '#f59e0b'
                        };
                    }
                }
                let revenueChartInstance = null;
                let pieChartInstance = null;

                function initCharts() {
                    const isDark = !document.body.classList.contains('light');
                    const colors = getChartColors(isDark);
                    const revenueCtx = document.getElementById('revenueChart');
                    if (revenueCtx) {
                        if (revenueChartInstance) revenueChartInstance.destroy();
                        revenueChartInstance = new Chart(revenueCtx, {
                            type: 'line',
                            data: {
                                labels: ['يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو', 'يوليو', 'أغسطس'],
                                datasets: [{
                                    label: 'الإيرادات (ج.م)',
                                    data: [98000, 115000, 108000, 132000, 125000, 148000, 138000, 142850],
                                    borderColor: colors.primary,
                                    backgroundColor: 'rgba(13,153,255,0.08)',
                                    borderWidth: 3,
                                    fill: true,
                                    tension: 0.4,
                                    pointBackgroundColor: colors.primary,
                                    pointBorderColor: '#fff',
                                    pointBorderWidth: 2,
                                    pointRadius: 5,
                                    pointHoverRadius: 8,
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: {
                                        labels: {
                                            color: colors.textColor, font: {
                                                family: 'Alexandria',
                                                size: 12
                                            }, usePointStyle: true, padding: 20
                                        }
                                    },
                                    tooltip: {
                                        backgroundColor: isDark ? '#1e293b' : '#fff',
                                        titleColor: colors.textColor,
                                        bodyColor: colors.textColor,
                                        borderColor: colors.gridColor,
                                        borderWidth: 1,
                                        cornerRadius: 8,
                                        padding: 12,
                                        titleFont: { family: 'Alexandria' },
                                        bodyFont: { family: 'Alexandria' }
                                    }
                                },
                                scales: {
                                    x: {
                                        grid: { color: colors.gridColor },
                                        ticks: {
                                            color: colors.textColor, font: {
                                                family: 'Alexandria',
                                                size: 11
                                            }
                                        }
                                    },
                                    y: {
                                        grid: { color: colors.gridColor },
                                        ticks: {
                                            color: colors.textColor, font: {
                                                family: 'Alexandria',
                                                size: 11
                                            }, callback: function (v) {
                                                return v
                                                    .toLocaleString('en-US') + ' ج.م';
                                            }
                                        }
                                    }
                                },
                                interaction: { intersect: false, mode: 'index' }
                            }
                        });
                    }
                    const pieCtx = document.getElementById('pieChart');
                    if (pieCtx) {
                        if (pieChartInstance) pieChartInstance.destroy();
                        pieChartInstance = new Chart(pieCtx, {
                            type: 'doughnut',
                            data: {
                                labels: ['مأكولات', 'مشروبات', 'حلويات', 'مقبلات', 'أخرى'],
                                datasets: [{
                                    data: [45, 25, 15, 10, 5],
                                    backgroundColor: [colors.primary, colors.secondary, colors.accent,
                                    colors.success, colors.warning
                                    ],
                                    borderColor: isDark ? '#00060c' : '#ffffff',
                                    borderWidth: 3,
                                    hoverBorderWidth: 4,
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: {
                                        position: 'bottom',
                                        labels: {
                                            color: colors.textColor, font: {
                                                family: 'Alexandria',
                                                size: 11
                                            }, usePointStyle: true, padding: 16,
                                            pointStyleWidth: 10
                                        }
                                    },
                                    tooltip: {
                                        backgroundColor: isDark ? '#1e293b' : '#fff',
                                        titleColor: colors.textColor,
                                        bodyColor: colors.textColor,
                                        borderColor: colors.gridColor,
                                        borderWidth: 1,
                                        cornerRadius: 8,
                                        padding: 12,
                                        titleFont: { family: 'Alexandria' },
                                        bodyFont: { family: 'Alexandria' },
                                        callbacks: {
                                            label: function (ctx) {
                                                return ctx.label + ': ' + ctx
                                                    .parsed + '%';
                                            }
                                        }
                                    }
                                },
                                cutout: '65%',
                            }
                        });
                    }
                }

                function updateChartsTheme(isDark) {
                    const colors = getChartColors(isDark);
                    if (revenueChartInstance) {
                        revenueChartInstance.options.plugins.legend.labels.color = colors.textColor;
                        revenueChartInstance.options.scales.x.grid.color = colors.gridColor;
                        revenueChartInstance.options.scales.x.ticks.color = colors.textColor;
                        revenueChartInstance.options.scales.y.grid.color = colors.gridColor;
                        revenueChartInstance.options.scales.y.ticks.color = colors.textColor;
                        revenueChartInstance.options.plugins.tooltip.backgroundColor = isDark ? '#1e293b' : '#fff';
                        revenueChartInstance.options.plugins.tooltip.titleColor = colors.textColor;
                        revenueChartInstance.options.plugins.tooltip.bodyColor = colors.textColor;
                        revenueChartInstance.options.plugins.tooltip.borderColor = colors.gridColor;
                        revenueChartInstance.update();
                    }
                    if (pieChartInstance) {
                        pieChartInstance.options.plugins.legend.labels.color = colors.textColor;
                        pieChartInstance.data.datasets[0].borderColor = isDark ? '#00060c' : '#ffffff';
                        pieChartInstance.options.plugins.tooltip.backgroundColor = isDark ? '#1e293b' : '#fff';
                        pieChartInstance.options.plugins.tooltip.titleColor = colors.textColor;
                        pieChartInstance.options.plugins.tooltip.bodyColor = colors.textColor;
                        pieChartInstance.options.plugins.tooltip.borderColor = colors.gridColor;
                        pieChartInstance.update();
                    }
                }
                const observer = new MutationObserver(function (mutations) {
                    mutations.forEach(function (mutation) {
                        if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
                            const isDark = !document.body.classList.contains('light');
                            updateChartsTheme(isDark);
                        }
                    });
                });
                observer.observe(document.body, { attributes: true, attributeFilter: ['class'] });
            })();
    </script>
</body>

</html>
