                <a href="/outgoing" class="sidebar-item" data-page="outgoing-invoices"><i class="las la-file-invoice-dollar"></i><span>خوارج</span></a>
                <a href="/visa" class="sidebar-item" data-page="visa"><i class="las la-credit-card"></i><span>فيز</span></a>
                <a href="/cash" class="sidebar-item" data-page="transfers"><i class="las la-exchange-alt"></i><span>تحويلات</span></a>
                <a href="/advances" class="sidebar-item" data-page="advances"><i class="las la-hand-holding-usd"></i><span>السلف</span></a>
                <div class="sidebar-section-title">الإدارة</div>
                <a href="/payments" class="sidebar-item active" data-page="payments"><i class="las la-credit-card"></i><span>المدفوعات</span></a>
                <div class="sidebar-section-title">النظام</div>
                <a href="/settings" class="sidebar-item" data-page="settings"><i class="las la-cog"></i><span>الإعدادات</span></a>
                <a href="/activity" class="sidebar-item" data-page="logs"><i class="las la-history"></i><span>سجل النشاط</span></a>
                <div class="mt-8 pt-4 border-t border-[var(--border-color)]">
                    <a href="#" id="logoutBtn" class="sidebar-item" style="color: #ef4444;"><i class="las la-sign-out-alt"></i><span>تسجيل الخروج</span></a>
                </div>
            </nav>
            <div class="mt-5 pt-4 border-t border-black/10 dark:border-white/10 text-center leading-tight">
                <span class="text-[9px] uppercase tracking-[0.15em] text-[var(--color-muted)] opacity-70">Developed by</span>
                <div>
                    <a href="https://www.facebook.com/Abdelrahman.Elshamhuot" target="_blank" rel="noopener noreferrer" class="text-[11px] font-medium text-[var(--color-muted)] hover:underline">Abdelrahman Mohamed</a>
                </div>
                <div class="mt-1 text-[9px] text-[var(--color-muted)] opacity-50">v3.2</div>
            </div>
        </aside>
        <main class="lg:mr-[280px] transition-all">
            <header id="mainHeader">
                <div class="flex items-center gap-6 mr-4">
                    <a class="flex w-fit select-none items-center" href="/">
                        <img src="https://files.catbox.moe/kdxauw.png" alt="logo" class="h-[52px] sm:h-[60px] md:h-[68px] object-contain">
                    </a>
                </div>
                <div class="flex items-center gap-3 sm:gap-4">
                    <button class="theme-toggle" id="themetoggle">
                        <div class="toggle-circle">
                            <i class="fas fa-sun icon sun-icon"></i>
                            <i class="fas fa-moon icon moon-icon"></i>
                        </div>
                    </button>
                    <img id="headerAvatar" src="https://i.ibb.co/yjsL7YQ/photo-2026-08-11-02-55-41.jpg" class="header-avatar" alt="avatar">
                </div>
            </header>
            <div class="container mx-auto px-4 py-6 max-w-7xl">
                <div class="mb-6">
                    <h1 class="text-2xl font-bold text-[var(--color-white)] flex items-center gap-3">
                        <i class="las la-credit-card text-primary text-3xl"></i> المدفوعات
                    </h1>
                    <p class="text-[var(--color-muted)] mt-1 mr-10">تسجيل المدفوعات ورفع الفواتير</p>
                </div>
                <div class="info-card mb-6">
                    <h3 class="text-lg font-bold text-[var(--color-white)] mb-4 flex items-center gap-2"><i class="las la-plus-circle text-primary"></i> تسجيل دفعة جديدة</h3>
                    <form id="paymentForm" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm text-[var(--color-muted)] mb-1">التاريخ</label>
                            <input type="date" id="paymentDate" class="input-field" required>
                        </div>
                        <div>
                            <label class="block text-sm text-[var(--color-muted)] mb-1">الوصف</label>
                            <input type="text" id="paymentDescription" class="input-field" placeholder="وصف الدفعة" required>
                        </div>
                        <div>
                            <label class="block text-sm text-[var(--color-muted)] mb-1">المبلغ</label>
                            <input type="number" id="paymentAmount" class="input-field" placeholder="0.00" required min="0" step="0.01">
                        </div>
                        <div>
                            <label class="block text-sm text-[var(--color-muted)] mb-1">طريقة الدفع</label>
                            <select id="paymentMethod" class="input-field">
                                <option value="cash">كاش</option>
                                <option value="visa">فيزا</option>
                                <option value="transfer">تحويل بنكي</option>
                            </select>
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-sm text-[var(--color-muted)] mb-1">رفع الفاتورة</label>
                            <input type="file" id="paymentInvoice" class="input-field" accept="image/*,.pdf">
                            <p class="text-xs text-[var(--color-muted)] mt-1" id="invoiceFileName"></p>
                        </div>
                        <div class="md:col-span-2">
                            <button type="submit" class="btn-primary w-full justify-center"><i class="las la-save"></i> إضافة الدفعة</button>
                        </div>
                    </form>
                </div>
                <div class="info-card">
                    <h3 class="text-lg font-bold text-[var(--color-white)] mb-4 flex items-center gap-2"><i class="las la-list text-primary"></i> سجل المدفوعات</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm min-w-[600px]">
                            <thead>
                                <tr class="border-b border-[var(--border-color)]">
                                    <th class="text-right py-2 px-2">التاريخ</th>
                                    <th class="text-right py-2 px-2">الوصف</th>
                                    <th class="text-right py-2 px-2">المبلغ</th>
                                    <th class="text-right py-2 px-2">الطريقة</th>
                                    <th class="text-right py-2 px-2">الفاتورة</th>
                                    <th class="text-right py-2 px-2">إجراءات</th>
                                </tr>
                            </thead>
                            <tbody id="paymentsTableBody">
                            </tbody>
                        </table>
                    </div>
                    <p id="noPaymentsMessage" class="text-center text-[var(--color-muted)] py-8 hidden">لا توجد مدفوعات مسجلة</p>
                </div>
            </div>
        </main>
    </div>
    <div class="modal-overlay" id="successModal">
        <div class="modal-content text-center">
            <button class="modal-close" id="closeSuccessModal"><i class="las la-times"></i></button>
            <i class="las la-check-circle text-5xl text-primary mb-4"></i>
            <h3 class="text-xl font-bold mb-2 text-[var(--color-white)]">تم بنجاح</h3>
            <p id="successMessage" class="text-[var(--color-muted)]"></p>
            <button id="okSuccessBtn" class="btn-primary mt-6 w-full justify-center">حسناً</button>
        </div>
    </div>
    <div class="modal-overlay" id="confirmModal">
        <div class="modal-content text-center">
            <button class="modal-close" id="closeConfirmModal"><i class="las la-times"></i></button>
            <i class="las la-exclamation-triangle text-5xl text-error mb-4"></i>
            <h3 class="text-xl font-bold mb-2 text-[var(--color-white)]" id="confirmTitle">تأكيد الحذف</h3>
            <p id="confirmMessage" class="text-[var(--color-muted)]">هل أنت متأكد؟</p>
            <div class="flex gap-3 mt-6">
                <button id="cancelConfirmBtn" class="btn-outline flex-1 justify-center">إلغاء</button>
                <button id="proceedConfirmBtn" class="btn-danger flex-1 justify-center">تأكيد الحذف</button>
            </div>
        </div>
    </div>
    <script>
        (function() {
            const appData = window.__APP_DATA__ || {};
            const currentUser = appData.user || {};
            const sidebar = document.getElementById('dashboardSidebar');
            const headerAvatar = document.getElementById('headerAvatar');
            const userAvatar = document.getElementById('userAvatar');
            let payments = JSON.parse(localStorage.getItem('paymentsList') || '[]');
            let fileData = null;
            let fileName = '';

            function openSidebar() {
                sidebar.classList.add('mobile-open');
                sidebar.classList.remove('mobile-closed');
            }

            function closeSidebar() {
                sidebar.classList.remove('mobile-open');
                sidebar.classList.add('mobile-closed');
            }

            if (window.innerWidth < 1025) sidebar.classList.add('mobile-closed');

            window.addEventListener('resize', function() {
                if (window.innerWidth >= 1025) {
                    sidebar.classList.remove('mobile-open', 'mobile-closed');
                } else {
                    if (!sidebar.classList.contains('mobile-open')) sidebar.classList.add('mobile-closed');
                }
            });

            headerAvatar.addEventListener('click', function(e) {
                e.stopPropagation();
                if (window.innerWidth < 1025) {
                    if (sidebar.classList.contains('mobile-open')) closeSidebar();
                    else openSidebar();
                }
            });

            document.addEventListener('click', function(e) {
                if (window.innerWidth < 1025 && sidebar.classList.contains('mobile-open')) {
                    if (!sidebar.contains(e.target) && e.target !== headerAvatar && !headerAvatar.contains(e.target)) {
                        closeSidebar();
                    }
                }
            });

            const sidebarItems = document.querySelectorAll('.sidebar-item');
            sidebarItems.forEach(item => {
                item.addEventListener('click', function() {
                    if (this.id === 'logoutBtn') return;
                    sidebarItems.forEach(i => i.classList.remove('active'));
                    this.classList.add('active');
                    if (window.innerWidth < 1025) closeSidebar();
                });
            });

            document.getElementById('logoutBtn').addEventListener('click', (e) => {
                e.preventDefault();
                if (confirm('هل أنت متأكد من تسجيل الخروج من لوحة التحكم؟')) window.location.href = '/';
            });

            const successModal = document.getElementById('successModal');
            const closeSuccessModal = document.getElementById('closeSuccessModal');
            const okSuccessBtn = document.getElementById('okSuccessBtn');
            const successMessageEl = document.getElementById('successMessage');

            function showSuccess(msg) {
                successMessageEl.textContent = msg;
                successModal.classList.add('active');
            }

            function hideSuccess() {
                successModal.classList.remove('active');
            }

            closeSuccessModal.addEventListener('click', hideSuccess);
            okSuccessBtn.addEventListener('click', hideSuccess);
            window.addEventListener('click', (e) => {
                if (e.target === successModal) hideSuccess();
            });

            const confirmModal = document.getElementById('confirmModal');
            const closeConfirmModal = document.getElementById('closeConfirmModal');
            const cancelConfirmBtn = document.getElementById('cancelConfirmBtn');
            const proceedConfirmBtn = document.getElementById('proceedConfirmBtn');
            const confirmMessageEl = document.getElementById('confirmMessage');
            const confirmTitleEl = document.getElementById('confirmTitle');
            let confirmCallback = null;

            function showConfirm(title, message, callback) {
                confirmTitleEl.textContent = title;
                confirmMessageEl.textContent = message;
                confirmCallback = callback;
                confirmModal.classList.add('active');
            }

            function hideConfirm() {
                confirmModal.classList.remove('active');
                confirmCallback = null;
            }

            closeConfirmModal.addEventListener('click', hideConfirm);
            cancelConfirmBtn.addEventListener('click', hideConfirm);
            proceedConfirmBtn.addEventListener('click', function() {
                if (confirmCallback) confirmCallback();
                hideConfirm();
            });
            window.addEventListener('click', (e) => {
                if (e.target === confirmModal) hideConfirm();
            });

            function populateUserInfo() {
                if (currentUser.name) document.getElementById('userFullName').textContent = currentUser.name;
                if (currentUser.job_title) document.getElementById('role').textContent = currentUser.job_title;
                else if (currentUser.account_type) document.getElementById('role').textContent = currentUser.account_type;
                if (currentUser.profile_picture) {
                    userAvatar.src = currentUser.profile_picture;
                    headerAvatar.src = currentUser.profile_picture;
                }
            }

            function loadTheme() {
                const savedTheme = localStorage.getItem('theme') || 'dark';
                const isDark = savedTheme === 'dark';
                document.body.classList.toggle('light', !isDark);
                const themeToggles = document.querySelectorAll('.theme-toggle');
                themeToggles.forEach(toggle => toggle.classList.toggle('dark', isDark));
            }

            populateUserInfo();
            loadTheme();

            const themeToggles = document.querySelectorAll('.theme-toggle');
            themeToggles.forEach(toggle => {
                toggle.addEventListener('click', () => {
                    const isDark = document.body.classList.contains('light') === false;
                    const newTheme = isDark ? 'light' : 'dark';
                    document.body.classList.toggle('light', !isDark);
                    themeToggles.forEach(t => t.classList.toggle('dark', !isDark));
                    localStorage.setItem('theme', newTheme);
                });
            });

            const paymentForm = document.getElementById('paymentForm');
            const paymentDate = document.getElementById('paymentDate');
            const paymentDescription = document.getElementById('paymentDescription');
            const paymentAmount = document.getElementById('paymentAmount');
            const paymentMethod = document.getElementById('paymentMethod');
            const paymentInvoice = document.getElementById('paymentInvoice');
            const invoiceFileName = document.getElementById('invoiceFileName');
            const paymentsTableBody = document.getElementById('paymentsTableBody');
            const noPaymentsMessage = document.getElementById('noPaymentsMessage');

            paymentInvoice.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (file) {
                    fileName = file.name;
                    invoiceFileName.textContent = fileName;
                    if (file.size < 2 * 1024 * 1024) {
                        const reader = new FileReader();
                        reader.onload = function(ev) {
                            fileData = ev.target.result;
                        };
                        reader.readAsDataURL(file);
                    } else {
                        fileData = null;
                    }
                } else {
                    fileName = '';
                    fileData = null;
                    invoiceFileName.textContent = '';
                }
            });

            function renderPayments() {
                paymentsTableBody.innerHTML = '';
                if (payments.length === 0) {
                    noPaymentsMessage.classList.remove('hidden');
                    return;
                }
                noPaymentsMessage.classList.add('hidden');
                payments.forEach(payment => {
                    const tr = document.createElement('tr');
                    tr.className = 'border-b border-[var(--border-color)] hover:bg-[var(--darker-bg)]';
                    tr.innerHTML = `
                        <td class="py-3 px-2">${payment.date || ''}</td>
                        <td class="py-3 px-2">${payment.description || ''}</td>
                        <td class="py-3 px-2">${parseFloat(payment.amount).toFixed(2)}</td>
                        <td class="py-3 px-2">${payment.method === 'cash' ? 'كاش' : payment.method === 'visa' ? 'فيزا' : 'تحويل بنكي'}</td>
                        <td class="py-3 px-2">
                            ${payment.invoice && payment.invoice.name ? 
                                (payment.invoice.data ? 
                                    `<a href="${payment.invoice.data}" download="${payment.invoice.name}" class="text-primary hover:underline">${payment.invoice.name}</a>` : 
                                    `<span class="text-[var(--color-muted)]">${payment.invoice.name}</span>`) 
                                : '<span class="text-[var(--color-muted)]">لا يوجد</span>'}
                        </td>
                        <td class="py-3 px-2">
                            <button class="btn-outline btn-sm delete-payment" data-id="${payment.id}"><i class="las la-trash-alt"></i> حذف</button>
                        </td>
                    `;
                    paymentsTableBody.appendChild(tr);
                });
                document.querySelectorAll('.delete-payment').forEach(btn => {
                    btn.addEventListener('click', function() {
                        const id = this.getAttribute('data-id');
                        showConfirm('تأكيد الحذف', 'هل أنت متأكد من حذف هذه الدفعة؟', function() {
                            payments = payments.filter(p => p.id !== id);
                            localStorage.setItem('paymentsList', JSON.stringify(payments));
                            renderPayments();
                            showSuccess('تم حذف الدفعة بنجاح');
                        });
                    });
                });
            }

            paymentForm.addEventListener('submit', function(e) {
                e.preventDefault();
                if (!paymentDate.value || !paymentDescription.value.trim() || !paymentAmount.value) {
                    showSuccess('يرجى ملء جميع الحقول المطلوبة');
                    return;
                }
                const newPayment = {
                    id: Date.now().toString(),
                    date: paymentDate.value,
                    description: paymentDescription.value.trim(),
                    amount: paymentAmount.value,
                    method: paymentMethod.value,
                    invoice: fileName ? { name: fileName, data: fileData } : null
                };
                payments.unshift(newPayment);
                localStorage.setItem('paymentsList', JSON.stringify(payments));
                renderPayments();
                paymentForm.reset();
                invoiceFileName.textContent = '';
                fileData = null;
                fileName = '';
                showSuccess('تم تسجيل الدفعة بنجاح');
            });

            renderPayments();
        })();
    </script>
</body>
</html>
