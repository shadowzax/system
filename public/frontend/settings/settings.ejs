        </div>
    </div>
    <div class="modal-overlay" id="confirmModal">
        <div class="modal-content text-center">
            <button class="modal-close" id="closeConfirmModal"><i class="las la-times"></i></button>
            <i class="las la-exclamation-triangle text-5xl text-error mb-4"></i>
            <h3 class="text-xl font-bold mb-2 text-[var(--color-white)]" id="confirmTitle">تأكيد الحذف</h3>
            <p id="confirmMessage" class="text-[var(--color-muted)]">هل أنت متأكد من رغبتك في حذف الحساب؟ لا يمكن التراجع عن هذا الإجراء.</p>
            <div class="flex gap-3 mt-6">
                <button id="cancelConfirmBtn" class="btn-outline flex-1 justify-center">إلغاء</button>
                <button id="proceedConfirmBtn" class="btn-danger flex-1 justify-center">تأكيد الحذف</button>
            </div>
        </div>
    </div>
    <script>
        (function() {
            const appData = window.__APP_DATA__ || {};
            const currentUser = appData.user || {};
            const sidebar = document.getElementById('dashboardSidebar');
            const headerAvatar = document.getElementById('headerAvatar');
            const userAvatar = document.getElementById('userAvatar');
            const profileAvatar = document.getElementById('profileAvatar');

            function openSidebar() {
                sidebar.classList.add('mobile-open');
                sidebar.classList.remove('mobile-closed');
            }

            function closeSidebar() {
                sidebar.classList.remove('mobile-open');
                sidebar.classList.add('mobile-closed');
            }

            if (window.innerWidth < 1025) sidebar.classList.add('mobile-closed');

            window.addEventListener('resize', function() {
                if (window.innerWidth >= 1025) {
                    sidebar.classList.remove('mobile-open', 'mobile-closed');
                } else {
                    if (!sidebar.classList.contains('mobile-open')) sidebar.classList.add('mobile-closed');
                }
            });

            headerAvatar.addEventListener('click', function(e) {
                e.stopPropagation();
                if (window.innerWidth < 1025) {
                    if (sidebar.classList.contains('mobile-open')) closeSidebar();
                    else openSidebar();
                }
            });

            document.addEventListener('click', function(e) {
                if (window.innerWidth < 1025 && sidebar.classList.contains('mobile-open')) {
                    if (!sidebar.contains(e.target) && e.target !== headerAvatar && !headerAvatar.contains(e.target)) {
                        closeSidebar();
                    }
                }
            });

            const sidebarItems = document.querySelectorAll('.sidebar-item');
            sidebarItems.forEach(item => {
                item.addEventListener('click', function() {
                    if (this.id === 'logoutBtn') return;
                    sidebarItems.forEach(i => i.classList.remove('active'));
                    this.classList.add('active');
                    if (window.innerWidth < 1025) closeSidebar();
                });
            });

            document.getElementById('logoutBtn').addEventListener('click', (e) => {
                e.preventDefault();
                if (confirm('هل أنت متأكد من تسجيل الخروج من لوحة التحكم؟')) window.location.href = '/';
            });

            const successModal = document.getElementById('successModal');
            const closeSuccessModal = document.getElementById('closeSuccessModal');
            const okSuccessBtn = document.getElementById('okSuccessBtn');
            const successMessageEl = document.getElementById('successMessage');

            function showSuccess(msg) {
                successMessageEl.textContent = msg;
                successModal.classList.add('active');
            }

            function hideSuccess() {
                successModal.classList.remove('active');
            }

            closeSuccessModal.addEventListener('click', hideSuccess);
            okSuccessBtn.addEventListener('click', hideSuccess);
            window.addEventListener('click', (e) => {
                if (e.target === successModal) hideSuccess();
            });

            const confirmModal = document.getElementById('confirmModal');
            const closeConfirmModal = document.getElementById('closeConfirmModal');
            const cancelConfirmBtn = document.getElementById('cancelConfirmBtn');
            const proceedConfirmBtn = document.getElementById('proceedConfirmBtn');
            const confirmMessageEl = document.getElementById('confirmMessage');
            const confirmTitleEl = document.getElementById('confirmTitle');
            let confirmCallback = null;

            function showConfirm(title, message, callback) {
                confirmTitleEl.textContent = title;
                confirmMessageEl.textContent = message;
                confirmCallback = callback;
                confirmModal.classList.add('active');
            }

            function hideConfirm() {
                confirmModal.classList.remove('active');
                confirmCallback = null;
            }

            closeConfirmModal.addEventListener('click', hideConfirm);
            cancelConfirmBtn.addEventListener('click', hideConfirm);
            proceedConfirmBtn.addEventListener('click', function() {
                if (confirmCallback) confirmCallback();
                hideConfirm();
            });
            window.addEventListener('click', (e) => {
                if (e.target === confirmModal) hideConfirm();
            });

            function populateFromUser() {
                const userData = currentUser;
                if (userData.fullName) {
                    document.getElementById('fullNameInput').value = userData.fullName;
                    document.getElementById('userFullName').textContent = userData.fullName;
                }
                if (userData.email) document.getElementById('emailInput').value = userData.email;
                if (userData.phone) document.getElementById('phoneInput').value = userData.phone;
                if (userData.role) {
                    document.getElementById('roleSelect').value = userData.role;
                    document.getElementById('role').textContent = userData.role === 'admin' ? 'Administrator' : userData.role;
                }
                if (userData.avatar) {
                    userAvatar.src = userData.avatar;
                    headerAvatar.src = userData.avatar;
                    profileAvatar.src = userData.avatar;
                }
                const restaurant = userData.restaurant || {};
                if (restaurant.name) document.getElementById('restaurantName').value = restaurant.name;
                if (restaurant.commercialReg) document.getElementById('commercialReg').value = restaurant.commercialReg;
                if (restaurant.phone) document.getElementById('restaurantPhone').value = restaurant.phone;
                if (restaurant.email) document.getElementById('restaurantEmail').value = restaurant.email;
                if (restaurant.address) document.getElementById('restaurantAddress').value = restaurant.address;
                if (restaurant.workingHours) document.getElementById('workingHours').value = restaurant.workingHours;
                if (restaurant.currency) document.getElementById('currencySelect').value = restaurant.currency;
            }

            function loadLocalStorage() {
                try {
                    const profileData = localStorage.getItem('userProfileSettings');
                    if (profileData) {
                        const p = JSON.parse(profileData);
                        if (p.fullName) {
                            document.getElementById('fullNameInput').value = p.fullName;
                            document.getElementById('userFullName').textContent = p.fullName;
                        }
                        if (p.email) document.getElementById('emailInput').value = p.email;
                        if (p.phone) document.getElementById('phoneInput').value = p.phone;
                        if (p.role) {
                            document.getElementById('roleSelect').value = p.role;
                            document.getElementById('role').textContent = p.role === 'admin' ? 'Administrator' : p.role;
                        }
                    }
                    const restaurantData = localStorage.getItem('restaurantSettings');
                    if (restaurantData) {
                        const r = JSON.parse(restaurantData);
                        if (r.name) document.getElementById('restaurantName').value = r.name;
                        if (r.commercialReg) document.getElementById('commercialReg').value = r.commercialReg;
                        if (r.phone) document.getElementById('restaurantPhone').value = r.phone;
                        if (r.email) document.getElementById('restaurantEmail').value = r.email;
                        if (r.address) document.getElementById('restaurantAddress').value = r.address;
                        if (r.workingHours) document.getElementById('workingHours').value = r.workingHours;
                        if (r.currency) document.getElementById('currencySelect').value = r.currency;
                    }
                    const notifData = localStorage.getItem('notificationSettings');
                    if (notifData) {
                        const n = JSON.parse(notifData);
                        if (n.orders !== undefined) document.getElementById('notifyOrders').checked = n.orders;
                        if (n.inventory !== undefined) document.getElementById('notifyInventory').checked = n.inventory;
                        if (n.reviews !== undefined) document.getElementById('notifyReviews').checked = n.reviews;
                        if (n.weekly !== undefined) document.getElementById('notifyWeekly').checked = n.weekly;
                        if (n.email !== undefined) document.getElementById('notifyEmail').checked = n.email;
                    }
                    const appearanceData = localStorage.getItem('appearanceSettings');
                    if (appearanceData) {
                        const a = JSON.parse(appearanceData);
                        if (a.fontSize) document.getElementById('fontSizeSelect').value = a.fontSize;
                        if (a.animations !== undefined) document.getElementById('animationsToggle').checked = a.animations;
                    }
                    const savedColor = localStorage.getItem('primaryColor');
                    if (savedColor) {
                        document.documentElement.style.setProperty('--color-primary', savedColor);
                        document.querySelectorAll('.color-option').forEach(b => {
                            b.classList.remove('border-white');
                            b.classList.add('border-transparent');
                            if (b.getAttribute('data-color') === savedColor) {
                                b.classList.remove('border-transparent');
                                b.classList.add('border-white');
                            }
                        });
                    }
                    const twoFactor = localStorage.getItem('twoFactorAuth');
                    if (twoFactor !== null) document.getElementById('twoFactorAuth').checked = twoFactor === 'true';
                } catch (e) {}
            }

            populateFromUser();
            loadLocalStorage();

            function saveProfile() {
                const data = {
                    fullName: document.getElementById('fullNameInput').value,
                    email: document.getElementById('emailInput').value,
                    phone: document.getElementById('phoneInput').value,
                    role: document.getElementById('roleSelect').value
                };
                localStorage.setItem('userProfileSettings', JSON.stringify(data));
                document.getElementById('userFullName').textContent = data.fullName;
                document.getElementById('role').textContent = data.role === 'admin' ? 'Administrator' : data.role;
                showSuccess('تم حفظ الملف الشخصي بنجاح');
            }

            function saveRestaurant() {
                const data = {
                    name: document.getElementById('restaurantName').value,
                    commercialReg: document.getElementById('commercialReg').value,
                    phone: document.getElementById('restaurantPhone').value,
                    email: document.getElementById('restaurantEmail').value,
                    address: document.getElementById('restaurantAddress').value,
                    workingHours: document.getElementById('workingHours').value,
                    currency: document.getElementById('currencySelect').value
                };
                localStorage.setItem('restaurantSettings', JSON.stringify(data));
                showSuccess('تم حفظ معلومات المطعم بنجاح');
            }

            function saveNotifications() {
                const data = {
                    orders: document.getElementById('notifyOrders').checked,
                    inventory: document.getElementById('notifyInventory').checked,
                    reviews: document.getElementById('notifyReviews').checked,
                    weekly: document.getElementById('notifyWeekly').checked,
                    email: document.getElementById('notifyEmail').checked
                };
                localStorage.setItem('notificationSettings', JSON.stringify(data));
                showSuccess('تم حفظ إعدادات الإشعارات بنجاح');
            }

            function changePassword() {
                const current = document.getElementById('currentPassword').value;
                const newPass = document.getElementById('newPassword').value;
                const confirmPass = document.getElementById('confirmPassword').value;
                if (!current || !newPass || !confirmPass) {
                    showSuccess('يرجى ملء جميع الحقول');
                    return;
                }
                if (newPass !== confirmPass) {
                    showSuccess('كلمتا المرور غير متطابقتين');
                    return;
                }
                localStorage.setItem('userPassword', newPass);
                document.getElementById('currentPassword').value = '';
                document.getElementById('newPassword').value = '';
                document.getElementById('confirmPassword').value = '';
                showSuccess('تم تغيير كلمة المرور بنجاح');
            }

            function deleteAccount() {
                localStorage.clear();
                showSuccess('تم حذف الحساب');
                setTimeout(() => window.location.href = '/', 1500);
            }

            function saveAppearance() {
                const data = {
                    fontSize: document.getElementById('fontSizeSelect').value,
                    animations: document.getElementById('animationsToggle').checked
                };
                localStorage.setItem('appearanceSettings', JSON.stringify(data));
                showSuccess('تم حفظ إعدادات المظهر بنجاح');
            }

            function createBackup() {
                const backup = {
                    profile: localStorage.getItem('userProfileSettings'),
                    restaurant: localStorage.getItem('restaurantSettings'),
                    notifications: localStorage.getItem('notificationSettings'),
                    appearance: localStorage.getItem('appearanceSettings'),
                    primaryColor: localStorage.getItem('primaryColor'),
                    twoFactorAuth: localStorage.getItem('twoFactorAuth'),
                    theme: localStorage.getItem('theme')
                };
                const blob = new Blob([JSON.stringify(backup, null, 2)], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `backup-${new Date().toISOString().slice(0,10)}.json`;
                a.click();
                URL.revokeObjectURL(url);
                showSuccess('تم إنشاء النسخة الاحتياطية');
            }

            function restoreBackup(file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    try {
                        const data = JSON.parse(e.target.result);
                        if (data.profile) localStorage.setItem('userProfileSettings', data.profile);
                        if (data.restaurant) localStorage.setItem('restaurantSettings', data.restaurant);
                        if (data.notifications) localStorage.setItem('notificationSettings', data.notifications);
                        if (data.appearance) localStorage.setItem('appearanceSettings', data.appearance);
                        if (data.primaryColor) localStorage.setItem('primaryColor', data.primaryColor);
                        if (data.twoFactorAuth) localStorage.setItem('twoFactorAuth', data.twoFactorAuth);
                        if (data.theme) localStorage.setItem('theme', data.theme);
                        loadLocalStorage();
                        showSuccess('تم استعادة النسخة الاحتياطية بنجاح');
                    } catch (err) {
                        showSuccess('ملف النسخة الاحتياطية غير صالح');
                    }
                };
                reader.readAsText(file);
            }

            document.getElementById('saveProfileBtn').addEventListener('click', saveProfile);
            document.getElementById('saveRestaurantBtn').addEventListener('click', saveRestaurant);
            document.getElementById('saveNotificationsBtn').addEventListener('click', saveNotifications);
            document.getElementById('changePasswordBtn').addEventListener('click', changePassword);
            document.getElementById('deleteAccountBtn').addEventListener('click', function() {
                showConfirm('تأكيد الحذف', 'هل أنت متأكد من رغبتك في حذف الحساب؟ لا يمكن التراجع عن هذا الإجراء.', deleteAccount);
            });
            document.getElementById('saveAppearanceBtn').addEventListener('click', saveAppearance);
            document.getElementById('createBackupBtn').addEventListener('click', createBackup);
            document.getElementById('restoreBackupBtn').addEventListener('click', function() {
                document.getElementById('restoreFileInput').click();
            });
            document.getElementById('restoreFileInput').addEventListener('change', function(e) {
                if (e.target.files.length > 0) {
                    restoreBackup(e.target.files[0]);
                    e.target.value = '';
                }
            });

            const colorOptions = document.querySelectorAll('.color-option');
            colorOptions.forEach(btn => {
                btn.addEventListener('click', function() {
                    const color = this.getAttribute('data-color');
                    document.documentElement.style.setProperty('--color-primary', color);
                    localStorage.setItem('primaryColor', color);
                    colorOptions.forEach(b => {
                        b.classList.remove('border-white');
                        b.classList.add('border-transparent');
                    });
                    this.classList.remove('border-transparent');
                    this.classList.add('border-white');
                    showSuccess('تم تغيير اللون الأساسي');
                });
            });

            document.getElementById('darkModeToggle').addEventListener('change', function(e) {
                const isDark = e.target.checked;
                document.body.classList.toggle('light', !isDark);
                document.querySelectorAll('.theme-toggle').forEach(t => t.classList.toggle('dark', isDark));
                localStorage.setItem('theme', isDark ? 'dark' : 'light');
                showSuccess('تم تغيير الوضع');
            });

            document.getElementById('twoFactorAuth').addEventListener('change', function(e) {
                localStorage.setItem('twoFactorAuth', e.target.checked ? 'true' : 'false');
            });

            const settingsTabs = document.querySelectorAll('.settings-tab');
            const tabContents = {
                'profile': document.getElementById('tab-profile'),
                'restaurant': document.getElementById('tab-restaurant'),
                'notifications': document.getElementById('tab-notifications'),
                'security': document.getElementById('tab-security'),
                'appearance': document.getElementById('tab-appearance'),
                'backup': document.getElementById('tab-backup')
            };

            settingsTabs.forEach(tab => {
                tab.addEventListener('click', function() {
                    settingsTabs.forEach(t => t.classList.remove('active'));
                    this.classList.add('active');
                    const tabName = this.getAttribute('data-tab');
                    Object.keys(tabContents).forEach(key => {
                        if (tabContents[key]) tabContents[key].classList.add('hidden');
                    });
                    if (tabContents[tabName]) tabContents[tabName].classList.remove('hidden');
                });
            });

            const themeToggles = document.querySelectorAll('.theme-toggle');
            function applyTheme(theme) {
                const isDark = theme === 'dark';
                document.body.classList.toggle('light', !isDark);
                themeToggles.forEach(toggle => toggle.classList.toggle('dark', isDark));
                document.getElementById('darkModeToggle').checked = isDark;
                localStorage.setItem('theme', theme);
            }
            const savedTheme = localStorage.getItem('theme') || 'dark';
            applyTheme(savedTheme);
            themeToggles.forEach(toggle => {
                toggle.addEventListener('click', () => {
                    const isDark = document.body.classList.contains('light') === false;
                    applyTheme(isDark ? 'light' : 'dark');
                });
            });

            document.getElementById('changeAvatarBtn').addEventListener('click', function() {
                const input = document.createElement('input');
                input.type = 'file';
                input.accept = 'image/*';
                input.onchange = function(e) {
                    if (e.target.files.length > 0) {
                        const file = e.target.files[0];
                        const reader = new FileReader();
                        reader.onload = function(ev) {
                            const imgUrl = ev.target.result;
                            userAvatar.src = imgUrl;
                            headerAvatar.src = imgUrl;
                            profileAvatar.src = imgUrl;
                            localStorage.setItem('userAvatar', imgUrl);
                            showSuccess('تم تغيير الصورة بنجاح');
                        };
                        reader.readAsDataURL(file);
                    }
                };
                input.click();
            });

            const savedAvatar = localStorage.getItem('userAvatar');
            if (savedAvatar) {
                userAvatar.src = savedAvatar;
                headerAvatar.src = savedAvatar;
                profileAvatar.src = savedAvatar;
            }
        })();
    </script>
</body>
</html>
