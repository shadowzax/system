<!DOCTYPE html>
<html lang="ar" dir="rtl" class="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <meta name="theme-color" content="#0d99ff">
    <title>إدارة المطاعم</title>
    <meta name="description" content="إدارة بيانات المطاعم">
    <link rel="icon" type="image/png" href="https://files.catbox.moe/kdxauw.png">
    <link rel="apple-touch-icon" href="https://files.catbox.moe/kdxauw.png">
    <link rel="manifest" href="/manifest.json">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/line-awesome/1.3.0/line-awesome/css/line-awesome.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <script src="https://cdn.tailwindcss.com">
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11">
    </script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#0d99ff',
                        secondary: '#7c3aed',
                        accent: '#06b6d4',
                        error: '#ef4444',
                        success: '#10b981',
                        warning: '#f59e0b',
                    }
                }
            }
        }
    </script>
    <style>
        :root {
            --color-primary: #0d99ff;
            --color-secondary: #7c3aed;
            --color-accent: #06b6d4;
            --color-background: #00080f;
            --color-card: #00060c;
            --color-darker: #000308;
            --color-paragraph: #bababa;
            --color-white: #ffffff;
            --color-muted: #9ca3af;
            --border-subtle: rgba(186, 186, 186, 0.24);
            --card-bg: #00060c;
            --border-color: rgba(186, 186, 186, 0.24);
            --darker-bg: #000308;
            --header-height: 70px;
            --shadow-glow: 0 0 30px rgba(13, 153, 255, 0.08);
        }

        .light {
            --color-background: #f1f5f9;
            --color-card: #ffffff;
            --color-darker: #e2e8f0;
            --color-paragraph: #334155;
            --color-white: #0f172a;
            --color-muted: #64748b;
            --border-subtle: rgba(0, 0, 0, 0.08);
            --card-bg: #ffffff;
            --border-color: rgba(0, 0, 0, 0.1);
            --darker-bg: #e2e8f0;
            --shadow-glow: 0 0 30px rgba(13, 153, 255, 0.04);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Alexandria', system-ui, sans-serif;
            background-color: var(--color-background);
            color: var(--color-white);
            transition: background-color 0.3s, color 0.3s;
            overflow-x: hidden;
            padding-bottom: 0;
        }

        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }

        ::-webkit-scrollbar-track {
            background: var(--color-background);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb {
            background: #0563a7;
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #0d99ff;
        }

        #mainHeader {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: var(--header-height);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            border-bottom: 1px solid var(--border-subtle);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            background: var(--color-background);
            z-index: 110;
            transition: background-color 0.3s;
        }

        main {
            padding-top: var(--header-height);
        }

        .title-cell {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 30px 32px;
            text-align: center;
            box-shadow: var(--shadow-glow);
            margin-bottom: 28px;
        }

        .title-cell h1 {
            font-size: 2rem;
            font-weight: 700;
            color: var(--color-white);
        }

        .title-cell p {
            color: var(--color-muted);
            font-size: 1rem;
            margin-top: 6px;
        }

        .title-cell .title-icon {
            font-size: 2.4rem;
            color: var(--color-primary);
            margin-bottom: 8px;
        }

        .theme-toggle {
            position: relative;
            width: 70px;
            height: 35px;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            overflow: hidden;
            background: linear-gradient(45deg, #ffd700, #ffed4a);
            box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.3);
            transition: all .4s ease;
        }

        .theme-toggle .toggle-circle {
            position: absolute;
            top: 4px;
            right: 4px;
            width: 27px;
            height: 27px;
            border-radius: 50%;
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 8px rgba(0, 0, 0, .2), inset 0 1px 0 rgba(255, 255, 255, .8);
            transition: all .45s cubic-bezier(.68, -0.55, .265, 1.55);
        }

        .theme-toggle .icon {
            position: absolute;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all .4s ease;
        }

        .theme-toggle .sun-icon {
            color: #ff6b35;
            opacity: 1;
            transform: rotate(0deg) scale(1);
        }

        .theme-toggle .moon-icon {
            color: #a78bfa;
            opacity: 0;
            transform: rotate(180deg) scale(.5);
        }

        .theme-toggle.dark {
            background: linear-gradient(45deg, #475569, #1e293b);
            box-shadow: 0 4px 12px rgba(30, 41, 59, .4), inset 0 1px 0 rgba(255, 255, 255, .08);
        }

        .theme-toggle.dark .toggle-circle {
            right: calc(100% - 31px);
            background: #1e293b;
            box-shadow: 0 4px 12px rgba(0, 0, 0, .4), inset 0 1px 0 rgba(255, 255, 255, .08);
        }

        .theme-toggle.dark .sun-icon {
            opacity: 0;
            transform: rotate(-180deg) scale(.5);
        }

        .theme-toggle.dark .moon-icon {
            opacity: 1;
            transform: rotate(0deg) scale(1);
        }

        .restaurant-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        @media (min-width: 640px) {
            .restaurant-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (min-width: 768px) {
            .restaurant-grid {
                grid-template-columns: repeat(4, 1fr);
            }
        }

        @media (min-width: 1024px) {
            .restaurant-grid {
                grid-template-columns: repeat(5, 1fr);
            }
        }

        @media (min-width: 1280px) {
            .restaurant-grid {
                grid-template-columns: repeat(6, 1fr);
            }
        }

        .restaurant-card-item {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: var(--shadow-glow);
            transition: all 0.3s ease;
            display: flex;
            cursor: pointer;
            position: relative;
            text-decoration: none;
        }

        .restaurant-card-item:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 40px rgba(13, 153, 255, 0.15);
            border-color: var(--color-primary);
        }

        .restaurant-card-item .logo-area {
            aspect-ratio: 1;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--darker-bg);
            overflow: hidden;
            transition: background-color 0.3s;
        }

        .restaurant-card-item .logo-area:hover {
            background: rgba(13, 153, 255, 0.04);
        }

        .restaurant-card-item .logo-area img {
            width: 70%;
            height: 70%;
            object-fit: contain;
            transition: transform 0.3s ease;
            border-radius: 12px;
        }

        .restaurant-card-item:hover .logo-area img {
            transform: scale(1.05);
        }

        .restaurant-card-item .logo-area .fallback-icon {
            font-size: 3rem;
            color: var(--color-muted);
            opacity: 0.5;
        }

        .empty-state {
            grid-column: 1 / -1;
            text-align: center;
            padding: 60px 20px;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            box-shadow: var(--shadow-glow);
        }

        .empty-state i {
            font-size: 4rem;
            color: var(--color-muted);
            opacity: 0.4;
        }

        .empty-state p {
            color: var(--color-muted);
            font-size: 1.1rem;
            font-weight: 600;
            margin-top: 16px;
        }

        .empty-state .sub-text {
            font-size: 0.85rem;
            opacity: 0.7;
            margin-top: 4px;
        }

        .header-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--color-white);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .header-title i {
            color: var(--color-primary);
            font-size: 1.5rem;
        }

        .logout-btn {
            background: transparent;
            border: 1px solid var(--border-color);
            color: var(--color-muted);
            cursor: pointer;
            border-radius: 12px;
            padding: 8px 14px;
            font-size: 0.85rem;
            font-family: inherit;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
        }

        .logout-btn:hover {
            color: #ef4444;
            border-color: #ef4444;
            background: rgba(239, 68, 68, 0.08);
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        @media (max-width: 480px) {
            .restaurant-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 12px;
            }

            .header-title {
                font-size: 1rem;
            }

            .header-title i {
                font-size: 1.2rem;
            }

            .logout-btn span {
                display: none;
            }

            .title-cell {
                padding: 20px 16px;
            }

            .title-cell h1 {
                font-size: 1.4rem;
            }
        }
    </style>
</head>

<body>
    <header id="mainHeader">
        <div class="header-title">
            <i class="las la-utensils"></i>
            <span>إدارة المطاعم</span>
        </div>
        <div class="header-actions">
            <button id="themetoggle" class="theme-toggle" aria-label="تبديل السمة">
                <span class="toggle-circle">
                    <span class="icon sun-icon"><i class="fas fa-sun"></i></span>
                    <span class="icon moon-icon"><i class="fas fa-moon"></i></span>
                </span>
            </button>
            <button id="logoutBtn" class="logout-btn">
                <i class="las la-sign-out-alt"></i>
                <span>تسجيل الخروج</span>
            </button>
        </div>
    </header>

    <main>
        <div class="container mx-auto px-4 py-6 max-w-7xl">
            <div class="title-cell">
                <div class="title-icon"><i class="las la-utensils"></i></div>
                <h1>إدارة المطاعم</h1>
                <p>اضغط على الأيقونة للانتقال إلى المطعم</p>
            </div>
            <div class="restaurant-grid" id="restaurantGrid"></div>
        </div>
    </main>

    <script>
        const restaurantGrid = document.getElementById('restaurantGrid');
        let restaurants = [];

        const defaultRestaurants = [{
            id: "1",
            name: "ابن حميدو السلام",
            logo: "https://sys.shadowza.space/logos/1.png",
            main_link: "/",
            admin_link: "/admin/resturant/1"
        }, {
            id: "2",
            name: "مطاعم نعمه",
            logo: "https://sys.shadowza.space/logos/2.png",
            main_link: "/neama/outgoing",
            admin_link: "/admin/resturant/2"
        }, {
            id: "3",
            name: "تشكن كينج",
            logo: "/logos/3.png",
            main_link: "/chicken/outgoing",
            admin_link: "/admin/resturant/3"
        }];

        function renderRestaurantGrid() {
            restaurantGrid.innerHTML = '';
            if (restaurants.length === 0) {
                const emptyDiv = document.createElement('div');
                emptyDiv.className = 'empty-state';
                emptyDiv.innerHTML = `
                    <i class="las la-store-alt"></i>
                    <p>لا توجد مطاعم حالياً</p>
                    <p class="sub-text">ابدأ بإضافة مطعم جديد</p>
                `;
                restaurantGrid.appendChild(emptyDiv);
                return;
            }
            restaurants.forEach((rest) => {
                const card = document.createElement('a');
                card.className = 'restaurant-card-item';
                card.href = rest.main_link || '#';
                const logoContent = rest.logo ?
                    `<img src="${rest.logo}" alt="${rest.name}" onerror="this.onerror=null;this.parentElement.innerHTML='<i class=\\'las la-store-alt fallback-icon\\'></i>'">` :
                    `<i class="las la-store-alt fallback-icon"></i>`;
                card.innerHTML = `
                    <div class="logo-area">
                        ${logoContent}
                    </div>
                `;
                restaurantGrid.appendChild(card);
            });
        }

        const themeToggleBtn = document.getElementById('themetoggle');
        const body = document.body;

        function applyTheme(theme) {
            const isDark = theme === 'dark';
            body.classList.toggle('light', !isDark);
            themeToggleBtn.classList.toggle('dark', isDark);
            localStorage.setItem('theme', theme);
        }

        const savedTheme = localStorage.getItem('theme') || 'dark';
        applyTheme(savedTheme);

        themeToggleBtn.addEventListener('click', () => {
            const isDark = !body.classList.contains('light');
            applyTheme(isDark ? 'light' : 'dark');
        });

        const logoutBtn = document.getElementById('logoutBtn');
        logoutBtn.addEventListener('click', () => {
            Swal.fire({
                title: 'تسجيل الخروج',
                text: 'هل أنت متأكد من تسجيل الخروج؟',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#0d99ff',
                confirmButtonText: 'نعم، تسجيل الخروج',
                cancelButtonText: 'إلغاء'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
                    window.location.href = '/';
                }
            });
        });

        restaurants = defaultRestaurants;
        renderRestaurantGrid();
    </script>
</body>

</html>
