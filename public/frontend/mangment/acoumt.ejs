    </script>

    <script>
    // ============================================================
    // 42. تطبيق الثيم
    // ============================================================
    var savedTheme = localStorage.getItem('theme') || 'dark';
    applyTheme(savedTheme);

    themeToggles.forEach(function(toggle) {
        toggle.addEventListener('click', function () {
            var isDark = body.classList.contains('light') === false;
            applyTheme(isDark ? 'light' : 'dark');
        });
    });
    </script>

    <script>
    // ============================================================
    // 43. تحميل بيانات المستخدم من localStorage
    // ============================================================
    try {
        var stored = localStorage.getItem('userProfileData');
    if (stored) {
            var data = JSON.parse(stored);
    if (data.fullName) userFullNameEl.textContent = data.fullName;
    if (data.role) roleEl.textContent = data.role;
    if (data.avatar) {headerAvatarImg.src = data.avatar;
                userAvatarImg.src = data.avatar; }
        }
    } catch (e) { }
    </script>

    <script>
    // ============================================================
    // 44. التحميل الأولي للحسابات
    // ============================================================
    loadAccounts();
    </script>
</body>

</html>