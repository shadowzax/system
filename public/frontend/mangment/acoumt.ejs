    <script>
        // ============================================================
        // 8. formatDate
        // ============================================================
        function formatDate(isoString) {
            if (!isoString) return 'لم يسجل بعد';
            try {
                var d = new Date(isoString);
                return d.toLocaleDateString('ar-EG', { day: 'numeric', month: 'short', year: 'numeric' }) + ' ' + d.toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' });
            } catch (e) {
                return isoString;
            }
        }
    </script>

    <script>
        // ============================================================
        // 9. getRoleBadgeClass
        // ============================================================
        function getRoleBadgeClass(role) {
            var map = { admin: 'admin', manager: 'manager', user: 'user', viewer: 'viewer' };
            return map[role] || 'user';
        }
    </script>

    <script>
        // ============================================================
        // 10. getRoleLabel
        // ============================================================
        function getRoleLabel(role) {
            var map = { admin: 'مدير النظام', manager: 'مدير', user: 'مستخدم', viewer: 'مشاهد فقط' };
            return map[role] || 'مستخدم';
        }
    </script>

    <script>
        // ============================================================
        // 11. getStatusBadge
        // ============================================================
        function getStatusBadge(status) {
            var isActive = status === 'active' || status === true || status === 1;
            if (isActive) {
                return '<span class="badge-success"><i class="las la-check-circle"></i> نشط</span>';
            }
            return '<span class="badge-danger"><i class="las la-times-circle"></i> غير نشط</span>';
        }
    </script>

    <script>
        // ============================================================
        // 12. renderAccountsTable
        // ============================================================
        function renderAccountsTable(accounts) {
            cachedAccounts = accounts || [];
            accountsTableBody.innerHTML = '';
            if (!cachedAccounts.length) {
                noAccountsMsg.style.display = 'block';
                accountsTable.style.display = 'none';
                accountsCountLabel.textContent = '0 حساب';
                accountsLoadingMsg.style.display = 'none';
                accountsErrorMsg.style.display = 'none';
                return;
            }
            noAccountsMsg.style.display = 'none';
            accountsTable.style.display = 'table';
            accountsLoadingMsg.style.display = 'none';
            accountsErrorMsg.style.display = 'none';
            accountsCountLabel.textContent = cachedAccounts.length + ' حساب';
            cachedAccounts.forEach(function (acc) {
                var tr = document.createElement('tr');
                var accId = acc.id || acc._id || '';
                var accName = acc.name || acc.fullName || acc.full_name || '-';
                var accEmailVal = acc.email || '-';
                var accRoleVal = acc.account_type || acc.role || acc.accountType || 'user';
                var accStatusVal = acc.account_status || acc.status || acc.active;
                var accLastLogin = acc.last_login || acc.lastLogin || null;
                var accJobTitleVal = acc.job_title || acc.jobTitle || '';
                tr.innerHTML =
                    '<td><div class="flex items-center gap-2"><div class="w-8 h-8 rounded-full bg-[var(--darker-bg)] border border-[var(--border-color)] flex items-center justify-center flex-shrink-0"><i class="las la-user text-sm text-[var(--color-muted)]"></i></div><div><p class="font-medium text-[var(--color-white)] text-sm">' +
                    accName + '</p>' + (accJobTitleVal ? '<p class="text-xs text-[var(--color-muted)]">' + accJobTitleVal + '</p>' : '') +
                    '</div></div></td>' +
                    '<td class="text-sm text-[var(--color-muted)]" dir="ltr" style="text-align:right;">' + accEmailVal + '</td>' +
                    '<td><span class="role-badge ' + getRoleBadgeClass(accRoleVal) + '">' + getRoleLabel(accRoleVal) + '</span></td>' +
                    '<td>' + getStatusBadge(accStatusVal) + '</td>' +
                    '<td class="text-xs text-[var(--color-muted)]">' + formatDate(accLastLogin) + '</td>' +
                    '<td><div class="flex gap-1"><button class="btn-outline btn-xs edit-account-btn" data-id="' + accId + '" title="تعديل"><i class="las la-edit"></i></button><button class="btn-outline btn-xs delete-account-btn" data-id="' + accId + '" title="حذف" style="color:#ef4444;border-color:rgba(239,68,68,0.3);"><i class="las la-trash-alt"></i></button></div></td>';
                accountsTableBody.appendChild(tr);
            });
            accountsTableBody.querySelectorAll('.edit-account-btn').forEach(function (btn) {
                btn.addEventListener('click', function () { openEditModal(this.getAttribute('data-id')); });
            });
            accountsTableBody.querySelectorAll('.delete-account-btn').forEach(function (btn) {
                btn.addEventListener('click', function () { confirmDeleteAccount(this.getAttribute('data-id')); });
            });
        }
    </script>

    <script>
        // ============================================================
