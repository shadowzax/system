    </script>

    <script>
        // ============================================================
        // 14. showErrorState
        // ============================================================
        function showErrorState() {
            accountsTable.style.display = 'none';
            noAccountsMsg.style.display = 'none';
            accountsLoadingMsg.style.display = 'none';
            accountsErrorMsg.style.display = 'block';
            accountsCountLabel.textContent = 'فشل التحميل';
        }
    </script>

    <script>
        // ============================================================
        // 15. loadAccounts
        // ============================================================
        function loadAccounts() {
            showLoadingState();
            fetch(LIST_URL, { method: 'GET', headers: { 'Content-Type': 'application/json' } })
                .then(function (res) {
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(function (data) {
                    var accounts = [];
                    if (Array.isArray(data)) {
                        accounts = data;
                    } else if (data && data.success && Array.isArray(data.data)) {
                        accounts = data.data;
                    } else if (data && Array.isArray(data.accounts)) {
                        accounts = data.accounts;
                    } else if (data && Array.isArray(data.results)) {
                        accounts = data.results;
                    }
                    renderAccountsTable(accounts);
                })
                .catch(function () {
                    showErrorState();
                });
        }
    </script>

