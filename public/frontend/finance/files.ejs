    <div class="modal-overlay" id="employeeFormModal">
        <div class="modal-content">
            <button class="modal-close" id="closeEmployeeFormModal"><i class="las la-times"></i></button>
            <h3 class="text-xl font-bold mb-4 text-[var(--color-white)] text-center" id="employeeFormTitle">إضافة موظف</h3>
            <div id="employeeFormFields">
                <div id="empReadonlyFields" style="display:none;">
                    <div class="mb-3">
                        <label class="text-sm text-[var(--color-muted)] block mb-1">كود الموظف</label>
                        <div class="readonly-label" id="empCodeDisplay">---</div>
                    </div>
                    <div class="mb-3">
                        <label class="text-sm text-[var(--color-muted)] block mb-1">الاسم</label>
                        <div class="readonly-label" id="empNameDisplay">---</div>
                    </div>
                </div>
                <div id="empEditableFields">
                    <div id="empNameInputWrap" class="mb-3">
                        <label class="text-sm text-[var(--color-muted)] block mb-1">الاسم</label>
                        <input type="text" id="empNameInput" class="input-field" placeholder="أدخل اسم الموظف">
                    </div>
                    <div class="mb-3">
                        <label class="text-sm text-[var(--color-muted)] block mb-1">المهنة</label>
                        <input type="text" id="empProfessionInput" class="input-field" placeholder="أدخل المهنة">
                    </div>
                    <div class="mb-3">
                        <label class="text-sm text-[var(--color-muted)] block mb-1">الراتب الشهري (ج.م)</label>
                        <input type="text" id="empMonthlySalaryInput" class="input-field" placeholder="أدخل الراتب الشهري" inputmode="decimal">
                    </div>
                </div>
            </div>
            <input type="hidden" id="empEditId">
            <div class="flex gap-3 mt-5 justify-center">
                <button class="btn-primary btn-sm" id="saveEmployeeBtn"><i class="las la-save"></i> حفظ</button>
                <button class="btn-outline btn-sm" id="cancelEmployeeBtn"><i class="las la-times"></i> إلغاء</button>
            </div>
        </div>
    </div>
    <div class="modal-overlay" id="fileFormModal">
        <div class="modal-content">
            <button class="modal-close" id="closeFileFormModal"><i class="las la-times"></i></button>
            <h3 class="text-xl font-bold mb-4 text-[var(--color-white)] text-center">ملف جديد</h3>
            <div><label class="text-sm text-[var(--color-muted)] block mb-1">اسم الملف</label><input type="text" id="fileNameInput" class="input-field" placeholder="أدخل اسم الملف"></div>
            <div class="flex gap-3 mt-5 justify-center">
                <button class="btn-primary btn-sm" id="saveFileBtn"><i class="las la-save"></i> إنشاء</button>
                <button class="btn-outline btn-sm" id="cancelFileBtn"><i class="las la-times"></i> إلغاء</button>
            </div>
        </div>
    </div>
    <div class="modal-overlay" id="successModal">
        <div class="modal-content text-center">
            <button class="modal-close" id="closeSuccessModal"><i class="las la-times"></i></button>
            <i class="las la-check-circle text-5xl text-primary mb-4"></i>
            <h3 class="text-xl font-bold mb-2 text-[var(--color-white)]">تم بنجاح</h3>
            <p id="successMessage" class="text-[var(--color-muted)]"></p>
            <button id="okSuccessBtn" class="btn-primary mt-6 w-full justify-center">حسناً</button>
        </div>
    </div>
    <div class="modal-overlay" id="confirmModal">
        <div class="modal-content text-center">
            <button class="modal-close" id="closeConfirmModal"><i class="las la-times"></i></button>
            <i class="las la-question-circle text-5xl text-warning mb-4"></i>
            <h3 class="text-xl font-bold mb-2 text-[var(--color-white)]">تأكيد</h3>
            <p id="confirmMessage" class="text-[var(--color-muted)]"></p>
            <div class="flex gap-3 mt-5 justify-center">
                <button class="btn-primary btn-sm" id="confirmYesBtn" style="background:#ef4444;">نعم</button>
                <button class="btn-outline btn-sm" id="confirmNoBtn">لا</button>
            </div>
        </div>
    </div>
    <script>
        window.__SERVER_DATA__ = <%- JSON.stringify(adminFiles) %>;
    </script>
    <script>
        (function() {
            var API_BASE = "<%= api %>" + '/api/admin/files';
            var appData = { files: [] };
            var currentFileId = null;
            var confirmCallback = null;
            var sidebar = document.getElementById('dashboardSidebar');
            var headerAvatar = document.getElementById('headerAvatar');

            function openSidebar() {
                sidebar.classList.add('mobile-open');
                sidebar.classList.remove('mobile-closed');
            }

            function closeSidebar() {
                sidebar.classList.remove('mobile-open');
                sidebar.classList.add('mobile-closed');
            }
            if (window.innerWidth < 1025) sidebar.classList.add('mobile-closed');
            window.addEventListener('resize', function() {
                if (window.innerWidth >= 1025) {
                    sidebar.classList.remove('mobile-open', 'mobile-closed');
                } else {
                    if (!sidebar.classList.contains('mobile-open')) sidebar.classList.add('mobile-closed');
                }
            });
            if (headerAvatar) {
                headerAvatar.addEventListener('click', function(e) {
                    e.stopPropagation();
                    if (window.innerWidth < 1025) {
                        if (sidebar.classList.contains('mobile-open')) closeSidebar();
                        else openSidebar();
                    }
                });
            }
            document.addEventListener('click', function(e) {
                if (window.innerWidth < 1025 && sidebar.classList.contains('mobile-open')) {
                    if (!sidebar.contains(e.target) && e.target !== headerAvatar && !headerAvatar.contains(e.target)) {
                        closeSidebar();
                    }
                }
            });
            var sidebarItems = document.querySelectorAll('.sidebar-item');
            sidebarItems.forEach(function(item) {
                item.addEventListener('click', function() {
                    if (this.id === 'logoutBtn') return;
                    sidebarItems.forEach(function(i) { i.classList.remove('active'); });
                    this.classList.add('active');
                    if (window.innerWidth < 1025) closeSidebar();
                });
            });
            var logoutBtn = document.getElementById('logoutBtn');
            if (logoutBtn) {
                logoutBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    if (confirm('هل أنت متأكد من تسجيل الخروج؟')) window.location.href = '/';
                });
            }
            var bottomNavItems = document.querySelectorAll('.bottom-nav-item');
            var navNotch = document.getElementById('navNotch');

            function moveNotch(activeItem) {
                if (!navNotch || !activeItem) return;
                var rect = activeItem.getBoundingClientRect();
                var navRect = document.getElementById('bottomMobileNav').getBoundingClientRect();
                var centerX = rect.left + rect.width / 2 - navRect.left;
                navNotch.style.left = centerX + 'px';
            }
            bottomNavItems.forEach(function(item) {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    bottomNavItems.forEach(function(i) { i.classList.remove('active'); });
                    this.classList.add('active');
                    moveNotch(this);
                });
            });
            var initialActive = document.querySelector('.bottom-nav-item.active');
            if (initialActive) moveNotch(initialActive);
            window.addEventListener('resize', function() {
                var activeItem = document.querySelector('.bottom-nav-item.active');
                if (activeItem) moveNotch(activeItem);
            });
            var successModal = document.getElementById('successModal');
            var successMessageEl = document.getElementById('successMessage');

            function showSuccess(msg) {
                successMessageEl.textContent = msg;
                successModal.classList.add('active');
            }

            function hideSuccess() {
                successModal.classList.remove('active');
            }
            document.getElementById('closeSuccessModal').addEventListener('click', hideSuccess);
            document.getElementById('okSuccessBtn').addEventListener('click', hideSuccess);
            window.addEventListener('click', function(e) {
                if (e.target === successModal) hideSuccess();
            });
            var confirmModal = document.getElementById('confirmModal');
            var confirmMessageEl = document.getElementById('confirmMessage');

            function showConfirm(msg, callback) {
                confirmMessageEl.textContent = msg;
                confirmCallback = callback;
                confirmModal.classList.add('active');
            }

            function hideConfirm() {
                confirmModal.classList.remove('active');
                confirmCallback = null;
            }
            document.getElementById('closeConfirmModal').addEventListener('click', hideConfirm);
            document.getElementById('confirmNoBtn').addEventListener('click', hideConfirm);
            document.getElementById('confirmYesBtn').addEventListener('click', function() {
                if (confirmCallback) {
                    confirmCallback();
                    confirmCallback = null;
                }
                hideConfirm();
            });
            window.addEventListener('click', function(e) {
                if (e.target === confirmModal) hideConfirm();
            });
            var employeeFormModal = document.getElementById('employeeFormModal');
            var fileFormModal = document.getElementById('fileFormModal');
            document.getElementById('closeEmployeeFormModal').addEventListener('click', function() {
                employeeFormModal.classList.remove('active');
            });
            document.getElementById('cancelEmployeeBtn').addEventListener('click', function() {
                employeeFormModal.classList.remove('active');
            });
            document.getElementById('closeFileFormModal').addEventListener('click', function() {
                fileFormModal.classList.remove('active');
            });
            document.getElementById('cancelFileBtn').addEventListener('click', function() {
                fileFormModal.classList.remove('active');
            });
            window.addEventListener('click', function(e) {
                if (e.target === employeeFormModal) employeeFormModal.classList.remove('active');
                if (e.target === fileFormModal) fileFormModal.classList.remove('active');
            });
            var filesView = document.getElementById('filesView');
            var employeesView = document.getElementById('employeesView');
            var filesList = document.getElementById('filesList');
            var currentFileName = document.getElementById('currentFileName');
            var employeesTableBody = document.getElementById('employeesTableBody');
            var employeeSearchInput = document.getElementById('employeeSearch');
            var fileSearchInput = document.getElementById('fileSearch');

            function renderFilesList() {
                var query = fileSearchInput ? fileSearchInput.value.toLowerCase().trim() : '';
                filesList.innerHTML = '';
                var filteredFiles = appData.files.filter(function(file) {
                    return file.name && file.name.toLowerCase().includes(query);
                });
                if (filteredFiles.length === 0) {
                    filesList.innerHTML =
                        '<div class="text-center py-8 text-[var(--color-muted)]"><i class="las la-folder-open text-5xl block mb-3 opacity-30"></i><p>لا توجد ملفات</p><p class="text-xs mt-1">أنشئ ملفاً جديداً أو غيّر البحث</p></div>';
                    return;
                }
                filteredFiles.forEach(function(file) {
                    var employeeCount = file.employees ? file.employees.length : 0;
                    var div = document.createElement('div');
                    div.className = 'file-card';
                    div.innerHTML =
                        '<div class="file-icon"><i class="las la-folder"></i></div><div class="flex-1 min-w-0"><p class="font-bold text-[var(--color-white)] text-base">' +
                        (file.name || 'ملف بدون اسم') +
                        '</p><p class="text-xs text-[var(--color-muted)]">' + employeeCount +
                        ' موظف · أنشئ ' + new Date(file.createdAt).toLocaleDateString('ar-EG') +
                        '</p></div><div class="flex gap-2 flex-shrink-0"><button class="btn-outline btn-xs open-file-btn" data-id="' +
                        file.id + '" title="فتح الملف"><i class="las la-folder-open"></i> فتح</button><button class="btn-outline btn-xs delete-file-btn" data-id="' +
                        file.id + '" title="حذف الملف" style="color:#ef4444;border-color:rgba(239,68,68,0.3);"><i class="las la-trash-alt"></i></button></div>';
                    filesList.appendChild(div);
                });
                document.querySelectorAll('.open-file-btn').forEach(function(btn) {
                    btn.addEventListener('click', function() {
                        openFile(this.getAttribute('data-id'));
                    });
                });
                document.querySelectorAll('.delete-file-btn').forEach(function(btn) {
                    btn.addEventListener('click', function(e) {
                        e.stopPropagation();
                        var fid = this.getAttribute('data-id');
                        showConfirm('هل أنت متأكد من حذف هذا الملف وجميع موظفيه؟', function() {
                            deleteFile(fid);
                        });
                    });
                });
            }
            if (fileSearchInput) {
                fileSearchInput.addEventListener('input', renderFilesList);
            }

            function openFile(fileId) {
                currentFileId = fileId;
                var file = appData.files.find(function(f) { return f.id === fileId; });
                if (!file) return;
                if (!file.employees) file.employees = [];
                currentFileName.textContent = '📁 ' + (file.name || 'ملف');
                filesView.style.display = 'none';
                employeesView.style.display = 'block';
                if (employeeSearchInput) employeeSearchInput.value = '';
                renderEmployeesTable();
            }

            function closeFile() {
                currentFileId = null;
                filesView.style.display = 'block';
                employeesView.style.display = 'none';
                renderFilesList();
            }

            function deleteFile(fileId) {
                fetch(API_BASE + '/delete-file', {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ fileId: fileId })
                })
                .then(function(res) { return res.json(); })
                .then(function(result) {
                    if (result.success) {
                        appData.files = appData.files.filter(function(f) { return f.id !== fileId; });
                        if (currentFileId === fileId) closeFile();
                        renderFilesList();
                        showSuccess(result.message || 'تم حذف الملف بنجاح.');
                    } else {
                        showSuccess(result.message || 'فشل حذف الملف');
                    }
                })
                .catch(function(err) {
                    showSuccess('حدث خطأ: ' + err.message);
                });
            }

            function updateLocalFile(fileId, updatedFile) {
                var index = appData.files.findIndex(function(f) { return f.id === fileId; });
                if (index !== -1) {
                    appData.files[index] = updatedFile;
                } else {
                    appData.files.push(updatedFile);
                }
            }

            function renderEmployeesTable() {
                employeesTableBody.innerHTML = '';
                var file = appData.files.find(function(f) { return f.id === currentFileId; });
                if (!file || !file.employees || file.employees.length === 0) {
                    employeesTableBody.innerHTML =
                        '<tr><td colspan="7" class="text-center py-8 text-[var(--color-muted)]"><i class="las la-users text-4xl block mb-2 opacity-30"></i>لا يوجد موظفين في هذا الملف</td></tr>';
                    return;
                }
                file.employees.forEach(function(emp, index) {
                    var monthly = parseFloat(emp.monthlySalary) || 0;
                    var daily = monthly / 30;
                    var dailyStr = daily.toFixed(2);
                    var tr = document.createElement('tr');
                    tr.innerHTML =
                        '<td>' + (index + 1) +
                        '</td><td><span class="emp-code">' + (emp.code || '---') +
                        '</span></td><td><div class="emp-name">' + (emp.name || '---') +
                        '</div></td><td>' + (emp.profession || '---') +
                        '</td><td>' + monthly +
                        '</td><td><span class="daily-salary">' + dailyStr +
                        '</span></td><td><div class="emp-actions"><button class="btn-outline btn-xs edit-emp-btn" data-eid="' +
                        emp.id + '" title="تعديل"><i class="las la-edit"></i></button><button class="btn-outline btn-xs delete-emp-btn" data-eid="' +
                        emp.id + '" title="حذف" style="color:#ef4444;border-color:rgba(239,68,68,0.3);"><i class="las la-trash-alt"></i></button></div></td>';
                    employeesTableBody.appendChild(tr);
                });
                employeesTableBody.querySelectorAll('.edit-emp-btn').forEach(function(btn) {
                    btn.addEventListener('click', function() {
                        openEmployeeForm(this.getAttribute('data-eid'));
                    });
                });
                employeesTableBody.querySelectorAll('.delete-emp-btn').forEach(function(btn) {
                    btn.addEventListener('click', function() {
                        var eid = this.getAttribute('data-eid');
                        showConfirm('هل أنت متأكد من حذف هذا الموظف؟', function() {
                            deleteEmployee(eid);
                        });
                    });
                });
                applyEmployeeFilter();
            }

            function applyEmployeeFilter() {
                var query = employeeSearchInput ? employeeSearchInput.value.toLowerCase().trim() : '';
                var rows = employeesTableBody.querySelectorAll('tr');
                rows.forEach(function(row) {
                    var codeCell = row.cells[1];
                    var nameCell = row.cells[2];
                    if (!codeCell || !nameCell) return;
                    var codeText = codeCell.textContent.toLowerCase();
                    var nameText = nameCell.textContent.toLowerCase();
                    if (codeText.includes(query) || nameText.includes(query)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }
            if (employeeSearchInput) {
                employeeSearchInput.addEventListener('input', applyEmployeeFilter);
            }

            function deleteEmployee(employeeId) {
                var fileId = currentFileId;
                if (!fileId) return;
                fetch(API_BASE + '/delete-employee', {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ fileId: fileId, employeeId: employeeId })
                })
                .then(function(res) { return res.json(); })
                .then(function(result) {
                    if (result.success && result.file) {
                        updateLocalFile(fileId, result.file);
                        renderEmployeesTable();
                        showSuccess(result.message || 'تم حذف الموظف بنجاح.');
                    } else {
                        showSuccess(result.message || 'فشل حذف الموظف');
                    }
                })
                .catch(function(err) {
                    showSuccess('حدث خطأ: ' + err.message);
                });
            }

            function openEmployeeForm(editId) {
                var modal = document.getElementById('employeeFormModal');
                var title = document.getElementById('employeeFormTitle');
                var editIdInput = document.getElementById('empEditId');
                var readonlyWrap = document.getElementById('empReadonlyFields');
                var editableWrap = document.getElementById('empEditableFields');
                var nameInputWrap = document.getElementById('empNameInputWrap');
                var nameInput = document.getElementById('empNameInput');
                var codeDisplay = document.getElementById('empCodeDisplay');
                var nameDisplay = document.getElementById('empNameDisplay');
                var professionInput = document.getElementById('empProfessionInput');
                var salaryInput = document.getElementById('empMonthlySalaryInput');
                editIdInput.value = editId || '';
                if (editId) {
                    title.textContent = 'تعديل بيانات الموظف';
                    readonlyWrap.style.display = 'block';
                    nameInputWrap.style.display = 'none';
                    var file = appData.files.find(function(f) { return f.id === currentFileId; });
                    if (file) {
                        var emp = file.employees.find(function(e) { return e.id === editId; });
                        if (emp) {
                            codeDisplay.textContent = emp.code || '---';
                            nameDisplay.textContent = emp.name || '---';
                            professionInput.value = emp.profession || '';
                            salaryInput.value = emp.monthlySalary || '';
                        }
                    }
                } else {
                    title.textContent = 'إضافة موظف جديد';
                    readonlyWrap.style.display = 'none';
                    nameInputWrap.style.display = 'block';
                    nameInput.value = '';
                    professionInput.value = '';
                    salaryInput.value = '';
                }
                modal.classList.add('active');
            }

            function saveEmployee() {
                var editId = document.getElementById('empEditId').value;
                var nameInput = document.getElementById('empNameInput');
                var professionInput = document.getElementById('empProfessionInput');
                var salaryInput = document.getElementById('empMonthlySalaryInput');
                var fileId = currentFileId;
                if (!fileId) return;

                if (editId) {
                    var nameDisplay = document.getElementById('empNameDisplay');
                    var employeeName = nameDisplay.textContent.trim();
                    var payload = {
                        fileId: fileId,
                        employeeId: editId,
                        name: employeeName,
                        profession: professionInput.value.trim(),
                        monthlySalary: salaryInput.value.trim()
                    };
                    fetch(API_BASE + '/update-employee', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    })
                    .then(function(res) { return res.json(); })
                    .then(function(result) {
                        if (result.success && result.file) {
                            updateLocalFile(fileId, result.file);
                            document.getElementById('employeeFormModal').classList.remove('active');
                            renderEmployeesTable();
                            showSuccess(result.message || 'تم تحديث بيانات الموظف بنجاح.');
                        } else {
                            showSuccess(result.message || 'فشل تحديث الموظف');
                        }
                    })
                    .catch(function(err) {
                        showSuccess('حدث خطأ: ' + err.message);
                    });
                } else {
                    var name = nameInput.value.trim();
                    if (!name) {
                        showSuccess('يرجى إدخال اسم الموظف.');
                        return;
                    }
                    var payload = {
                        fileId: fileId,
                        name: name,
                        profession: professionInput.value.trim(),
                        monthlySalary: salaryInput.value.trim()
                    };
                    fetch(API_BASE + '/add-employee', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    })
                    .then(function(res) { return res.json(); })
                    .then(function(result) {
                        if (result.success && result.file) {
                            updateLocalFile(fileId, result.file);
                            document.getElementById('employeeFormModal').classList.remove('active');
                            renderEmployeesTable();
                            showSuccess(result.message || 'تم إضافة الموظف بنجاح.');
                        } else {
                            showSuccess(result.message || 'فشل إضافة الموظف');
                        }
                    })
                    .catch(function(err) {
                        showSuccess('حدث خطأ: ' + err.message);
                    });
                }
            }

            document.getElementById('addFileBtn').addEventListener('click', function() {
                document.getElementById('fileNameInput').value = '';
                fileFormModal.classList.add('active');
            });
            document.getElementById('saveFileBtn').addEventListener('click', function() {
                var name = document.getElementById('fileNameInput').value.trim();
                if (!name) {
                    showSuccess('يرجى إدخال اسم الملف.');
                    return;
                }
                fetch(API_BASE + '/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: name })
                })
                .then(function(res) { return res.json(); })
                .then(function(result) {
                    if (result.success && result.file) {
                        appData.files.push(result.file);
                        fileFormModal.classList.remove('active');
                        renderFilesList();
                        showSuccess(result.message || 'تم إنشاء الملف بنجاح.');
                    } else {
                        showSuccess(result.message || 'فشل إنشاء الملف');
                    }
                })
                .catch(function(err) {
                    showSuccess('حدث خطأ: ' + err.message);
                });
            });
            document.getElementById('backToFilesBtn').addEventListener('click', closeFile);
            document.getElementById('addEmployeeBtn').addEventListener('click', function() {
                openEmployeeForm(null);
            });
            document.getElementById('saveEmployeeBtn').addEventListener('click', saveEmployee);

            function loadInitialData() {
                var serverData = window.__SERVER_DATA__;
                if (serverData && serverData.success && Array.isArray(serverData.files)) {
                    appData.files = serverData.files;
                    renderFilesList();
                } else if (serverData && Array.isArray(serverData)) {
                    appData.files = serverData;
                    renderFilesList();
                } else {
                    showSuccess('فشل تحميل الملفات');
                }
            }

            document.addEventListener('DOMContentLoaded', function() {
                var themeToggles = document.querySelectorAll('.theme-toggle');
                var body = document.body;

                function applyTheme(theme) {
                    var isDark = theme === 'dark';
                    body.classList.toggle('light', !isDark);
                    themeToggles.forEach(function(toggle) { toggle.classList.toggle('dark', isDark); });
                    localStorage.setItem('theme', theme);
                }
                var savedTheme = localStorage.getItem('theme') || 'dark';
                applyTheme(savedTheme);
                themeToggles.forEach(function(toggle) {
                    toggle.addEventListener('click', function() {
                        var isDark = body.classList.contains('light') === false;
                        applyTheme(isDark ? 'light' : 'dark');
                    });
                });
                loadInitialData();
            });
        })();
    </script>
</body>
</html>
