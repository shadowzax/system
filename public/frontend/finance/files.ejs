<!DOCTYPE html>
<html lang="ar" dir="rtl" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <meta name="theme-color" content="#0d99ff">
    <title>إدارة الملفات والموظفين</title>
    <meta name="description" content="نظام إدارة الملفات والموظفين">
    <link rel="icon" type="image/png" href="/favicon.ico">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/line-awesome/1.3.0/line-awesome/css/line-awesome.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/files.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#0d99ff',
                        secondary: '#7c3aed',
                        accent: '#06b6d4',
                        error: '#ef4444',
                        success: '#10b981',
                        warning: '#f59e0b',
                    }
                }
            }
        }
    </script>
    <style>
        .admin-lock-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.85);
            z-index: 99999;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            text-align: center;
            padding: 2rem;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }
        .admin-lock-overlay .lock-icon {
            font-size: 6rem;
            color: #ef4444;
            margin-bottom: 1.5rem;
            animation: pulse-lock 2s ease-in-out infinite;
        }
        .admin-lock-overlay h2 {
            font-size: 2rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 0.75rem;
            font-family: 'Alexandria', sans-serif;
        }
        .admin-lock-overlay p {
            font-size: 1.1rem;
            color: #9ca3af;
            max-width: 500px;
            line-height: 1.8;
            font-family: 'Alexandria', sans-serif;
        }
        .admin-lock-overlay .lock-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #ef4444;
            padding: 0.75rem 1.5rem;
            border-radius: 9999px;
            font-weight: 600;
            font-size: 0.9rem;
            margin-top: 1.5rem;
            font-family: 'Alexandria', sans-serif;
        }
        @keyframes pulse-lock {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.1); opacity: 0.7; }
        }
    </style>
</head>
<body>
    <script>
        window.__APP_DATA__ = {
            token: "<%- token %>",
            api: "<%- api %>",
            isAuthenticated: <%- isAuthenticated ? 'true' : 'false' %>,
            user: <%- JSON.stringify(user || null) %>
        };
    </script>
    <div id="adminLockOverlay" class="admin-lock-overlay" style="display:none;">
        <i class="las la-lock lock-icon"></i>
        <h2>هذه الصفحة مخصصة للمديرين فقط</h2>
        <p>عذراً، ليس لديك صلاحية للوصول إلى هذه الصفحة. إذا كنت تعتقد أن هذا خطأ، يرجى التواصل مع مدير النظام.</p>
        <div class="lock-badge">
            <i class="las la-shield-alt"></i>
            <span>صلاحية المدير مطلوبة</span>
        </div>
    </div>
    <%- include('../../sections/header-ebnhamido.ejs') %>
            <div class="container mx-auto px-4 py-6 max-w-7xl">
                <div class="title-cell">
                    <div class="title-icon"><i class="las la-folder-open"></i></div>
                    <h1>إدارة الملفات والموظفين</h1>
                    <p>إنشاء ملفات وإضافة الموظفين وتعديل بياناتهم</p>
                </div>
                <div id="filesView">
                    <div class="info-card">
                        <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
                            <h3 class="text-lg font-bold text-[var(--color-white)] flex items-center gap-2"><i class="las la-folder-open text-primary"></i> الملفات</h3>
                            <button class="btn-primary btn-sm" id="addFileBtn"><i class="las la-plus"></i> ملف جديد</button>
                        </div>
                        <div class="mb-4">
                            <div class="relative">
                                <i class="las la-search absolute left-4 top-1/2 transform -translate-y-1/2 text-[var(--color-muted)] text-lg"></i>
                                <input type="text" id="fileSearch" class="input-field pr-10" placeholder="ابحث عن ملف...">
                            </div>
                        </div>
                        <div class="space-y-3" id="filesList"></div>
                    </div>
                </div>
                <div id="employeesView" style="display:none;">
                    <div class="info-card">
                        <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
                            <div class="flex items-center gap-3">
                                <button class="btn-outline btn-sm" id="backToFilesBtn"><i class="las la-arrow-right"></i> رجوع</button>
                                <h3 class="text-lg font-bold text-[var(--color-white)] flex items-center gap-2" id="currentFileName"></h3>
                            </div>
                            <div class="flex flex-wrap gap-2">
                                <button class="btn-primary btn-sm" id="addEmployeeBtn"><i class="las la-user-plus"></i> إضافة موظف</button>
                            </div>
                        </div>
                        <div class="mb-4">
                            <div class="relative">
                                <i class="las la-search absolute left-4 top-1/2 transform -translate-y-1/2 text-[var(--color-muted)] text-lg"></i>
                                <input type="text" id="employeeSearch" class="input-field pr-10" placeholder="ابحث بالكود أو الاسم...">
                            </div>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="employee-table" id="employeesTable">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>الكود</th>
                                        <th>الاسم</th>
                                        <th>الهاتف</th>
                                        <th>المهنة</th>
                                        <th>الراتب الشهري</th>
                                        <th>اليومية</th>
                                        <th>إجراءات</th>
                                    </tr>
                                </thead>
                                <tbody id="employeesTableBody"></tbody>
                            </table>
                        </div>
                        <div class="text-center text-xs text-[var(--color-muted)] mt-3">يمكنك إضافة وتعديل وحذف الموظفين داخل الملف.</div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <div class="modal-overlay" id="employeeFormModal">
        <div class="modal-content">
            <button class="modal-close" id="closeEmployeeFormModal"><i class="las la-times"></i></button>
            <h3 class="text-xl font-bold mb-4 text-[var(--color-white)] text-center" id="employeeFormTitle">إضافة موظف</h3>
            <div id="employeeFormFields">
                <div id="empReadonlyFields" style="display:none;">
                    <div class="mb-3">
                        <label class="text-sm text-[var(--color-muted)] block mb-1">كود الموظف</label>
                        <div class="readonly-label" id="empCodeDisplay">---</div>
                    </div>
                </div>
                <div id="empEditableFields">
                    <div id="empNameInputWrap" class="mb-3">
                        <label class="text-sm text-[var(--color-muted)] block mb-1">الاسم</label>
                        <input type="text" id="empNameInput" class="input-field" placeholder="أدخل اسم الموظف">
                    </div>
                    <div class="mb-3">
                        <label class="text-sm text-[var(--color-muted)] block mb-1">رقم الهاتف</label>
                        <input type="text" id="empPhoneInput" class="input-field" placeholder="أدخل رقم الهاتف" inputmode="tel">
                    </div>
                    <div class="mb-3">
                        <label class="text-sm text-[var(--color-muted)] block mb-1">المهنة</label>
                        <input type="text" id="empProfessionInput" class="input-field" placeholder="أدخل المهنة">
                    </div>
                    <div class="mb-3">
                        <label class="text-sm text-[var(--color-muted)] block mb-1">الراتب الشهري (ج.م)</label>
                        <input type="text" id="empMonthlySalaryInput" class="input-field" placeholder="أدخل الراتب الشهري" inputmode="decimal">
                    </div>
                </div>
            </div>
            <input type="hidden" id="empEditId">
            <div class="flex gap-3 mt-5 justify-center">
                <button class="btn-primary btn-sm" id="saveEmployeeBtn"><i class="las la-save"></i> حفظ</button>
                <button class="btn-outline btn-sm" id="cancelEmployeeBtn"><i class="las la-times"></i> إلغاء</button>
            </div>
        </div>
    </div>
    <div class="modal-overlay" id="fileFormModal">
        <div class="modal-content">
            <button class="modal-close" id="closeFileFormModal"><i class="las la-times"></i></button>
            <h3 class="text-xl font-bold mb-4 text-[var(--color-white)] text-center">ملف جديد</h3>
            <div><label class="text-sm text-[var(--color-muted)] block mb-1">اسم الملف</label><input type="text" id="fileNameInput" class="input-field" placeholder="أدخل اسم الملف"></div>
            <div class="flex gap-3 mt-5 justify-center">
                <button class="btn-primary btn-sm" id="saveFileBtn"><i class="las la-save"></i> إنشاء</button>
                <button class="btn-outline btn-sm" id="cancelFileBtn"><i class="las la-times"></i> إلغاء</button>
            </div>
        </div>
    </div>
    <div class="modal-overlay" id="copyFileModal">
        <div class="modal-content">
            <button class="modal-close" id="closeCopyFileModal"><i class="las la-times"></i></button>
            <h3 class="text-xl font-bold mb-4 text-[var(--color-white)] text-center">نسخ الملف</h3>
            <div class="mb-3">
                <label class="text-sm text-[var(--color-muted)] block mb-1">اسم الملف الجديد</label>
                <input type="text" id="copyFileNameInput" class="input-field" placeholder="أدخل اسم الملف الجديد">
            </div>
            <div class="mb-3">
                <label class="text-sm text-[var(--color-muted)] block mb-1">كلمة المرور</label>
                <input type="password" id="copyFilePasswordInput" class="input-field" placeholder="أدخل كلمة المرور">
            </div>
            <input type="hidden" id="copyFileId">
            <div class="flex gap-3 mt-5 justify-center">
                <button class="btn-primary btn-sm" id="saveCopyFileBtn"><i class="las la-copy"></i> نسخ</button>
                <button class="btn-outline btn-sm" id="cancelCopyFileBtn"><i class="las la-times"></i> إلغاء</button>
            </div>
        </div>
    </div>
    <script>
        window.__SERVER_DATA__ = <%- JSON.stringify(adminFiles) %>;
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        (function() {
            var API_BASE = "<%= api %>" + '/api/admin/files';
            var appData = { files: [] };
            var currentFileId = null;
            var RESTAURANT_ID = "1";

            var isAdmin = window.__APP_DATA__.user && window.__APP_DATA__.user.account_type === 'admin';

            var sidebar = document.getElementById('dashboardSidebar');
            var headerAvatar = document.getElementById('headerAvatar');

            function openSidebar() {
                sidebar.classList.add('mobile-open');
                sidebar.classList.remove('mobile-closed');
            }

            function closeSidebar() {
                sidebar.classList.remove('mobile-open');
                sidebar.classList.add('mobile-closed');
            }
            if (window.innerWidth < 1025) sidebar.classList.add('mobile-closed');
            window.addEventListener('resize', function() {
                if (window.innerWidth >= 1025) {
                    sidebar.classList.remove('mobile-open', 'mobile-closed');
                } else {
                    if (!sidebar.classList.contains('mobile-open')) sidebar.classList.add('mobile-closed');
                }
            });
            if (headerAvatar) {
                headerAvatar.addEventListener('click', function(e) {
                    e.stopPropagation();
                    if (window.innerWidth < 1025) {
                        if (sidebar.classList.contains('mobile-open')) closeSidebar();
                        else openSidebar();
                    }
                });
            }
            document.addEventListener('click', function(e) {
                if (window.innerWidth < 1025 && sidebar.classList.contains('mobile-open')) {
                    if (!sidebar.contains(e.target) && e.target !== headerAvatar && !headerAvatar.contains(e.target)) {
                        closeSidebar();
                    }
                }
            });
            var sidebarItems = document.querySelectorAll('.sidebar-item');
            sidebarItems.forEach(function(item) {
                item.addEventListener('click', function() {
                    if (this.id === 'logoutBtn') return;
                    sidebarItems.forEach(function(i) { i.classList.remove('active'); });
                    this.classList.add('active');
                    if (window.innerWidth < 1025) closeSidebar();
                });
            });
            var logoutBtn = document.getElementById('logoutBtn');
            if (logoutBtn) {
                logoutBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    Swal.fire({
                        title: 'تسجيل الخروج',
                        text: 'هل أنت متأكد من تسجيل الخروج؟',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'نعم',
                        cancelButtonText: 'لا'
                    }).then(function(result) {
                        if (result.isConfirmed) window.location.href = '/';
                    });
                });
            }
            var bottomNavItems = document.querySelectorAll('.bottom-nav-item');
            var navNotch = document.getElementById('navNotch');

            function moveNotch(activeItem) {
                if (!navNotch || !activeItem) return;
                var rect = activeItem.getBoundingClientRect();
                var navRect = document.getElementById('bottomMobileNav').getBoundingClientRect();
                var centerX = rect.left + rect.width / 2 - navRect.left;
                navNotch.style.left = centerX + 'px';
            }
            bottomNavItems.forEach(function(item) {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    bottomNavItems.forEach(function(i) { i.classList.remove('active'); });
                    this.classList.add('active');
                    moveNotch(this);
                });
            });
            var initialActive = document.querySelector('.bottom-nav-item.active');
            if (initialActive) moveNotch(initialActive);
            window.addEventListener('resize', function() {
                var activeItem = document.querySelector('.bottom-nav-item.active');
                if (activeItem) moveNotch(activeItem);
            });

            function showAlert(message, type) {
                Swal.fire({
                    icon: type || 'success',
                    text: message,
                    confirmButtonText: 'حسناً'
                });
            }

            function showConfirm(message, callback) {
                Swal.fire({
                    title: 'تأكيد',
                    text: message,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'نعم',
                    cancelButtonText: 'لا'
                }).then(function(result) {
                    if (result.isConfirmed) callback();
                });
            }

            function showPasswordPrompt(message, callback) {
                Swal.fire({
                    title: 'أدخل كلمة المرور',
                    text: message,
                    input: 'password',
                    inputPlaceholder: 'كلمة المرور',
                    inputAttributes: {
                        autocapitalize: 'off',
                        autocorrect: 'off'
                    },
                    showCancelButton: true,
                    confirmButtonText: 'تأكيد',
                    cancelButtonText: 'إلغاء',
                    preConfirm: function(password) {
                        if (!password) {
                            Swal.showValidationMessage('كلمة المرور مطلوبة');
                        }
                        return password;
                    }
                }).then(function(result) {
                    if (result.isConfirmed) callback(result.value);
                });
            }

            var employeeFormModal = document.getElementById('employeeFormModal');
            var fileFormModal = document.getElementById('fileFormModal');
            var copyFileModal = document.getElementById('copyFileModal');
            document.getElementById('closeEmployeeFormModal').addEventListener('click', function() {
                employeeFormModal.classList.remove('active');
            });
            document.getElementById('cancelEmployeeBtn').addEventListener('click', function() {
                employeeFormModal.classList.remove('active');
            });
            document.getElementById('closeFileFormModal').addEventListener('click', function() {
                fileFormModal.classList.remove('active');
            });
            document.getElementById('cancelFileBtn').addEventListener('click', function() {
                fileFormModal.classList.remove('active');
            });
            document.getElementById('closeCopyFileModal').addEventListener('click', function() {
                copyFileModal.classList.remove('active');
            });
            document.getElementById('cancelCopyFileBtn').addEventListener('click', function() {
                copyFileModal.classList.remove('active');
            });
            window.addEventListener('click', function(e) {
                if (e.target === employeeFormModal) employeeFormModal.classList.remove('active');
                if (e.target === fileFormModal) fileFormModal.classList.remove('active');
                if (e.target === copyFileModal) copyFileModal.classList.remove('active');
            });
            var filesView = document.getElementById('filesView');
            var employeesView = document.getElementById('employeesView');
            var filesList = document.getElementById('filesList');
            var currentFileName = document.getElementById('currentFileName');
            var employeesTableBody = document.getElementById('employeesTableBody');
            var employeeSearchInput = document.getElementById('employeeSearch');
            var fileSearchInput = document.getElementById('fileSearch');

            function renderFilesList() {
                var query = fileSearchInput ? fileSearchInput.value.toLowerCase().trim() : '';
                filesList.innerHTML = '';
                var filteredFiles = appData.files.filter(function(file) {
                    return file.name && file.name.toLowerCase().includes(query);
                });
                if (filteredFiles.length === 0) {
                    filesList.innerHTML =
                        '<div class="text-center py-8 text-[var(--color-muted)]"><i class="las la-folder-open text-5xl block mb-3 opacity-30"></i><p>لا توجد ملفات</p><p class="text-xs mt-1">أنشئ ملفاً جديداً أو غيّر البحث</p></div>';
                    return;
                }
                filteredFiles.forEach(function(file) {
                    var employeeCount = file.employees ? file.employees.length : 0;
                    var div = document.createElement('div');
                    div.className = 'file-card';
                    div.innerHTML =
                        '<div class="file-icon"><i class="las la-folder"></i></div><div class="flex-1 min-w-0"><p class="font-bold text-[var(--color-white)] text-base">' +
                        (file.name || 'ملف بدون اسم') +
                        '</p><p class="text-xs text-[var(--color-muted)]">' + employeeCount +
                        ' موظف · أنشئ ' + new Date(file.createdAt).toLocaleDateString('ar-EG') +
                        '</p></div><div class="flex gap-2 flex-shrink-0"><button class="btn-outline btn-xs open-file-btn" data-id="' +
                        file.id + '" title="فتح الملف"><i class="las la-folder-open"></i> فتح</button><button class="btn-outline btn-xs copy-file-btn" data-id="' +
                        file.id + '" title="نسخ الملف"><i class="las la-copy"></i></button><button class="btn-outline btn-xs delete-file-btn" data-id="' +
                        file.id + '" title="حذف الملف" style="color:#ef4444;border-color:rgba(239,68,68,0.3);"><i class="las la-trash-alt"></i></button></div>';
                    filesList.appendChild(div);
                });
                document.querySelectorAll('.open-file-btn').forEach(function(btn) {
                    btn.addEventListener('click', function() {
                        openFile(this.getAttribute('data-id'));
                    });
                });
                document.querySelectorAll('.copy-file-btn').forEach(function(btn) {
                    btn.addEventListener('click', function(e) {
                        e.stopPropagation();
                        var fid = this.getAttribute('data-id');
                        openCopyModal(fid);
                    });
                });
                document.querySelectorAll('.delete-file-btn').forEach(function(btn) {
                    btn.addEventListener('click', function(e) {
                        e.stopPropagation();
                        var fid = this.getAttribute('data-id');
                        showPasswordPrompt('هل أنت متأكد من حذف هذا الملف وجميع موظفيه؟', function(password) {
                            deleteFile(fid, password);
                        });
                    });
                });
            }
            if (fileSearchInput) {
                fileSearchInput.addEventListener('input', renderFilesList);
            }

            function openCopyModal(fileId) {
                document.getElementById('copyFileId').value = fileId;
                document.getElementById('copyFileNameInput').value = '';
                document.getElementById('copyFilePasswordInput').value = '';
                copyFileModal.classList.add('active');
            }

            function saveCopyFile() {
                var fileId = document.getElementById('copyFileId').value;
                var newName = document.getElementById('copyFileNameInput').value.trim();
                var password = document.getElementById('copyFilePasswordInput').value.trim();
                if (!newName) {
                    showAlert('يرجى إدخال اسم الملف الجديد.', 'warning');
                    return;
                }
                if (!password) {
                    showAlert('يرجى إدخال كلمة المرور.', 'warning');
                    return;
                }
                fetch(API_BASE + '/copy', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        fileId: fileId,
                        name: newName,
                        restaurant_id: RESTAURANT_ID,
                        password: password
                    })
                })
                .then(function(res) { return res.json(); })
                .then(function(result) {
                    if (result.success && result.file) {
                        if (result.file.restaurant_id === RESTAURANT_ID) {
                            appData.files.push(result.file);
                        }
                        copyFileModal.classList.remove('active');
                        renderFilesList();
                        showAlert(result.message || 'تم نسخ الملف بنجاح.', 'success');
                    } else {
                        showAlert(result.message || 'فشل نسخ الملف', 'error');
                    }
                })
                .catch(function(err) {
                    showAlert('حدث خطأ: ' + err.message, 'error');
                });
            }

            document.getElementById('saveCopyFileBtn').addEventListener('click', saveCopyFile);

            function openFile(fileId) {
                currentFileId = fileId;
                var file = appData.files.find(function(f) { return f.id === fileId; });
                if (!file) return;
                if (!file.employees) file.employees = [];
                currentFileName.textContent = '📁 ' + (file.name || 'ملف');
                filesView.style.display = 'none';
                employeesView.style.display = 'block';
                if (employeeSearchInput) employeeSearchInput.value = '';
                renderEmployeesTable();
            }

            function closeFile() {
                currentFileId = null;
                filesView.style.display = 'block';
                employeesView.style.display = 'none';
                renderFilesList();
            }

            function deleteFile(fileId, password) {
                fetch(API_BASE + '/delete-folder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ folderId: fileId, password: password })
                })
                .then(function(res) { return res.json(); })
                .then(function(result) {
                    if (result.success) {
                        appData.files = appData.files.filter(function(f) { return f.id !== fileId; });
                        if (currentFileId === fileId) closeFile();
                        renderFilesList();
                        showAlert(result.message || 'تم حذف الملف بنجاح.', 'success');
                    } else {
                        showAlert(result.message || 'فشل حذف الملف', 'error');
                    }
                })
                .catch(function(err) {
                    showAlert('حدث خطأ: ' + err.message, 'error');
                });
            }

            function updateLocalFile(fileId, updatedFile) {
                var index = appData.files.findIndex(function(f) { return f.id === fileId; });
                if (index !== -1) {
                    appData.files[index] = updatedFile;
                } else {
                    appData.files.push(updatedFile);
                }
            }

            function renderEmployeesTable() {
                employeesTableBody.innerHTML = '';
                var file = appData.files.find(function(f) { return f.id === currentFileId; });
                if (!file || !file.employees || file.employees.length === 0) {
                    employeesTableBody.innerHTML =
                        '<tr><td colspan="8" class="text-center py-8 text-[var(--color-muted)]"><i class="las la-users text-4xl block mb-2 opacity-30"></i>لا يوجد موظفين في هذا الملف</td></tr>';
                    return;
                }
                file.employees.forEach(function(emp, index) {
                    var monthly = parseFloat(emp.monthlySalary) || 0;
                    var daily = monthly / 30;
                    var dailyStr = daily.toFixed(2);
                    var tr = document.createElement('tr');
                    tr.innerHTML =
                        '<td>' + (index + 1) +
                        '</td><td><span class="emp-code">' + (emp.code || '---') +
                        '</span></td><td><div class="emp-name">' + (emp.name || '---') +
                        '</div></td><td>' + (emp.phone || '---') +
                        '</td><td>' + (emp.profession || '---') +
                        '</td><td>' + monthly +
                        '</td><td><span class="daily-salary">' + dailyStr +
                        '</span></td><td><div class="emp-actions"><button class="btn-outline btn-xs edit-emp-btn" data-eid="' +
                        emp.id + '" title="تعديل"><i class="las la-edit"></i></button><button class="btn-outline btn-xs delete-emp-btn" data-eid="' +
                        emp.id + '" title="حذف" style="color:#ef4444;border-color:rgba(239,68,68,0.3);"><i class="las la-trash-alt"></i></button></div></td>';
                    employeesTableBody.appendChild(tr);
                });
                employeesTableBody.querySelectorAll('.edit-emp-btn').forEach(function(btn) {
                    btn.addEventListener('click', function() {
                        openEmployeeForm(this.getAttribute('data-eid'));
                    });
                });
                employeesTableBody.querySelectorAll('.delete-emp-btn').forEach(function(btn) {
                    btn.addEventListener('click', function() {
                        var eid = this.getAttribute('data-eid');
                        showPasswordPrompt('هل أنت متأكد من حذف هذا الموظف؟', function(password) {
                            deleteEmployee(eid, password);
                        });
                    });
                });
                applyEmployeeFilter();
            }

            function applyEmployeeFilter() {
                var query = employeeSearchInput ? employeeSearchInput.value.toLowerCase().trim() : '';
                var rows = employeesTableBody.querySelectorAll('tr');
                rows.forEach(function(row) {
                    var codeCell = row.cells[1];
                    var nameCell = row.cells[2];
                    if (!codeCell || !nameCell) return;
                    var codeText = codeCell.textContent.toLowerCase();
                    var nameText = nameCell.textContent.toLowerCase();
                    if (codeText.includes(query) || nameText.includes(query)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }
            if (employeeSearchInput) {
                employeeSearchInput.addEventListener('input', applyEmployeeFilter);
            }

            function deleteEmployee(employeeId, password) {
                var fileId = currentFileId;
                if (!fileId) return;
                fetch(API_BASE + '/delete-employee', {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ fileId: fileId, employeeId: employeeId, password: password })
                })
                .then(function(res) { return res.json(); })
                .then(function(result) {
                    if (result.success && result.file) {
                        updateLocalFile(fileId, result.file);
                        renderEmployeesTable();
                        showAlert(result.message || 'تم حذف الموظف بنجاح.', 'success');
                    } else {
                        showAlert(result.message || 'فشل حذف الموظف', 'error');
                    }
                })
                .catch(function(err) {
                    showAlert('حدث خطأ: ' + err.message, 'error');
                });
            }

            function openEmployeeForm(editId) {
                var modal = document.getElementById('employeeFormModal');
                var title = document.getElementById('employeeFormTitle');
                var editIdInput = document.getElementById('empEditId');
                var readonlyWrap = document.getElementById('empReadonlyFields');
                var editableWrap = document.getElementById('empEditableFields');
                var nameInputWrap = document.getElementById('empNameInputWrap');
                var nameInput = document.getElementById('empNameInput');
                var codeDisplay = document.getElementById('empCodeDisplay');
                var professionInput = document.getElementById('empProfessionInput');
                var salaryInput = document.getElementById('empMonthlySalaryInput');
                var phoneInput = document.getElementById('empPhoneInput');
                editIdInput.value = editId || '';
                if (editId) {
                    title.textContent = 'تعديل بيانات الموظف';
                    readonlyWrap.style.display = 'block';
                    nameInputWrap.style.display = 'block';
                    var file = appData.files.find(function(f) { return f.id === currentFileId; });
                    if (file) {
                        var emp = file.employees.find(function(e) { return e.id === editId; });
                        if (emp) {
                            codeDisplay.textContent = emp.code || '---';
                            nameInput.value = emp.name || '';
                            phoneInput.value = emp.phone || '';
                            professionInput.value = emp.profession || '';
                            salaryInput.value = emp.monthlySalary || '';
                        }
                    }
                } else {
                    title.textContent = 'إضافة موظف جديد';
                    readonlyWrap.style.display = 'none';
                    nameInputWrap.style.display = 'block';
                    nameInput.value = '';
                    phoneInput.value = '';
                    professionInput.value = '';
                    salaryInput.value = '';
                }
                modal.classList.add('active');
            }

            function saveEmployee() {
                var editId = document.getElementById('empEditId').value;
                var nameInput = document.getElementById('empNameInput');
                var professionInput = document.getElementById('empProfessionInput');
                var salaryInput = document.getElementById('empMonthlySalaryInput');
                var phoneInput = document.getElementById('empPhoneInput');
                var fileId = currentFileId;
                if (!fileId) return;

                if (editId) {
                    var employeeName = nameInput.value.trim();
                    if (!employeeName) {
                        showAlert('يرجى إدخال اسم الموظف.', 'warning');
                        return;
                    }
                    var payload = {
                        fileId: fileId,
                        employeeId: editId,
                        name: employeeName,
                        phone: phoneInput.value.trim(),
                        profession: professionInput.value.trim(),
                        monthlySalary: salaryInput.value.trim()
                    };
                    fetch(API_BASE + '/update-employee', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    })
                    .then(function(res) { return res.json(); })
                    .then(function(result) {
                        if (result.success && result.file) {
                            updateLocalFile(fileId, result.file);
                            document.getElementById('employeeFormModal').classList.remove('active');
                            renderEmployeesTable();
                            showAlert(result.message || 'تم تحديث بيانات الموظف بنجاح.', 'success');
                        } else {
                            showAlert(result.message || 'فشل تحديث الموظف', 'error');
                        }
                    })
                    .catch(function(err) {
                        showAlert('حدث خطأ: ' + err.message, 'error');
                    });
                } else {
                    var name = nameInput.value.trim();
                    if (!name) {
                        showAlert('يرجى إدخال اسم الموظف.', 'warning');
                        return;
                    }
                    var payload = {
                        fileId: fileId,
                        name: name,
                        phone: phoneInput.value.trim(),
                        profession: professionInput.value.trim(),
                        monthlySalary: salaryInput.value.trim()
                    };
                    fetch(API_BASE + '/add-employee', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    })
                    .then(function(res) { return res.json(); })
                    .then(function(result) {
                        if (result.success && result.file) {
                            updateLocalFile(fileId, result.file);
                            document.getElementById('employeeFormModal').classList.remove('active');
                            renderEmployeesTable();
                            showAlert(result.message || 'تم إضافة الموظف بنجاح.', 'success');
                        } else {
                            showAlert(result.message || 'فشل إضافة الموظف', 'error');
                        }
                    })
                    .catch(function(err) {
                        showAlert('حدث خطأ: ' + err.message, 'error');
                    });
                }
            }

            document.getElementById('addFileBtn').addEventListener('click', function() {
                document.getElementById('fileNameInput').value = '';
                fileFormModal.classList.add('active');
            });
            document.getElementById('saveFileBtn').addEventListener('click', function() {
                var name = document.getElementById('fileNameInput').value.trim();
                if (!name) {
                    showAlert('يرجى إدخال اسم الملف.', 'warning');
                    return;
                }
                fetch(API_BASE + '/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: name, restaurant_id: RESTAURANT_ID })
                })
                .then(function(res) { return res.json(); })
                .then(function(result) {
                    if (result.success && result.file) {
                        if (result.file.restaurant_id === RESTAURANT_ID) {
                            appData.files.push(result.file);
                        }
                        fileFormModal.classList.remove('active');
                        renderFilesList();
                        showAlert(result.message || 'تم إنشاء الملف بنجاح.', 'success');
                    } else {
                        showAlert(result.message || 'فشل إنشاء الملف', 'error');
                    }
                })
                .catch(function(err) {
                    showAlert('حدث خطأ: ' + err.message, 'error');
                });
            });
            document.getElementById('backToFilesBtn').addEventListener('click', closeFile);
            document.getElementById('addEmployeeBtn').addEventListener('click', function() {
                openEmployeeForm(null);
            });
            document.getElementById('saveEmployeeBtn').addEventListener('click', saveEmployee);

            function loadInitialData() {
                var serverData = window.__SERVER_DATA__;
                if (serverData && serverData.success && Array.isArray(serverData.files)) {
                    appData.files = serverData.files.filter(function(file) {
                        return file.restaurant_id === RESTAURANT_ID;
                    });
                    renderFilesList();
                } else if (serverData && Array.isArray(serverData)) {
                    appData.files = serverData.filter(function(file) {
                        return file.restaurant_id === RESTAURANT_ID;
                    });
                    renderFilesList();
                } else {
                    showAlert('فشل تحميل الملفات', 'error');
                }
            }

            function applyAdminLock() {
                if (!isAdmin) {
                    var overlay = document.getElementById('adminLockOverlay');
                    if (overlay) {
                        overlay.style.display = 'flex';
                    }
                    var allInteractive = document.querySelectorAll('input, button, select, textarea, a, .btn, .btn-outline, .btn-primary, .input-field, .file-card, .open-file-btn, #fileSearch, #employeeSearch, #employeeMonthFilter, #backToFilesBtn, #printFileBtn, .bottom-nav-item, .sidebar-item');
                    allInteractive.forEach(function(el) {
                        if (el.id !== 'adminLockOverlay' && !el.closest('#adminLockOverlay')) {
                            el.style.pointerEvents = 'none';
                            el.setAttribute('tabindex', '-1');
                            if (el.tagName === 'INPUT' || el.tagName === 'SELECT' || el.tagName === 'TEXTAREA' || el.tagName === 'BUTTON') {
                                el.setAttribute('disabled', 'disabled');
                            }
                        }
                    });
                    document.querySelectorAll('a, .btn, .btn-outline, .btn-primary, .file-card, .open-file-btn, .bottom-nav-item, .sidebar-item').forEach(function(el) {
                        if (el.id !== 'adminLockOverlay' && !el.closest('#adminLockOverlay')) {
                            el.setAttribute('aria-disabled', 'true');
                        }
                    });
                    var tableHint = document.querySelector('.text-center.text-xs');
                    if (tableHint) {
                        tableHint.textContent = 'أنت بحاجة إلى صلاحية المدير لإدارة الملفات والموظفين.';
                        tableHint.style.color = '#ef4444';
                    }
                } else {
                    var overlay = document.getElementById('adminLockOverlay');
                    if (overlay) {
                        overlay.style.display = 'none';
                    }
                }
            }

            document.addEventListener('DOMContentLoaded', function() {
                var themeToggles = document.querySelectorAll('.theme-toggle');
                var body = document.body;

                function applyTheme(theme) {
                    var isDark = theme === 'dark';
                    body.classList.toggle('light', !isDark);
                    themeToggles.forEach(function(toggle) { toggle.classList.toggle('dark', isDark); });
                    localStorage.setItem('theme', theme);
                }
                var savedTheme = localStorage.getItem('theme') || 'dark';
                applyTheme(savedTheme);
                themeToggles.forEach(function(toggle) {
                    toggle.addEventListener('click', function() {
                        var isDark = body.classList.contains('light') === false;
                        applyTheme(isDark ? 'light' : 'dark');
                    });
                });
                applyAdminLock();
                loadInitialData();
            });
        })();
    </script>
</body>
</html>
